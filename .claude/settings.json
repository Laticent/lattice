{
  "doneMeansMerged": true,
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git fetch*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git rebase*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git stash*)",
      "Bash(git merge*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(npm run test:*)",
      "Bash(npm run build*)",
      "Bash(npm run check:*)",
      "Bash(npm run preview*)",
      "Bash(npm run lint:deck*)",
      "Bash(node tools/*)",
      "Bash(npx marp*)",
      "Bash(marp*)",
      "mcp__claude-code-remote__subscribe_pr_activity",
      "mcp__claude-code-remote__unsubscribe_pr_activity",
      "mcp__github__pull_request_read",
      "mcp__github__get_check_run",
      "mcp__github__list_commits",
      "mcp__github__get_job_logs",
      "mcp__github__get_file_contents",
      "mcp__github__list_pull_requests",
      "mcp__github__search_pull_requests",
      "mcp__github__get_me",
      "mcp__github__actions_get",
      "mcp__github__actions_list",
      "mcp__github__create_pull_request"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-rebase-check.sh"
          }
        ]
      }
    ]
  }
}
