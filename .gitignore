node_modules/
.scratch/
tokenization/
/release/

# Marp / build outputs
# (note: the four allow-listed locations below are intentionally
# tracked: examples/ ship-with-the-package demos, per-component +
# per-bucket galleries under lib/components/, per-integration
# galleries under lib/integrations/, and the CI baseline regression
# decks under test/integration/baseline-decks/. See
# engineering/workflow.md and CLAUDE.md. The rule below catches
# ad-hoc renders elsewhere in the tree.)
*.pptx
*.pdf
!examples/*.pdf
!exemplars/**/*.pdf
!lib/components/**/*.pdf
!lib/base/**/*.pdf
!lib/integrations/**/*.pdf
# The Marp kit's sample deck, rendered through real marp-cli — the HARD RULE #9
# artifact for a feature colocated with its implementation. Reviewable in the
# diff, which is the point: the first version of this deck shipped with a blank
# trailing page and three truncated slides that no unit test could see.
!kit/*.pdf
!test/integration/baseline-decks/*.pdf
!docs/*.pdf
!themes/*.pdf

# esbuild check tempfiles — produced next to the bundles by
# `npm run runtime:check` / `emulator:check`. The scripts clean up on
# success/failure; these catch the killed-mid-build case.
dist/lattice-runtime.js.check.tmp
dist/lattice-emulator.js.check.tmp

# Opt-in full-offline colour-emoji font (~25 MB) vendored on demand by
# `npm run fonts:emoji`. Excluded from the npm tarball (package.json `files`)
# AND from git so a fetch in a working tree can't be accidentally committed.
dist/fonts/noto-color-emoji.ttf

# Bucket-gallery build tempfiles — tools/build-bucket-galleries.js writes
# <bucket>.gallery.<theme>.tmp.md next to the source during render and
# normally deletes it; this catches the killed-mid-build case.
lib/components/**/*.gallery.*.tmp.md

# LibreOffice lock files
.~lock.*#

# macOS
.DS_Store

# Python bytecode (design/logo/generate.py)
__pycache__/
*.pyc

examples/*.html
examples/**/*.html
examples/*.notes.txt
design/**/*.html
exemplars/**/*.html
lib/components/**/*.html
test/integration/**/*.html
!examples/*.pdf
!examples/**/*.pdf
!exemplars/**/*.pdf
!lib/components/**/*.pdf
!lib/base/**/*.pdf

# Regression-gate fresh-render tempfiles — tools/regression-gate.mjs renders
# each candidate into the gallery's OWN dir (so relative assets resolve) as a
# `.regr-*` dotfile and normally deletes it. This MUST sit after the
# `!lib/components/**/*.pdf` negations above, or that negation would force-track
# a `.regr-*.pdf` left behind by a killed-mid-run. Re-ignore the whole family.
lib/components/**/.regr-*
lib/base/**/.regr-*
# The `decks` scope (#1379) renders into FIVE more directories for the same reason —
# the emulator resolves a deck's relative assets against the output path — so the same
# killed-mid-run hazard now exists beside every committed deck, not just the galleries.
examples/**/.regr-*
exemplars/**/.regr-*
design/.regr-*
themes/.regr-*
test/integration/baseline-decks/.regr-*

# emulator render sidecars next to the palette-audit deck
themes/*.html

# Agent isolation worktrees (transient; auto-cleaned)
.claude/worktrees/

# perf-collect / perf-nightly working dirs (docs/scripts/perf-collect.mjs;
# the nightly workflow writes .perf-out/ at the repo root)
.perf/
.perf-out/
.scratch-*

# Scratch decks written NEXT TO a fixture by a size-sweeping gate. `check-chart-fit.js`
# rewrites the fixture's front matter per deck shape and writes `.chart-fit-<size>-<pid>.md`
# beside it; its own comment records that a run exiting early "would strand the per-size
# scratch decks in test/fixtures/" — the path that always runs while a gate is being fixed.
# An agent reproducing a clip leaves the same shape behind. None of these is ever tracked,
# and an untracked one trips the repo's commit-and-push hook on every turn.
test/fixtures/.*.md

# Astro scratch written by a root-level `astro sync` / `astro preview` run.
# docs/.gitignore covers docs/.astro; nothing covered the repo root, so a stray
# run left preview.json/preview.log tracked (and tripped the lint-coverage gate).
.astro/

# Transient dark-injected gallery sources. A sweep that renders every gallery in the
# dark mood has to write its injected copy NEXT TO the original — the emulator resolves
# a deck's relative assets against the deck's own directory, which is why
# build-galleries.js does the same with `*.gallery.<theme>.tmp.md`. Each is deleted the
# moment its render finishes, so these only exist mid-run; ignored so a sweep in flight
# cannot be mistaken for work to commit.
*.darksweep.tmp.md

# ── Generated bundles: BUILT, not committed (2026-08-17) ─────────────────────
# `npm run build` produces these in ~16s with no browser. They were committed
# until the merge queue made that untenable: the minified files run ~9.6 KB per
# LINE, so any two PRs that regenerated them conflicted with certainty and the
# queue ejected one, silently clearing its auto-merge flag. 43 of the last 50
# commits touched dist/.
#
# Keeping them committed was considered and rejected on measurement: the only
# reason to was that people might fetch them from the repo, and jsDelivr's public
# stats show 2 lifetime /gh/ hits, both against an immutable commit SHA (which
# keeps resolving regardless). The npm package is unaffected — `files` carries
# dist/ and the tarball is built at publish.
# See engineering/decisions/2026-08-17-generated-bundles-uncommitted.md
dist/
docs/public/playground/
docs/src/playground/*.generated.js
docs/src/lib/*/dist/
