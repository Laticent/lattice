{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // ── EXCLUSIONS ────────────────────────────────────────────────────────────────
    // The rule (#1223): nothing but vendor code, generated code, or source a standard
    // parser cannot read may be excluded — and every entry says which it is, in prose,
    // on the line above it. This file is `.jsonc` for exactly that reason. It was
    // `biome.json`, where 29 exclusions carried ZERO reasons: nothing distinguished
    // "generated, generator at tools/build-playground.js" from "we gave up on this
    // one", and nothing noticed when an entry stopped matching anything — which is how
    // `examples/**/*.json` survived pointing at nothing at all.
    //
    // CLASSES: dependency · build-output · transient · vendor · not-code ·
    // generated by `<path>` · unparseable: <why>.
    //
    // ── THIS IS A CONVENTION, NOT A GATE, AND THAT IS DELIBERATE ──────────────────
    // A gate was written to enforce it and then REMOVED before merge, because an
    // adversarial pass found it answered the wrong question. It validated the SPELLING
    // of `!` entries in this array; lint coverage does not live there. Measured against
    // the real Biome:
    //
    //   • deleting one POSITIVE line above (`"**/*.ts"`) drops coverage 1249 → 888
    //     files. The gate read only `!` entries, so it saw nothing.
    //   • one line in `.gitignore` un-lints tracked source (`vcs.useIgnoreFile` is on,
    //     line 3) with no edit to this file at all. 1249 → 1231, still tracked.
    //   • `overrides[].linter.enabled: false`, `linter.includes`, and `files.maxSize`
    //     each silence lint while the file COUNT stays flat or rises — so even a
    //     coverage ratchet would not see them. `"maxSize": 60` yields "Checked 1 file",
    //     zero errors, exit 0.
    //   • and the origin incident itself walks straight back in: re-adding
    //     `"!docs/src/components/ui"` under the one word `vendor` passes every check a
    //     syntax gate can make. The comment is unverifiable prose.
    //
    // A gate that misses the failure it was born from, while blocking every push in the
    // repo when it false-positives (it did, on its first legitimate edit), is worse than
    // an honest convention — it sells assurance it does not have. The replacement gates
    // EFFECT rather than syntax: see the issue linked from
    // engineering/decisions/2026-07-28-lint-exclusions-and-off-studio-back.md.
    //
    // So: keep writing the reasons. They are cheap and they are the useful half. Just
    // know that nothing enforces them yet, and do not add a claim here that says
    // otherwise.
    "includes": [
      "**/*.js",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.json",
      "**/*.ts",
      "**/*.tsx",

      // dependency — third-party packages, never our source.
      "!node_modules",
      // build-output — regenerated by `npm run build`; HARD RULE #2 forbids hand-edits.
      "!dist",
      // build-output — Astro's per-package type/content cache.
      "!**/.astro",
      // build-output — the docs site's Astro cache, named explicitly.
      "!docs/.astro",
      // transient — throwaway experiments; also .gitignore:2, so belt-and-braces.
      "!.scratch",

      // generated by `tools/build-playground.js` — the browser playground bundle.
      "!docs/public/playground/lattice-playground.js",
      // generated by `tools/build-katex-provider.js` — the KaTeX provider bundle.
      "!docs/public/playground/lattice-katex.js",
      // generated by `tools/build-theme-core.js` — theme token core.
      "!docs/src/playground/theme-core.generated.js",
      // generated by `tools/build-layout-core.js` — layout core.
      "!docs/src/playground/layout-core.generated.js",
      // generated by `tools/build-authoring-core.js` — authoring/lint core.
      "!docs/src/playground/authoring-core.generated.js",
      // generated by `tools/build-exemplar-core.js` — exemplar deck core.
      "!docs/src/playground/exemplar-core.generated.js",
      // generated by `tools/build-standalone-core.js` — standalone SVG core.
      "!docs/src/playground/standalone-svg.generated.js",
      // generated by `tools/build-image-set-core.js` — image-set core.
      "!docs/src/playground/image-set-core.generated.js",
      // generated by `tools/build-a11y-textures.js` — a11y texture core.
      "!docs/src/playground/a11y-textures.generated.js",
      // generated by `tools/build-player-core.js` — player core.
      "!docs/src/playground/player-core.generated.js",
      // generated by `tools/build-player-prune.js` — player prune core.
      "!docs/src/playground/player-prune.generated.js",
      // generated by `tools/build-read-along-core.js` — read-along core.
      "!docs/src/playground/read-along-core.generated.js",
      // generated by `tools/build-anima-player.js` — the export-time player bundle.
      "!lib/export/anima-player-bundle.generated.mjs",
      // generated by `tools/build-cadenza-lib.js` — compiled library output.
      "!docs/src/lib/cadenza/dist",
      // generated by `tools/build-vetrina-lib.js` — compiled library output.
      "!docs/src/lib/vetrina/dist",
      // generated by `tools/build-lente-lib.js` — compiled library output.
      "!docs/src/lib/lente/dist",
      // generated by `tools/build-suono-lib.js` — compiled library output.
      "!docs/src/lib/suono/dist",

      // vendor — minified third-party, in any location.
      "!**/*.min.js",
      // vendor — the pinned Mermaid build.
      "!mermaid-v11.min.js",

      // not-code — binaries that happen to sit beside source.
      "!**/*.pdf",
      // not-code — a lockfile, machine-written and enormous.
      "!package-lock.json",

      // unparseable: Workflow scripts run inside an async wrapper with injected globals
      // (agent/phase/log/args/budget), so their top-level `return`s are legal for the
      // runtime and a hard parse error for Biome ("Illegal return statement outside of
      // a function"). House source in a NON-STANDARD DIALECT — the third category the
      // vendor-or-generated rule did not have. Still gated: HARD RULE #27's
      // `checkAgentModelPinning` reads these files' `agent()` calls.
      "!.claude/workflows"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noAssignInExpressions": "off"
      },
      "style": {
        "useTemplate": "off",
        "useNodejsImportProtocol": "off"
      },
      "complexity": {
        "noForEach": "off"
      },
      "performance": {
        "noDelete": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.js", "**/*.test.ts", "**/*.spec.ts", "test/**", "docs/e2e/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
