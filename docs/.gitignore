# build output
dist/
# The library dists (node-consumable CJS + .d.ts, built by
# tools/build-{cadenza,vetrina,lente,suono}-lib.js) USED to be re-included here and
# committed. They are not any more — like dist/ at the root, they are built, not
# committed: two PRs that both regenerated them conflicted in the merge queue with
# certainty. `npm run build` produces them; CI and the SessionStart hook build before
# anything reads them. The `dist/` rule above now covers them, which is why the eight
# `!src/lib/*/dist/**` negations that stood here are gone — leaving them would have
# silently kept 47 files tracked and undone the change at the root.
# See 2026-08-17-generated-bundles-uncommitted.md, and
# 2026-07-08-library-shape-cadenza-vetrina.md for why they exist at all.
# generated types
.astro/
# portal copies staged from ../docs by scripts/sync-portal.mjs
public/components.html
public/components.md
public/gallery.pdf
# engine + palette stylesheets + runtime, staged for the playground at build
# time into a content-hashed dir (scripts/sync-playground-assets.mjs)
public/playground/v/
# scratch dir used by scripts/rasterize-showcase.mjs (cleaned up on success)
.showcase-tmp/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store
.lighthouseci
# perf-collect / perf-regression working dirs (scripts/perf-collect.mjs)
.perf/
# preview-e2e screenshots + report (scripts/check-preview-render.mjs)
.preview-e2e-out/
# Playwright E2E (playwright.config.ts): HTML report, trace/video/screenshot
# artifacts, and blob reports. Committed snapshot baselines (if any) live under
# e2e/**-snapshots and are NOT ignored.
playwright-report/
test-results/
blob-report/
