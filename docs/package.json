{
  "name": "lattice-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "sync:portal": "node scripts/sync-portal.mjs",
    "sync:playground": "node scripts/sync-playground-assets.mjs",
    "showcase": "node scripts/rasterize-showcase.mjs",
    "showcase:check": "node scripts/rasterize-showcase.mjs --check",
    "dev": "npm run sync:portal && npm run sync:playground && astro dev",
    "start": "npm run sync:portal && npm run sync:playground && astro dev",
    "build": "npm run showcase:check && npm run sync:portal && npm run sync:playground && astro build && node scripts/inject-modulepreload.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro sync && tsc --noEmit",
    "check:vetrina": "tsc -p tsconfig.vetrina.json",
    "check:lente": "tsc -p tsconfig.lente.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf": "node scripts/perf-collect.mjs --out .perf/local && node scripts/perf-regression.mjs --report .perf/local",
    "perf:collect": "node scripts/perf-collect.mjs",
    "perf:compare": "node scripts/perf-regression.mjs",
    "perf:frame": "node scripts/frame-bench.mjs",
    "settle:check": "node scripts/runtime-settle-check.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:preview": "node scripts/check-preview-render.mjs",
    "check:modulepreload-coverage": "node scripts/check-modulepreload-coverage.mjs",
    "build:e2e": "npm run sync:portal && npm run sync:playground && astro build",
    "preview:e2e": "astro preview --port 4321",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=desktop --grep @smoke",
    "test:e2e:bless": "playwright test --update-snapshots --grep @visual",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/starlight": "^0.39.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@floating-ui/dom": "^1.7.6",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.11",
    "driver.js": "^1.4.0",
    "fuse.js": "^7.4.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.18.0",
    "markdown-it": "^14.3.0",
    "pptxgenjs": "^3.12.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.5",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.1",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.2",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "vivus": "^0.4.6",
    "web-vitals": "^4.2.4",
    "zdog": "^1.1.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.2.0",
    "css-tree": "^3.2.1",
    "esbuild": "^0.27.7",
    "fast-check": "^4.8.0",
    "jsdom": "^25.0.1",
    "patch-package": "^8.0.1",
    "puppeteer-core": "^25.1.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  }
}
