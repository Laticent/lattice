# Cloudflare Pages, which serves the PR previews, reads this file; GitHub Pages (lattice.style)
# ignores it and sends max-age=600. The playground asset folder is named by a hash of its contents
# (docs/scripts/sync-playground-assets.mjs), so a file under it never changes: cache it for good.
# Without this the previews send max-age=0, and every mark, theme and script revalidates per request.
/playground/v/*
  Cache-Control: public, max-age=31536000, immutable
