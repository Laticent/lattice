---
// A catalog entry's mark.
//   • A PLUGIN's mark is its manifest's `icon` (lib/plugins/<name>/<name>.manifest.json), drawn
//     inline by lib/plugins/plugin-icon.mjs. Its inks take the site's palette tokens
//     (catalog.css `.plugin-icon`), so it holds contrast on every palette, light or dark,
//     whatever the device's own color scheme says.
//   • A LIBRARY's mark is the multi-color drawing made for its demo page (`mark:` in its catalog
//     entry), shown as an image.
// A plugin entry whose manifest is missing, or has no well-formed icon, FAILS THE BUILD by name:
// every plugin on the site is in-tree, so a blank tile would only hide a mistake. A library with
// no `mark:` renders nothing, and the caller shows its initial instead.
//
// Props:  entry — a catalog entry;  size — px
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { joinBase } from '../../lib/base-url.mjs';
import { slugOf } from '../../lib/catalog.mjs';
import { pluginIconSvg } from '../../../../lib/plugins/plugin-icon.mjs';

const { entry, size = 26 } = Astro.props;
const url = (p) => joinBase(import.meta.env.BASE_URL, p);
const d = entry.data;
let svg = '';
if (d.kind === 'plugin') {
	const slug = slugOf(entry);
	const file = join(process.cwd(), '..', 'lib', 'plugins', slug, `${slug}.manifest.json`);
	if (!existsSync(file)) throw new Error(`catalog/plugins/${slug}: no manifest at ${file}`);
	svg = pluginIconSvg(JSON.parse(readFileSync(file, 'utf8')).icon, { size });
	if (!svg) throw new Error(`catalog/plugins/${slug}: its manifest has no well-formed \`icon\` (spec/LPM.md §3.1)`);
}
---

{svg ? <Fragment set:html={svg} /> : d.mark ? <img src={url(d.mark.replace(/^\//, ''))} alt="" width={size} height={size} loading="lazy" /> : null}
