---
// A catalog entry's mark. The plugin marks (public/plugin-*-mark.svg) are drawn INLINE, so
// their two inks come from the site's palette tokens (catalog.css .cat-mark-svg): an <img>
// can't see the page's theme, and its own prefers-color-scheme follows the DEVICE — so on a
// light-mode phone with the site set to dark it drew dark lines on a dark tile. The library
// marks are multi-color drawings made for their own demo pages, and stay images.
//
// Props:  mark — the entry's `mark` path;  size — px
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { joinBase } from '../../lib/base-url.mjs';

const { mark, size = 26 } = Astro.props;
const url = (p) => joinBase(import.meta.env.BASE_URL, p);
const file = mark.replace(/^\//, '');
const inline = /^plugin-[a-z-]+-mark\.svg$/.test(file);
// The file's own <style> is for anyone opening it on its own; inline, the page colors it.
const svg = inline
	? readFileSync(join(process.cwd(), 'public', file), 'utf8')
			.replace(/<style>[\s\S]*?<\/style>/, '')
			.replace('<svg ', `<svg class="cat-mark-svg" width="${size}" height="${size}" aria-hidden="true" focusable="false" `)
	: null;
---

{inline ? <Fragment set:html={svg} /> : <img src={url(file)} alt="" width={size} height={size} loading="lazy" />}
