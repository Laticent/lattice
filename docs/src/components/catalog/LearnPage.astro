---
// The Learn page for one catalog entry — a library or a plugin. Hero (the promise, two
// sentences, the facts), then the body in a fixed teaching order with a sticky
// "On this page" rail, then "Go deeper" (the repo docs, for anyone who wants the weeds)
// and a pager through the rest of the kind. Rendered by pages/libraries/[slug]/learn.astro
// and pages/plugins/[slug]/learn.astro.
//
// Props:  entry — the catalog entry;  siblings — every entry of the same kind, in order
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import CatalogTabs from './CatalogTabs.astro';
import { joinBase } from '../../lib/base-url.mjs';
import { KIND, hrefsFor, inlineCode, plainText, renderCatalogMarkdown } from '../../lib/catalog.mjs';

const { entry, siblings } = Astro.props;
const d = entry.data;
const url = (p) => joinBase(import.meta.env.BASE_URL, p);
const hrefs = hrefsFor(entry, url);
const k = KIND[d.kind];
const { html, headings } = await renderCatalogMarkdown(entry.body ?? '');
const toc = headings.filter((h) => h.depth === 2);

const i = siblings.findIndex((s) => s.id === entry.id);
const prev = i > 0 ? siblings[i - 1] : null;
const next = i < siblings.length - 1 ? siblings[i + 1] : null;
const isExternal = (href) => /^https?:/.test(href);
---

<CatalogLayout title={`${d.name} — learn the ${k.label.toLowerCase()} · Lattice`} description={`${d.promise} ${plainText(d.intro)}`}>
	<CatalogTabs slot="subbar" kind={d.kind} name={d.name} hrefs={hrefs} current="learn" />

	<header class="cat-learn-hero">
		<div class="wrap"><div class="cat-learn-hero-inner">
			<p class="cat-eyebrow">
				<span>{k.label} · Learn</span>
				{d.facts.find((f) => f.k === 'Package') && <code>{d.facts.find((f) => f.k === 'Package').v}</code>}
			</p>
			<div class="cat-learn-title">
				{d.mark && <img src={url(d.mark.replace(/^\//, ''))} alt="" width="52" height="52" />}
				<h1 class="cat-h1">{d.name}</h1>
			</div>
			<p class="cat-promise">{d.promise}</p>
			<p class="cat-lede" set:html={inlineCode(d.intro)} />
			<div class="cat-actions">
				<a class="cat-btn primary" href={hrefs.demo}><span class="ico ico-play" aria-hidden="true"></span> Try the live demo</a>
				<a class="cat-btn" href="#how-to-use-it">Jump to the code <span class="ico ico-chevron-down" aria-hidden="true"></span></a>
			</div>
			<dl class="cat-facts">
				{d.facts.map((f) => (
					<div>
						<dt>{f.k}</dt>
						<dd>{f.v}</dd>
					</div>
				))}
			</dl>
		</div></div>
	</header>

	<div class="wrap cat-learn">
		<aside class="cat-toc" aria-label="On this page">
			<p>On this page</p>
			<ol>
				{toc.map((h) => (
					<li><a href={`#${h.slug}`}>{h.text}</a></li>
				))}
				<li><a href="#go-deeper">Go deeper</a></li>
			</ol>
		</aside>
		<article class="cat-prose" set:html={html} />
	</div>

	<section class="cat-section" id="go-deeper" aria-labelledby="go-deeper-title">
		<div class="wrap">
			<div class="cat-section-head">
				<h2 class="cat-h2" id="go-deeper-title">Go deeper</h2>
				<p>The full detail lives in the repository: the reference, the design notes, and the reasons behind each choice.</p>
			</div>
			<ul class="cat-deeper">
				{d.reference.map((r) => (
					<li>
						<a href={isExternal(r.href) ? r.href : url(r.href.replace(/^\//, ''))}>
							<strong>
								{r.label}
								{isExternal(r.href) && <span class="ico ico-arrow-right" aria-hidden="true"></span>}
							</strong>
							{r.note && <span>{r.note}</span>}
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="cat-section">
		<div class="wrap cat-pager">
			{prev && (
				<a class="prev" href={hrefsFor(prev, url).learn}>
					<small>← Previous {k.label.toLowerCase()}</small>
					<strong>{prev.data.name}</strong>
				</a>
			)}
			{next ? (
				<a class="next" href={hrefsFor(next, url).learn}>
					<small>Next {k.label.toLowerCase()} →</small>
					<strong>{next.data.name}</strong>
				</a>
			) : (
				<a class="next" href={hrefs.hub}>
					<small>Back to</small>
					<strong>All {k.plural}</strong>
				</a>
			)}
		</div>
	</section>

	<script>
		// Light the rail entry for the chapter in view. Progressive: without it the rail is
		// still a plain list of links.
		const links = [...document.querySelectorAll<HTMLAnchorElement>('.cat-toc a')];
		const targets = links
			.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
			.filter((el): el is HTMLElement => !!el);
		if ('IntersectionObserver' in window && targets.length) {
			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (!e.isIntersecting) continue;
						for (const a of links) a.setAttribute('aria-current', String(a.hash === `#${e.target.id}`));
					}
				},
				{ rootMargin: '-20% 0px -70% 0px' },
			);
			for (const t of targets) io.observe(t);
		}
	</script>
</CatalogLayout>
