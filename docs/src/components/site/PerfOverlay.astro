---
// Live performance overlay — mounts the React island (PerfOverlay.tsx) that
// renders a draggable, tappable readout: WEB VITALS + RUNTIME + the Lattice
// RENDER pipeline, each row a shadcn Popover (tablet/desktop) or Sheet (phone)
// you open for a plain-language explanation and its budget.
//
// client:only — the overlay is browser-only (reads localStorage/window, runs
// rAF/observer loops) and never needs SSR/SEO. It renders NOTHING until the
// shared pref is on (perf-overlay-prefs.js: the Studio/Drawing-Board switches +
// the `?perf` param), so a normal page view pays nothing. Included once per page
// via ResourceHints (standalone routes), Header (docs zone), and features.astro;
// a module-level singleton claim in the island makes a double-include a no-op.
import PerfOverlay from './PerfOverlay.tsx';
---

<PerfOverlay client:only="react" />
