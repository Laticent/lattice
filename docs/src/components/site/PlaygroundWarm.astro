---
// Warm a first Playground visit from the page that leads to it — see `warmPlayground` in
// src/lib/prefetch-engine.ts for what and when. Two halves:
//
// 1. THE ASSETS the Playground asks for before its first slide: the newcomer bake for the
//    reader's mode, and the theme sheets. Connection-aware, like <EngineWarm>.
// 2. THE PAGE, through speculation rules (Chromium; other browsers ignore the block): the
//    Playground document is prefetched once a reader hovers a link to it for a moment
//    (`moderate`). The browser itself stands the rules down under Save-Data, battery saver and
//    memory pressure. NOT prerendered: a prerender runs the whole app — the engine included —
//    for every hover that does not become a click, and Chromium refuses to prerender under
//    DevTools, so it could not be verified from an automated browser.
import { assetBase } from '../../playground/asset-version.mjs';
import { joinBase } from '../../lib/base-url.mjs';

const base = import.meta.env.BASE_URL;
const pg = assetBase();
const cfg = {
	urls: {
		bakeBase: joinBase(base, pg + 'newcomer/'),
		themes: [joinBase(base, pg + 'themes/lattice.css'), joinBase(base, pg + 'themes/cuoio.css')],
	},
	bakePalette: 'cuoio',
};
const playground = joinBase(base, 'playground/');
const rules = {
	prefetch: [{ where: { href_matches: playground + '*' }, eagerness: 'moderate' }],
};
---

<script type="application/json" data-playground-warm set:html={JSON.stringify(cfg).replace(/</g, '\\u003c')}></script>
<script type="speculationrules" set:html={JSON.stringify(rules).replace(/</g, '\\u003c')}></script>
<script>
	import { warmPlayground } from '../../lib/prefetch-engine.ts';
	const el = document.querySelector('script[data-playground-warm]');
	if (el?.textContent) {
		const { urls, bakePalette } = JSON.parse(el.textContent);
		const root = document.documentElement;
		const mode = root.getAttribute('data-mode') === 'dark' ? 'dark' : 'light';
		warmPlayground({ bake: `${urls.bakeBase}${mode}/`, themes: urls.themes }, { allowEager: true, palette: root.getAttribute('data-palette') || 'cuoio', bakePalette });
	}
</script>
