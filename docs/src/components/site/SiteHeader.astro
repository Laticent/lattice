---
// THE one site header — the single source of truth for the top bar on every
// surface. Both the standalone routes (landing, playground, drawing board,
// workbench, features, comparison, the component reference) and the Starlight
// docs zone render this exact component, so the chrome can no longer drift
// (it used to be copy-pasted into 8 places across two class systems).
//
// Shape:  [brand] [Studio ᴾᴿᴱⱽ · Playground · Docs · Components · Features · Comparison · Libraries ▾]
//                            …flex spacer…
//         [Search ⌘K] [theme select] [light/dark] [GitHub] [☰ on mobile]
//
// The apps lead the bar (Studio first — it is the front door), then the
// content links, then the Libraries disclosure. The "Tools" disclosure that
// used to hide the apps behind a hover is gone: the Studio and the Playground
// are one click from every page (nav.mjs).
//
// The inline links + the Libraries disclosure are static HTML (SSR, no-JS,
// crawlable). Everything interactive — the ⌘K command palette, the theme
// controls, the mobile menu — is the single <NavActions> island. The Libraries
// disclosure is a native <details> (no island) with a tiny shared script to
// close it on outside-click / Escape.
//
// Props:
//   palettes    string[]  — selectable palette names (titleCased for display)
//   wide        boolean   — full-bleed inner (apps/reference) vs centred (landing)
//   standalone  boolean   — render the sticky <header> wrapper (standalone routes);
//                           false inside Starlight, whose .header already wraps us
//   mobileMenu  boolean   — render our hamburger+Sheet (standalone). False in the
//                           docs zone, where Starlight owns the mobile menu (it
//                           also carries the page TOC).
import NavActions from './NavActions.tsx';
// The React-free label derivation (#1592). `palette-label.ts` imports only the generated
// theme catalog, so pulling it in here costs this page's module graph nothing — the point of
// splitting it out of `PaletteSelectItems.tsx`, which drags radix + React behind it.
import { paletteLabel } from '../../lib/palette-label';
import { joinBase } from '../../lib/base-url.mjs';
import { appsNav, contentNav, librariesNav, primaryNav, GITHUB_URL, isCurrent, librariesActive } from '../../lib/nav.mjs';

const { palettes = [], wide = false, standalone = true, mobileMenu = true } = Astro.props;

const base = import.meta.env.BASE_URL;
const url = (p) => joinBase(base, p);
const here = Astro.url.pathname;

const annotate = (items) => items.map((l) => ({ ...l, current: isCurrent(l, here) }));
const apps = annotate(appsNav(url));
const content = annotate(contentNav(url));
const libraries = annotate(librariesNav(url));
const links = annotate(primaryNav(url)); // flat, for the command palette + sheet
const libsOn = librariesActive(here, url);
const pagefindUrl = url('pagefind/pagefind.js');
const homeHref = url('');

const Wrapper = standalone ? 'header' : 'div';

// palette → the label the theme <select> shows, resolved at BUILD time so the pre-paint
// seed below is a lookup rather than a second copy of the derivation (#1592).
// `[\w-]` is belt and braces before these names reach a CSS selector below; they come from
// our own generated token file, matched by a regex that already excludes quotes. ONE filtered
// list feeds both the label map and the rules, so the seed can never call a palette shipped
// that has no rule to reveal it.
const seedablePalettes = palettes.filter((p) => /^[\w-]+$/.test(p));
const paletteLabels = Object.fromEntries(seedablePalettes.map((p) => [p, paletteLabel(p)]));
// What PaletteControls falls back to when the attribute names nothing this build ships —
// declared here so the seed resolves the SAME palette the control's first render will.
const fallbackPalette = seedablePalettes[0] ?? null;
// ONE RULE PER PALETTE, so the theme control's label is painted from `<html data-palette>`
// rather than written into the DOM by a script that has to beat the first frame (#1592).
// PaletteControls renders every label and these show one — the same shape as the mode
// toggle's three icons, and for the same reason: the server cannot know the answer, but the
// attribute carrying it is set before anything paints. Handed to the seed below and appended
// to <head> there; see the note at that line for why it cannot be a <style> in this template.
const paletteLabelCss = seedablePalettes
	.map((p) => `:root[data-palette="${p}"] [data-palette-label="${p}"]{display:inline}`)
	.join('\n');
---

<!-- PRE-PAINT CHROME SEED (#1592). The header's two controls are the last things on the
     site that still tell the visitor something they will take back a second later: the theme
     <select> rendered EMPTY and filled in with "Burgundy" whenever the island hydrated, and
     the mode toggle rendered the Monitor ("System") icon at a visitor who had pinned dark —
     a control naming the WRONG stop, which is worse than one naming none. Measured at
     1440x900 with the CPU throttled 6x: empty/Monitor from t≈145ms, correct at t≈1.9s on the
     component reference, t≈3.8s on the landing, t≈5.1s on the Playground.
     Both answers are already in localStorage before paint. This publishes them on <html>,
     and the controls are PAINTED FROM THOSE ATTRIBUTES by the rules at the foot of this file
     — so nothing has to write into the markup, and the first frame is already right.
     It runs ABOVE the header markup, which is what makes that true: an earlier draft patched
     the trigger's text right after the markup instead, and a per-frame sampler caught the
     un-seeded state ~1 run in 3 ("Indaco"/System at t=114ms, correct at t=177ms). A script
     that has to beat the first paint of markup it sits below is a race; setting an attribute
     the markup has not been parsed against yet is not.
     Deliberately here rather than in a per-route head script: this header is the thing that
     has the defect, and it is on every page. It is idempotent with the head seeds that
     already stamp `data-palette` (playground.astro, ComponentsLayout, ThemeProvider) — they
     agree by construction, both reading `lattice-docs-palette` — and it is the only one on
     the landing, which has none. -->
<script is:inline define:vars={{ paletteLabels, fallbackPalette, paletteLabelCss }}>
	(function () {
		try {
			var r = document.documentElement;
			// A palette this build still ships. Anything else names a theme whose CSS 404s, and
			// the head seeds drop such a value for the same reason.
			var shipped = function (n) { return !!n && Object.prototype.hasOwnProperty.call(paletteLabels, n); };
			var p = null;
			try { p = localStorage.getItem('lattice-docs-palette'); } catch (e) {}
			// DROP a stored palette this build no longer ships, rather than merely declining to
			// spend it. Normalizing the attribute alone was not enough: `syncFromStorage` re-reads
			// the KEY at mount with no validation of its own and stamps it straight back, so the
			// page painted the fallback and then flipped to a theme whose CSS 404s — a palette
			// flash this seed introduced. `playground.astro`'s head seed has always cleared it for
			// exactly this reason ("blank in my browser, fine in private browsing"); the site-wide
			// surfaces had nothing that did, so they never recovered.
			if (p && !shipped(p)) {
				try { localStorage.removeItem('lattice-docs-palette'); } catch (e) {}
				p = null;
			}
			if (!shipped(p)) p = r.getAttribute('data-palette');
			if (!shipped(p)) p = fallbackPalette;
			// Publish it even when it did not change: the label rules below resolve from this
			// attribute, so leaving an unshippable one in place would show no label at all.
			if (shipped(p)) r.setAttribute('data-palette', p);
			// THE LABEL RULES, injected here rather than shipped as a <style> in the template.
			// A dynamic style tag in an .astro component is not bundled into the head — Astro
			// emits it at the END of the body, i.e. after the header it is supposed to style,
			// which reopens the very window this seed exists to close (measured: no label at
			// all from t≈165ms to t≈365ms, ~1 run in 3). Appending it to <head> from a script
			// that runs before the header is parsed does not have that problem. It is the whole
			// table, not just the palette in force, so a later pick is styled too.
			var st = document.createElement('style');
			st.textContent = paletteLabelCss;
			(document.head || r).appendChild(st);
			// The mode PREFERENCE, which `data-mode` cannot express: System-resolved-dark and
			// pinned-dark are the same resolved mode and a different stop.
			var m = null;
			try { m = localStorage.getItem('lattice-docs-mode'); } catch (e) {}
			r.setAttribute('data-mode-pref', m === 'light' || m === 'dark' ? m : 'system');
		} catch (e) {}
	})();
</script>

<Wrapper class:list={['site-header', { 'is-standalone': standalone }]}>
	<div class:list={['site-header-inner', { wide }]}>
		<a class="sh-brand" href={homeHref} aria-label="Lattice — home">
			<img class="sh-brand-logo" src={url('lattice-mark-min.svg')} alt="" width="30" height="30" />
			<span class="sh-brand-mark">Lattice</span>
		</a>

		<nav class="sh-nav" aria-label="Primary">
			{apps.map((l) => (
				<a class="sh-link sh-link-app" href={l.href} aria-current={l.current ? 'page' : undefined}>
					{l.label}
					{l.badge && <span class="sh-link-badge">{l.badge}</span>}
				</a>
			))}
			<span class="sh-divider" aria-hidden="true"></span>
			{content.map((l) => (
				<a class="sh-link" href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>
			))}
			<details class="sh-tools sh-libraries">
				<summary class="sh-link sh-tools-summary" data-active={libsOn ? '' : undefined} aria-current={libsOn ? 'true' : undefined}>
					Libraries
					<svg class="sh-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</summary>
				<div class="sh-tools-menu" role="menu">
					{libraries.map((l) => (
						<a class="sh-tools-item" href={l.href} role="menuitem" aria-current={l.current ? 'page' : undefined}>
							<span class="sh-tools-item-head">
								<span class="sh-tools-item-label">{l.label}</span>
							</span>
							{l.desc && <span class="sh-tools-item-desc">{l.desc}</span>}
						</a>
					))}
				</div>
			</details>
		</nav>

		<div class="sh-spacer"></div>

		<div class="sh-actions lx-ui">
			<NavActions
				client:idle
				palettes={palettes}
				links={links}
				apps={apps}
				content={content}
				libraries={libraries}
				githubUrl={GITHUB_URL}
				pagefindUrl={pagefindUrl}
				homeHref={homeHref}
				mobileMenu={mobileMenu}
			/>
		</div>
	</div>
</Wrapper>

<script>
	// Close the Libraries disclosure on outside-click / Escape (native <details>
	// doesn't). One listener for every <details.sh-tools> on the page; runs once
	// per page because Astro hoists + dedupes this module script.
	const closeTools = (except?: EventTarget | null) => {
		for (const d of document.querySelectorAll<HTMLDetailsElement>('details.sh-tools[open]')) {
			if (except && d.contains(except as Node)) continue;
			d.open = false;
		}
	};
	document.addEventListener('click', (e) => closeTools(e.target));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeTools();
	});
</script>

<style is:global>
	/* THE MODE TOGGLE'S ICON, chosen by the seeded preference rather than by React (#1592).
	   PaletteControls renders all three (Monitor · Sun · Moon) and these rules show one.
	   It has to work this way round: the server cannot know which stop the visitor is on, so
	   React choosing would put Monitor in the HTML and Moon in the client's first render for
	   anyone who pinned dark — a hydration mismatch React 19 does not patch. Rendering the
	   same three on both sides moves the choice to an attribute the pre-paint seed above has
	   already written, so the button names the right stop from the first frame.
	   `is:global` because the icons live inside the React island, which Astro's scoping
	   attribute never reaches. */
	[data-slot='mode-icon'] {
		display: none;
	}
	:root[data-mode-pref='system'] [data-slot='mode-icon'][data-pref='system'],
	:root[data-mode-pref='light'] [data-slot='mode-icon'][data-pref='light'],
	:root[data-mode-pref='dark'] [data-slot='mode-icon'][data-pref='dark'] {
		display: block;
	}
	/* No seed (scripting off, or a surface that never runs the header's): show the System
	   stop rather than an empty button. It is also the default preference, so it is the
	   honest answer for anyone whose choice we cannot read. */
	:root:not([data-mode-pref]) [data-slot='mode-icon'][data-pref='system'] {
		display: block;
	}

	/* THE THEME CONTROL'S LABEL, painted from `<html data-palette>` for the same reason and by
	   the same means: PaletteControls renders every palette's label and one rule per palette
	   shows the one in force. Only the base rule can live here — the per-palette ones are
	   injected into <head> by the seed above, because a dynamic <style> in this template is
	   emitted after the header it styles. */
	[data-palette-label] {
		display: none;
	}
</style>

<style>
	/* The component owns its styles, so Astro bundles them into BOTH worlds —
	   the standalone routes (which import landing.css) and the Starlight docs
	   zone (customCss: lattice.css). All colour goes through palette tokens. */
	.site-header.is-standalone {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 86%, transparent);
		backdrop-filter: saturate(180%) blur(12px);
		border-bottom: 1px solid var(--border);
	}
	.site-header-inner {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		height: 3.75rem;
		width: 100%;
		max-width: var(--maxw, 1180px);
		margin: 0 auto;
		padding: 0 24px;
	}
	.site-header-inner.wide {
		max-width: none;
	}

	.sh-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		flex: 0 0 auto;
		text-decoration: none;
	}
	.sh-brand-logo {
		display: block;
		height: 30px;
		width: auto;
	}
	.sh-brand-mark {
		font-family: var(--font-display, 'Playfair Display', Georgia, serif);
		font-weight: 700;
		font-size: 1.375rem;
		line-height: 1;
		letter-spacing: -0.01em;
		color: var(--text-heading);
	}

	.sh-nav {
		display: none;
		align-items: center;
		gap: 0.18rem;
		/* No margin-left: `.site-header-inner`'s own 0.75rem gap already separates
		   the nav from the brand, and the row's width is measured to the pixel
		   below — an outside-the-box margin is exactly what that math can't see. */
	}
	/* The bar's width budget, in three steps. Below lg the nav is hidden and the
	 * Sheet / ⌘K palette carry everything. From lg (1024px) the nav appears with
	 * the two app links + the four content links; the search control is an ICON
	 * there, which is what buys the room. From xl (1280px) the Libraries
	 * disclosure joins and the search grows back to a pill.
	 *
	 * These steps are measured, not guessed — the row's right edge, against the
	 * viewport it has to fit inside:
	 *
	 *   1024px (lg)   → 1015px   nav + icon search
	 *   1280px (xl)   → 1149px   + the search pill returns
	 *   1408px        → 1239px   + Libraries
	 *   1536px (2xl)  → 1319px   + the pill widens to w-64
	 *
	 * The previous layout (four content links + the Tools and Libraries
	 * disclosures + a 176px search pill from lg) overflowed the viewport by 88px
	 * at exactly 1024, cutting off the GitHub icon — every step above is now
	 * positive. If you add an item here, re-measure before you ship: every link
	 * is `white-space: nowrap`, so this row cannot reflow — it can only
	 * overflow. */
	@media (min-width: 64rem) {
		.sh-nav {
			display: flex;
		}
	}
	/* Libraries — the four sibling projects — is the lowest-priority family in
	 * the bar, so it is the one that waits for room, and it waits until after
	 * the search pill has taken its share back. Below 88rem it is reached
	 * through the ⌘K palette (the site's one findability surface, on every
	 * page), the mobile Sheet, and the Starlight sidebar in the docs zone. */
	.sh-libraries {
		display: none;
	}
	@media (min-width: 88rem) {
		.sh-libraries {
			display: block;
		}
	}

	.sh-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.4rem 0.45rem;
		border-radius: var(--radius-sm, 8px);
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1;
		color: var(--text-body);
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition: color 0.12s ease, background-color 0.12s ease;
	}
	.sh-link:hover {
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 8%, transparent);
	}
	.sh-link[aria-current='page'],
	.sh-tools-summary[data-active] {
		color: var(--accent);
		font-weight: 600;
	}

	/* The app links (Studio, Playground) lead the bar. They carry the heading
	   colour + a touch more weight than the content links so the eye lands on
	   the front door first — a rank cue, not a second button. */
	.sh-link-app {
		font-weight: 600;
		color: var(--text-heading);
	}
	.sh-link-app[aria-current='page'] {
		color: var(--accent);
	}
	/* The inline "Preview" pill — same chip as the disclosure/mobile/palette
	   badges, palette-token only so it tracks the theme in light and dark. */
	.sh-link-badge {
		font-size: 0.6rem;
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 0.2rem 0.35rem;
		border-radius: 999px;
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 14%, transparent);
	}
	/* Hairline between the apps and the content links — the one visual cue that
	   these are two families now that neither sits behind a disclosure. Drawn as
	   a 1px content box inside transparent padding (background-clip) rather than
	   with a margin — HARD RULE #20's habit, kept even here where the engine
	   gate doesn't reach. */
	.sh-divider {
		box-sizing: content-box;
		width: 1px;
		height: 1.1rem;
		flex: 0 0 auto;
		padding-inline: 0.3rem;
		background: var(--border);
		background-clip: content-box;
	}

	/* Libraries disclosure */
	.sh-tools {
		position: relative;
	}
	.sh-tools-summary {
		list-style: none;
	}
	.sh-tools-summary::-webkit-details-marker {
		display: none;
	}
	.sh-chevron {
		transition: transform 0.15s ease;
	}
	.sh-tools[open] .sh-chevron {
		transform: rotate(180deg);
	}
	.sh-tools-menu {
		position: absolute;
		top: calc(100% + 0.4rem);
		left: 0;
		min-width: 15rem;
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		padding: 0.4rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-md, 14px);
		background: var(--bg);
		box-shadow: var(--shadow-lg, 0 24px 60px rgba(10, 22, 40, 0.14));
		z-index: 60;
	}
	.sh-tools-item {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0.5rem 0.6rem;
		border-radius: var(--radius-sm, 8px);
		text-decoration: none;
		color: var(--text-body);
	}
	.sh-tools-item:hover {
		background: color-mix(in srgb, var(--accent) 10%, transparent);
	}
	.sh-tools-item[aria-current='page'] .sh-tools-item-label {
		color: var(--accent);
	}
	.sh-tools-item-head {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.sh-tools-item-label {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-heading);
	}
	/* "Preview" (or any nav pill) — a small accent-tinted chip; palette-token
	   only, so it recolours with the theme in both light and dark. */
	.sh-tools-item-badge {
		font-size: 0.6rem;
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 0.2rem 0.4rem;
		border-radius: 999px;
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 14%, transparent);
	}
	.sh-tools-item-desc {
		font-size: 0.78rem;
		color: var(--text-muted);
	}

	.sh-spacer {
		flex: 1 1 auto;
	}
	.sh-actions {
		display: flex;
		align-items: center;
		flex: 0 0 auto;
	}

	@media print {
		.site-header {
			display: none;
		}
	}
</style>
