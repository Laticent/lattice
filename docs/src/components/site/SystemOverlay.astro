---
// System diagnostic panel — mounts the React island (SystemOverlay.tsx): what Lattice sees of this
// device (browser, graphics, memory, cores, storage, network), the tier it chose, and why.
//
// client:only — it reads browser-only APIs and never needs SSR. It renders NOTHING until the shared
// pref is on (system-overlay-prefs.ts: the Workspace switch and the `?system` parameter), so a normal
// page view pays nothing. Mounted with the Storage overlay (ResourceHints and Header), and a
// module-level singleton claim makes a double include a no-op.
import SystemOverlay from './SystemOverlay.tsx';
---

<SystemOverlay client:only="react" />
