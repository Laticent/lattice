{
  "name": "@laticent/cadenza",
  "version": "0.1.0",
  "description": "Framework-free caption + timeline engine — text in, a timed caption track + a clock→word cursor + WebVTT/SRT out. No dependency except `@laticent/ltt` (the timing-track format it produces), no DOM, no audio.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "types": "./index.ts",
  "module": "./dist/index.mjs",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@laticent/ltt": "0.1.0"
  },
  "files": [
    "dist",
    "*.ts",
    "!*.test.ts",
    "README.md"
  ]
}
