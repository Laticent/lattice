{
  "name": "@laticent/markup",
  "version": "0.1.0",
  "private": true,
  "description": "Balanced-HTML string walking for highlighted code and rendered slides: the tokenizer, the section walker, top-level element and list readers, tag stripping, escaping, and the per-line split of highlighted code. Reads only the string it is given: no DOM, no Node, no dependencies.",
  "license": "AGPL-3.0-only",
  "author": "Sharmarke Aden (Laticent) <sharmarke.aden@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laticent/lattice.git",
    "directory": "docs/src/lib/markup"
  },
  "homepage": "https://github.com/Laticent/lattice/tree/main/docs/src/lib/markup#readme",
  "bugs": {
    "url": "https://github.com/Laticent/lattice/issues"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "@laticent/source": "./index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "*.ts",
    "!*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../../../../tools/library-prepack.js"
  }
}
