{
  "name": "@laticent/segno",
  "version": "0.1.0",
  "description": "A general-purpose grammar engine that only builds grammars it can prove are linear (LL(1) over characters), and a small inline notation built on it: values, [lists] and {records}, one separator, name=value, and schema-bound types with aliases and shortcuts. Framework-free, zero-dependency, no DOM.",
  "license": "AGPL-3.0-only",
  "author": "Sharmarke Aden (Laticent) <sharmarke.aden@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laticent/lattice.git",
    "directory": "docs/src/lib/segno"
  },
  "homepage": "https://github.com/Laticent/lattice/tree/main/docs/src/lib/segno#readme",
  "bugs": {
    "url": "https://github.com/Laticent/lattice/issues"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "@laticent/source": "./index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./values": {
      "@laticent/source": "./values.ts",
      "import": {
        "types": "./dist/values.d.ts",
        "default": "./dist/values.mjs"
      },
      "require": {
        "types": "./dist/values.d.ts",
        "default": "./dist/values.cjs"
      }
    },
    "./read": {
      "@laticent/source": "./read.ts",
      "import": {
        "types": "./dist/read.d.ts",
        "default": "./dist/read.mjs"
      },
      "require": {
        "types": "./dist/read.d.ts",
        "default": "./dist/read.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "*.ts",
    "!*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../../../tools/library-prepack.js"
  }
}
