{
  "name": "@laticent/vetrina",
  "version": "0.1.0",
  "description": "A self-driving UI walkthrough engine — theater over real state, seamlessly interruptible. Framework-free core; an optional React adapter at ./react.",
  "license": "AGPL-3.0-only",
  "author": "Sharmarke Aden (Laticent) <sharmarke.aden@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laticent/lattice.git",
    "directory": "docs/src/lib/vetrina"
  },
  "homepage": "https://github.com/Laticent/lattice/tree/main/docs/src/lib/vetrina#readme",
  "bugs": {
    "url": "https://github.com/Laticent/lattice/issues"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./index.ts",
  "module": "./dist/index.mjs",
  "main": "./dist/index.cjs",
  "dependencies": {
    "@laticent/ltt": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "types": "./react.ts",
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "*.ts",
    "!*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../../../tools/library-prepack.js"
  }
}
