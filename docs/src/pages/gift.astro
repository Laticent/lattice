---
// /gift — where a gift link lands (engineering/decisions/2026-11-06-gift-link-cli.md §1, §6).
//
// A gift link is `<site>/gift#<token>`: a spend-capped OpenRouter key someone made from their own
// account, carried in the part after `#`, which the browser never sends to the server. This page
// reads the token with the codec the admin CLI wrote it with (lib/core/gift-link.mjs), removes it
// from the address bar at once, stores the key through the one writer for that slot
// (`writeOpenRouterKey`, minted: true, so an early refusal while OpenRouter activates a fresh key
// reads as "not active yet"), and hands over to the Studio. The Studio's startup fill then points an
// unset chat at OpenRouter and says so.
//
// Static HTML plus one small script. No React, no engine: this page is the first thing a visitor
// who scanned a card sees, often on a phone on a café connection.
import '../styles/landing.css';
import ResourceHints from '../components/site/ResourceHints.astro';
import ColorSchemeSeed from '../components/site/ColorSchemeSeed.astro';
import { joinBase } from '../lib/base-url.mjs';

const base = import.meta.env.BASE_URL;
const url = (p) => joinBase(base, p);
---

<!doctype html>
<html lang="en" data-palette="cuoio" data-mode="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex" />
		<meta name="referrer" content="no-referrer" />
		<ResourceHints />
		<ColorSchemeSeed />
		<title>A deck on us — Lattice</title>
		<meta name="description" content="Open a Lattice gift link: a model key someone shared with you, ready in the Studio." />
		<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
		<script is:inline>
			(function () {
				var r = document.documentElement;
				try {
					var p = localStorage.getItem('lattice-docs-palette');
					if (p) r.setAttribute('data-palette', p);
					var m = localStorage.getItem('lattice-docs-mode');
					if (m === 'light' || m === 'dark') r.setAttribute('data-mode', m);
					else if (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) r.setAttribute('data-mode', 'dark');
				} catch (e) {}
			})();
		</script>
	</head>
	<body>
		<main class="gift" data-studio={url('studio/')}>
			<p class="gift-brand"><a href={url('')}>Lattice</a></p>

			<section class="gift-card" data-gift-state="reading" aria-live="polite">
				<h1 class="gift-title">A deck on us</h1>

				<div data-show="reading">
					<p class="gift-lede">Opening your gift link…</p>
				</div>

				<form data-show="pin" class="gift-form" novalidate>
					<p class="gift-lede">This gift is locked with a PIN. It is printed on the card, apart from the code.</p>
					<label for="gift-pin" class="gift-label">PIN</label>
					<div class="gift-row">
						<input id="gift-pin" name="pin" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 -]*" maxlength="16" class="gift-input" />
						<button type="submit" class="gift-btn">Unlock</button>
					</div>
					<p class="gift-error" role="alert" data-pin-error hidden></p>
				</form>

				<div data-show="replace">
					<p class="gift-lede">This browser already has an OpenRouter key. Use the gift instead? Your own key is removed from this browser, not from your OpenRouter account.</p>
					<div class="gift-actions">
						<button type="button" class="gift-btn" data-act="replace">Use the gift</button>
						<a class="gift-btn gift-btn-quiet" data-act="keep" href={url('studio/')}>Keep my key</a>
					</div>
				</div>

				<div data-show="ready">
					<p class="gift-lede">Someone shared a model key with you. Lattice turns plain writing into a finished slide deck, and the Studio’s chat can draft one with you. Nothing to sign up for.</p>
					<p class="gift-note">The key has a small spending cap set by whoever made the card. It is stored in this browser only. When it runs out, you can sign in with your own OpenRouter account and keep every deck you made.</p>
					<div class="gift-actions">
						<a class="gift-btn" data-act="open" href={url('studio/')}>Open the Studio</a>
					</div>
					<div class="gift-phone" data-phone hidden>
						<p class="gift-note">Lattice is at its best on a laptop. Send this gift to yourself and open it there.</p>
						<button type="button" class="gift-btn gift-btn-quiet" data-act="send">Send to my laptop</button>
						<p class="gift-note" data-send-note hidden></p>
					</div>
				</div>

				<div data-show="error">
					<p class="gift-lede" data-error-text></p>
					<div class="gift-actions">
						<a class="gift-btn gift-btn-quiet" href={url('studio/')}>Open the Studio without it</a>
					</div>
				</div>
			</section>
		</main>

		<script>
			import { decodeGift, extractGiftToken, GiftLinkError, inspectGiftToken } from '../../../lib/core/gift-link.mjs';
			import { loadOpenRouterKey, readOpenRouterKey, writeOpenRouterKey, writeOpenRouterVia } from '../lib/openrouter-key.js';

			const card = document.querySelector<HTMLElement>('.gift-card')!;
			const show = (state: string) => card.setAttribute('data-gift-state', state);
			const fail = (message: string) => {
				card.querySelector('[data-error-text]')!.textContent = message;
				show('error');
			};

			// Take the token out of the address bar before anything else: a screenshot, a shared
			// tab or the history list should never carry the key. The link stays in memory only,
			// for "Send to my laptop".
			let link = location.href;
			let token = extractGiftToken(location.hash);
			const clearFragment = () => {
				if (location.hash) history.replaceState(history.state, '', location.pathname + location.search);
			};
			clearFragment();

			let key: string | null = null;

			const store = async () => {
				await writeOpenRouterKey(key, { minted: true });
				writeOpenRouterVia('key');
				show('ready');
				const phone = matchMedia('(pointer: coarse) and (max-width: 820px)').matches;
				card.querySelector<HTMLElement>('[data-phone]')!.hidden = !phone;
			};

			const opened = async (k: string) => {
				key = k;
				await loadOpenRouterKey().catch(() => {});
				const current = readOpenRouterKey();
				if (current && current !== k) show('replace');
				else await store();
			};

			const start = async () => {
				if (!token) return fail('There is no gift in this link. Scan the card again, or copy the whole link, including everything after the “#”.');
				try {
					if (inspectGiftToken(token).locked) {
						show('pin');
						document.getElementById('gift-pin')?.focus();
						return;
					}
					await opened((await decodeGift(token)).key);
				} catch (e) {
					fail(e instanceof GiftLinkError ? e.message : 'This gift link could not be opened.');
				}
			};

			card.querySelector('form[data-show="pin"]')!.addEventListener('submit', async (ev) => {
				ev.preventDefault();
				const input = document.getElementById('gift-pin') as HTMLInputElement;
				const note = card.querySelector<HTMLElement>('[data-pin-error]')!;
				const button = card.querySelector<HTMLButtonElement>('form button')!;
				button.disabled = true;
				note.hidden = true;
				try {
					await opened((await decodeGift(token!, { pin: input.value })).key);
				} catch (e) {
					note.textContent = e instanceof GiftLinkError ? e.message : 'This gift link could not be opened.';
					note.hidden = false;
					input.select();
				} finally {
					button.disabled = false;
				}
			});

			card.querySelector('[data-act="replace"]')!.addEventListener('click', () => void store());

			card.querySelector('[data-act="send"]')!.addEventListener('click', async () => {
				const note = card.querySelector<HTMLElement>('[data-send-note]')!;
				try {
					if (navigator.share) {
						await navigator.share({ title: 'A Lattice gift', text: 'Open this on my laptop.', url: link });
						return;
					}
					await navigator.clipboard.writeText(link);
					note.textContent = 'Link copied. Paste it into a message or an email to yourself.';
				} catch (e) {
					if ((e as Error)?.name === 'AbortError') return;
					note.textContent = 'Could not open the share sheet here. Open this card’s link on your laptop instead.';
				}
				note.hidden = false;
			});

			// A second link opened in this same tab changes only the hash, which does not reload the page.
			addEventListener('hashchange', () => {
				const next = extractGiftToken(location.hash);
				if (!next) return;
				link = location.href;
				token = next;
				clearFragment();
				show('reading');
				void start();
			});

			void start();
		</script>

		<style>
			.gift {
				min-height: 100dvh;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 20px;
				padding: 32px 16px calc(32px + env(safe-area-inset-bottom));
				background: var(--bg);
				color: var(--text-body);
				font-family: var(--font-body);
			}
			.gift-brand {
				margin: 0;
				font-family: var(--font-display);
				font-size: 15px;
				font-weight: 600;
				letter-spacing: 0.02em;
			}
			.gift-brand a {
				color: var(--text-muted);
				text-decoration: none;
			}
			.gift-card {
				width: 100%;
				max-width: 480px;
				display: flex;
				flex-direction: column;
				gap: 16px;
				padding: 32px 28px;
				border: 1px solid var(--border);
				border-radius: 16px;
				background: var(--bg-alt);
			}
			.gift-card > [data-show] {
				display: none;
				flex-direction: column;
				gap: 14px;
			}
			.gift-card[data-gift-state='reading'] > [data-show='reading'],
			.gift-card[data-gift-state='pin'] > [data-show='pin'],
			.gift-card[data-gift-state='replace'] > [data-show='replace'],
			.gift-card[data-gift-state='ready'] > [data-show='ready'],
			.gift-card[data-gift-state='error'] > [data-show='error'] {
				display: flex;
			}
			.gift-title {
				margin: 0;
				font-family: var(--font-display);
				font-size: clamp(28px, 6vw, 36px);
				line-height: 1.1;
				color: var(--text-heading);
			}
			.gift-lede {
				margin: 0;
				font-size: 16px;
				line-height: 1.5;
			}
			.gift-note {
				margin: 0;
				font-size: 14px;
				line-height: 1.5;
				color: var(--text-muted);
			}
			.gift-label {
				font-size: 13px;
				font-weight: 600;
				color: var(--text-heading);
			}
			.gift-row,
			.gift-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 10px;
			}
			.gift-input {
				flex: 1 1 140px;
				min-width: 0;
				padding: 10px 12px;
				border: 1px solid var(--border);
				border-radius: 8px;
				background: var(--bg);
				color: var(--text-heading);
				font: 600 18px/1.2 var(--font-body);
				letter-spacing: 0.12em;
			}
			.gift-input:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 1px;
			}
			.gift-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 44px;
				padding: 10px 18px;
				border: 1px solid var(--accent);
				border-radius: 8px;
				background: var(--accent);
				color: var(--on-accent);
				font: 600 15px/1.2 var(--font-body);
				text-decoration: none;
				cursor: pointer;
			}
			.gift-btn:disabled {
				opacity: 0.6;
				cursor: progress;
			}
			.gift-btn:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
			}
			.gift-btn-quiet {
				background: transparent;
				color: var(--accent);
			}
			.gift-phone {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 10px;
				padding-top: 14px;
				border-top: 1px solid var(--border);
			}
			.gift-phone[hidden],
			.gift-error[hidden],
			.gift-note[hidden] {
				display: none;
			}
			.gift-error {
				margin: 0;
				font-size: 14px;
				color: var(--fail, var(--accent));
			}
		</style>
	</body>
</html>
