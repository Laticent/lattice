---
// Lattice landing page — a standalone Astro route (NOT a Starlight page), so it
// renders full-bleed with the engine's own tokens instead of Starlight chrome.
// The docs pages (/getting-started, /introduction, …) stay 100% Starlight.
//
// Phase 4 of the shadcn migration: the marketing sections are React + Tailwind +
// shadcn. Astro owns the page shell (head, topbar, footer, the engine <script>);
// React owns the content. Static sections (hero copy/CTAs, feature/why/next
// cards, section heads) render SERVER-SIDE with NO client: directive → zero JS.
// Only the genuinely interactive bits hydrate: the hero Preview/Source Tabs
// (HeroPreview), the field-card live previews (FieldCardsLive), and the restyle
// carousel (RestyleShowcase). Each WRAPS the irreducible engine via the shared
// <DeckPreview> bridge (src/components/DeckPreview.tsx → src/lib/single-slide-render.ts)
// — it never reimplements the engine render.
// See engineering/decisions/2026-06-09-shadcn-migration.md §0.
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { join } from 'node:path';
import '../styles/landing.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import { HeroCopy } from '../components/landing/HeroCopy.tsx';
import HeroPreview from '../components/landing/HeroPreview.tsx';
import {
	ByomSection,
	HowItWorks,
	NextSteps,
	nextStepsFor,
	ProofStrip,
	RoomCards,
	SayMoreSection,
	SectionHead,
	StudioActions,
	StudioCopy,
	StudioTrust,
	WhyCards,
} from '../components/landing/sections.tsx';
import FieldCardsLive from '../components/landing/FieldCardsLive.tsx';
import { ROOM_SLIDES, SAY_MORE_SLIDE } from '../components/landing/room-decks';
import RestyleShowcase from '../components/landing/RestyleShowcase.tsx';
import StudioPreview from '../components/landing/StudioPreview.tsx';
import { DECKS } from '../components/studio/decks';
import { assetBase, engineAsset } from '../playground/asset-version.mjs';
import { joinBase } from '../lib/base-url.mjs';
import ResourceHints from '../components/site/ResourceHints.astro';
import EngineWarm from '../components/site/EngineWarm.astro';
import PlaygroundWarm from '../components/site/PlaygroundWarm.astro';
import { sourceHasDrawnFence } from '../../../lib/plugins/drawn-probe.mjs';

// Astro evaluates this frontmatter at build time with cwd = docs/, so anchor
// repo reads to cwd (import.meta.url is unreliable once the page is bundled).
const docsRoot = process.cwd();
const repoRoot = join(docsRoot, '..');
const require = createRequire(import.meta.url);
const { loadAll } = require(join(repoRoot, 'lib/components', 'index.js'));
const manifests = loadAll();

// Base-path-safe URL builder (project pages live under /lattice/).
const base = import.meta.env.BASE_URL;
const url = (p) => joinBase(base, p);
// Cache-busted prefix for the playground's runtime-fetched assets — see
// asset-version.mjs. `playground/` (the route) stays bare.
const pg = assetBase();

// Palette list = the distinct names baked into the generated token CSS — one
// source of truth (themes/*.css via build-landing-tokens.js), no duplication.
const tokensCss = readFileSync(join(docsRoot, 'src/styles/lattice-tokens.generated.css'), 'utf8');
const palettes = [...new Set([...tokensCss.matchAll(/data-palette="([^"]+)"/g)].map((m) => m[1]))];
const titleCase = (s) => s.replace(/(^|-)(\w)/g, (_, sep, c) => (sep ? ' ' : '') + c.toUpperCase());

// The hero's left panel shows the REAL manifest sample that produced the right
// panel's rendered slide image — so "write this, get this" is literally true.
// Hero = the component flagged `showcase.hero` in its manifest; its sample is
// shown verbatim as the headline source and rendered as the hero slide.
const heroComp = manifests.find((m) => m.showcase && m.showcase.hero);
const escapeHtml = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const heroSource = heroComp.sample.trim();
const heroCodeHtml = heroSource
	.split('\n')
	.map((line) => {
		let cls = 'ln-dim';
		if (/^<!--\s*_class/.test(line)) cls = 'ln-class';
		else if (/^#{1,6}\s/.test(line)) cls = 'ln-h';
		return `<span class="${cls}">${escapeHtml(line) || ' '}</span>`;
	})
	.join('\n');

// "One source, every palette" demo = ONE slide re-rendered live through every
// palette. Swatch colors are each palette's light `--accent`, read from the
// generated tokens CSS (the same source the topbar selector lists).
const restyleComp = manifests.find((m) => m.name === 'kpi');
const paletteAccents = palettes.map((name) => {
	const hit = tokensCss.match(
		new RegExp(`\\[data-palette="${name}"\\]\\[data-mode="light"\\]\\{[^}]*?--accent:(#[0-9A-Fa-f]{3,8})`),
	);
	return { name, label: titleCase(name), accent: hit ? hit[1] : '#888888' };
});

// Live-render data: the islands render the hero, the field cards, and the
// restyle demo through the engine runtime so they follow the selected palette +
// light/dark, instead of being baked-in-indaco static images.
// A fence a runtime draws (Mermaid's), by the plugin registry's fence names — never narrower than
// what the CLI bakes (`~~~`, indented and blockquoted fences count).
const needsDrawn = (s) => sourceHasDrawnFence(s || '');

// The "say more" before/after slide and the six audience-room cards each render a
// REAL slide live (no static image) through the same engine runtime the hero +
// carousel use. The sources live in room-decks.ts.
const cardData = Object.fromEntries(
	[['say-more', SAY_MORE_SLIDE], ...Object.entries(ROOM_SLIDES)].map(([key, sample]) => [
		key,
		{ sample, drawn: needsDrawn(sample) },
	]),
);

// Shared engine endpoints handed to every live island. `engineUrl` is the
// ~554KB-gz render bundle: it is no longer loaded eagerly in <head> — each
// island loads it on demand (load-engine.ts, via the bridge's whenReady) when
// it first needs to render, so the static hero text paints first.
const themeBase = url(pg + 'themes/');
const runtimeUrl = url(pg + 'lattice-runtime.js');
const engineUrl = url(engineAsset());
// Locally-vendored Mermaid + KaTeX, the same copies the Playground and the Studio
// use, staged by sync-playground-assets. The landing page DOES render diagrams —
// `needsDrawn` above gates the `diagram` field card on ```mermaid (via CARD_COMPONENTS) — so
// without these the most-visited page on the site fetched a floating `mermaid@11`
// from jsdelivr with no `integrity`: third-party code execution a firewall or an
// offline reader can refuse, on every one of those renders.
// The dagre layout engine, split out of the runtime bundle so a landing visitor with
// no state chart on screen does not fetch it. The islands below hand it to the
// renderer, which emits the tag only for a slide that carries a drawn machine.
const dagreUrl = url(pg + 'lattice-dagre.js');
const katexUrl = url(pg + 'katex/katex.min.css');

const heroData = {
	sample: heroComp.sample,
	drawn: needsDrawn(heroComp.sample),
	codeHtml: heroCodeHtml,
	componentName: heroComp.name,
	themeBase,
	runtimeUrl,
	engineUrl,
	dagreUrl,
	katexUrl,
};
const fieldCardsData = { cards: cardData, themeBase, runtimeUrl, engineUrl, dagreUrl, katexUrl };
const restyleData = {
	sample: restyleComp.sample || restyleComp.skeleton,
	drawn: needsDrawn(restyleComp.sample || restyleComp.skeleton),
	palettes: paletteAccents,
	themeBase,
	runtimeUrl,
	engineUrl,
	dagreUrl,
	katexUrl,
};

// The Studio section's live proof. Every displayed string is DERIVED from the
// Studio's own deck module at build time — the deck the Studio actually boots
// into — so the landing can't drift from the app. The slide count comes from
// `slides.length`, deliberately NOT from the deck's hand-written `meta` string,
// which can rot independently. Same counts policy as `manifests.length` above:
// exact where it is generated (copy doc §7.3).
const studioDeck = DECKS[0];
const studioSample = studioDeck.slides[0];
const studioData = {
	sample: studioSample,
	drawn: needsDrawn(studioSample),
	deckTitle: studioDeck.title,
	slideCount: studioDeck.slides.length,
	themeBase,
	runtimeUrl,
	engineUrl,
	dagreUrl,
	katexUrl,
};

// The four next-step cards now live in sections.tsx with the rest of the landing
// copy — card 4's body carries an inline link, and JSX can't appear in Astro
// frontmatter.
const nextSteps = nextStepsFor(url);
---

<!doctype html>
<html lang="en" data-palette="cuoio" data-mode="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<ResourceHints />
		{/* NO RUNTIME PREFETCH HERE (2026-10-26-lighthouse-home-runtime-prefetch.md). The hero
		    renders only after the engine downloads, so a 461 KB runtime prefetch can only share the
		    link with that download. Locally it cost the hero's first slide ~0.2 s and Lighthouse
		    ~2 s of LCP; on the real CDN both were unchanged within noise (§7). Neutral there, a
		    win locally, and one download fewer: the iframe fetches the runtime when it needs it. */}
		<title>Lattice — Markdown to boardroom-ready slide decks (PDF, PPTX)</title>
		<meta
			name="description"
			content="Write plain Markdown, pick a layout per slide, and Lattice renders a polished PDF, PPTX, or HTML deck with one palette and zero design work. Free, offline, open source (AGPL-3.0)."
		/>
		<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
		<!-- Set palette/mode before first paint to avoid a flash. Shares the
		     portal's localStorage keys so a choice carries across the jump. -->
		<script is:inline>
			(function () {
				var r = document.documentElement;
				try {
					var p = localStorage.getItem('lattice-docs-palette');
					if (p) r.setAttribute('data-palette', p);
					var m = localStorage.getItem('lattice-docs-mode');
					if (m === 'light' || m === 'dark') r.setAttribute('data-mode', m);
					else if (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches)
						r.setAttribute('data-mode', 'dark');
				} catch (e) {}
			})();
		</script>
	</head>
	<body>
		<SiteHeader palettes={palettes} />

		<main>
			<!-- Hero -->
			<section class="py-[clamp(48px,7vw,96px)] pb-[clamp(40px,5vw,72px)]">
				<div class="wrap grid grid-cols-1 items-center gap-[clamp(28px,4vw,56px)] lg:grid-cols-[1.05fr_1fr]">
					<!-- Static copy + CTAs (zero JS). -->
					<HeroCopy
						studioHref={url('studio/')}
						getStartedHref={url('getting-started/')}
						galleryHref={url('gallery.pdf')}
					/>
					<!-- Interactive Preview/Source flip + live render (hydrates). -->
					<HeroPreview client:load data={heroData} />
				</div>
			</section>

			<!-- Say more with less — the communication thesis, directly under the
			     hero: what a deck is FOR (the people who decide understand you) before
			     how it is made. Muted, with its own before/after proof; the live slide
			     host is filled by the FieldCardsLive island in the rooms section below.
			     See engineering/decisions/2026-10-28-home-positioning-audit.md §5. -->
			<section class="border-y border-border bg-muted py-[clamp(48px,6vw,88px)]">
				<div class="wrap">
					<SayMoreSection playgroundHref={url('playground/')} />
				</div>
			</section>

			<!-- Every room — the audience by the room a deck is for, not the author's
			     job title (positioning audit §6). The former "speaks your field"
			     professions are the last card, "The review". -->
			<section class="py-[clamp(48px,6vw,88px)]">
				<div class="wrap">
					<SectionHead eyebrow="Every room where you need to be understood" title="From the boardroom to the lecture hall.">
						Executives, sales and marketing teams, public servants, teachers, nonprofit staff, and engineers all make
						the same kind of deck: one that has to land with people who have little time. Each room already has the layouts it needs.
					</SectionHead>
					<RoomCards playgroundHref={url('playground/')} layoutCount={manifests.length} />
				</div>
				<!-- Invisible controller: fills the say-more slide's and the cards' live hosts, each as it nears the viewport, + wires "Edit this
				     deck". client:load (not client:visible) because this island renders
				     null — a zero-box element has nothing for client:visible's observer to
				     intersect, so it would never hydrate. It does its OWN lazy render
				     (an IntersectionObserver per host), so eager hydration is cheap. -->
				<FieldCardsLive client:idle data={fieldCardsData} />
			</section>

			<!-- How it works — a slim three-step band, after the "why" (say-more and
			     the rooms) so the mechanism arrives once the visitor knows what it is for. -->
			<section class="border-y border-border bg-muted py-[clamp(28px,3.5vw,44px)]">
				<div class="wrap">
					<HowItWorks />
				</div>
			</section>

			<!-- The Studio — the browser door, opened. It sits directly AFTER "How it
			     works" on purpose, so the visitor reads the text-file → engine model
			     before they learn there is an app. Ahead of it the page would read "web
			     app that also has a CLI".
			     Plain background; the section supplies its own inset bg-card panel. -->
			<section class="py-[clamp(48px,6vw,88px)]">
				<div class="wrap">
					<!-- The inset panel is what makes this read as an OBJECT you can open
					     rather than another prose band, and what separates it from the
					     plain card sections around it. Astro owns the panel + grid;
					     React owns the content — the same split the hero uses, and the
					     reason the preview is a SIBLING island rather than a child. -->
					<div class="rounded-2xl border border-border bg-card p-[clamp(20px,3vw,40px)] text-card-foreground shadow-sm">
						<!-- Same column ratio as the hero, so the page keeps one visual
						     language and the eye recognizes "another open-it moment".
						     THREE children, not two, so the CTA can follow the PROOF when
						     the grid stacks: below lg the order reads prose → preview →
						     buttons; at lg the prose and buttons sit in column 1 and the
						     preview spans both rows in column 2. -->
						<div class="grid grid-cols-1 items-start gap-x-[clamp(24px,3vw,44px)] gap-y-7 lg:grid-cols-[1.05fr_1fr]">
							<div class="min-w-0 lg:col-start-1 lg:row-start-1"><StudioCopy /></div>
							<!-- The one island. client:visible — it is below the fold, and the
							     engine bundle it needs is already in flight from the hero's
							     client:load preview, so this adds no new network bytes. -->
							<div class="min-w-0 lg:col-start-2 lg:row-start-1 lg:row-span-2">
								<StudioPreview client:visible data={studioData} />
							</div>
							<div class="min-w-0 lg:col-start-1 lg:row-start-2">
								<StudioActions studioHref={url('studio/')} newDeckHref={url('studio/') + '?new=1'} />
							</div>
						</div>
						<StudioTrust />
					</div>
				</div>
			</section>

			<!-- Bring your own model — its own band again, at h2 altitude, directly
			     after the Studio. It was briefly absorbed into the Studio section as an
			     h3 to hold the page's section count; that trade was wrong. The eyebrow
			     exists to disclaim AT SKIM ALTITUDE (copy doc §5.5), and a skimmer
			     scanning h2s never sees an h3 in another section's footer. Adjacent to
			     the Studio, the page still reads as ONE AI conversation rather than two
			     in two registers — which was the real goal; "no net section" was only
			     the bookkeeping. -->
			<section class="border-y border-border bg-muted py-[clamp(48px,6vw,88px)]">
				<div class="wrap">
					<ByomSection featuresHref={url('features/') + '#ai-authoring'} />
				</div>
			</section>

			<!-- Why -->
			<section class="py-[clamp(48px,6vw,88px)]">
				<div class="wrap">
					<SectionHead eyebrow="Why decks drift, and why these don't" title="Every deck looks like it came from the same team — because it did.">
						Slide tools make every slide a blank canvas, so the headline font on page 4 drifts from page 5 and the accent
						blue wanders between two shades. Lattice removes the canvas. You choose meaning; the engine owns the pixels.
					</SectionHead>
					<WhyCards />
				</div>
			</section>

			<!-- Proof — one receipt from /comparison, a slim band -->
			<section class="border-y border-border bg-muted py-[clamp(40px,5vw,64px)]">
				<div class="wrap">
					<ProofStrip comparisonHref={url('comparison/')} />
				</div>
			</section>

			<!-- Showcase — plain. The bands alternate light/muted from the hero down;
			     with say-more and the rooms added above, this one lands light, and Next
			     steps (also light) is divided from it by its top rule. -->
			<section class="py-[clamp(48px,6vw,88px)]">
				<div class="wrap">
					<SectionHead eyebrow="One source, every palette" title="Change one line. Restyle the whole deck.">
						Watch a single slide move through every palette — in light or dark. This is the one-file palette
						contract paying off: edit one <code class="font-mono text-[0.88em] text-primary">theme:</code> line and the whole deck follows.
					</SectionHead>
					<RestyleShowcase client:visible data={restyleData} />
				</div>
			</section>

			<!-- Next steps — plain with a top rule, not muted: the footer below is
			     muted, and a muted band above it would run into it. The libraries and
			     specs that sat above it moved behind its "For developers" card
			     (positioning audit §7). -->
			<section class="border-t border-border py-[clamp(48px,6vw,88px)]">
				<div class="wrap">
					<SectionHead eyebrow="Where to go next" title="Pick a starting point.">
						The engine ships today; the Laticent desktop app is on the way.
					</SectionHead>
					<NextSteps links={nextSteps} />
				</div>
			</section>
		</main>

		<footer class="foot">
			<div class="wrap foot-inner">
				<a class="brand" href={url('')}>
					<img class="brand-logo" src={url('lattice-mark-min.svg')} alt="" width="26" height="26" />
					<span class="brand-mark">Lattice</span>
				</a>
				<nav>
					<a href={url('introduction/')}>What is Lattice?</a>
					<a href={url('story/')}>Story</a>
					<a href={url('getting-started/')}>Get started</a>
					<a href={url('playground/')}>Playground</a>
					<a href={url('studio/')}>Studio</a>
					<a href={url('guides/authoring/')}>Authoring</a>
					<a href={url('components/')}>Components</a>
					<a href={url('features/')}>Features</a>
					<a href={url('comparison/')}>Comparison</a>
					<a href={url('libraries/')}>Libraries</a>
					<a href="https://github.com/Laticent/lattice">GitHub</a>
				</nav>
				<span class="legal">Designed by humans. Refined with Claude. · Part of Laticent · AGPL-3.0-licensed</span>
			</div>
		</footer>

		<!-- The Lattice render engine (window.LatticePlayground) is NOT loaded here
		     anymore — it's injected ON DEMAND by load-engine.ts the first time a
		     live island needs to render (hero mount, field/restyle in view), so the
		     static hero text paints without the ~554KB-gz bundle competing for the
		     main thread. The engine URL is wired through the island data payloads. -->
		<!-- Warm that same bundle into cache per the connection-first policy.
		     allowEager: this is the funnel into the apps, so a fast link fetches it
		     on idle (priming the jump to the Studio/Playground — and the hero CTA
		     now points at the Studio, so the bundle this caches is the one that
		     destination loads on mount); a slow link or
		     Save-Data stays hands-off. See src/lib/prefetch-engine.ts. -->
		<EngineWarm allowEager />
		{/* …and the rest of a first Playground visit: its baked first slide, its theme, and the
		    page itself on hover. See PlaygroundWarm.astro. */}
		<PlaygroundWarm />
	</body>
</html>
