---
// Filo — a standalone, framework-free showcase driven by the REAL library (docs/src/lib/filo, the
// `@laticent/filo` workspace). One document, four writers that never call each other: an editor,
// a settings panel, a list of sections with an AI rewrite, and a lint fix. Each commits to one
// Filo history, and ⌘Z anywhere on the page undoes the last change, whoever made it. The thread
// below is drawn from the history's own `steps()` and `marks()`, and the counters read its byte
// size, so nothing on screen is a second copy of the truth. A guided storyboard walks the
// guarantees. Reached at /libraries/filo/; its Learn page is /libraries/filo/learn/
// (src/content/catalog/), which carries the code, the guarantees and the measurements.
import DemoBar from '../../../components/catalog/DemoBar.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Filo — one undo history for every way a document changes</title>
		<link rel="icon" href="/filo-mark-min.svg" type="image/svg+xml" />
		<!-- Global (unscoped): the thread, the sections and the beats are built in JS at runtime, so
		     Astro's element-scoped hashes would never match them. -->
		<style is:global>
			:root {
				--paper: #f6f3ec; --stage: #f1ebe9; --ink: #2a1418; --muted: #6e5a5f; --line: #e2d6d6;
				--accent: #91123f; --accent-ink: #fff; --live: #15ab83; --live-ink: #0b6e54; --live-bg: #dcf3ec;
				--panel: #fdfbfa; --soft: #f6e6ea; --ring: #3a0619; --shadow: 0 1px 2px rgba(42,20,24,.06), 0 8px 24px rgba(42,20,24,.07);
				--serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
				--sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
				--mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
				color-scheme: light;
			}
			@media (prefers-color-scheme: dark) {
				:root:not([data-theme="light"]) {
					--paper: #121012; --stage: #1a1517; --ink: #f3e5e8; --muted: #b29aa1; --line: #33272b;
					--accent: #fb6188; --accent-ink: #2a0610; --live: #62fecb; --live-ink: #62fecb; --live-bg: #0f2f26;
					--panel: #171214; --soft: #3a1a24; --ring: #2a0d15; --shadow: 0 1px 2px rgba(0,0,0,.4), 0 10px 30px rgba(0,0,0,.35);
					color-scheme: dark;
				}
			}
			:root[data-theme="dark"] {
				--paper: #121012; --stage: #1a1517; --ink: #f3e5e8; --muted: #b29aa1; --line: #33272b;
				--accent: #fb6188; --accent-ink: #2a0610; --live: #62fecb; --live-ink: #62fecb; --live-bg: #0f2f26;
				--panel: #171214; --soft: #3a1a24; --ring: #2a0d15; --shadow: 0 1px 2px rgba(0,0,0,.4), 0 10px 30px rgba(0,0,0,.35);
				color-scheme: dark;
			}
			* { box-sizing: border-box; }
			body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans);
				line-height: 1.5; -webkit-font-smoothing: antialiased; padding: clamp(16px, 4vw, 48px); }
			.wrap { max-width: 1120px; margin: 0 auto; }
			header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
			.brand { display: flex; align-items: center; gap: 13px; }
			.brand .logo { width: 46px; height: 46px; flex-shrink: 0; }
			.logo .t-pri { stroke: var(--accent); }
			.logo .t-warm { stroke: var(--live); }
			.logo .t-hub { fill: var(--accent); }
			.logo .t-halo { fill: var(--paper); }
			.logo .t-ring { stroke: var(--ring); }
			h1 { font-family: var(--serif); font-size: clamp(28px, 5vw, 40px); font-weight: 600; margin: 0; letter-spacing: -.01em; }
			h2 { font-family: var(--serif); font-size: 21px; font-weight: 600; margin: 0; }
			.tag { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent);
				border: 1px solid var(--accent); padding: 3px 8px; border-radius: 999px; font-weight: 600; white-space: nowrap; }
			.sub { color: var(--muted); font-size: 15px; max-width: 74ch; margin: 10px 0 0; }
			.sub b { color: var(--ink); font-weight: 600; }
			.sub kbd, .diag kbd { font-family: var(--mono); font-size: .85em; border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 5px; padding: 0 5px; background: var(--panel); color: var(--ink); }
			.theme { background: none; border: 1px solid var(--line); color: var(--muted); border-radius: 999px; font-size: 11px;
				padding: 5px 11px; cursor: pointer; font-family: var(--sans); display: inline-flex; align-items: center; gap: 6px; }
			.theme:hover { color: var(--accent); border-color: var(--accent); }
			.theme svg { width: 12px; height: 12px; }
			.promise { font-family: var(--serif); font-size: clamp(21px, 3vw, 27px); line-height: 1.3; color: var(--ink); max-width: 34ch; margin: 14px 0 0; text-wrap: balance; }
			section.block { margin-top: 34px; }
			.block-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
			.block-head p { margin: 4px 0 0; color: var(--muted); font-size: 13.5px; max-width: 70ch; }

			/* ── The stage ───────────────────────────────────────────────────── */
			.stage { margin-top: 22px; background: var(--stage); border: 1px solid var(--line); border-radius: 18px;
				box-shadow: var(--shadow); padding: clamp(12px, 2.4vw, 22px); }
			.toolbar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; justify-content: space-between; margin-bottom: 14px; }
			.toolbar .group { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
			.btn { border: 1px solid var(--line); background: var(--panel); color: var(--ink); font-family: var(--sans);
				font-size: 12.5px; font-weight: 600; border-radius: 999px; padding: 7px 13px; cursor: pointer; white-space: nowrap;
				display: inline-flex; align-items: center; gap: 6px; transition: transform .08s ease, border-color .12s ease; }
			.btn:hover:not(:disabled) { transform: translateY(-1px); border-color: var(--accent); }
			.btn:disabled { opacity: .45; cursor: default; }
			.btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
			.btn svg { width: 13px; height: 13px; }
			.btn .lbl { font-weight: 500; color: inherit; opacity: .8; max-width: 22ch; overflow: hidden; text-overflow: ellipsis; }
			.views { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 12px; }
			.view { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; display: flex; flex-direction: column; min-width: 0; overflow: hidden;
				transition: box-shadow .25s ease, border-color .25s ease; }
			.view.touched { border-color: var(--live); box-shadow: 0 0 0 3px color-mix(in srgb, var(--live) 28%, transparent); }
			.view-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 12px; border-bottom: 1px solid var(--line); }
			.view-head .name { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); font-weight: 700; display: inline-flex; gap: 7px; align-items: center; }
			.view-head .name i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); display: inline-block; }
			.view-head .meta { font-family: var(--mono); font-size: 11px; color: var(--muted); }
			.v-editor { grid-row: span 2; }
			.side { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
			textarea#src { flex: 1; min-height: 300px; width: 100%; resize: none; border: 0; background: transparent; color: var(--ink);
				font-family: var(--mono); font-size: 13px; line-height: 20px; padding: 12px 14px; tab-size: 2; white-space: pre-wrap; overflow: auto; }
			textarea#src:focus { outline: none; box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent) 55%, transparent); }
			@media (pointer: coarse) { textarea, select { font-size: max(16px, 1em); } }
			.settings { padding: 10px 12px 12px; display: grid; gap: 10px; }
			.settings label { display: grid; grid-template-columns: 92px minmax(0, 1fr) auto; align-items: center; gap: 10px; font-size: 13px; }
			.settings .k { color: var(--muted); }
			.settings select { font-family: var(--sans); font-size: 13px; padding: 5px 8px; border-radius: 8px; border: 1px solid var(--line); background: var(--panel); color: var(--ink); }
			.settings input[type="range"] { accent-color: var(--accent); width: 100%; }
			.settings output { font-family: var(--mono); font-size: 12px; color: var(--muted); min-width: 30px; text-align: right; }
			.switch { justify-self: start; border: 1px solid var(--line); background: var(--panel); border-radius: 999px; width: 42px; height: 24px; padding: 2px; cursor: pointer; position: relative; }
			.switch::after { content: ''; display: block; width: 18px; height: 18px; border-radius: 50%; background: var(--muted); transition: transform .15s ease, background .15s ease; }
			.switch[aria-checked="true"] { background: var(--soft); border-color: var(--accent); }
			.switch[aria-checked="true"]::after { transform: translateX(18px); background: var(--accent); }
			.sections { list-style: none; margin: 0; padding: 8px; display: flex; flex-direction: column; gap: 4px; }
			.sections li { display: flex; align-items: center; gap: 6px; padding: 5px 6px 5px 10px; border-radius: 9px; font-size: 13px; }
			.sections li:hover { background: var(--soft); }
			.sections .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.sections button { border: 1px solid var(--line); background: var(--panel); color: var(--muted); border-radius: 7px; font-size: 11.5px; font-weight: 600;
				padding: 3px 7px; cursor: pointer; font-family: var(--sans); }
			.sections button:hover:not(:disabled) { color: var(--accent); border-color: var(--accent); }
			.sections button:disabled { opacity: .35; cursor: default; }
			.sections button.ai { color: var(--live-ink); }

			/* ── The thread: the history as Filo holds it ─────────────────────── */
			.wire { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 12px; margin-top: 12px; }
			.thread { list-style: none; margin: 0; padding: 10px 12px 12px 14px; height: 240px; overflow: auto; display: flex; flex-direction: column; gap: 0; }
			.thread li { display: grid; grid-template-columns: 18px minmax(0, 1fr) auto auto; align-items: center; gap: 9px; padding: 3px 4px; position: relative; font-size: 13px; }
			.thread li::before { content: ''; position: absolute; left: 12px; top: -4px; bottom: -4px; width: 2px; background: var(--accent); opacity: .35; }
			.thread li:first-child::before { top: 50%; }
			.thread li:last-child::before { bottom: 50%; }
			.thread .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--accent); border: 2px solid var(--accent); position: relative; z-index: 1; margin-left: 1px; }
			.thread li.undone { color: var(--muted); }
			.thread li.undone .dot { background: var(--panel); }
			.thread li.undone .lab { text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--muted) 50%, transparent); }
			.thread li.head { background: var(--live-bg); border-radius: 8px; }
			.thread li.head .dot { background: var(--live); border-color: var(--live); box-shadow: 0 0 0 4px color-mix(in srgb, var(--live) 25%, transparent); }
			.thread li.gap .dot { border-style: dashed; background: var(--panel); }
			.thread li.flash { animation: flash 1.1s ease; }
			@keyframes flash { 0% { background: color-mix(in srgb, var(--live) 45%, transparent); } 100% { background: transparent; } }
			.thread .lab { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.thread .org { font-family: var(--mono); font-size: 10.5px; color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); border-radius: 999px; padding: 0 7px; }
			.thread li.undone .org { color: var(--muted); border-color: var(--line); }
			.thread .sz { font-family: var(--mono); font-size: 11px; color: var(--muted); min-width: 52px; text-align: right; }
			.thread .floor { color: var(--muted); font-style: italic; }
			.thread .floor .dot { background: var(--panel); border-color: var(--muted); }
			.marks { list-style: none; margin: 0; padding: 4px 12px 10px; display: flex; flex-direction: column; gap: 4px; }
			.marks li { display: flex; align-items: center; gap: 8px; font-size: 12.5px; }
			.marks .pin { width: 9px; height: 9px; transform: rotate(45deg); background: var(--accent); flex-shrink: 0; }
			.marks li.auto .pin { background: var(--live); }
			.marks .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.marks button { border: 1px solid var(--line); background: var(--panel); color: var(--accent); border-radius: 7px; font-size: 11.5px; font-weight: 600; padding: 2px 8px; cursor: pointer; font-family: var(--sans); }
			.marks .empty { color: var(--muted); font-size: 12.5px; }
			.stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; padding: 10px; }
			.stat { border: 1px solid var(--line); border-radius: 10px; padding: 8px 10px; }
			.stat .k { font-size: 11px; color: var(--muted); display: block; }
			.stat .v { font-family: var(--mono); font-size: 18px; font-weight: 700; }
			.stat.hot .v { color: var(--live-ink); }
			.diag { margin: 10px 2px 0; font-size: 13px; color: var(--muted); min-height: 20px; }
			.diag b { color: var(--ink); }
			@media (max-width: 860px) {
				.views, .wire { grid-template-columns: minmax(0, 1fr); }
				.v-editor { grid-row: auto; }
				textarea#src { min-height: 240px; }
				.thread { height: auto; max-height: 240px; }
				.settings label { grid-template-columns: 80px minmax(0, 1fr) auto; }
			}

			/* ── Storyboard ───────────────────────────────────────────────────── */
			.beats { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px; }
			.beat { text-align: left; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); padding: 14px 15px;
				cursor: pointer; display: flex; gap: 12px; align-items: flex-start; transition: border-color .12s ease, transform .08s ease; font-family: var(--sans); color: var(--ink); }
			.beat:hover { transform: translateY(-2px); border-color: var(--accent); }
			.beat[aria-current="true"] { border-color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 16%, transparent); }
			.beat .n { flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: var(--stage); border: 1px solid var(--line);
				color: var(--accent); font-family: var(--mono); font-size: 12px; font-weight: 700; display: grid; place-items: center; }
			.beat[aria-current="true"] .n { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
			.beat .bt { display: block; font-size: 14px; font-weight: 600; margin: 0 0 2px; }
			.beat .bd { font-size: 12.5px; color: var(--muted); margin: 0 0 4px; line-height: 1.45; display: block; }
			.beat .api { font-family: var(--mono); font-size: 11px; color: var(--accent); overflow-wrap: anywhere; }

			.start { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 18px; }
			.btn.big { font-size: 15px; padding: 11px 20px; }
			.start-hint { font-size: 13.5px; color: var(--muted); max-width: 62ch; }
			.start-hint b { color: var(--ink); font-weight: 600; }
			.foot { margin-top: 34px; color: var(--muted); font-size: 12px; line-height: 1.7; border-top: 1px solid var(--line); padding-top: 16px; }
			.foot a { color: var(--accent); }
			:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
		</style>
	</head>
	<body>
		<div class="wrap">
			<DemoBar slug="filo" />
			<header>
				<div class="brand">
					<!-- The mark, inline so it follows this page's theme toggle as well as the OS
					     (docs/public/filo-mark.svg is the same geometry): a clew, the thread wound out
					     from the family's ringed hub, its live end where the author is now. -->
					<svg class="logo" viewBox="0 0 128 128" fill="none" aria-hidden="true"><path d="M51.5 85.7 L50.4 85.1 L49.3 84.5 L48.3 83.9 L47.3 83.2 L46.3 82.4 L45.3 81.6 L44.4 80.8 L43.5 79.9 L42.7 79.0 L41.9 78.0 L41.1 76.9 L40.4 75.9 L39.8 74.8 L39.2 73.6 L38.6 72.4 L38.1 71.2 L37.7 70.0 L37.3 68.7 L37.0 67.4 L36.8 66.1 L36.6 64.8 L36.4 63.5 L36.4 62.2 L36.4 60.8 L36.5 59.5 L36.6 58.1 L36.8 56.7 L37.1 55.4 L37.4 54.1 L37.8 52.7 L38.3 51.4 L38.8 50.2 L39.4 48.9 L40.1 47.7 L40.8 46.4 L41.6 45.3 L42.4 44.1 L43.4 43.0 L44.3 42.0 L45.3 40.9 L46.4 40.0 L47.5 39.1 L48.7 38.2 L49.9 37.4 L51.2 36.6 L52.5 35.9 L53.8 35.3 L55.2 34.7 L56.6 34.2 L58.0 33.8 L59.4 33.4 L60.9 33.1 L62.4 32.9 L63.9 32.7 L65.4 32.6 L67.0 32.6 L68.5 32.7 L70.0 32.8 L71.6 33.0 L73.1 33.3 L74.6 33.7 L76.1 34.1 L77.6 34.6 L79.0 35.2 L80.5 35.9 L81.9 36.6 L83.3 37.4 L84.6 38.3 L85.9 39.2 L87.1 40.2 L88.4 41.3 L89.5 42.4 L90.6 43.6 L91.7 44.9 L92.7 46.2 L93.6 47.5 L94.5 48.9 L95.3 50.4 L96.0 51.9 L96.7 53.4 L97.2 55.0 L97.8 56.5 L98.2 58.2 L98.5 59.8 L98.8 61.5 L99.0 63.2 L99.1 64.9 L99.2 66.6 L99.1 68.3 L99.0 70.0 L98.8 71.7 L98.5 73.4 L98.1 75.1 L97.6 76.8 L97.1 78.5 L96.4 80.1 L95.7 81.7 L94.9 83.3 L94.0 84.8 L93.1 86.3 L92.1 87.8 L91.0 89.2 L89.8 90.5 L88.6 91.9 L87.3 93.1 L85.9 94.3 L84.5 95.4 L83.0 96.5 L81.4 97.4 L79.8 98.4 L78.2 99.2 L76.5 99.9 L74.8 100.6 L73.0 101.2 L71.2 101.7 L69.4 102.1 L67.6 102.5 L65.7 102.7 L63.8 102.9 L62.0 102.9 L60.1 102.9 L58.2 102.8 L56.3 102.6 L54.4 102.3 L52.5 101.9 L50.6 101.4 L48.8 100.8 L47.0 100.1 L45.2 99.4 L43.5 98.5 L41.8 97.6 L40.1 96.6 L38.5 95.5 L36.9 94.3 L35.4 93.0 L33.9 91.7 L32.5 90.2 L31.2 88.8 L29.9 87.2 L28.8 85.6 L27.7 83.9 L26.6 82.2 L25.7 80.4 L24.8 78.6 L24.1 76.7 L23.4 74.8 L22.8 72.8 L22.3 70.8 L21.9 68.8 L21.6 66.8 L21.4 64.7 L21.3 62.7 L21.3 60.6 L21.4 58.5 L21.6 56.4 L21.9 54.4 L22.3 52.3 L22.8 50.3 L23.4 48.2 L24.1 46.2 L24.9 44.3 L25.8 42.3 L26.8 40.5 L27.9 38.6 L29.1 36.8 L30.3 35.1 L31.7 33.4 L33.1 31.8 L34.6 30.3 L36.2 28.8 L37.9 27.4 L39.7 26.1 L41.5 24.8 L43.3 23.7 L45.3 22.6 L47.2 21.7 L49.3 20.8 L51.3 20.0 L53.5 19.3 L55.6 18.8 L57.8 18.3 L60.0 17.9 L62.2 17.7 L64.5 17.5 L66.7 17.5 L69.0 17.6 L71.3 17.8 L73.5 18.0 L75.8 18.4 L78.0 19.0 L80.2 19.6 L82.4 20.3 L84.5 21.1 L86.6 22.1 L88.7 23.1 L90.7 24.3 L92.7 25.5 L94.6 26.9 L96.4 28.3 L98.2 29.8 L99.9 31.4 L101.5 33.1 L103.0 34.9 L104.5 36.8 L105.9 38.7 L107.2 40.7 L108.3 42.8 L109.4 44.9 L110.4 47.1 L111.3 49.3" class="t-pri" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M114.2 63.5 L114.3 65.9 L114.2 68.4 L114.1 70.8 L113.8 73.2 L113.4 75.7 L112.9 78.1 L112.3 80.5 L111.5 82.8 L110.7 85.2 L109.7 87.4 L108.6 89.7 L107.4 91.9 L106.1 94.0 L104.7 96.1 L103.2 98.1 L101.6 100.0 L99.9 101.9 L98.1 103.7 L96.2 105.4 L94.2 107.0 L92.2 108.5 L90.0 109.9 L87.8 111.2 L85.6 112.4" class="t-warm" stroke-width="7.3" stroke-linecap="round"/><circle cx="64" cy="64" r="15.0" class="t-halo"/><circle cx="64" cy="64" r="12.2" class="t-hub"/><circle cx="64" cy="64" r="7.6" class="t-ring" fill="none" stroke-width="1.8" opacity="0.6"/></svg>
					<h1>Filo</h1><span class="tag">Library</span>
				</div>
				<button class="theme" id="themeBtn" type="button"><svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4.8" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M6 1.2 A4.8 4.8 0 0 1 6 10.8 Z" fill="currentColor" /></svg>theme</button>
			</header>
			<p class="promise">One undo history for every way a document changes.</p>
			<p class="sub">Four writers change one document: the <b>editor</b>, a <b>settings</b> panel, a list of <b>sections</b> you can reorder or have an AI tighten, and a <b>lint fix</b>. None of them keeps its own undo. Each commits to one Filo history, drawn below as a thread. Change things in any of them, then press <kbd>⌘Z</kbd> or <kbd>Ctrl+Z</kbd> <b>with focus anywhere on this page</b>: the last change goes back, whoever made it.</p>

			<div class="start">
				<button class="btn primary big" type="button" id="playBtn">▸ Play the tour</button>
				<span class="start-hint">A narrated cursor changes the document through all four writers, then undoes from outside the editor. <b>Click or type anywhere</b> and the page is yours.</span>
			</div>

			<div class="stage" id="stage">
				<div class="toolbar">
					<div class="group">
						<button class="btn primary" type="button" id="undoBtn"><svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M5 9 2 6l3-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /><path d="M2 6h6.5a3.5 3.5 0 0 1 0 7H7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>Undo <span class="lbl" id="undoLbl"></span></button>
						<button class="btn" type="button" id="redoBtn"><svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="m9 9 3-3-3-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /><path d="M12 6H5.5a3.5 3.5 0 0 0 0 7H7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>Redo <span class="lbl" id="redoLbl"></span></button>
					</div>
					<div class="group">
						<button class="btn" type="button" id="markBtn">Save a version</button>
						<button class="btn" type="button" id="fixBtn">Fix all</button>
						<button class="btn" type="button" id="outsideBtn">Change it outside</button>
						<button class="btn" type="button" id="resetBtn">Reset</button>
					</div>
				</div>
				<div class="views">
					<div class="view v-editor" data-origin="editor">
						<div class="view-head"><span class="name"><i></i>Editor</span><span class="meta" id="editorMeta"></span></div>
						<textarea id="src" spellcheck="false" aria-label="Document source"></textarea>
					</div>
					<div class="side">
						<div class="view" data-origin="settings">
							<div class="view-head"><span class="name"><i></i>Settings</span><span class="meta">front matter</span></div>
							<div class="settings">
								<label><span class="k">Theme</span><select id="themeSel"><option value="indaco">Indaco</option><option value="cuoio">Cuoio</option><option value="carbone">Carbone</option></select><span></span></label>
								<label><span class="k">Text size</span><input id="sizeIn" type="range" min="12" max="24" step="1" /><output id="sizeOut"></output></label>
								<label><span class="k">Page numbers</span><button class="switch" id="numSw" type="button" role="switch" aria-checked="false" aria-label="Page numbers"></button><span></span></label>
							</div>
						</div>
						<div class="view" data-origin="rail">
							<div class="view-head"><span class="name"><i></i>Sections</span><span class="meta">move or tighten</span></div>
							<ul class="sections" id="sections" aria-label="Sections"></ul>
						</div>
					</div>
				</div>
				<div class="wire">
					<div class="view">
						<div class="view-head"><span class="name">The thread</span><span class="meta" id="threadMeta"></span></div>
						<ol class="thread" id="thread" aria-label="Undo history"></ol>
					</div>
					<div class="view">
						<div class="view-head"><span class="name">Versions</span><span class="meta">marks</span></div>
						<ul class="marks" id="marks" aria-label="Saved versions"></ul>
						<div class="stats" id="stats"></div>
					</div>
				</div>
				<p class="diag" id="diag" role="status" aria-live="polite">Type in the editor, change a setting or move a section. Then press <kbd>⌘Z</kbd> from anywhere.</p>
			</div>

			<section class="block" aria-labelledby="sb">
				<div class="block-head">
					<div><h2 id="sb">The storyboard</h2><p>Each beat drives the stage above through the public API it names.</p></div>
					<button class="btn" type="button" id="tourBtn">Play all eight</button>
				</div>
				<div class="beats" id="beats"></div>
			</section>

			<p class="foot">This page runs the real library in your browser. <a href="/libraries/filo/learn/">Learn how Filo works, and how to use it →</a></p>
		</div>

		<script>
			import { createFilo, type History, type Move } from '@/lib/filo';

			const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector(sel) as T;
			const root = document.documentElement;
			const THEME_LS = 'filo-demo-theme';
			const osDark = () => window.matchMedia('(prefers-color-scheme: dark)').matches;
			const applyTheme = (t: string | null) => { if (t === 'light' || t === 'dark') root.setAttribute('data-theme', t); else root.removeAttribute('data-theme'); };
			try { const t = localStorage.getItem(THEME_LS); applyTheme(t === 'light' || t === 'dark' ? t : osDark() ? 'dark' : 'light'); } catch { /* storage blocked */ }
			$('#themeBtn').addEventListener('click', () => {
				const cur = root.getAttribute('data-theme') || (osDark() ? 'dark' : 'light');
				const next = cur === 'dark' ? 'light' : 'dark';
				applyTheme(next);
				try { localStorage.setItem(THEME_LS, next); } catch { /* storage blocked */ }
			});

			// ── The document, and the one history every writer shares ────────────────
			const DOC = `---
title: Field notes
theme: indaco
size: 16
numbers: off
---

# Field notes

Teh first section says what the team saw on the river trip.

## Findings

Three sites flooded twice  in one week, and the north bank lost a sensor.

## Risks

The next storm could take the two sensors that are left before anyone can move them.

## Next steps

Move the sensors up the bank, and check them after every storm.
`;
			// Typing never joins across a heading: an edit in one section is its own step.
			const boundary = (a: number, b: number, text: string) => /\n#/.test(text.slice(Math.max(0, a - 1), b + 1));
			let filo = createFilo({ boundary, limits: { entries: 100 } });
			let h: History = filo.load('demo:field-notes', DOC);
			let shown = DOC; // what the editor shows: always h.text after every write here
			let lastMs = 0;

			const src = $<HTMLTextAreaElement>('#src');
			const diag = $('#diag');
			const say = (html: string) => { diag.innerHTML = html; };
			const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);

			/** Time one call to the history: the counters show the last one. */
			const timed = <T,>(fn: () => T): T => { const t0 = performance.now(); try { return fn(); } finally { lastMs = performance.now() - t0; } };

			/** Every writer goes through this: one commit, against the head it saw. */
			function write(next: string, label: string, origin: string) {
				const r = timed(() => h.commit({ base: h.head, next, label, origin }));
				if (!r.ok) { if (r.reason === 'stale') say('Refused a stale write.'); return false; }
				shown = h.text;
				touch(origin);
				render();
				return true;
			}

			// ── Writer 1 · the editor: its own account of each change, so typing joins ──
			src.addEventListener('input', () => {
				const next = src.value;
				const a = shown;
				let p = 0;
				while (p < a.length && p < next.length && a[p] === next[p]) p++;
				let q = 0;
				while (q < a.length - p && q < next.length - p && a[a.length - 1 - q] === next[next.length - 1 - q]) q++;
				const edit = { from: p, to: a.length - q, insert: next.slice(p, next.length - q) };
				const r = timed(() => h.commit({ base: h.head, edits: [edit], label: 'Typing', origin: 'editor', before: p, after: src.selectionStart }));
				if (r.ok) shown = h.text;
				render(false);
			});

			// ── Writer 2 · settings: each row rewrites one front-matter line ──────────
			const fm = (text: string, key: string) => (text.match(new RegExp(`^${key}: (.*)$`, 'm')) ?? [])[1] ?? '';
			const setFm = (text: string, key: string, value: string) => text.replace(new RegExp(`^${key}: .*$`, 'm'), `${key}: ${value}`);
			const themeSel = $<HTMLSelectElement>('#themeSel');
			const sizeIn = $<HTMLInputElement>('#sizeIn');
			const sizeOut = $('#sizeOut');
			const numSw = $('#numSw');
			const name = (v: string) => v.charAt(0).toUpperCase() + v.slice(1);
			themeSel.addEventListener('change', () => write(setFm(shown, 'theme', themeSel.value), `Theme → ${name(themeSel.value)}`, 'settings'));
			numSw.addEventListener('click', () => {
				const on = fm(shown, 'numbers') !== 'on';
				write(setFm(shown, 'numbers', on ? 'on' : 'off'), on ? 'Page numbers on' : 'Page numbers off', 'settings');
			});
			// A drag is one step: the group opens on pointer-down and closes on release.
			sizeIn.addEventListener('pointerdown', () => h.openGroup('Text size'));
			sizeIn.addEventListener('input', () => write(setFm(shown, 'size', sizeIn.value), 'Text size', 'settings'));
			for (const ev of ['pointerup', 'pointercancel', 'change', 'blur']) sizeIn.addEventListener(ev, () => { h.closeGroup(); render(); });

			// ── Writer 3 · sections: move one, or have an "AI" tighten it ─────────────
			type Sec = { title: string; start: number; end: number };
			function sectionsOf(text: string): Sec[] {
				const out: Sec[] = [];
				const re = /^## (.+)$/gm;
				let m: RegExpExecArray | null = re.exec(text);
				while (m) { out.push({ title: m[1], start: m.index, end: text.length }); m = re.exec(text); }
				for (let i = 0; i < out.length - 1; i++) out[i].end = out[i + 1].start;
				return out;
			}
			const TIGHT: Record<string, string> = {
				Findings: 'Three sites flooded twice in a week; the north bank lost a sensor.',
				Risks: 'One more storm could take the last two sensors.',
				'Next steps': 'Move the sensors up the bank; check them after each storm.',
			};
			function move(i: number, dir: -1 | 1) {
				const secs = sectionsOf(shown);
				const a = secs[Math.min(i, i + dir)], b = secs[Math.max(i, i + dir)];
				if (!a || !b) return;
				const blockA = shown.slice(a.start, a.end).replace(/\n*$/, '\n\n');
				const blockB = shown.slice(b.start, b.end).replace(/\n*$/, '\n\n');
				const tail = shown.slice(b.end);
				const next = (shown.slice(0, a.start) + blockB + blockA + tail).replace(/\n{3,}/g, '\n\n').replace(/\n*$/, '\n');
				write(next, `Move “${secs[i].title}” ${dir < 0 ? 'up' : 'down'}`, 'rail');
			}
			function tighten(i: number) {
				const s = sectionsOf(shown)[i];
				const body = TIGHT[s.title];
				if (!body) return;
				const next = shown.slice(0, s.start) + `## ${s.title}\n\n${body}\n` + (s.end < shown.length ? '\n' : '') + shown.slice(s.end);
				write(next, `AI: tighten “${s.title}”`, 'ai');
			}

			// ── Writer 4 · a lint fix: several edits, one step (batch) ────────────────
			$('#fixBtn').addEventListener('click', () => {
				const fixes: [RegExp, string][] = [[/\bTeh\b/, 'The'], [/ {2,}/, ' ']];
				const found = fixes.filter(([re]) => re.test(shown));
				if (!found.length) { say('Nothing left to fix.'); return; }
				timed(() => h.batch(`Fix all (${found.length})`, () => {
					for (const [re, to] of found) {
						h.commit({ base: h.head, next: h.text.replace(re, to), label: 'Fix', origin: 'lint' });
					}
				}));
				shown = h.text;
				touch('editor');
				render();
				say(`<b>Fix all (${found.length})</b>: ${found.length} edits, one step. One ⌘Z takes both back.`);
			});

			// ── Marks, outside changes, reset ────────────────────────────────────────
			$('#markBtn').addEventListener('click', () => {
				const n = h.marks().filter((m) => !m.auto).length + 1;
				h.mark(`Version ${n}`);
				render();
				say(`Saved <b>Version ${n}</b>: a name on the thread, not a copy of the text.`);
			});
			$('#outsideBtn').addEventListener('click', () => {
				// A file changed on disk, another tab, a live session ending: the text moves without a commit.
				const next = shown.replace(/^title: .*$/m, 'title: Field notes (edited elsewhere)');
				shown = next;
				h.sync(next);
				render();
				say('The document changed <b>outside the history</b>. The next ⌘Z records that as one step and stops there, so no old patch lands on text it wasn’t made for.');
			});
			$('#resetBtn').addEventListener('click', reset);
			function reset() {
				filo = createFilo({ boundary, limits: { entries: 100 } });
				h = filo.load('demo:field-notes', DOC);
				shown = DOC;
				lastMs = 0;
				render();
				say('A fresh document and an empty history.');
			}

			// ── Undo and redo, from anywhere ─────────────────────────────────────────
			function apply(m: Move | null, verb: 'undo' | 'redo') {
				if (!m) { say(verb === 'undo' ? 'Nothing to undo.' : 'Nothing to redo.'); return; }
				shown = m.text;
				render();
				if (m.gap) { say('Recorded the outside change as its own step. <b>⌘Z again</b> to undo it.'); flashHead(); return; }
				if (m.caret !== null) { src.setSelectionRange(m.caret, m.caret); scrollCaret(m.caret); }
				touch(m.origin === 'lint' ? 'editor' : m.origin);
				flashHead();
				say(`${verb === 'undo' ? 'Undid' : 'Redid'}: <b>${esc(m.label)}</b> <span style="opacity:.7">(from ${esc(m.origin)}, in ${lastMs.toFixed(2)} ms)</span>`);
			}
			const undo = () => apply(timed(() => h.undo()), 'undo');
			const redo = () => apply(timed(() => h.redo()), 'redo');
			$('#undoBtn').addEventListener('click', undo);
			$('#redoBtn').addEventListener('click', redo);
			// One keymap for the page, as the Studio has: the editor's own native undo is replaced too.
			window.addEventListener('keydown', (e) => {
				if (e.isComposing || e.altKey) return;
				const mac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
				if (!(mac ? e.metaKey && !e.ctrlKey : e.ctrlKey && !e.metaKey)) return;
				const k = /^[a-z]$/i.test(e.key) ? e.key.toLowerCase() : e.code === 'KeyZ' ? 'z' : e.code === 'KeyY' ? 'y' : '';
				const verb = k === 'z' ? (e.shiftKey ? 'redo' : 'undo') : k === 'y' && !mac && !e.shiftKey ? 'redo' : null;
				if (!verb) return;
				if (e.target instanceof HTMLSelectElement) return;
				e.preventDefault();
				verb === 'undo' ? undo() : redo();
			});
			// The Edit menu's Undo and the iOS shake arrive as beforeinput in the editor.
			src.addEventListener('beforeinput', (e) => {
				if (e.inputType === 'historyUndo') { e.preventDefault(); undo(); }
				else if (e.inputType === 'historyRedo') { e.preventDefault(); redo(); }
			});
			function scrollCaret(at: number) {
				const line = shown.slice(0, at).split('\n').length - 1;
				src.scrollTop = Math.max(0, line * 20 - src.clientHeight / 3);
			}
			const panels = [...document.querySelectorAll<HTMLElement>('[data-origin]')];
			let touchTimer = 0;
			function touch(origin: string) {
				const key = origin === 'ai' ? 'rail' : origin === 'lint' ? 'editor' : origin;
				for (const p of panels) p.classList.toggle('touched', p.dataset.origin === key);
				clearTimeout(touchTimer);
				touchTimer = window.setTimeout(() => { for (const p of panels) p.classList.remove('touched'); }, 900);
			}
			function flashHead() {
				const el = $('#thread').querySelector('li.head') as HTMLElement | null;
				el?.classList.remove('flash');
				void el?.offsetWidth;
				el?.classList.add('flash');
			}

			// ── Drawing: every view reads the history; none keeps a copy ─────────────
			const sectionsEl = $('#sections');
			const threadEl = $('#thread');
			const marksEl = $('#marks');
			const statsEl = $('#stats');
			function render(syncEditor = true) {
				if (syncEditor && src.value !== shown) {
					const sel = src.selectionStart;
					src.value = shown;
					src.setSelectionRange(Math.min(sel, shown.length), Math.min(sel, shown.length));
				}
				$('#editorMeta').textContent = `${shown.length.toLocaleString()} chars`;
				themeSel.value = fm(shown, 'theme') || 'indaco';
				sizeIn.value = fm(shown, 'size') || '16';
				sizeOut.textContent = `${sizeIn.value}px`;
				numSw.setAttribute('aria-checked', String(fm(shown, 'numbers') === 'on'));
				const secs = sectionsOf(shown);
				sectionsEl.innerHTML = secs.map((s, i) => `<li><span class="t">${esc(s.title)}</span><button type="button" data-up="${i}" ${i === 0 ? 'disabled' : ''} aria-label="Move ${esc(s.title)} up">↑</button><button type="button" data-down="${i}" ${i === secs.length - 1 ? 'disabled' : ''} aria-label="Move ${esc(s.title)} down">↓</button><button type="button" class="ai" data-ai="${i}" ${TIGHT[s.title] && !shown.includes(TIGHT[s.title]) ? '' : 'disabled'}>AI: tighten</button></li>`).join('');
				const st = h.state();
				const steps = h.steps();
				const headIdx = steps.map((s) => s.done).lastIndexOf(true);
				const rows = steps.map((s, i) => `<li class="${s.done ? '' : 'undone'} ${i === headIdx ? 'head' : ''} ${s.origin === 'gap' ? 'gap' : ''}"><span class="dot"></span><span class="lab">${esc(s.label)}</span><span class="org">${esc(s.origin)}</span><span class="sz">${s.size.toLocaleString()} ch</span></li>`);
				const floor = `<li class="floor ${headIdx < 0 ? 'head' : ''}"><span class="dot"></span><span class="lab">The document as it opened</span><span></span><span class="sz"></span></li>`;
				const pending = st.stale ? `<li class="gap"><span class="dot"></span><span class="lab">Changed outside (recorded on the next ⌘Z)</span><span class="org">sync</span><span class="sz"></span></li>` : '';
				threadEl.innerHTML = floor + rows.join('') + pending;
				threadEl.scrollTop = threadEl.scrollHeight;
				$('#threadMeta').textContent = `${st.steps} step${st.steps === 1 ? '' : 's'} · ${steps.length - st.steps} to redo`;
				const marks = h.marks();
				marksEl.innerHTML = marks.length
					? marks.map((m) => `<li class="${m.auto ? 'auto' : ''}"><span class="pin"></span><span class="t">${esc(m.label)}</span><button type="button" data-restore="${m.id}">Restore</button></li>`).join('')
					: '<li class="empty">No versions yet. Save one, or undo and type.</li>';
				const copies = (steps.length + marks.length) * shown.length;
				statsEl.innerHTML = [
					['Stored by Filo', `${h.size.toLocaleString()} ch`, true],
					['As full copies', `${copies.toLocaleString()} ch`, false],
					['Last call', `${lastMs.toFixed(2)} ms`, false],
					['Cap', `${h.entryLimit} steps`, false],
				].map(([k, v, hot]) => `<div class="stat ${hot ? 'hot' : ''}"><span class="k">${k}</span><span class="v">${v}</span></div>`).join('');
				const undoBtn = $<HTMLButtonElement>('#undoBtn'), redoBtn = $<HTMLButtonElement>('#redoBtn');
				undoBtn.disabled = !st.canUndo;
				redoBtn.disabled = !st.canRedo;
				$('#undoLbl').textContent = st.undoLabel ?? '';
				$('#redoLbl').textContent = st.redoLabel ?? '';
			}
			sectionsEl.addEventListener('click', (e) => {
				const b = (e.target as HTMLElement).closest('button');
				if (!b) return;
				if (b.dataset.up) move(Number(b.dataset.up), -1);
				else if (b.dataset.down) move(Number(b.dataset.down), 1);
				else if (b.dataset.ai) tighten(Number(b.dataset.ai));
			});
			marksEl.addEventListener('click', (e) => {
				const b = (e.target as HTMLElement).closest('button');
				if (!b?.dataset.restore) return;
				const label = h.marks().find((m) => m.id === Number(b.dataset.restore))?.label ?? '';
				const m = timed(() => h.restore(Number(b.dataset.restore)));
				if (m) { shown = m.text; render(); flashHead(); say(`Restored <b>${esc(label)}</b> as a new step. ⌘Z takes the restore back.`); }
			});
			src.value = shown;
			render();

			// ── The played tour: the real Vetrina library narrates and drives this page ──────────
			// Every change still goes through this page's own writers (write, move, tighten, undo),
			// so the tour is the same code a visitor's clicks run; Vetrina only points and speaks.
			// Its typing lands through `tourType`, one Filo commit per chunk, so it coalesces like
			// real typing. The visitor's first real click or key ends the tour and hands over.
			let tourAt = 0;
			const tourType = {
				set: () => {},
				append: (t: string) => {
					const r = h.commit({ base: h.head, edits: [{ from: tourAt, to: tourAt, insert: t }], label: 'Typing', origin: 'editor', before: tourAt, after: tourAt + t.length });
					if (!r.ok) return;
					shown = h.text;
					tourAt += t.length;
					render();
					src.setSelectionRange(tourAt, tourAt);
					scrollCaret(tourAt);
				},
			};
			const tourActions = {
				theme: (v: string) => { themeSel.value = v; write(setFm(shown, 'theme', v), `Theme → ${name(v)}`, 'settings'); },
				move: (i: number, dir: -1 | 1) => move(i, dir),
				tighten: (i: number) => tighten(i),
				undo: () => undo(),
				redo: () => redo(),
			};
			const playBtn = $<HTMLButtonElement>('#playBtn');
			let tourHandle: { stop(): void } | null = null;
			async function playTour() {
				if (tourHandle) { tourHandle.stop(); return; }
				const { run, wait } = await import('@/lib/vetrina');
				reset();
				playBtn.textContent = '■ Stop the tour';
				tourHandle = run({
					root: document.body,
					actions: tourActions,
					type: tourType,
					takeover: { scope: 'window' },
					onStop: (reason: string) => {
						tourHandle = null;
						playBtn.textContent = '▸ Play the tour';
						if (reason === 'takeover') say('<b>The page is yours.</b> Change anything, then press ⌘Z from anywhere.');
					},
					play: async (ctx: any) => {
						const { stage, actions, signal } = ctx;
						const stamp = (sel: string) => (document.querySelector(sel) as HTMLElement | null) ?? '#stage';
						stage.say('One document, four writers, and one history behind all of them.');
						await stage.point('#src', signal); await wait(900, signal);
						tourAt = shown.indexOf('river trip') + 'river trip'.length;
						src.focus({ preventScroll: true });
						stage.say('The editor types. A burst of keystrokes is one step.');
						await ctx.type('#src', ' last week', { cadence: 70 });
						await stage.gesture('underline', stamp('#thread li.head'), signal); await wait(700, signal);
						stage.say('A settings panel rewrites a line of front matter.');
						await stage.point('#themeSel', signal); actions.theme('cuoio');
						await stage.gesture('check', '#themeSel', signal); await wait(600, signal);
						stage.say('The section list moves a section…');
						await stage.point('[data-down="0"]', signal); actions.move(0, 1);
						await stage.gesture('check', '#sections', signal); await wait(500, signal);
						stage.say('…and an AI rewrite tightens one. Each is one labeled step on the thread.');
						await stage.point(stamp('[data-ai]:not([disabled])'), signal); actions.tighten(0);
						await stage.gesture('circle', '#thread', signal); await wait(900, signal);
						stage.say('Now undo, with focus on the page, not in the editor. The last change goes back, whoever made it.');
						(document.activeElement as HTMLElement | null)?.blur?.();
						await stage.point('#undoBtn', signal);
						for (let i = 0; i < 3; i++) { actions.undo(); await stage.gesture('tap', '#undoBtn', signal); await wait(850, signal); }
						stage.say('Three undos: the AI rewrite, the move, the theme. The typing is still there.');
						await stage.gesture('underline', stamp('#thread li.head'), signal); await wait(1100, signal);
						stage.say('Redo brings the theme back.');
						await stage.point('#redoBtn', signal); actions.redo();
						await stage.gesture('check', '#themeSel', signal); await wait(900, signal);
						stage.say('Your turn: change anything, then press ⌘Z from anywhere on this page.');
						await wait(2200, signal);
					},
				});
			}
			playBtn.addEventListener('click', playTour);

			// ── The storyboard: each beat drives the stage through the API it names ──
			const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
			const typeAt = async (needle: string, text: string) => {
				src.focus();
				let at = shown.indexOf(needle) + needle.length;
				for (const ch of text) {
					src.setRangeText(ch, at, at, 'end');
					src.dispatchEvent(new Event('input'));
					at += ch.length;
					await wait(45);
				}
			};
			const BEATS: { t: string; d: string; api: string; run: () => Promise<void> }[] = [
				{ t: 'Typing is one step', d: 'Type a phrase: a dozen keystrokes join into one step, because they are close together, next to each other and from one writer.', api: 'commit({ edits }) · coalescing', run: async () => { reset(); await typeAt('river trip', ' last week'); say('Ten keystrokes, <b>one step</b> on the thread. ⌘Z takes the whole phrase back.'); } },
				{ t: 'Undo from anywhere', d: 'Change the theme in the settings panel, then undo without touching the editor. The last change goes back, whoever made it.', api: 'commit({ next }) · undo()', run: async () => { themeSel.value = 'cuoio'; themeSel.dispatchEvent(new Event('change')); await wait(700); undo(); } },
				{ t: 'A drag is one step', d: 'Drag the text size from 16 to 22: every value along the way joins one step, so one undo puts it back to 16.', api: 'openGroup() · closeGroup()', run: async () => { h.openGroup('Text size'); for (let v = 17; v <= 22; v++) { sizeIn.value = String(v); write(setFm(shown, 'size', String(v)), 'Text size', 'settings'); await wait(90); } h.closeGroup(); render(); say('Six writes during the drag, <b>one step</b>.'); } },
				{ t: 'A command is one step', d: 'Fix all makes two edits in one batch. One undo takes both back.', api: 'batch(label, fn)', run: async () => { reset(); $('#fixBtn').click(); await wait(900); undo(); } },
				{ t: 'A rewrite is labeled', d: 'An AI action tightens a section and a move reorders two. Each is one step with its own label and origin on the thread.', api: 'commit({ label, origin })', run: async () => { reset(); tighten(0); await wait(600); move(1, 1); await wait(600); undo(); } },
				{ t: 'Redo is not a trap door', d: 'Undo two steps, then type: the redo branch is gone from the thread, but Filo kept one automatic mark for it. Restore it from Versions.', api: 'auto mark · restore(id)', run: async () => { reset(); themeSel.value = 'carbone'; themeSel.dispatchEvent(new Event('change')); await wait(400); numSw.click(); await wait(400); undo(); await wait(400); undo(); await wait(500); await typeAt('river trip', '!'); say('The redo branch was dropped, and <b>kept as a mark</b>: see Versions.'); } },
				{ t: 'A version is a name, not a copy', d: 'Save a version, change things, and restore it. The restore is one more step, so it can be undone too. Compare the two byte counters.', api: 'mark(label) · restore(id)', run: async () => { reset(); $('#markBtn').click(); await wait(400); tighten(1); await wait(400); themeSel.value = 'cuoio'; themeSel.dispatchEvent(new Event('change')); await wait(600); const m = h.marks().find((x) => !x.auto); if (m) (marksEl.querySelector(`[data-restore="${m.id}"]`) as HTMLButtonElement)?.click(); } },
				{ t: 'An outside change stops the undo', d: 'Change the document outside the history, as another tab or a file on disk would. The first undo records that change as a step; only the next one undoes it.', api: 'sync(text) · gap step', run: async () => { reset(); themeSel.value = 'cuoio'; themeSel.dispatchEvent(new Event('change')); await wait(400); $('#outsideBtn').click(); await wait(900); undo(); } },
			];
			const beatsEl = $('#beats');
			beatsEl.innerHTML = BEATS.map((b, i) => `<button class="beat" type="button" data-beat="${i}"><span class="n">${i + 1}</span><span><span class="bt">${b.t}</span><span class="bd">${b.d}</span><span class="api">${b.api}</span></span></button>`).join('');
			let running = false;
			async function play(i: number) {
				for (const el of beatsEl.querySelectorAll('.beat')) el.setAttribute('aria-current', String(el.getAttribute('data-beat') === String(i)));
				await BEATS[i].run();
			}
			beatsEl.addEventListener('click', async (e) => {
				const b = (e.target as HTMLElement).closest<HTMLElement>('.beat');
				if (!b || running) return;
				running = true;
				try { await play(Number(b.dataset.beat)); } finally { running = false; }
			});
			$('#tourBtn').addEventListener('click', async () => {
				if (running) return;
				running = true;
				try { for (let i = 0; i < BEATS.length; i++) { await play(i); await wait(1800); } } finally { running = false; }
			});
		</script>
	</body>
</html>
