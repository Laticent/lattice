---
import LibraryTheme from '../../../components/LibraryTheme.astro';
// Fuoco — a standalone, framework-free showcase driven by the REAL library (docs/src/lib/fuoco,
// the `@laticent/fuoco` workspace). One document, four independent views — an editor, an
// outline, a rendered view and a minimap — that never call each other: each reports to one
// focus hub and reacts to what it publishes. A domain switch re-runs the same four views over a
// Markdown document, a timed transcript and a code file, each through the library's own
// plain-text outliner, because the point is that the hub knows nothing about what a document
// is. A live log and counters show every publication, its origin and cause, and what each lane
// delivered. A guided storyboard walks the guarantees. Reached at /libraries/fuoco/; its Learn
// page is /libraries/fuoco/learn/ (src/content/catalog/), which carries the code, the guarantees
// and the measurements this page used to.
import DemoBar from '../../../components/catalog/DemoBar.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Fuoco — one focus for every view</title>
		<link rel="icon" href="/fuoco-mark-min.svg" type="image/svg+xml" />
		<LibraryTheme lib="fuoco" />
		<!-- Global (unscoped): the views, the log and the beats are built in JS at runtime, so
		     Astro's element-scoped hashes would never match them. -->
		<style is:global>
			* { box-sizing: border-box; }
			body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans);
				line-height: 1.5; -webkit-font-smoothing: antialiased; padding: clamp(16px, 4vw, 48px); }
			.wrap { max-width: 1120px; margin: 0 auto; }
			header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
			.brand { display: flex; align-items: center; gap: 13px; }
			.brand .logo { width: 46px; height: 46px; flex-shrink: 0; }
			.logo .t-pri { stroke: var(--accent); }
			.logo .t-warm { stroke: var(--glow); }
			.logo .t-hub { fill: var(--accent); }
			.logo .t-halo { fill: var(--paper); }
			.logo .t-ring { stroke: var(--ring); }
			.home { color: var(--muted); text-decoration: none; font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 5px; }
			.home:hover { color: var(--accent); }
			.home svg, .theme svg { width: 12px; height: 12px; }
			h1 { font-family: var(--stage-serif); font-size: clamp(28px, 5vw, 40px); font-weight: 600; margin: 0; letter-spacing: -.01em; }
			h2 { font-family: var(--stage-serif); font-size: 21px; font-weight: 600; margin: 0; }
			.tag { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent);
				border: 1px solid var(--accent); padding: 3px 8px; border-radius: 999px; font-weight: 600; white-space: nowrap; }
			.sub { color: var(--muted); font-size: 15px; max-width: 74ch; margin: 10px 0 0; }
			.sub b { color: var(--ink); font-weight: 600; }
			.theme { background: none; border: 1px solid var(--line); color: var(--muted); border-radius: 999px; font-size: 11px;
				padding: 5px 11px; cursor: pointer; font-family: var(--sans); display: inline-flex; align-items: center; gap: 6px; }
			.theme:hover { color: var(--accent); border-color: var(--accent); }
			.promise { font-family: var(--stage-serif); font-size: clamp(21px, 3vw, 27px); line-height: 1.3; color: var(--ink); max-width: 34ch; margin: 14px 0 0; text-wrap: balance; }
			section.block { margin-top: 34px; }
			.block-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
			.block-head p { margin: 4px 0 0; color: var(--muted); font-size: 13.5px; max-width: 70ch; }

			/* ── The stage ───────────────────────────────────────────────────── */
			.stage { margin-top: 22px; background: var(--stage); border: 1px solid var(--line); border-radius: 18px;
				box-shadow: var(--shadow); padding: clamp(12px, 2.4vw, 22px); }
			.toolbar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; justify-content: space-between; margin-bottom: 14px; }
			.toolbar .group { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
			.seg { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; background: var(--panel); padding: 3px; gap: 2px; }
			.seg button { border: 0; background: none; color: var(--muted); font-family: var(--sans); font-size: 12.5px; font-weight: 600;
				border-radius: 999px; padding: 6px 12px; cursor: pointer; white-space: nowrap; }
			.seg button[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); }
			.btn { border: 1px solid var(--line); background: var(--panel); color: var(--ink); font-family: var(--sans);
				font-size: 12.5px; font-weight: 600; border-radius: 999px; padding: 7px 13px; cursor: pointer; white-space: nowrap;
				display: inline-flex; align-items: center; gap: 6px; transition: transform .08s ease, border-color .12s ease; }
			.btn:hover { transform: translateY(-1px); border-color: var(--accent); }
			.btn.icon { padding: 7px 11px; }
			.btn svg { width: 12px; height: 12px; }
			.views { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); grid-template-rows: auto auto; gap: 12px; }
			.view { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; display: flex; flex-direction: column; min-width: 0; overflow: hidden; }
			.view-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 12px; border-bottom: 1px solid var(--line); }
			.view-head .name { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); font-weight: 700; display: inline-flex; gap: 7px; align-items: center; }
			.view-head .name i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); display: inline-block; transition: background .15s ease, transform .15s ease; }
			.view-head .name i.lit { background: var(--glow); transform: scale(1.5); }
			.view-head .meta { font-family: var(--mono); font-size: 11px; color: var(--muted); }
			.v-editor { grid-row: span 2; }
			textarea#src { flex: 1; min-height: 430px; width: 100%; resize: none; border: 0; background: transparent; color: var(--ink);
				font-family: var(--mono); font-size: 13px; line-height: 20px; padding: 12px 14px; tab-size: 2; white-space: pre; overflow: auto; }
			textarea#src:focus { outline: none; box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent) 55%, transparent); }
			@media (pointer: coarse) { textarea, input { font-size: max(16px, 1em); } }
			.outline { list-style: none; margin: 0; padding: 8px; overflow: auto; max-height: 190px; display: flex; flex-direction: column; gap: 2px; }
			.outline button { width: 100%; text-align: left; border: 0; background: none; color: var(--ink); font-family: var(--sans);
				font-size: 13px; padding: 4px 8px; border-radius: 7px; cursor: pointer; display: flex; gap: 8px; align-items: baseline; }
			.outline button .n { font-family: var(--mono); font-size: 11px; color: var(--muted); min-width: 22px; }
			.outline button.part { padding-left: 32px; color: var(--muted); }
			.outline button:hover { background: var(--soft); }
			.outline button[aria-current="true"] { background: var(--accent); color: var(--accent-ink); }
			.outline button[aria-current="true"] .n { color: var(--accent-ink); }
			.render { padding: 14px 18px 12px; min-height: 196px; overflow: auto; font-size: 14px; position: relative; }
			.render [data-s] { border-radius: 6px; cursor: pointer; transition: background .12s ease, box-shadow .12s ease; margin: 0; padding: 2px 6px; }
			.render [data-s]:hover { background: var(--soft); }
			.render [data-s].caret { box-shadow: inset 3px 0 0 var(--glow); }
			.render [data-s].picked { background: var(--glow-bg); box-shadow: 0 0 0 1.5px var(--glow); }
			.render .dim { opacity: .38; }
			.render h3 { font-family: var(--stage-serif); font-size: 20px; margin: 0 0 6px; font-weight: 600; }
			.render h4 { font-family: var(--stage-serif); font-size: 16px; margin: 10px 0 4px; font-weight: 600; color: var(--accent); }
			.render p { margin: 2px 0; }
			.render pre { font-family: var(--mono); font-size: 12px; background: var(--stage); padding: 8px 10px !important; overflow: auto; }
			.render .cue { font-family: var(--stage-serif); font-size: 19px; line-height: 1.4; }
			.render .cue .t { font-family: var(--mono); font-size: 12px; color: var(--glow-ink); display: block; margin-bottom: 4px; }
			.render .timeline { display: flex; gap: 4px; margin-top: 16px; }
			.render .timeline span { height: 6px; flex: 1; border-radius: 3px; background: var(--line); }
			.render .timeline span.on { background: var(--glow); }
			.render .code { font-family: var(--mono); font-size: 12.5px; line-height: 1.7; white-space: pre; }
			.render .code .ln { color: var(--muted); display: inline-block; width: 26px; user-select: none; }
			.pager { display: flex; justify-content: center; gap: 6px; padding: 6px 0 10px; min-height: 22px; }
			.pager span { width: 7px; height: 7px; border-radius: 50%; background: var(--line); }
			.pager span.on { background: var(--glow); }
			.minimap { display: flex; flex-wrap: wrap; gap: 6px; padding: 12px; align-items: center; }
			.minimap button { width: 30px; height: 30px; border-radius: 8px; border: 1px solid var(--line); background: var(--panel);
				font-family: var(--mono); font-size: 11px; color: var(--muted); cursor: pointer; }
			.minimap button.first { border-left: 3px solid var(--accent); }
			.minimap button[aria-current="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
			@media (max-width: 860px) {
				.views { grid-template-columns: minmax(0, 1fr); }
				.v-editor { grid-row: auto; }
				textarea#src { min-height: 220px; }
				/* Stacked, the preview sits right under the editor so both are on screen together. */
				.v-preview { order: 1; }
				.v-outline { order: 2; }
				.outline { max-height: 160px; }
			}

			/* ── The wire: what the hub published, and who heard it ────────────── */
			.wire { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 12px; margin-top: 12px; }
			
			.log { list-style: none; margin: 0; padding: 8px 10px; font-family: var(--mono); font-size: 12px; min-height: 196px; max-height: 196px; overflow: hidden; }
			@media (max-width: 860px) {
				.wire { grid-template-columns: minmax(0, 1fr); }
				.log { min-height: 0; max-height: 150px; }
				.wire .view-head .meta { display: none; }
			}
			.log li { display: grid; grid-template-columns: 38px 76px 64px 1fr; gap: 8px; padding: 3px 4px; border-radius: 6px; white-space: nowrap; }
			.log li:first-child { background: var(--soft); }
			.log .seq { color: var(--muted); }
			.log .org { color: var(--accent); font-weight: 700; overflow: hidden; text-overflow: ellipsis; }
			.log .cause { color: var(--glow-ink); }
			.log .where { color: var(--ink); overflow: hidden; text-overflow: ellipsis; }
			.log li.drop .cause, .log li.drop .where { color: var(--muted); text-decoration: line-through; }
			.stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; padding: 10px; }
			.stat { border: 1px solid var(--line); border-radius: 10px; padding: 8px 10px; }
			.stat .k { font-size: 11px; color: var(--muted); display: block; }
			.stat .v { font-family: var(--mono); font-size: 18px; font-weight: 700; }
			.stat.hot .v { color: var(--glow-ink); }
			.diag { margin: 10px 2px 0; font-size: 13px; color: var(--muted); min-height: 20px; }
			.diag b { color: var(--ink); }

			/* ── Storyboard ───────────────────────────────────────────────────── */
			.beats { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px; }
			.beat { text-align: left; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); padding: 14px 15px;
				cursor: pointer; display: flex; gap: 12px; align-items: flex-start; transition: border-color .12s ease, transform .08s ease; font-family: var(--sans); color: var(--ink); }
			.beat:hover { transform: translateY(-2px); border-color: var(--accent); }
			.beat[aria-current="true"] { border-color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 16%, transparent); }
			.beat .n { flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: var(--stage); border: 1px solid var(--line);
				color: var(--accent); font-family: var(--mono); font-size: 12px; font-weight: 700; display: grid; place-items: center; }
			.beat[aria-current="true"] .n { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
			.beat .bt { display: block; font-size: 14px; font-weight: 600; margin: 0 0 2px; }
			.beat .bd { font-size: 12.5px; color: var(--muted); margin: 0 0 4px; line-height: 1.45; }
			.beat .api { font-family: var(--mono); font-size: 11px; color: var(--accent); overflow-wrap: anywhere; }

			.foot { margin-top: 34px; color: var(--muted); font-size: 12px; line-height: 1.7; border-top: 1px solid var(--line); padding-top: 16px; }
			.foot code { overflow-wrap: anywhere; font-family: var(--mono); background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; }
			.foot a { color: var(--accent); }
			:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
		</style>
	</head>
	<body>
		<div class="wrap">
			<DemoBar slug="fuoco" />
			<header>
				<div class="brand">
					<!-- The mark, inline so it follows this page's theme toggle as well as the OS
					     (docs/public/fuoco-mark.svg is the same geometry): a viewfinder's focus
					     brackets around the family's ringed hub, the focused line either side. -->
					<svg class="logo" viewBox="0 0 128 128" fill="none" aria-hidden="true">
						<g stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round">
							<path class="t-pri" d="M14 38 L14 14 L38 14" /><path class="t-pri" d="M90 14 L114 14 L114 38" />
							<path class="t-pri" d="M114 90 L114 114 L90 114" /><path class="t-pri" d="M38 114 L14 114 L14 90" />
						</g>
						<g stroke-width="7.3" stroke-linecap="round"><path class="t-warm" d="M26 64 L44 64" /><path class="t-warm" d="M84 64 L102 64" /></g>
						<circle cx="64" cy="64" r="15" class="t-halo" /><circle cx="64" cy="64" r="12.2" class="t-hub" />
						<circle cx="64" cy="64" r="7.6" class="t-ring" stroke-width="1.8" opacity="0.6" />
					</svg>
					<h1>Fuoco</h1><span class="tag">Library</span>
				</div>
				<div style="display:flex; gap:14px; align-items:center;">
					<button class="theme" id="themeBtn" type="button"><svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4.8" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M6 1.2 A4.8 4.8 0 0 1 6 10.8 Z" fill="currentColor" /></svg>theme</button>
				</div>
			</header>
			<p class="promise">Every view of a document agrees on where the reader is.</p>
			<p class="sub">Below are four views of one document: an <b>editor</b>, an <b>outline</b>, a <b>preview</b> and a <b>minimap</b>. None of them calls another; each reports to one Fuoco hub. <b>Click a line in the editor</b> and watch the other three follow, then <b>pick a heading in the outline</b>. Switch to a <b>transcript</b> or a <b>code file</b>: the same four views work unchanged. The log shows every move, who made it, and who heard it.</p>

			<div class="stage">
				<div class="toolbar">
					<div class="group">
						<div class="seg" id="domainSeg" role="group" aria-label="Document">
							<button type="button" data-d="doc" aria-pressed="true">Markdown doc</button>
							<button type="button" data-d="transcript" aria-pressed="false">Transcript</button>
							<button type="button" data-d="code" aria-pressed="false">Code file</button>
						</div>
						<div class="seg" id="pageSeg" role="group" aria-label="Preview pages">
							<button type="button" data-p="off" aria-pressed="true">One page</button>
							<button type="button" data-p="on" aria-pressed="false">Paginate</button>
						</div>
					</div>
					<div class="group">
						<button class="btn icon" type="button" id="prevBtn" aria-label="Previous (step)"><svg viewBox="0 0 12 12" fill="none"><path d="M7.5 2.5 L4 6 L7.5 9.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
						<button class="btn icon" type="button" id="nextBtn" aria-label="Next (step)"><svg viewBox="0 0 12 12" fill="none"><path d="M4.5 2.5 L8 6 L4.5 9.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
						<button class="btn" type="button" id="insertBtn">Insert &amp; go</button>
						<button class="btn" type="button" id="lateBtn">Late report</button>
						<button class="btn" type="button" id="burstBtn">Held key</button>
					</div>
				</div>
				<div class="views">
					<div class="view v-editor">
						<div class="view-head"><span class="name"><i data-for="editor"></i>Editor</span><span class="meta" id="editorMeta"></span></div>
						<textarea id="src" spellcheck="false" wrap="off" aria-label="Document source"></textarea>
					</div>
					<div class="view v-outline">
						<div class="view-head"><span class="name"><i data-for="outline"></i>Outline</span><span class="meta" id="outlineMeta"></span></div>
						<ul class="outline" id="outline" aria-label="Outline"></ul>
					</div>
					<div class="view v-preview">
						<div class="view-head"><span class="name"><i data-for="preview"></i>Preview</span><span class="meta" id="previewMeta"></span></div>
						<div class="render" id="preview" aria-live="off"></div>
						<div class="pager" id="pager" aria-hidden="true"></div>
					</div>
				</div>
				<div class="wire">
					<div class="view">
						<div class="view-head"><span class="name">The hub, publishing</span><span class="meta">seq · origin · cause · where</span></div>
						<ol class="log" id="log" aria-label="Publications"></ol>
					</div>
					<div class="view">
						<div class="view-head"><span class="name"><i data-for="minimap"></i>Minimap</span><span class="meta" id="mapMeta"></span></div>
						<div class="minimap" id="minimap" aria-label="Minimap"></div>
						<div class="stats" id="stats"></div>
					</div>
				</div>
				<p class="diag" id="diag" role="status" aria-live="polite">Click anywhere in the editor, the outline, the preview or the minimap. The other three follow.</p>
			</div>

			<section class="block" aria-labelledby="sb">
				<div class="block-head">
					<div><h2 id="sb">The storyboard</h2><p>Each beat drives the stage above through the public API it names.</p></div>
					<button class="btn" type="button" id="tourBtn">Play all seven</button>
				</div>
				<div class="beats" id="beats"></div>
			</section>

			<p class="foot">This page runs the real library in your browser. <a href="/libraries/fuoco/learn/">Learn how Fuoco works, and how to use it →</a></p>
		</div>

		<script>
			import { byHeadings, byPattern, createFocusHub, createTextOutliner, type Focus, type FocusHub, type Outline, type Outliner, partCount, revealOffset } from '@/lib/fuoco';

			const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector(s) as T;
			const root = document.documentElement;
			const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);

			// ── Theme (the key the docs site uses; `system` follows the OS) ──
			const THEME_LS = 'lattice-docs-mode';
			const osDark = () => matchMedia('(prefers-color-scheme: dark)').matches;
			const applyTheme = (t: string | null) => { if (t === 'light' || t === 'dark') root.setAttribute('data-theme', t); else root.removeAttribute('data-theme'); };
			try { const t = localStorage.getItem(THEME_LS); applyTheme(t === 'light' || t === 'dark' ? t : osDark() ? 'dark' : 'light'); } catch { /* storage blocked */ }
			$('#themeBtn').addEventListener('click', () => {
				const cur = root.getAttribute('data-theme') || (osDark() ? 'dark' : 'light');
				const next = cur === 'dark' ? 'light' : 'dark';
				applyTheme(next);
				try { localStorage.setItem(THEME_LS, next); } catch { /* storage blocked */ }
			});

			// ── Three documents, three outliners — the hub is the same for all of them ──
			const DOC = `# Fuoco

One focus for every view of a document.

## The problem

An editor, an outline and a preview each need to know where the reader is.

## The idea

Views report facts and ask for moves. The hub decides, and tells the others.

# Using it

Create one hub per document, with an outliner that says what a unit is.

## Report

The editor reports its text and its caret, nothing more.

## Subscribe

Each view selects what it shows, and a lane to hear it on.

## Navigate

An outline click is a move: \`hub.go('outline', target)\`.

# Guarantees

No echoes, no stale answers, no re-entry, no timers.

## Origins

A view never hears its own moves.

## Revisions

A report against older text is dropped.
`;
			const TRANSCRIPT = `[00:00] Welcome back. Today: why views drift apart.
[00:14] Every editor ends up with a preview, a rail, an outline.
[00:31] Each one tracks where the reader is, on its own.
[00:52] And each keeps a little memory of what it last told the others.
[01:10] Those memories go stale, and the views stop agreeing.
[01:33] The fix is one place that holds the focus.
[01:55] Views report what they know, and ask for moves.
[02:20] The hub answers, once, and everyone hears it.
`;
			const CODE = `import { createFocusHub } from '@laticent/fuoco';

export function mountEditor(hub, el) {
  el.addEventListener('input', () => hub.update(el.value, { by: 'editor' }));
  el.addEventListener('keyup', () => report(hub, el));
}

function report(hub, el) {
  hub.report('editor', { head: el.selectionStart });
}

export function mountOutline(hub, list) {
  hub.subscribe((f) => f.flat, (flat) => highlight(list, flat), { lane: 'frame' });
}

function highlight(list, flat) {
  list.querySelectorAll('li').forEach((li, i) => li.classList.toggle('on', i === flat));
}

