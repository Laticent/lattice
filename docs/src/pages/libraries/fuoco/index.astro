				{ id: 'page', t: 'Page, then part, then unit', d: 'With pagination on, “next” turns the preview’s pages first, then moves on — the order a reader pages a document.', api: "hub.pages('preview', …) · hub.step('keys', 'next')",
					run: () => { mount('doc'); setPaginate(true); hub.go('outline', { unitIndex: 1, part: 0 }); for (let i = 1; i <= 5; i++) after(i * 700, () => step('next')); after(4000, () => say('Each step turned a page while the part had pages left, then moved to the next part.')); } },
				{ id: 'insert', t: 'Insert, then go there', d: 'Ask for a unit that does not exist yet; the hub waits for exactly that text.', api: 'hub.go(origin, target, { after: text })', run: () => { mount('doc'); setPaginate(false); after(300, insertAndGo); } },
				{ id: 'late', t: 'A late report changes nothing', d: 'A report computed against older text is dropped instead of moving everyone to the wrong place.', api: "hub.report('worker', { head, rev })", run: () => { mount('transcript'); after(400, lateReport); } },
				{ id: 'held', t: 'A held key costs one render a frame', d: 'Fifty caret moves in a dozen frames: the preview renders on the frame lane, latest focus only.', api: "subscribe(select, fn, { lane: 'frame' })", run: () => { mount('code'); after(300, heldKey); } },
			];
			const beatsEl = $('#beats');
			function setCurrent(id: string | null) { [...beatsEl.children].forEach((b) => b.setAttribute('aria-current', String((b as HTMLElement).dataset.id === id))); }
			BEATS.forEach((b, i) => {
				const btn = document.createElement('button');
				btn.className = 'beat'; btn.type = 'button'; btn.dataset.id = b.id;
				btn.innerHTML = `<span class="n">${i + 1}</span><span><span class="bt">${b.t}</span><p class="bd">${b.d}</p><span class="api">${esc(b.api)}</span></span>`;
				btn.addEventListener('click', () => { stopTour(); clearTimers(); setCurrent(b.id); b.run(); });
				beatsEl.appendChild(btn);
			});
			let tourTimer = 0;
			const tourBtn = $('#tourBtn');
			function stopTour() { if (!tourTimer) return; clearInterval(tourTimer); tourTimer = 0; clearTimers(); tourBtn.textContent = 'Play all seven'; }
			tourBtn.addEventListener('click', () => {
				if (tourTimer) { stopTour(); return; }
				let i = 0; tourBtn.textContent = 'Stop the tour';
				const next = () => { if (i >= BEATS.length) { stopTour(); return; } clearTimers(); const b = BEATS[i++]; setCurrent(b.id); b.run(); };
				next();
				tourTimer = window.setInterval(next, 5200);
			});

			mount('doc');
		</script>
	</body>
</html>
