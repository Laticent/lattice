---
import LibraryTheme from '../../../components/LibraryTheme.astro';
// Lastra — a standalone showcase driven by the REAL library (docs/src/lib/lastra, the `@laticent/lastra`
// workspace, and its `/decode` subpath). A picture goes through the pipeline Lattice's exports use: read the
// header, strip the metadata, decode, turn upright, resize with Lanczos-3, encode a JPEG; then Lattice's own
// `images: optimized` thresholds say what its export would do with the file (docs/src/lib/lastra-demo.ts). The
// three samples are examples/media's, the pictures Lattice's old header readers got wrong. A reader's own
// file stays in the page. Reached at /libraries/lastra/; its Learn page is /libraries/lastra/learn/.
import DemoBar from '../../../components/catalog/DemoBar.astro';
import { EDGES, LATTICE } from '../../../lib/lastra-demo';
import canoe from '../../../../../examples/media/canoe.jpg?url';
import mug from '../../../../../examples/media/mug-exif-after-frame.jpg?url';
import turnedPng from '../../../../../examples/media/canoe-turned.png?url';

const SAMPLES = [
	{ id: 'canoe', url: canoe, name: 'canoe.jpg', label: 'A photo' },
	{ id: 'mug', url: mug, name: 'mug-exif-after-frame.jpg', label: 'Turned, EXIF after the frame' },
	{ id: 'png', url: turnedPng, name: 'canoe-turned.png', label: 'A turned PNG' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Lastra — one image library, the same answer everywhere</title>
		<link rel="icon" href="/lastra-mark-min.svg" type="image/svg+xml" />
		<LibraryTheme lib="lastra" />
		<style is:global>
			* { box-sizing: border-box; }
			body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); line-height: 1.5;
				-webkit-font-smoothing: antialiased; padding: clamp(16px, 4vw, 48px); }
			.wrap { max-width: 1040px; margin: 0 auto; }
			.brand { display: flex; align-items: center; gap: 13px; margin-top: 14px; }
			.brand img { width: 46px; height: 46px; }
			h1 { font-family: var(--stage-serif); font-size: clamp(28px, 5vw, 40px); font-weight: 600; margin: 0; letter-spacing: -.01em; }
			h2 { font-family: var(--stage-serif); font-size: 21px; font-weight: 600; margin: 0; }
			.promise { font-family: var(--stage-serif); font-size: clamp(21px, 3vw, 27px); line-height: 1.3; max-width: 34ch; margin: 14px 0 0; text-wrap: balance; }
			.sub { color: var(--muted); font-size: 15px; max-width: 72ch; margin: 10px 0 0; }
			code { font-family: var(--mono); font-size: .92em; }
			.head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 16px; margin-top: 30px; }
			.head p { color: var(--muted); font-size: 13px; margin: 0; }

			.picks { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
			.chip { border: 1px solid var(--line); background: var(--panel); color: var(--ink); font: inherit; font-size: 13.5px; font-weight: 600;
				border-radius: 999px; padding: 8px 15px; cursor: pointer; }
			.chip:hover { border-color: var(--accent); }
			.chip[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
			.chip:focus-visible, .ctl:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			.file { position: relative; }
			.file input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; }
			.file:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
			.private { color: var(--muted); font-size: 12.5px; }

			.stagebox { margin-top: 12px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; background: var(--stage);
				border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow); padding: clamp(12px, 2.4vw, 20px); }
			.pane { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
			.label { font-size: 12px; color: var(--muted); letter-spacing: .02em; display: flex; justify-content: space-between; gap: 8px; }
			.label b { color: var(--ink); font-weight: 600; font-family: var(--mono); font-size: 11.5px; overflow-wrap: anywhere; text-align: right; }
			.frame { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; aspect-ratio: 16 / 10; display: grid; place-items: center;
				overflow: hidden; padding: 8px; }
			.frame img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; border-radius: 4px; }
			.frame .none { color: var(--muted); font-size: 13px; text-align: center; padding: 12px; }

			dl.facts { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 0; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
			dl.facts dt, dl.facts dd { margin: 0; padding: 7px 12px; font-size: 13px; border-top: 1px solid var(--line); }
			dl.facts dt:first-of-type, dl.facts dt:first-of-type + dd { border-top: 0; }
			dl.facts dt { color: var(--muted); }
			dl.facts dd { font-family: var(--mono); font-size: 12.5px; overflow-wrap: anywhere; }
			dl.facts dd .warn { color: var(--glow); font-family: var(--sans); font-weight: 600; }

			.controls { display: grid; grid-template-columns: auto 1fr auto; gap: 8px 12px; align-items: center; background: var(--panel);
				border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; font-size: 13px; }
			.controls .k { color: var(--muted); }
			.edges { display: flex; flex-wrap: wrap; gap: 6px; grid-column: 2 / 4; }
			.edges button { border: 1px solid var(--line); background: var(--paper); color: var(--ink); font: inherit; font-size: 12.5px; font-family: var(--mono);
				border-radius: 999px; padding: 4px 11px; cursor: pointer; }
			.edges button[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
			.edges button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			input[type="range"] { accent-color: var(--accent); width: 100%; min-width: 0; }
			.q { font-family: var(--mono); font-weight: 600; min-width: 2.5ch; text-align: right; }

			.verdict { border-radius: 12px; padding: 11px 14px; font-size: 13.5px; background: var(--panel); border: 1px solid var(--line); border-left: 4px solid var(--accent); }
			.verdict[data-kind="keep"] { border-left-color: var(--glow); }
			.verdict b { font-weight: 600; }
			.verdict small { display: block; color: var(--muted); font-size: 12px; margin-top: 3px; }

			.stats { margin-top: 14px; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
			.stat { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; }
			.stat b { display: block; font-family: var(--mono); font-size: 20px; font-weight: 600; color: var(--accent); }
			.stat span { font-size: 12px; color: var(--muted); }
			.note { color: var(--muted); font-size: 13px; max-width: 78ch; margin-top: 16px; }
			@media (max-width: 760px) { .stagebox { grid-template-columns: 1fr; } }
		</style>
	</head>
	<body>
		<div class="wrap">
			<DemoBar slug="lastra" />
			<div class="brand">
				<img src="/lastra-mark.svg" alt="" />
				<h1>Lastra</h1>
			</div>
			<p class="promise">Read, clean, resize and re-encode a picture, the same in every engine.</p>
			<p class="sub">
				Everything below runs on the real <code>@laticent/lastra</code>, in this tab, in plain JavaScript: no canvas and no
				browser encoder. Pick a picture and watch it go through the pipeline Lattice's exports use.
			</p>

			<div class="head">
				<h2>Pick a picture</h2>
				<p>Two of these fooled Lattice's old header readers.</p>
			</div>
			<div class="picks" id="picks">
				{SAMPLES.map((s, i) => (
					<button class="chip" type="button" data-url={s.url} data-name={s.name} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label}</button>
				))}
				<label class="chip file">Your own file…<input type="file" id="file" accept="image/*" aria-label="Your own picture" /></label>
				<span class="private">Your file stays in this tab.</span>
			</div>

			<div class="stagebox">
				<div class="pane">
					<span class="label">What the header says <b id="name"></b></span>
					<div class="frame" id="orig"><span class="none">Loading…</span></div>
					<dl class="facts" id="facts" aria-live="polite"></dl>
				</div>
				<div class="pane">
					<span class="label">Lastra's JPEG <b id="outsize"></b></span>
					<div class="frame" id="out"><span class="none">Decoding…</span></div>
					<div class="controls">
						<span class="k" id="edge-label">Long edge</span>
						<div class="edges" id="edges" role="group" aria-labelledby="edge-label">
							{EDGES.map((e) => (
								<button type="button" data-edge={e} aria-pressed={e === 640 ? 'true' : 'false'}>{e}{e === LATTICE.maxEdge ? ' (Lattice)' : ''}</button>
							))}
						</div>
						<label class="k" for="q">Quality</label>
						<input class="ctl" id="q" type="range" min="10" max="100" step="1" value={LATTICE.quality} />
						<span class="q" id="qv">{LATTICE.quality}</span>
					</div>
					<div class="verdict" id="verdict" aria-live="polite"></div>
				</div>
			</div>

			<div class="stats">
				<div class="stat"><b id="s-read">0</b><span>ms to read the header</span></div>
				<div class="stat"><b id="s-clean">0</b><span>ms to strip the metadata</span></div>
				<div class="stat"><b id="s-decode">0</b><span>ms to decode, in JavaScript</span></div>
				<div class="stat"><b id="s-encode">0</b><span>ms to resize and encode</span></div>
			</div>
			<p class="note">
				The first picture is the file as your browser paints it; the second is the JPEG Lastra wrote, decoded and
				turned upright by Lastra first. The verdict uses Lattice's own thresholds for <code>images: optimized</code>,
				with the long edge and quality you set here. Lastra decodes PNG and JPEG; for any other format it still reads
				the header, and cleans GIF and WebP.
			</p>
		</div>

		<script>
			import { cleanerFor, imageFormat, readImage } from '@laticent/lastra';
			import { decodeUpright, kb, readPicture, recode, verdict } from '../../../lib/lastra-demo';

			const $ = (id) => document.getElementById(id);
			const chips = [...document.querySelectorAll('#picks button.chip')];
			const edges = [...document.querySelectorAll('#edges button')];
			let bytes = null;
			let reading = null;
			let pixels = null;
			let edge = 640;
			let run = 0;
			const urls = { orig: '', out: '' };

			const ms = (t0) => (performance.now() - t0).toFixed(1);
			const yesNo = (b) => (b ? 'yes' : 'no');
			function show(slot, data, type, alt) {
				if (urls[slot]) URL.revokeObjectURL(urls[slot]);
				const frame = $(slot);
				frame.replaceChildren();
				if (!data) return;
				urls[slot] = URL.createObjectURL(new Blob([data], { type }));
				const img = document.createElement('img');
				img.src = urls[slot];
				img.alt = alt;
				frame.append(img);
			}
			function note(slot, text) {
				const span = document.createElement('span');
				span.className = 'none';
				span.textContent = text;
				$(slot).replaceChildren(span);
			}
			function facts(rows) {
				const dl = $('facts');
				dl.replaceChildren();
				for (const [k, v, warn] of rows) {
					const dt = document.createElement('dt');
					dt.textContent = k;
					const dd = document.createElement('dd');
					if (warn) {
						const w = document.createElement('span');
						w.className = 'warn';
						w.textContent = v;
						dd.append(w);
					} else dd.textContent = v;
					dl.append(dt, dd);
				}
			}

			async function load(data, name) {
				const mine = ++run;
				bytes = data;
				pixels = null;
				delete document.body.dataset.done;
				$('s-decode').textContent = '–';
				$('s-encode').textContent = '–';
				$('name').textContent = name;
				reading = readPicture(bytes);
				const { info, painted, agreed, cleaned } = reading;
				// The two header-only steps, timed one at a time.
				let t0 = performance.now();
				readImage(bytes);
				$('s-read').textContent = ms(t0);
				const clean = info ? cleanerFor(info.mime) : null;
				t0 = performance.now();
				clean?.(bytes);
				$('s-clean').textContent = clean ? ms(t0) : '–';
				if (!info) {
					const fmt = imageFormat(bytes);
					facts([['Format', fmt ? `${fmt.toUpperCase()}, with no pixel size in its header` : 'not a picture lastra can read', true], ['Bytes', kb(bytes.length)]]);
					note('orig', 'lastra could not read this file’s header.');
					note('out', 'Nothing to decode.');
					$('outsize').textContent = '';
					drawVerdict();
					return;
				}
				show('orig', bytes, info.mime, `${name}, as your browser paints it`);
				const rows = [
					['Format', `${info.format.toUpperCase()} · ${info.mime}`],
					['Stored size', `${info.width} × ${info.height}`],
					['Painted size', `${painted.width} × ${painted.height}`],
					['Transparency', info.alpha ? 'possible' : 'none'],
					['EXIF turn', info.orientation === 1 ? '1 (upright)' : `${info.orientation} (turned or flipped)`],
					['Every engine turns it', yesNo(agreed), !agreed && info.orientation > 1],
					['Bytes', kb(bytes.length)],
					['Without metadata', cleaned ? (cleaned.length === bytes.length ? `${kb(cleaned.length)} (nothing to strip)` : `${kb(cleaned.length)} (−${kb(bytes.length - cleaned.length)})`) : 'no cleaner for this format'],
				];
				facts(rows);
				note('out', 'Decoding…');
				t0 = performance.now();
				try {
					const px = await decodeUpright(bytes, info);
					if (mine !== run) return;
					$('s-decode').textContent = ms(t0);
					if (!px) {
						note('out', `Lastra decodes PNG and JPEG; this is ${info.format.toUpperCase()}.`);
						$('outsize').textContent = '';
						drawVerdict();
						return;
					}
					pixels = px;
					encode();
				} catch (e) {
					if (mine !== run) return;
					note('out', `Lastra refused it: ${e?.code ?? e?.message ?? e}`);
					$('outsize').textContent = '';
					drawVerdict();
				}
			}

			function encode() {
				if (!pixels || !reading?.info) return drawVerdict();
				const q = Number($('q').value);
				const t0 = performance.now();
				const out = recode(pixels, reading.info, bytes.length, edge, q);
				$('s-encode').textContent = ms(t0);
				show('out', out.jpeg, 'image/jpeg', `The JPEG Lastra wrote, ${out.width} by ${out.height} at quality ${q}`);
				const pct = Math.round((out.jpeg.length / bytes.length) * 100);
				$('outsize').textContent = `${out.width} × ${out.height} · ${kb(out.jpeg.length)} (${pct}%)`;
				drawVerdict(out);
			}

			function drawVerdict(out) {
				const el = $('verdict');
				el.replaceChildren();
				const q = Number($('q').value);
				const { plan, reason } = verdict(reading?.info ?? null, bytes?.length ?? 0, edge, q);
				const head = document.createElement('b');
				const small = document.createElement('small');
				if (plan) {
					el.dataset.kind = 'recode';
					head.textContent = `Lattice's export would re-encode it: ${plan.width} × ${plan.height} JPEG at ${plan.quality}.`;
					small.textContent = out ? (out.accepted ? 'And it keeps the result: the JPEG above is small enough.' : 'But it keeps the original: the JPEG above is not small enough to be worth it.') : '';
				} else {
					el.dataset.kind = 'keep';
					head.textContent = 'Lattice’s export keeps this file as it is.';
					const share = out && bytes ? ` The JPEG above is ${Math.round((out.jpeg.length / bytes.length) * 100)}% of the original, which Lattice would ${out.accepted ? 'keep' : 'throw away'} if it had made it.` : '';
					small.textContent = `Because ${reason}.${share}`;
				}
				el.append(head, small);
				document.body.dataset.done = $('name').textContent;
			}

			async function pick(chip) {
				for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
				const res = await fetch(chip.dataset.url);
				load(new Uint8Array(await res.arrayBuffer()), chip.dataset.name);
			}
			for (const c of chips) c.addEventListener('click', () => pick(c));
			$('file').addEventListener('change', async (ev) => {
				const f = ev.target.files?.[0];
				if (!f) return;
				for (const c of chips) c.setAttribute('aria-pressed', 'false');
				load(new Uint8Array(await f.arrayBuffer()), f.name);
			});
			for (const b of edges) {
				b.addEventListener('click', () => {
					edge = Number(b.dataset.edge);
					for (const o of edges) o.setAttribute('aria-pressed', String(o === b));
					encode();
				});
			}
			let timer = 0;
			$('q').addEventListener('input', () => {
				$('qv').textContent = $('q').value;
				clearTimeout(timer);
				timer = setTimeout(encode, 60);
			});
			pick(chips[0]);
		</script>
	</body>
</html>
