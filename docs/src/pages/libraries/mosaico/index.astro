---
// Mosaico — a standalone, framework-free showcase driven by the REAL library (docs/src/lib/mosaico,
// the `@laticent/mosaico` workspace). It shows the library, not Lattice's layouts: two panels, one
// per strategy — `tree` packs up to six boxes of any shape into a container you pick, and `rows`
// lays out a list of boxes you can flip between equal cells and equal area, with the area spread
// measured beside it. Collage and logo-wall are named once each, as the Lattice layouts built on them. Reached
// at /libraries/mosaico/; its Learn page is /libraries/mosaico/learn/ (src/content/catalog/).
import DemoBar from '../../../components/catalog/DemoBar.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Mosaico — every box keeps its shape</title>
		<link rel="icon" href="/mosaico-mark-min.svg" type="image/svg+xml" />
		<style is:global>
			:root {
				--paper: #f5f5ef; --stage: #ecede3; --ink: #1d2112; --muted: #5d6350; --line: #dcdfcf;
				--accent: #4f5f00; --accent-ink: #fff; --glow: #034e64; --glow-bg: #d4eef5;
				--panel: #fbfbf7; --tile: #e2e8c9; --tile-ink: #384300;
				--mark-warm: #0994b9; --ring: #1f2600;
				--shadow: 0 1px 2px rgba(29,33,18,.06), 0 8px 24px rgba(29,33,18,.06);
				--stage-serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
				--sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
				--mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--paper: #11130d; --stage: #191c13; --ink: #e7ebdf; --muted: #9da28e; --line: #2c3022;
					--accent: #a9bf4a; --accent-ink: #151a04; --glow: #8ddefd; --glow-bg: #0d2a33;
					--panel: #161910; --tile: #2e3618; --tile-ink: #e2ecc0;
					--mark-warm: #8ddefd; --ring: #0f1300;
					--shadow: 0 1px 2px rgba(0,0,0,.4), 0 10px 30px rgba(0,0,0,.35);
				}
			}
			:root[data-theme="light"] {
				--paper: #f5f5ef; --stage: #ecede3; --ink: #1d2112; --muted: #5d6350; --line: #dcdfcf;
				--accent: #4f5f00; --accent-ink: #fff; --glow: #034e64; --glow-bg: #d4eef5;
				--panel: #fbfbf7; --tile: #e2e8c9; --tile-ink: #384300;
				--mark-warm: #0994b9; --ring: #1f2600;
			}
			:root[data-theme="dark"] {
				--paper: #11130d; --stage: #191c13; --ink: #e7ebdf; --muted: #9da28e; --line: #2c3022;
				--accent: #a9bf4a; --accent-ink: #151a04; --glow: #8ddefd; --glow-bg: #0d2a33;
				--panel: #161910; --tile: #2e3618; --tile-ink: #e2ecc0;
				--mark-warm: #8ddefd; --ring: #0f1300;
			}
			/* The header mark, drawn inline so it follows the theme toggle (docs/public/mosaico-mark.svg is the same geometry). */
			.logo .t-pri { stroke: var(--accent); }
			.logo .t-warm { stroke: var(--mark-warm); }
			.logo .t-hub { fill: var(--accent); }
			.logo .t-halo { fill: var(--paper); }
			.logo .t-ring { stroke: var(--ring); }
			* { box-sizing: border-box; }
			body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans);
				line-height: 1.5; -webkit-font-smoothing: antialiased; padding: clamp(16px, 4vw, 48px); }
			.wrap { max-width: 920px; margin: 0 auto; }
			header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
			.brand { display: flex; align-items: center; gap: 13px; }
			.brand .logo { width: 46px; height: 46px; flex-shrink: 0; }
			h1 { font-family: var(--stage-serif); font-size: clamp(28px, 5vw, 40px); font-weight: 600; margin: 0; letter-spacing: -.01em; }
			.tag { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent);
				border: 1px solid var(--accent); padding: 3px 8px; border-radius: 999px; font-weight: 600; }
			.promise { font-family: var(--stage-serif); font-size: clamp(21px, 3vw, 27px); line-height: 1.3; max-width: 34ch; margin: 14px 0 0; text-wrap: balance; }
			.sub { color: var(--muted); font-size: 15px; max-width: 64ch; margin: 8px 0 0; }
			.sub b { color: var(--ink); font-weight: 600; }
			.theme { background: none; border: 1px solid var(--line); color: var(--muted); border-radius: 999px; font-size: 11px; padding: 5px 11px; cursor: pointer; font-family: var(--sans); }

			.tabs { display: flex; gap: 8px; margin: 26px 0 0; flex-wrap: wrap; }
			.tab { border: 1px solid var(--line); background: var(--panel); color: var(--ink); font: 600 13px var(--sans);
				border-radius: 999px; padding: 8px 16px; cursor: pointer; }
			.tab[aria-selected="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }

			.stage { margin: 12px 0 0; background: var(--stage); border: 1px solid var(--line); border-radius: 18px;
				box-shadow: var(--shadow); padding: clamp(16px, 4vw, 32px); }
			.controls { display: flex; gap: 10px 18px; flex-wrap: wrap; align-items: center; }
			.group { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
			.group .lbl { font: 600 11px var(--sans); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-right: 2px; }
			.chip { border: 1px solid var(--line); background: var(--panel); color: var(--ink); font: 600 12px var(--mono);
				border-radius: 999px; padding: 6px 11px; cursor: pointer; min-height: 32px; }
			.chip[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 16%, transparent); }
			.chip:disabled { opacity: .4; cursor: default; }
			.slider input { accent-color: var(--accent); width: 104px; margin: 0; }
			.slider output { font: 12px var(--mono); color: var(--ink); min-width: 4.5ch; }

			.frame { margin: 20px auto 0; background: var(--panel); border: 1px dashed var(--line); border-radius: 10px;
				position: relative; width: 100%; max-height: 62vh; overflow: hidden; }
			.frame .box { position: absolute; border: 0; padding: 0; border-radius: 6px; cursor: pointer;
				background: linear-gradient(150deg, var(--tile), color-mix(in srgb, var(--tile) 70%, var(--accent))); color: var(--tile-ink);
				display: grid; place-items: center; font: 600 12px var(--mono); transition: left .25s ease, top .25s ease, width .25s ease, height .25s ease, filter .12s ease; }
			.frame .box:hover { filter: brightness(1.04); }
			.frame .box:disabled { cursor: default; filter: none; }
			@media (max-width: 560px) { .frame .box { font-size: 10px; } }
			.frame .box.warm { background: linear-gradient(150deg, var(--glow-bg), color-mix(in srgb, var(--glow-bg) 70%, var(--glow))); color: var(--glow); }
			.frame .inset { position: absolute; border: 1px dashed color-mix(in srgb, var(--accent) 50%, transparent); border-radius: 4px; pointer-events: none; }
			.frame .cell { position: absolute; border: 1px dashed color-mix(in srgb, var(--muted) 45%, transparent); border-radius: 6px; }
			.stats { margin: 14px 0 0; display: flex; gap: 8px 20px; flex-wrap: wrap; font: 12px var(--mono); color: var(--muted); }
			.stats b { color: var(--ink); font-weight: 600; }
			.note { margin: 10px 0 0; font-size: 13px; color: var(--muted); max-width: 70ch; }
			.panel[hidden] { display: none; }

			.block { margin: 44px 0 0; }
			.block h2 { font-family: var(--stage-serif); font-size: clamp(22px, 3.2vw, 28px); font-weight: 600; margin: 0; letter-spacing: -.005em; }
			.block .lede { color: var(--muted); font-size: 15px; max-width: 64ch; margin: 6px 0 0; }
			.block .lede b { color: var(--ink); font-weight: 600; }
			.block .lede code { font-family: var(--mono); font-size: 13px; }
			.tries { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
			.try { width: 100%; height: 100%; text-align: left; background: var(--panel); border: 1px solid color-mix(in srgb, var(--muted) 70%, var(--line)); border-radius: 12px; padding: 12px 14px; cursor: pointer; color: var(--ink); font: 14px/1.45 var(--sans); }
			.try:hover { border-color: var(--accent); }
			.try b { display: block; font-weight: 600; margin-bottom: 2px; }
			.try span { color: var(--muted); font-size: 13px; }
			pre.css { margin: 16px 0 0; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; font: 12.5px/1.6 var(--mono); color: var(--ink); overflow-x: auto; white-space: pre; }
			pre.css .c { color: var(--muted); }
			.run { display: flex; gap: 10px 14px; align-items: center; flex-wrap: wrap; margin: 16px 0 0; }
			.run .stats { margin: 0; }
			.run .chip { font-family: var(--sans); }
			.cards { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); margin: 16px 0 0; }
			.card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; }
			.card .k { display: block; font-size: 12px; color: var(--muted); }
			.card .v { display: block; font: 600 20px/1.3 var(--mono); margin-top: 2px; }
			.card .d { display: block; font-size: 12.5px; color: var(--muted); margin-top: 4px; }
			.table-wrap { margin: 16px 0 0; overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); }
			table { border-collapse: collapse; width: 100%; font-size: 13.5px; min-width: 560px; }
			th, td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
			tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
			thead th { font: 600 11px var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
			tbody th { font-weight: 600; white-space: nowrap; }
			td.num { font-family: var(--mono); white-space: nowrap; }
			.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
			.note code { font-family: var(--mono); font-size: 12px; background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; }
			.foot { margin-top: 26px; color: var(--muted); font-size: 12px; line-height: 1.7; }
			.foot a { color: var(--accent); }
			:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
		</style>
	</head>
	<body>
		<div class="wrap">
			<DemoBar slug="mosaico" />
			<header>
				<div class="brand">
					<svg class="logo" viewBox="0 0 128 128" fill="none" aria-hidden="true">
						<g stroke-width="6.5" stroke-linejoin="round"><rect x="14" y="14" width="45" height="100" rx="7" class="t-pri" /><rect x="69" y="14" width="45" height="45" rx="7" class="t-warm" /><rect x="69" y="69" width="17.5" height="45" rx="7" class="t-pri" /><rect x="96.5" y="69" width="17.5" height="45" rx="7" class="t-pri" /></g>
						<circle cx="64" cy="64" r="15" class="t-halo" /><circle cx="64" cy="64" r="12.2" class="t-hub" />
						<circle cx="64" cy="64" r="7.6" class="t-ring" stroke-width="1.8" opacity="0.6" />
					</svg>
					<h1>Mosaico</h1><span class="tag">Library</span>
				</div>
				<button class="theme" id="themeBtn" type="button">Theme</button>
			</header>
			<p class="promise">Every box keeps its shape, and every gutter comes out exact.</p>
			<p class="sub">Four ways to pack boxes of any shape, all running live below. <b>Fill a box</b> searches every arrangement of up to six boxes for the one with the least empty space and crop, and steers away from boxes that shrink to slivers. <b>Even weight</b> breaks a list into rows and gives every box the same area, so the wide ones stop dominating. <b>Even grid</b> puts every box in a same-size cell and picks the column count that makes the boxes biggest. <b>Justified</b> fills every row to the edge at one height, as a photo gallery does.</p>

			<div class="tabs" role="tablist" aria-label="Strategy">
				<button class="tab" role="tab" id="tabTree" aria-selected="true" aria-controls="panelTree" type="button">Fill a box · tree</button>
				<button class="tab" role="tab" id="tabRows" aria-selected="false" aria-controls="panelRows" tabindex="-1" type="button">Even weight · rows</button>
				<button class="tab" role="tab" id="tabGrid" aria-selected="false" aria-controls="panelGrid" tabindex="-1" type="button">Even grid · grid</button>
				<button class="tab" role="tab" id="tabJust" aria-selected="false" aria-controls="panelJust" tabindex="-1" type="button">Justified · rows</button>
			</div>

			<div class="stage">
				<section class="panel" id="panelTree" role="tabpanel" aria-labelledby="tabTree">
					<div class="controls">
						<div class="group" id="shapes" aria-label="Add a box"><span class="lbl">Add</span></div>
						<div class="group" id="boxes" aria-label="Box shape"><span class="lbl">Box</span></div>
						<div class="group" aria-label="Order"><span class="lbl">Order</span>
							<button class="chip" id="free" aria-pressed="true" type="button">free</button>
							<button class="chip" id="ordered" aria-pressed="false" type="button">ordered</button>
						</div>
						<div class="group" id="treeAlign" aria-label="Align"><span class="lbl">Align</span></div>
						<label class="group slider"><span class="lbl">Gap</span><input type="range" id="treeGap" min="0" max="0.08" step="0.005" /><output id="treeGapOut" for="treeGap"></output></label>
						<label class="group slider"><span class="lbl">Padding</span><input type="range" id="treePad" min="0" max="0.12" step="0.01" /><output id="treePadOut" for="treePad"></output></label>
						<button class="chip" id="clear" type="button">clear</button>
					</div>
					<div class="frame" id="treeFrame"></div>
					<div class="stats" id="treeStats" role="status" aria-live="polite"></div>
					<p class="note">Every box keeps its exact shape, and whatever the container's shape leaves over becomes empty margin, never a crop; <b>Align</b> says where the margin goes. Gap and padding are shares of the box's height here; give the container a <code>width</code> and <code>height</code> and they are pixels. <code>columnGap</code> and <code>rowGap</code> set the two directions apart. Click a box to remove it. Up to six boxes: the search tries every guillotine arrangement. Lattice's <code>collage</code> layout is this strategy.</p>
				</section>

				<section class="panel" id="panelRows" role="tabpanel" aria-labelledby="tabRows" hidden>
					<div class="controls">
						<div class="group" id="marks" aria-label="Add a box"><span class="lbl">Add</span></div>
						<div class="group" aria-label="Sizing"><span class="lbl">Sizing</span>
							<button class="chip" id="cells" aria-pressed="false" type="button">equal cells</button>
							<button class="chip" id="area" aria-pressed="true" type="button">equal area</button>
						</div>
						<div class="group" id="rowsAlign" aria-label="Align"><span class="lbl">Align</span></div>
						<label class="group slider"><span class="lbl">Gap</span><input type="range" id="rowsGap" min="0" max="0.1" step="0.005" /><output id="rowsGapOut" for="rowsGap"></output></label>
						<label class="group slider"><span class="lbl">Padding</span><input type="range" id="rowsPad" min="0" max="0.12" step="0.01" /><output id="rowsPadOut" for="rowsPad"></output></label>
						<button class="chip" id="clearMarks" type="button">reset</button>
					</div>
					<div class="frame" id="rowsFrame"></div>
					<div class="stats" id="rowsStats" role="status" aria-live="polite"></div>
					<p class="note">Equal cells draw each box as large as its cell allows, so a wide box takes the room. Equal area gives every box the same area, unless that would stand it taller than a cap. Rows are balanced, and <b>Align</b> places each one; <b>justify</b> spreads a row across the width and starts the last row at the left. Gap and padding are shares of the width here. Lattice's <code>logo-wall</code> layout is this strategy.</p>
				</section>

				<section class="panel" id="panelGrid" role="tabpanel" aria-labelledby="tabGrid" hidden>
					<div class="controls">
						<div class="group" id="gridAdd" aria-label="Add a box"><span class="lbl">Add</span></div>
						<div class="group" id="gridCols" aria-label="Columns"><span class="lbl">Columns</span></div>
						<label class="group slider"><span class="lbl">Gap</span><input type="range" id="gridGap" min="0" max="0.08" step="0.005" /><output id="gridGapOut" for="gridGap"></output></label>
						<button class="chip" id="gridReset" type="button">reset</button>
					</div>
					<div class="frame" id="gridFrame"></div>
					<div class="stats" id="gridStats" role="status" aria-live="polite"></div>
					<p class="note">Every cell is the same size and every box sits inside its cell at its own shape. <b>auto</b> tries every column count and keeps the one that makes the boxes biggest, so wide boxes stack and tall ones go side by side. The last row starts at the left. Gap is a share of the box's height here.</p>
				</section>

				<section class="panel" id="panelJust" role="tabpanel" aria-labelledby="tabJust" hidden>
					<div class="controls">
						<div class="group" id="justAdd" aria-label="Add a box"><span class="lbl">Add</span></div>
						<div class="group" id="justLast" aria-label="Last row"><span class="lbl">Last row</span></div>
						<label class="group slider"><span class="lbl">Row height</span><input type="range" id="justTarget" min="0.1" max="0.4" step="0.01" /><output id="justTargetOut" for="justTarget"></output></label>
						<label class="group slider"><span class="lbl">Gap</span><input type="range" id="justGap" min="0" max="0.08" step="0.005" /><output id="justGapOut" for="justGap"></output></label>
						<button class="chip" id="justReset" type="button">reset</button>
					</div>
					<div class="frame" id="justFrame"></div>
					<div class="stats" id="justStats" role="status" aria-live="polite"></div>
					<p class="note">Every row but the last fills the width exactly, its boxes at one height, and each box keeps its shape. The breaks keep the rows as close as they can be to the row height you ask for. The last row is not stretched. The height of the whole layout is an output. Row height and gap are shares of the width here.</p>
				</section>
			</div>

			<section class="block" aria-labelledby="try-h">
				<h2 id="try-h">Five things to try</h2>
				<p class="lede">Each one loads a set into the demo above and shows what the strategy does with it.</p>
				<ul class="tries" id="tries"></ul>
			</section>

			<section class="block" aria-labelledby="css-h">
				<h2 id="css-h">Every gutter comes out exact</h2>
				<p class="lede">The <b>Fill a box</b> layout above, as the CSS grid <code>toGrid()</code> hands you. The tracks are <code>fr</code>, so the browser fits the grid to whatever box it has. Each box spans whole tracks and keeps its exact shape, because every width in the tree was solved as a straight line in its height, gutters included.</p>
				<pre class="css" id="gridCss" aria-live="polite"></pre>
			</section>

			<section class="block" aria-labelledby="speed-h">
				<h2 id="speed-h">Try to make it slow</h2>
				<p class="lede">Six boxes is the worst case for <b>tree</b>: every guillotine arrangement of every order. <b>rows</b> takes a list of any length. This runs each 40 times in your browser and reports the median.</p>
				<div class="run"><button class="chip" id="runSpeed" type="button">Run it</button><span class="stats" id="speedOut" role="status" aria-live="polite"></span></div>
			</section>

			<section class="block" aria-labelledby="first-h">
				<h2 id="first-h">First user: Lattice</h2>
				<p class="lede">Two Lattice layouts run on Mosaico, in the command-line export and in the live preview alike.</p>
				<div class="cards">
					<div class="card"><span class="k">collage · six photos</span><span class="v">58 → 9 ms</span><span class="d">Moving the search into Mosaico made it about six times faster.</span></div>
					<div class="card"><span class="k">collage · layouts changed</span><span class="v">0 of 4,128</span><span class="d">A golden file pins every layout, byte for byte, to the old packer.</span></div>
					<div class="card"><span class="k">logo-wall · wordmark vs crest</span><span class="v">3.6× → 2×</span><span class="d">Beside a crest, wordmarks come down to a badge's area, and no row stands taller.</span></div>
					<div class="card"><span class="k">logo-wall · one shape</span><span class="v">unchanged</span><span class="d">A wall of one mark shape draws exactly as it did.</span></div>
				</div>
			</section>

			<section class="block" aria-labelledby="vs-h">
				<h2 id="vs-h">How it compares</h2>
				<p class="lede">Measured on one machine: median / 95th percentile, in ms. The three solve different jobs, so read each column for what it does.</p>
				<div class="table-wrap">
					<table>
						<thead><tr><th scope="col"><span class="sr">Items</span></th><th scope="col">Mosaico free</th><th scope="col">Mosaico ordered</th><th scope="col">diorama 2.0.18</th><th scope="col">justified-layout 4.1.0</th></tr></thead>
						<tbody>
							<tr><th scope="row">4 items</th><td class="num">0.21 / 0.46</td><td class="num">0.04 / 0.27</td><td class="num">0.13 / 0.59</td><td class="num">0.01 / 0.02</td></tr>
							<tr><th scope="row">6 items</th><td class="num">8.19 / 12.11</td><td class="num">0.39 / 0.58</td><td class="num">0.43 / 0.98</td><td class="num">0.01 / 0.02</td></tr>
							<tr><th scope="row">What it does</th><td>Every order, every guillotine arrangement, exact gutters</td><td>Your order, every arrangement, exact gutters</td><td>Ordered trees only, no gutters</td><td>Rows only; the height lands wherever it lands</td></tr>
						</tbody>
					</table>
				</div>
			</section>

			<p class="foot">This page runs the real library in your browser. <a href="/libraries/mosaico/learn/">Learn how Mosaico works, and how to use it →</a></p>
		</div>

		<script>
			import { pack, toGrid } from '@/lib/mosaico';

			const $ = (s: string) => document.querySelector(s) as HTMLElement;
			const root = document.documentElement;

			// Theme toggle (shared key with the docs site; see the Lente demo for the `system` value).
			const THEME_LS = 'lattice-docs-mode';
			const applyTheme = (t: string) => { if (t === 'light' || t === 'dark') root.setAttribute('data-theme', t); else root.removeAttribute('data-theme'); };
			const resolveThemePref = (t: string | null) => (t === 'light' || t === 'dark' ? t : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			try { applyTheme(resolveThemePref(localStorage.getItem(THEME_LS))); } catch {}
			$('#themeBtn').addEventListener('click', () => {
				const cur = root.getAttribute('data-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				const next = cur === 'dark' ? 'light' : 'dark';
				applyTheme(next);
				try { localStorage.setItem(THEME_LS, next); } catch {}
			});

			// Tabs.
			const tabs = [['#tabTree', '#panelTree'], ['#tabRows', '#panelRows'], ['#tabGrid', '#panelGrid'], ['#tabJust', '#panelJust']] as const;
			// The selected tab is the one in the Tab order; Left and Right move between them.
			const selectTab = (k: number) => {
				tabs.forEach(([t, p], j) => {
					$(t).setAttribute('aria-selected', String(j === k));
					$(t).tabIndex = j === k ? 0 : -1;
					$(p).hidden = j !== k;
				});
				render();
			};
			tabs.forEach(([tab], k) => {
				$(tab).addEventListener('click', () => selectTab(k));
				$(tab).addEventListener('keydown', (ev) => {
					const step = { ArrowLeft: -1, ArrowRight: 1, Home: -k, End: tabs.length - 1 - k }[(ev as KeyboardEvent).key];
					if (step === undefined) return;
					ev.preventDefault();
					const next = (k + step + tabs.length) % tabs.length;
					selectTab(next);
					$(tabs[next][0]).focus();
				});
			});

			const chip = (label: string, onClick: () => void) => {
				const b = document.createElement('button');
				b.type = 'button';
				b.className = 'chip';
				b.textContent = label;
				b.addEventListener('click', onClick);
				return b;
			};
			const ratio = (a: number) => {
				for (const [w, h] of [[16, 9], [9, 16], [3, 2], [2, 3], [4, 3], [3, 4], [1, 1], [12, 5], [1, 2], [4, 1], [3, 1]]) if (Math.abs(w / h - a) < 0.01) return `${w}:${h}`;
				return a.toFixed(2);
			};

			// ── Collage (tree) ───────────────────────────────────────────────────────────────
			const SHAPES: [string, number][] = [['tall', 2 / 3], ['wide', 3 / 2], ['square', 1], ['pano', 12 / 5], ['column', 1 / 2], ['16:9', 16 / 9]];
			const BOXES: [string, number][] = [['16:9', 16 / 9], ['4:3', 4 / 3], ['1:1', 1], ['9:16', 9 / 16]];
			const GAP = 0.02;
			// Five different shapes that pack to under 1% matte in a 16:9 box.
			let items: number[] = [2 / 3, 3 / 2, 1, 12 / 5, 16 / 9];
			let box = 16 / 9;
			let ordered = false;
			const shapesEl = $('#shapes');
			for (const [name, a] of SHAPES) shapesEl.append(chip(name, () => { if (items.length < 6) { items = [...items, a]; render(); } }));
			const boxesEl = $('#boxes');
			const boxChips = BOXES.map(([name, a]) => {
				const b = chip(name, () => { box = a; render(); });
				boxesEl.append(b);
				return [b, a] as const;
			});
			$('#free').addEventListener('click', () => { ordered = false; render(); });
			$('#ordered').addEventListener('click', () => { ordered = true; render(); });
			$('#clear').addEventListener('click', () => { items = []; render(); });

			// Spacing: the library's own options, in shares of the box (tree: of its height, rows: of its width).
			type Align = 'start' | 'center' | 'end' | 'justify';
			const RGAP_DEFAULT = 0.045, RPAD_DEFAULT = 0.04;
			let treeGap = GAP, treePad = 0, treeAlign: Align = 'center';
			let rowsGap = RGAP_DEFAULT, rowsPad = RPAD_DEFAULT, rowsAlign: Align = 'center';
			const resetSpacing = () => { treeGap = GAP; treePad = 0; treeAlign = 'center'; rowsGap = RGAP_DEFAULT; rowsPad = RPAD_DEFAULT; rowsAlign = 'center'; };
			const pct = (v: number) => `${+(v * 100).toFixed(1)}%`;
			const slider = (id: string, get: () => number, set: (v: number) => void) => {
				const input = $(`#${id}`) as HTMLInputElement;
				input.addEventListener('input', () => { set(Number(input.value)); render(); });
				return () => { input.value = String(get()); $(`#${id}Out`).textContent = pct(get()); };
			};
			const alignChips = (id: string, options: Align[], get: () => Align, set: (a: Align) => void) => {
				const chips = options.map((a) => { const b = chip(a, () => { set(a); render(); }); $(`#${id}`).append(b); return [b, a] as const; });
				return () => { for (const [b, a] of chips) b.setAttribute('aria-pressed', String(a === get())); };
			};
			const syncTree = [
				slider('treeGap', () => treeGap, (v) => { treeGap = v; }),
				slider('treePad', () => treePad, (v) => { treePad = v; }),
				alignChips('treeAlign', ['start', 'center', 'end'], () => treeAlign, (a) => { treeAlign = a; }),
			];
			const syncRows = [
				slider('rowsGap', () => rowsGap, (v) => { rowsGap = v; }),
				slider('rowsPad', () => rowsPad, (v) => { rowsPad = v; }),
				alignChips('rowsAlign', ['start', 'center', 'end', 'justify'], () => rowsAlign, (a) => { rowsAlign = a; }),
			];
			// A dashed line where the padding ends, in shares of the frame.
			const inset = (frame: HTMLElement, l: number, t: number, w: number, h: number) => {
				const el = document.createElement('div');
				el.className = 'inset';
				Object.assign(el.style, { left: `${l * 100}%`, top: `${t * 100}%`, width: `${w * 100}%`, height: `${h * 100}%` });
				frame.append(el);
			};

			function renderTree() {
				const frame = $('#treeFrame');
				for (const [b, a] of boxChips) b.setAttribute('aria-pressed', String(a === box));
				$('#free').setAttribute('aria-pressed', String(!ordered));
				$('#ordered').setAttribute('aria-pressed', String(ordered));
				for (const b of shapesEl.querySelectorAll('button')) (b as HTMLButtonElement).disabled = items.length >= 6;
				for (const sync of syncTree) sync();
				frame.style.aspectRatio = String(box);
				frame.style.maxWidth = `calc(62vh * ${box})`;
				frame.replaceChildren();
				const stats = $('#treeStats');
				if (!items.length) { stats.textContent = 'Add a box to start.'; $('#gridCss').textContent = '/* add a box to see its grid */'; return; }
				const t0 = performance.now();
				const res = pack(items, { aspect: box }, { gap: treeGap, padding: treePad, align: treeAlign, order: ordered ? 'ordered' : 'free' });
				const ms = performance.now() - t0;
				if (!res.ok) { stats.textContent = `No layout: ${res.reason}`; return; }
				if (treePad > 0) inset(frame, treePad / box, treePad, 1 - (2 * treePad) / box, 1 - 2 * treePad);
				// `placed` is in the container's units: the box is `box` wide and 1 tall.
				res.placed.forEach((r, i) => {
					const el = document.createElement('button');
					el.type = 'button';
					el.className = 'box' + (i === 0 ? ' warm' : '');
					el.style.left = `${(r.x / box) * 100}%`;
					el.style.top = `${r.y * 100}%`;
					el.style.width = `${(r.w / box) * 100}%`;
					el.style.height = `${r.h * 100}%`;
					el.textContent = ratio(items[i]);
					el.setAttribute('aria-label', `Box ${i + 1}, ${ratio(items[i])}: remove`);
					el.addEventListener('click', () => { items = items.filter((_, k) => k !== i); render(); });
					frame.append(el);
				});
				showGrid(res);
				stats.innerHTML = `<span>arrangement <b>${res.arrangement}</b></span><span>empty <b>${(res.empty * 100).toFixed(1)}%</b></span><span>searched <b>${res.work.arrangements}</b> arrangements in <b>${ms.toFixed(1)} ms</b></span>`;
			}

			// The current Fill-a-box layout as CSS: fr tracks, one grid area per box.
			function showGrid(res: Parameters<typeof toGrid>[0]) {
				const g = toGrid(res);
				// Scaled by 1000: fr factors that sum below 1 leave part of the grid empty, and the row
				// tracks sum to 1 minus the gutters (lib/components/imagery/collage/collage.transform.js does the same).
				const fr = (v: number[]) => v.map((x) => `minmax(0, ${(x * 1000).toFixed(1)}fr)`).join(' ');
				const lines = [
					'.mosaic {',
					'  display: grid;',
					`  aspect-ratio: ${res.aspect.toFixed(3)};`,
					`  height: 360px;  <span class="c">/* any height; the width follows the aspect */</span>`,
					`  gap: ${+(360 * res.rowGap).toFixed(2)}px;  <span class="c">/* the gutter: ${+res.rowGap.toFixed(4)} of the grid's height */</span>`,
					`  grid-template-columns: ${fr(g.cols)};`,
					`  grid-template-rows: ${fr(g.rows)};`,
					'}',
					...g.areas.map((a, i) => `.box-${i + 1} { grid-area: ${a.join(' / ')}; }  <span class="c">/* ${ratio(items[i])} */</span>`),
					...(treePad > 0 ? ['<span class="c">/* the padding goes on the box that holds the grid */</span>'] : []),
				];
				$('#gridCss').innerHTML = lines.join('\n');
			}

			// ── Logo wall (rows) ─────────────────────────────────────────────────────────────
			const MARKS: [string, number][] = [['4:1', 4], ['3:1', 3], ['1:1', 1], ['1:2', 1 / 2]];
			const START = [4, 1, 1 / 2, 3, 3, 1, 4, 1 / 2];
			let marks = [...START];
			let equalArea = true;
			const COLS = 4, RGAP = 0.05, BAND = 0.09;
			const marksEl = $('#marks');
			for (const [name, a] of MARKS) marksEl.append(chip(name, () => { if (marks.length < 16) { marks = [...marks, a]; render(); } }));
			$('#cells').addEventListener('click', () => { equalArea = false; render(); });
			$('#area').addEventListener('click', () => { equalArea = true; render(); });
			$('#clearMarks').addEventListener('click', () => { marks = [...START]; rowsGap = RGAP_DEFAULT; rowsPad = RPAD_DEFAULT; rowsAlign = 'center'; render(); });

			function renderRows() {
				const frame = $('#rowsFrame');
				$('#cells').setAttribute('aria-pressed', String(!equalArea));
				$('#area').setAttribute('aria-pressed', String(equalArea));
				for (const sync of syncRows) sync();
				frame.replaceChildren();
				frame.style.maxWidth = '';
				// Every length here is a share of the frame's width (the container is 1 wide).
				const pad = rowsPad, gap = rowsGap, iw = 1 - 2 * pad;
				const cell = (iw - (COLS - 1) * gap) / COLS, band = BAND * iw;
				const rects: { x: number; y: number; w: number; h: number }[] = [];
				const cells: { x: number; y: number; w: number; h: number }[] = [];
				let H = 0;
				const t0 = performance.now();
				if (equalArea) {
					const res = pack(marks, {}, { strategy: 'rows', gap, heightCap: band * Math.SQRT2, minHeightCap: band, maxPerRow: COLS, minCell: cell, padding: pad, align: rowsAlign });
					if (!res.ok) { $('#rowsStats').textContent = `No layout: ${res.reason}`; return; }
					rects.push(...res.placed);
					// `cells` are in layout units (the width inside the padding is 1).
					cells.push(...(res.cells || []).map((c) => ({ x: pad + c.x * iw, y: pad + c.y * iw, w: c.w * iw, h: c.h * iw })));
					H = res.frame.h + 2 * pad;
				} else {
					// The old wall: equal cells, each mark drawn `contain` in a cell under the band, placed
					// by the same align rule.
					const rowsN = Math.ceil(marks.length / COLS);
					marks.forEach((a, i) => {
						const r = Math.floor(i / COLS), inRow = Math.min(COLS, marks.length - r * COLS);
						let align = r === rowsN - 1 && rowsAlign === 'justify' ? 'start' : rowsAlign;
						if (align === 'justify' && inRow < 2) align = 'start';
						const slack = iw - (inRow * cell + (inRow - 1) * gap);
						const step = cell + gap + (align === 'justify' ? slack / (inRow - 1) : 0);
						const x0 = pad + slack * ({ start: 0, center: 0.5, end: 1, justify: 0 } as const)[align] + (i % COLS) * step;
						const y0 = pad + r * (band + gap);
						const w = Math.min(cell, band * a), h = w / a;
						cells.push({ x: x0, y: y0, w: cell, h: band });
						rects.push({ x: x0 + (cell - w) / 2, y: y0 + (band - h) / 2, w, h });
					});
					H = rowsN * band + (rowsN - 1) * gap + 2 * pad;
				}
				const ms = performance.now() - t0;
				frame.style.aspectRatio = String(1 / H);
				if (pad > 0) inset(frame, pad, pad / H, iw, 1 - (2 * pad) / H);
				const place = (el: HTMLElement, r: { x: number; y: number; w: number; h: number }) => {
					el.style.left = `${r.x * 100}%`;
					el.style.width = `${r.w * 100}%`;
					el.style.top = `${(r.y / H) * 100}%`;
					el.style.height = `${(r.h / H) * 100}%`;
				};
				cells.forEach((c) => { const el = document.createElement('div'); el.className = 'cell'; place(el, c); frame.append(el); });
				rects.forEach((r, i) => {
					const el = document.createElement('button');
					el.type = 'button';
					el.className = 'box' + (marks[i] >= 3 ? ' warm' : '');
					place(el, r);
					el.textContent = ratio(marks[i]);
					// The last box stays: a wall needs one.
					el.disabled = marks.length <= 1;
					el.setAttribute('aria-label', `Box ${i + 1}, ${ratio(marks[i])}${el.disabled ? '' : ': remove'}`);
					el.addEventListener('click', () => { marks = marks.filter((_, k) => k !== i); render(); });
					frame.append(el);
				});
				const areas = rects.map((r) => r.w * r.h);
				const spread = Math.max(...areas) / Math.min(...areas);
				$('#rowsStats').innerHTML = `<span>largest box / smallest <b>${spread.toFixed(2)}×</b></span><span>rows <b>${equalArea ? 'balanced' : 'four, then the rest'}</b></span>${equalArea ? `<span>packed in <b>${ms < 0.1 ? 'under 0.1' : ms.toFixed(1)} ms</b></span>` : ''}`;
			}


			// ── Even grid and Justified ──────────────────────────────────────────────────────
			const FLAT_START = [3 / 2, 1, 2 / 3, 16 / 9, 1, 4 / 3, 3 / 4, 2, 1, 3 / 2, 2 / 3];
			let flat = [...FLAT_START];
			let gridCols = 0, gridGap = 0.02, justTarget = 0.22, justGap = 0.015, justLast: 'start' | 'center' = 'start';
			const FLAT_SHAPES: [string, number][] = [['tall', 2 / 3], ['wide', 3 / 2], ['square', 1], ['pano', 12 / 5]];
			for (const id of ['#gridAdd', '#justAdd']) for (const [name, a] of FLAT_SHAPES) $(id).append(chip(name, () => { if (flat.length < 24) { flat = [...flat, a]; render(); } }));
			const colChips = [0, 2, 3, 4, 5].map((c) => { const b = chip(c ? String(c) : 'auto', () => { gridCols = c; render(); }); $('#gridCols').append(b); return [b, c] as const; });
			const lastChips = (['start', 'center'] as const).map((a) => { const b = chip(a, () => { justLast = a; render(); }); $('#justLast').append(b); return [b, a] as const; });
			$('#gridReset').addEventListener('click', () => { flat = [...FLAT_START]; gridCols = 0; gridGap = 0.02; render(); });
			$('#justReset').addEventListener('click', () => { flat = [...FLAT_START]; justTarget = 0.22; justGap = 0.015; justLast = 'start'; render(); });
			const syncGrid = [slider('gridGap', () => gridGap, (v) => { gridGap = v; })];
			const syncJust = [slider('justTarget', () => justTarget, (v) => { justTarget = v; }), slider('justGap', () => justGap, (v) => { justGap = v; })];

			const drawBoxes = (frame: HTMLElement, cells: R[], rects: R[], place: (el: HTMLElement, r: R) => void) => {
				cells.forEach((c) => { const el = document.createElement('div'); el.className = 'cell'; place(el, c); frame.append(el); });
				rects.forEach((r, i) => {
					const el = document.createElement('button');
					el.type = 'button';
					el.className = 'box' + (flat[i] >= 3 ? ' warm' : '');
					place(el, r);
					el.textContent = ratio(flat[i]);
					el.disabled = flat.length <= 1;
					el.setAttribute('aria-label', `Box ${i + 1}, ${ratio(flat[i])}${el.disabled ? '' : ': remove'}`);
					el.addEventListener('click', () => { flat = flat.filter((_, k) => k !== i); render(); });
					frame.append(el);
				});
			};
			type R = { x: number; y: number; w: number; h: number };

			function renderGrid() {
				const frame = $('#gridFrame');
				for (const [b, c] of colChips) b.setAttribute('aria-pressed', String(c === gridCols));
				for (const sync of syncGrid) sync();
				frame.replaceChildren();
				const A = 16 / 9;
				frame.style.aspectRatio = String(A);
				const t0 = performance.now();
				const res = pack(flat, { aspect: A }, { strategy: 'grid', gap: gridGap, ...(gridCols ? { columns: gridCols } : {}) });
				const ms = performance.now() - t0;
				if (!res.ok) { $('#gridStats').textContent = `No layout: ${res.reason}`; return; }
				// Container units: A wide and 1 tall.
				const place = (el: HTMLElement, r: R) => { el.style.left = `${(r.x / A) * 100}%`; el.style.width = `${(r.w / A) * 100}%`; el.style.top = `${r.y * 100}%`; el.style.height = `${r.h * 100}%`; };
				drawBoxes(frame, res.placed, res.fitted ?? res.placed, place);
				$('#gridStats').innerHTML = `<span>grid <b>${res.arrangement}</b></span><span>boxes <b>${flat.length}</b></span><span>packed in <b>${ms < 0.1 ? 'under 0.1' : ms.toFixed(1)} ms</b></span>`;
			}

			function renderJust() {
				const frame = $('#justFrame');
				for (const [b, a] of lastChips) b.setAttribute('aria-pressed', String(a === justLast));
				for (const sync of syncJust) sync();
				frame.replaceChildren();
				const t0 = performance.now();
				const res = pack(flat, {}, { strategy: 'rows', goal: 'justified', gap: justGap, rowGap: justGap, targetRowHeight: justTarget, lastRow: justLast });
				const ms = performance.now() - t0;
				if (!res.ok) { $('#justStats').textContent = `No layout: ${res.reason}`; return; }
				const H = res.frame.h;
				frame.style.aspectRatio = String(1 / H);
				const place = (el: HTMLElement, r: R) => { el.style.left = `${r.x * 100}%`; el.style.width = `${r.w * 100}%`; el.style.top = `${(r.y / H) * 100}%`; el.style.height = `${(r.h / H) * 100}%`; };
				drawBoxes(frame, [], res.placed, place);
				$('#justStats').innerHTML = `<span>rows <b>${res.rows?.length ?? 0}</b></span><span>boxes <b>${flat.length}</b></span><span>packed in <b>${ms < 0.1 ? 'under 0.1' : ms.toFixed(1)} ms</b></span>`;
			}

			// A label that would spill out of its tile moves into the tile's tooltip.
			function fitLabels(frame: HTMLElement) {
				for (const el of frame.querySelectorAll<HTMLElement>('.box')) {
					const label = el.textContent || '';
					el.title = label;
					// Measure the text itself: centered text that spills out of both sides does not
					// show up in the tile's own scroll size.
					const probe = document.createElement('span');
					probe.textContent = label;
					el.replaceChildren(probe);
					if (probe.offsetWidth > el.clientWidth - 4 || probe.offsetHeight > el.clientHeight - 2) el.replaceChildren();
				}
			}
			// ── Five things to try ───────────────────────────────────────────────────────────
			const TRIES: { title: string; text: string; run: () => void }[] = [
				{ title: 'Five shapes, no margin', text: 'A square, a 3:2, a 4:3, another square and a 12:5 strip fill a 16:9 box with no visible margin.', run: () => { items = [1, 3 / 2, 4 / 3, 1, 12 / 5]; box = 16 / 9; ordered = false; selectTab(0); } },
				{ title: 'Five of a kind', text: 'Five 3:2 photos in a 16:9 box. With one shape the search still finds a layout under 1% margin, with the photos in two sizes.', run: () => { items = Array(5).fill(3 / 2); box = 16 / 9; ordered = false; selectTab(0); } },
				{ title: 'Phone stills in a wide box', text: 'Three 9:16 stills in a 16:9 box. Nothing is cropped: they stand side by side and leave under 3% margin.', run: () => { items = [9 / 16, 9 / 16, 9 / 16]; box = 16 / 9; ordered = false; selectTab(0); } },
				{ title: 'A full box or a sliver', text: 'In this order, five shapes fill the box exactly, but two shrink to a fifth of the largest. Switch to free: the search takes 12% margin instead.', run: () => { items = [2 / 3, 1 / 2, 1 / 2, 1, 12 / 5]; box = 16 / 9; ordered = true; selectTab(0); } },
				{ title: 'A crest among wordmarks', text: 'Equal cells give the wide wordmarks the room. Switch to equal area and every box gets the same weight.', run: () => { marks = [4, 3, 4, 1 / 2, 3, 1, 4, 1 / 2]; equalArea = false; selectTab(1); } },
			];
			const triesEl = $('#tries');
			for (const t of TRIES) {
				const li = document.createElement('li');
				const b = document.createElement('button');
				b.type = 'button';
				b.className = 'try';
				const title = document.createElement('b');
				title.textContent = t.title;
				const text = document.createElement('span');
				text.textContent = t.text;
				b.append(title, text);
				b.addEventListener('click', () => {
					// Each set is described at the default spacing.
					resetSpacing();
					t.run();
					// Focus follows the view: the selected tab, so a keyboard reader lands on the demo.
					$('.tab[aria-selected="true"]').focus({ preventScroll: true });
					$('.tabs').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
				});
				li.append(b);
				triesEl.append(li);
			}

			// ── Try to make it slow ──────────────────────────────────────────────────────────
			const time = (fn: () => void) => {
				const out: number[] = [];
				for (let k = 0; k < 40; k++) { const t0 = performance.now(); fn(); out.push(performance.now() - t0); }
				return out.sort((a, b) => a - b)[out.length >> 1];
			};
			const fmt = (ms: number) => (ms < 0.1 ? 'under 0.1' : ms.toFixed(1));
			$('#runSpeed').addEventListener('click', () => {
				const six = [16 / 9, 2 / 3, 1, 3 / 2, 1 / 2, 12 / 5];
				const forty = Array.from({ length: 40 }, (_, i) => [4, 3, 1, 1 / 2][i % 4]);
				$('#speedOut').textContent = 'Running…';
				// Let the status paint before the main thread is busy.
				setTimeout(() => {
					const free = pack(six, { aspect: 16 / 9 }, { gap: GAP });
					const ord = pack(six, { aspect: 16 / 9 }, { gap: GAP, order: 'ordered' });
					const tFree = time(() => pack(six, { aspect: 16 / 9 }, { gap: GAP }));
					const tOrd = time(() => pack(six, { aspect: 16 / 9 }, { gap: GAP, order: 'ordered' }));
					const tRows = time(() => pack(forty, {}, { strategy: 'rows', gap: RGAP, heightCap: BAND, maxPerRow: COLS }));
					const n = (r: ReturnType<typeof pack>) => (r.ok ? r.work.arrangements.toLocaleString('en-US') : '—');
					$('#speedOut').innerHTML = `<span>six boxes, free <b>${fmt(tFree)} ms</b> · ${n(free)} arrangements</span><span>six boxes, ordered <b>${fmt(tOrd)} ms</b> · ${n(ord)} arrangements</span><span>forty boxes in rows <b>${fmt(tRows)} ms</b></span>`;
				}, 30);
			});

			function render() {
				if (!$('#panelTree').hidden) { renderTree(); fitLabels($('#treeFrame')); }
				if (!$('#panelRows').hidden) { renderRows(); fitLabels($('#rowsFrame')); }
				if (!$('#panelGrid').hidden) { renderGrid(); fitLabels($('#gridFrame')); }
				if (!$('#panelJust').hidden) { renderJust(); fitLabels($('#justFrame')); }
			}
			render();
		</script>
	</body>
</html>
