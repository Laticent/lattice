---
// Mosaico — a standalone, framework-free showcase driven by the REAL library (docs/src/lib/mosaico,
// the `@laticent/mosaico` workspace). It shows the library, not Lattice's layouts: two panels, one
// per strategy — `tree` packs up to six boxes of any shape into a container you pick, and `rows`
// lays out a list of boxes you can flip between equal cells and equal area, with the area spread
// measured beside it. Collage and logo-wall are named once each, as the Lattice layouts built on them. Reached
// at /libraries/mosaico/; its Learn page is /libraries/mosaico/learn/ (src/content/catalog/).
import DemoBar from '../../../components/catalog/DemoBar.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Mosaico — every box keeps its shape</title>
		<link rel="icon" href="/mosaico-mark-min.svg" type="image/svg+xml" />
		<style is:global>
			:root {
				--paper: #f5f5ef; --stage: #ecede3; --ink: #1d2112; --muted: #5d6350; --line: #dcdfcf;
				--accent: #4f5f00; --accent-ink: #fff; --glow: #07708c; --glow-bg: #d4eef5;
				--panel: #fbfbf7; --tile: #e2e8c9; --tile-ink: #384300;
				--mark-warm: #0994b9; --ring: #1f2600;
				--shadow: 0 1px 2px rgba(29,33,18,.06), 0 8px 24px rgba(29,33,18,.06);
				--stage-serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
				--sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
				--mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--paper: #11130d; --stage: #191c13; --ink: #e7ebdf; --muted: #9da28e; --line: #2c3022;
					--accent: #a9bf4a; --accent-ink: #151a04; --glow: #8ddefd; --glow-bg: #0d2a33;
					--panel: #161910; --tile: #2e3618; --tile-ink: #e2ecc0;
				--mark-warm: #8ddefd; --ring: #0f1300;
					--shadow: 0 1px 2px rgba(0,0,0,.4), 0 10px 30px rgba(0,0,0,.35);
				}
			}
			:root[data-theme="light"] {
				--paper: #f5f5ef; --stage: #ecede3; --ink: #1d2112; --muted: #5d6350; --line: #dcdfcf;
				--accent: #4f5f00; --accent-ink: #fff; --glow: #07708c; --glow-bg: #d4eef5;
				--panel: #fbfbf7; --tile: #e2e8c9; --tile-ink: #384300;
				--mark-warm: #0994b9; --ring: #1f2600;
			}
			:root[data-theme="dark"] {
				--paper: #11130d; --stage: #191c13; --ink: #e7ebdf; --muted: #9da28e; --line: #2c3022;
				--accent: #a9bf4a; --accent-ink: #151a04; --glow: #8ddefd; --glow-bg: #0d2a33;
				--panel: #161910; --tile: #2e3618; --tile-ink: #e2ecc0;
				--mark-warm: #8ddefd; --ring: #0f1300;
			}
			/* The header mark, drawn inline so it follows the theme toggle (docs/public/mosaico-mark.svg is the same geometry). */
			.logo .t-pri { stroke: var(--accent); }
			.logo .t-warm { stroke: var(--mark-warm); }
			.logo .t-hub { fill: var(--accent); }
			.logo .t-halo { fill: var(--paper); }
			.logo .t-ring { stroke: var(--ring); }
			* { box-sizing: border-box; }
			body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans);
				line-height: 1.5; -webkit-font-smoothing: antialiased; padding: clamp(16px, 4vw, 48px); }
			.wrap { max-width: 920px; margin: 0 auto; }
			header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
			.brand { display: flex; align-items: center; gap: 13px; }
			.brand .logo { width: 46px; height: 46px; flex-shrink: 0; }
			h1 { font-family: var(--stage-serif); font-size: clamp(28px, 5vw, 40px); font-weight: 600; margin: 0; letter-spacing: -.01em; }
			.tag { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent);
				border: 1px solid var(--accent); padding: 3px 8px; border-radius: 999px; font-weight: 600; }
			.promise { font-family: var(--stage-serif); font-size: clamp(21px, 3vw, 27px); line-height: 1.3; max-width: 34ch; margin: 14px 0 0; text-wrap: balance; }
			.sub { color: var(--muted); font-size: 15px; max-width: 64ch; margin: 8px 0 0; }
			.sub b { color: var(--ink); font-weight: 600; }
			.theme { background: none; border: 1px solid var(--line); color: var(--muted); border-radius: 999px; font-size: 11px; padding: 5px 11px; cursor: pointer; font-family: var(--sans); }

			.tabs { display: flex; gap: 8px; margin: 26px 0 0; flex-wrap: wrap; }
			.tab { border: 1px solid var(--line); background: var(--panel); color: var(--ink); font: 600 13px var(--sans);
				border-radius: 999px; padding: 8px 16px; cursor: pointer; }
			.tab[aria-selected="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }

			.stage { margin: 12px 0 0; background: var(--stage); border: 1px solid var(--line); border-radius: 18px;
				box-shadow: var(--shadow); padding: clamp(16px, 4vw, 32px); }
			.controls { display: flex; gap: 10px 18px; flex-wrap: wrap; align-items: center; }
			.group { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
			.group .lbl { font: 600 11px var(--sans); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-right: 2px; }
			.chip { border: 1px solid var(--line); background: var(--panel); color: var(--ink); font: 600 12px var(--mono);
				border-radius: 999px; padding: 6px 11px; cursor: pointer; min-height: 32px; }
			.chip[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 16%, transparent); }
			.chip:disabled { opacity: .4; cursor: default; }

			.frame { margin: 20px auto 0; background: var(--panel); border: 1px dashed var(--line); border-radius: 10px;
				position: relative; width: 100%; max-height: 62vh; overflow: hidden; }
			.frame .box { position: absolute; border: 0; padding: 0; border-radius: 6px; cursor: pointer;
				background: linear-gradient(150deg, var(--tile), color-mix(in srgb, var(--tile) 70%, var(--accent))); color: var(--tile-ink);
				display: grid; place-items: center; font: 600 12px var(--mono); transition: left .25s ease, top .25s ease, width .25s ease, height .25s ease, filter .12s ease; }
			.frame .box:hover { filter: brightness(1.04); }
			.frame .box:disabled { cursor: default; filter: none; }
			@media (max-width: 560px) { .frame .box { font-size: 10px; } }
			.frame .box.warm { background: linear-gradient(150deg, var(--glow-bg), color-mix(in srgb, var(--glow-bg) 70%, var(--glow))); color: var(--glow); }
			.frame .cell { position: absolute; border: 1px dashed color-mix(in srgb, var(--muted) 45%, transparent); border-radius: 6px; }
			.stats { margin: 14px 0 0; display: flex; gap: 8px 20px; flex-wrap: wrap; font: 12px var(--mono); color: var(--muted); }
			.stats b { color: var(--ink); font-weight: 600; }
			.note { margin: 10px 0 0; font-size: 13px; color: var(--muted); max-width: 70ch; }
			.panel[hidden] { display: none; }

			.note code { font-family: var(--mono); font-size: 12px; background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; }
			.foot { margin-top: 26px; color: var(--muted); font-size: 12px; line-height: 1.7; }
			.foot a { color: var(--accent); }
			:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
		</style>
	</head>
	<body>
		<div class="wrap">
			<DemoBar slug="mosaico" />
			<header>
				<div class="brand">
					<svg class="logo" viewBox="0 0 128 128" fill="none" aria-hidden="true">
						<g stroke-width="6.5" stroke-linejoin="round"><rect x="14" y="14" width="45" height="100" rx="7" class="t-pri" /><rect x="69" y="14" width="45" height="45" rx="7" class="t-warm" /><rect x="69" y="69" width="17.5" height="45" rx="7" class="t-pri" /><rect x="96.5" y="69" width="17.5" height="45" rx="7" class="t-pri" /></g>
						<circle cx="64" cy="64" r="15" class="t-halo" /><circle cx="64" cy="64" r="12.2" class="t-hub" />
						<circle cx="64" cy="64" r="7.6" class="t-ring" stroke-width="1.8" opacity="0.6" />
					</svg>
					<h1>Mosaico</h1><span class="tag">Library</span>
				</div>
				<button class="theme" id="themeBtn" type="button">Theme</button>
			</header>
			<p class="promise">Every box keeps its shape, and every gutter comes out exact.</p>
			<p class="sub">Two ways to pack boxes of any shape, both running live below. <b>Fill a box</b> searches every arrangement of up to six boxes for the one with the least empty space and crop. <b>Even weight</b> breaks a list into rows and gives every box the same area, so the wide ones stop dominating.</p>

			<div class="tabs" role="tablist" aria-label="Strategy">
				<button class="tab" role="tab" id="tabTree" aria-selected="true" aria-controls="panelTree" type="button">Fill a box · tree</button>
				<button class="tab" role="tab" id="tabRows" aria-selected="false" aria-controls="panelRows" tabindex="-1" type="button">Even weight · rows</button>
			</div>

			<div class="stage">
				<section class="panel" id="panelTree" role="tabpanel" aria-labelledby="tabTree">
					<div class="controls">
						<div class="group" id="shapes" aria-label="Add a box"><span class="lbl">Add</span></div>
						<div class="group" id="boxes" aria-label="Box shape"><span class="lbl">Box</span></div>
						<div class="group" aria-label="Order"><span class="lbl">Order</span>
							<button class="chip" id="free" aria-pressed="true" type="button">free</button>
							<button class="chip" id="ordered" aria-pressed="false" type="button">ordered</button>
						</div>
						<button class="chip" id="clear" type="button">clear</button>
					</div>
					<div class="frame" id="treeFrame"></div>
					<div class="stats" id="treeStats" role="status" aria-live="polite"></div>
					<p class="note">Every box keeps its exact shape, and whatever the container's shape leaves over becomes empty margin, never a crop. Click a box to remove it. Up to six boxes: the search tries every guillotine arrangement. Lattice's <code>collage</code> layout is this strategy.</p>
				</section>

				<section class="panel" id="panelRows" role="tabpanel" aria-labelledby="tabRows" hidden>
					<div class="controls">
						<div class="group" id="marks" aria-label="Add a box"><span class="lbl">Add</span></div>
						<div class="group" aria-label="Sizing"><span class="lbl">Sizing</span>
							<button class="chip" id="cells" aria-pressed="false" type="button">equal cells</button>
							<button class="chip" id="area" aria-pressed="true" type="button">equal area</button>
						</div>
						<button class="chip" id="clearMarks" type="button">reset</button>
					</div>
					<div class="frame" id="rowsFrame"></div>
					<div class="stats" id="rowsStats" role="status" aria-live="polite"></div>
					<p class="note">Equal cells draw each box as large as its cell allows, so a wide box takes the room. Equal area gives every box the same area, unless that would stand it taller than a cap. Rows are balanced and centered. Lattice's <code>logo-wall</code> layout is this strategy.</p>
				</section>
			</div>

			<p class="foot">This page runs the real library in your browser. <a href="/libraries/mosaico/learn/">Learn how Mosaico works, and how to use it →</a></p>
		</div>

		<script>
			import { pack } from '@/lib/mosaico';

			const $ = (s: string) => document.querySelector(s) as HTMLElement;
			const root = document.documentElement;

			// Theme toggle (shared key with the docs site; see the Lente demo for the `system` value).
			const THEME_LS = 'lattice-docs-mode';
			const applyTheme = (t: string) => { if (t === 'light' || t === 'dark') root.setAttribute('data-theme', t); else root.removeAttribute('data-theme'); };
			const resolveThemePref = (t: string | null) => (t === 'light' || t === 'dark' ? t : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			try { applyTheme(resolveThemePref(localStorage.getItem(THEME_LS))); } catch {}
			$('#themeBtn').addEventListener('click', () => {
				const cur = root.getAttribute('data-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				const next = cur === 'dark' ? 'light' : 'dark';
				applyTheme(next);
				try { localStorage.setItem(THEME_LS, next); } catch {}
			});

			// Tabs.
			const tabs = [['#tabTree', '#panelTree'], ['#tabRows', '#panelRows']] as const;
			// The selected tab is the one in the Tab order; Left and Right move between them.
			const selectTab = (k: number) => {
				tabs.forEach(([t, p], j) => {
					$(t).setAttribute('aria-selected', String(j === k));
					$(t).tabIndex = j === k ? 0 : -1;
					$(p).hidden = j !== k;
				});
				render();
			};
			tabs.forEach(([tab], k) => {
				$(tab).addEventListener('click', () => selectTab(k));
				$(tab).addEventListener('keydown', (ev) => {
					const step = { ArrowLeft: -1, ArrowRight: 1, Home: -k, End: tabs.length - 1 - k }[(ev as KeyboardEvent).key];
					if (step === undefined) return;
					ev.preventDefault();
					const next = (k + step + tabs.length) % tabs.length;
					selectTab(next);
					$(tabs[next][0]).focus();
				});
			});

			const chip = (label: string, onClick: () => void) => {
				const b = document.createElement('button');
				b.type = 'button';
				b.className = 'chip';
				b.textContent = label;
				b.addEventListener('click', onClick);
				return b;
			};
			const ratio = (a: number) => {
				for (const [w, h] of [[16, 9], [9, 16], [3, 2], [2, 3], [4, 3], [3, 4], [1, 1], [12, 5], [1, 2], [4, 1], [3, 1]]) if (Math.abs(w / h - a) < 0.01) return `${w}:${h}`;
				return a.toFixed(2);
			};

			// ── Collage (tree) ───────────────────────────────────────────────────────────────
			const SHAPES: [string, number][] = [['tall', 2 / 3], ['wide', 3 / 2], ['square', 1], ['pano', 12 / 5], ['column', 1 / 2], ['16:9', 16 / 9]];
			const BOXES: [string, number][] = [['16:9', 16 / 9], ['4:3', 4 / 3], ['1:1', 1], ['9:16', 9 / 16]];
			const GAP = 0.02;
			// Five different shapes that pack to under 1% matte in a 16:9 box.
			let items: number[] = [2 / 3, 3 / 2, 1, 12 / 5, 16 / 9];
			let box = 16 / 9;
			let ordered = false;
			const shapesEl = $('#shapes');
			for (const [name, a] of SHAPES) shapesEl.append(chip(name, () => { if (items.length < 6) { items = [...items, a]; render(); } }));
			const boxesEl = $('#boxes');
			const boxChips = BOXES.map(([name, a]) => {
				const b = chip(name, () => { box = a; render(); });
				boxesEl.append(b);
				return [b, a] as const;
			});
			$('#free').addEventListener('click', () => { ordered = false; render(); });
			$('#ordered').addEventListener('click', () => { ordered = true; render(); });
			$('#clear').addEventListener('click', () => { items = []; render(); });

			function renderTree() {
				const frame = $('#treeFrame');
				for (const [b, a] of boxChips) b.setAttribute('aria-pressed', String(a === box));
				$('#free').setAttribute('aria-pressed', String(!ordered));
				$('#ordered').setAttribute('aria-pressed', String(ordered));
				for (const b of shapesEl.querySelectorAll('button')) (b as HTMLButtonElement).disabled = items.length >= 6;
				frame.style.aspectRatio = String(box);
				frame.style.maxWidth = `calc(62vh * ${box})`;
				frame.replaceChildren();
				const stats = $('#treeStats');
				if (!items.length) { stats.textContent = 'Add a box to start.'; return; }
				const t0 = performance.now();
				const res = pack(items, { aspect: box }, { gap: GAP, order: ordered ? 'ordered' : 'free' });
				const ms = performance.now() - t0;
				if (!res.ok) { stats.textContent = `No layout: ${res.reason}`; return; }
				// The layout is 1 tall and res.aspect wide; center it in the box (the leftover is matte).
				const scale = Math.min(1, box / res.aspect);
				const lw = (res.aspect * scale) / box, lh = scale;
				const ox = (1 - lw) / 2, oy = (1 - lh) / 2;
				res.rects.forEach((r, i) => {
					const el = document.createElement('button');
					el.type = 'button';
					el.className = 'box' + (i === 0 ? ' warm' : '');
					el.style.left = `${(ox + (r.x / res.aspect) * lw) * 100}%`;
					el.style.top = `${(oy + r.y * lh) * 100}%`;
					el.style.width = `${(r.w / res.aspect) * lw * 100}%`;
					el.style.height = `${r.h * lh * 100}%`;
					el.textContent = ratio(items[i]);
					el.setAttribute('aria-label', `Box ${i + 1}, ${ratio(items[i])}: remove`);
					el.addEventListener('click', () => { items = items.filter((_, k) => k !== i); render(); });
					frame.append(el);
				});
				stats.innerHTML = `<span>arrangement <b>${res.arrangement}</b></span><span>empty <b>${(res.empty * 100).toFixed(1)}%</b></span><span>searched <b>${res.work.arrangements}</b> arrangements in <b>${ms.toFixed(1)} ms</b></span>`;
			}

			// ── Logo wall (rows) ─────────────────────────────────────────────────────────────
			const MARKS: [string, number][] = [['4:1', 4], ['3:1', 3], ['1:1', 1], ['1:2', 1 / 2]];
			const START = [4, 1, 1 / 2, 3, 3, 1, 4, 1 / 2];
			let marks = [...START];
			let equalArea = true;
			const COLS = 4, RGAP = 0.05, BAND = 0.09;
			const marksEl = $('#marks');
			for (const [name, a] of MARKS) marksEl.append(chip(name, () => { if (marks.length < 16) { marks = [...marks, a]; render(); } }));
			$('#cells').addEventListener('click', () => { equalArea = false; render(); });
			$('#area').addEventListener('click', () => { equalArea = true; render(); });
			$('#clearMarks').addEventListener('click', () => { marks = [...START]; render(); });

			function renderRows() {
				const frame = $('#rowsFrame');
				$('#cells').setAttribute('aria-pressed', String(!equalArea));
				$('#area').setAttribute('aria-pressed', String(equalArea));
				frame.replaceChildren();
				frame.style.maxWidth = '';
				const cell = (1 - (COLS - 1) * RGAP) / COLS;
				const rects: { x: number; y: number; w: number; h: number }[] = [];
				const cells: { x: number; y: number; w: number; h: number }[] = [];
				let height = 0;
				const t0 = performance.now();
				if (equalArea) {
					const res = pack(marks, {}, { strategy: 'rows', gap: RGAP, heightCap: BAND * Math.SQRT2, minHeightCap: BAND, maxPerRow: COLS, minCell: cell });
					if (!res.ok) return;
					rects.push(...res.rects);
					cells.push(...(res.cells || []));
					height = 1 / res.aspect;
				} else {
					// The old wall: equal cells, each mark drawn `contain` in a cell under the band.
					const rowsN = Math.ceil(marks.length / COLS);
					marks.forEach((a, i) => {
						const r = Math.floor(i / COLS), inRow = Math.min(COLS, marks.length - r * COLS);
						const x0 = (1 - (inRow * cell + (inRow - 1) * RGAP)) / 2 + (i % COLS) * (cell + RGAP);
						const y0 = r * (BAND + RGAP);
						const w = Math.min(cell, BAND * a), h = w / a;
						cells.push({ x: x0, y: y0, w: cell, h: BAND });
						rects.push({ x: x0 + (cell - w) / 2, y: y0 + (BAND - h) / 2, w, h });
					});
					height = rowsN * BAND + (rowsN - 1) * RGAP;
				}
				const ms = performance.now() - t0;
				// Inset the wall by `pad` of the frame's width on all four sides.
				const pad = 0.04;
				const s = 1 - 2 * pad;
				const H = height * s + 2 * pad;
				frame.style.aspectRatio = String(1 / H);
				const place = (el: HTMLElement, r: { x: number; y: number; w: number; h: number }) => {
					el.style.left = `${(pad + r.x * s) * 100}%`;
					el.style.width = `${r.w * s * 100}%`;
					el.style.top = `${((pad + r.y * s) / H) * 100}%`;
					el.style.height = `${((r.h * s) / H) * 100}%`;
				};
				cells.forEach((c) => { const el = document.createElement('div'); el.className = 'cell'; place(el, c); frame.append(el); });
				rects.forEach((r, i) => {
					const el = document.createElement('button');
					el.type = 'button';
					el.className = 'box' + (marks[i] >= 3 ? ' warm' : '');
					place(el, r);
					el.textContent = ratio(marks[i]);
					// The last box stays: a wall needs one.
					el.disabled = marks.length <= 1;
					el.setAttribute('aria-label', `Box ${i + 1}, ${ratio(marks[i])}${el.disabled ? '' : ': remove'}`);
					el.addEventListener('click', () => { marks = marks.filter((_, k) => k !== i); render(); });
					frame.append(el);
				});
				const areas = rects.map((r) => r.w * r.h);
				const spread = Math.max(...areas) / Math.min(...areas);
				$('#rowsStats').innerHTML = `<span>largest box / smallest <b>${spread.toFixed(2)}×</b></span><span>rows <b>${equalArea ? 'balanced' : 'four, then the rest'}</b></span>${equalArea ? `<span>packed in <b>${ms < 0.1 ? 'under 0.1' : ms.toFixed(1)} ms</b></span>` : ''}`;
			}

			// A label that would spill out of its tile moves into the tile's tooltip.
			function fitLabels(frame: HTMLElement) {
				for (const el of frame.querySelectorAll<HTMLElement>('.box')) {
					const label = el.textContent || '';
					el.title = label;
					// Measure the text itself: centered text that spills out of both sides does not
					// show up in the tile's own scroll size.
					const probe = document.createElement('span');
					probe.textContent = label;
					el.replaceChildren(probe);
					if (probe.offsetWidth > el.clientWidth - 4 || probe.offsetHeight > el.clientHeight - 2) el.replaceChildren();
				}
			}
			function render() {
				if (!$('#panelTree').hidden) { renderTree(); fitLabels($('#treeFrame')); }
				if (!$('#panelRows').hidden) { renderRows(); fitLabels($('#rowsFrame')); }
			}
			render();
		</script>
	</body>
</html>
