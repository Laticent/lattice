---
import LibraryTheme from '../../../components/LibraryTheme.astro';
// Segno Languages — a standalone showcase driven by the REAL library (docs/src/lib/segno-markdown,
// the `@laticent/segno-languages` workspace; `./markdown` is its one language today). A Markdown
// deck in a textarea, and beside it what the deck model reads: the front matter, each slide's
// lines, the break above it and what it holds. Every edit goes through `updateDeckModel`, and each
// slide says whether that edit made the library read it again (docs/src/lib/segno-languages-demo.ts,
// held to the library by its unit test). Reached at /libraries/segno-languages/; its Learn page is
// /libraries/segno-languages/learn/ (src/content/catalog/).
import DemoBar from '../../../components/catalog/DemoBar.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Segno Languages — a deck's structure, read once</title>
		<link rel="icon" href="/segno-languages-mark-min.svg" type="image/svg+xml" />
		<LibraryTheme lib="segno-languages" />
		<style is:global>
			* { box-sizing: border-box; }
			body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); line-height: 1.5;
				-webkit-font-smoothing: antialiased; padding: clamp(16px, 4vw, 48px); }
			.wrap { max-width: 1040px; margin: 0 auto; }
			.brand { display: flex; align-items: center; gap: 13px; margin-top: 14px; }
			.brand img { width: 46px; height: 46px; }
			h1 { font-family: var(--serif); font-size: clamp(28px, 5vw, 40px); font-weight: 600; margin: 0; letter-spacing: -.01em; }
			h2 { font-family: var(--serif); font-size: 21px; font-weight: 600; margin: 0; }
			.promise { font-family: var(--serif); font-size: clamp(21px, 3vw, 27px); line-height: 1.3; max-width: 34ch; margin: 14px 0 0; text-wrap: balance; }
			.sub { color: var(--muted); font-size: 15px; max-width: 72ch; margin: 10px 0 0; }
			code { font-family: var(--mono); font-size: .92em; }
			.head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 16px; margin-top: 30px; }
			.head p { color: var(--muted); font-size: 13px; margin: 0; }
			.stagebox { margin-top: 12px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px; background: var(--stage);
				border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow); padding: clamp(12px, 2.4vw, 20px); }
			.pane { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
			.label { font-size: 12px; color: var(--muted); letter-spacing: .02em; }
			textarea { width: 100%; min-height: 560px; resize: vertical; background: var(--panel); color: var(--ink); border: 1px solid var(--line);
				border-radius: 12px; padding: 12px 14px; font: 13.5px/1.6 var(--mono); tab-size: 2; }
			textarea, code, pre { font-variant-ligatures: none; }
			textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
			.actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
			.actions button { background: var(--panel); color: var(--ink); border: 1px solid var(--line); border-radius: 999px; padding: 7px 15px; font: inherit; font-size: 13.5px; cursor: pointer; }
			.actions button:hover, .actions button:focus-visible { border-color: var(--accent); }
			.actions button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			.fm { margin: 0; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 8px 11px; font: 12.5px/1.55 var(--mono);
				white-space: pre-wrap; overflow-wrap: anywhere; color: var(--ink); }
			.fm-head { display: flex; justify-content: space-between; gap: 8px; font-family: var(--sans); font-size: 12px; color: var(--muted); padding-bottom: 2px; }
			.slides { list-style: none; padding: 0 2px 2px 0; margin: 0; display: flex; flex-direction: column; gap: 6px; flex: 1 1 0; min-height: 220px; overflow-y: auto; border-radius: 10px; }
			.slides:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			.slides button { width: 100%; text-align: left; display: grid; grid-template-columns: 1fr auto; gap: 1px 10px; background: var(--panel);
				color: var(--ink); border: 1px solid var(--line); border-radius: 10px; padding: 8px 11px; font: inherit; cursor: pointer; }
			.slides button:hover, .slides button:focus-visible { border-color: var(--accent); }
			.slides button:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
			.slides .num { font-size: 12px; color: var(--muted); font-weight: 600; letter-spacing: .02em; }
			.slides .title { grid-column: 1 / -1; font-size: 14px; font-weight: 600; overflow-wrap: anywhere; }
			.slides .title:empty::before { content: 'Empty'; color: var(--muted); font-weight: 400; }
			.slides .meta { grid-column: 1 / -1; font-family: var(--mono); font-size: 11.5px; color: var(--muted); overflow-wrap: anywhere; }
			.pill { font-size: 11.5px; font-weight: 600; padding: 0 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); align-self: start; }
			.slides li[data-state="reread"] button { background: var(--accent-bg); border-color: var(--accent); }
			.slides li[data-state="reread"] .num, .slides li[data-state="reread"] .meta { color: var(--ink); }
			.slides li[data-state="reread"] .pill { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
			.breaks { font-size: 12.5px; color: var(--muted); margin: 0; }
			.log { font-size: 13.5px; color: var(--ink); min-height: 1.5em; margin: 12px 0 0; }
			.stats { margin-top: 14px; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; }
			.stat { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; }
			.stat b { display: block; font-family: var(--mono); font-size: 20px; font-weight: 600; color: var(--accent); }
			.stat span { font-size: 12px; color: var(--muted); }
			.note { color: var(--muted); font-size: 13px; max-width: 78ch; margin-top: 16px; }
			@media (max-width: 720px) { .stagebox { grid-template-columns: 1fr; } textarea { min-height: 360px; } .slides { flex: none; min-height: 0; overflow: visible; } }
		</style>
	</head>
	<body>
		<main class="wrap">
			<DemoBar slug="segno-languages" />
			<div class="brand">
				<img src="/segno-languages-mark.svg" alt="" />
				<h1>Segno Languages</h1>
			</div>
			<p class="promise">Read a Markdown deck's structure once, then again only where it changed.</p>
			<p class="sub">
				The real <code>@laticent/segno-languages/markdown</code> reads the deck below in one CommonMark block pass: its front
				matter, its slides and the breaks between them. Edit it anywhere, and each slide says whether your edit made the
				library read it again. Besides the front matter's two, three <code>---</code> lines in this deck are not slide breaks; the model knows which.
			</p>

			<div class="head">
				<h2>Edit the deck</h2>
				<p>Type anywhere, or try one of the edits below.</p>
			</div>
			<div class="stagebox">
				<div class="pane">
					<span class="label" id="ed-label">The deck, in Markdown</span>
					<textarea id="ed" spellcheck="false" aria-labelledby="ed-label"></textarea>
					<div class="actions">
						<button id="type-in">Type in slide 3</button>
						<button id="split">Split slide 2</button>
						<button id="front">Edit the front matter</button>
						<button id="reset">Reset</button>
					</div>
				</div>
				<div class="pane">
					<span class="label" id="m-label">What the model reads</span>
					<div class="fm">
						<div class="fm-head"><span>Front matter</span><span id="fm-lines"></span></div>
						<span id="fm"></span>
					</div>
					<ol class="slides" id="slides" tabindex="0" aria-labelledby="m-label"></ol>
					<p class="breaks" id="breaks"></p>
				</div>
			</div>
			<p class="log" id="log" aria-live="polite"></p>

			<div class="stats">
				<div class="stat"><b id="s-slides">0</b><span>slides</span></div>
				<div class="stat"><b id="s-reread">0</b><span>lines read on the last edit, of <span id="s-lines"></span></span></div>
				<div class="stat"><b id="s-reused">0</b><span>slides reused as they were</span></div>
				<div class="stat"><b id="s-ms">0</b><span>ms for the last update</span></div>
			</div>
			<p class="note">
				Click a slide to select it in the deck. A slide break is a <code>---</code> outside every list, quote and fence, so the
				parser's state just after one is empty: <code>updateDeckModel</code> re-parses from the break above your edit, stops
				at the first break below it that the old parse also had, and keeps every other slide as it was. An edit in the front
				matter reads the whole deck again. Line numbers here are the editor's; the library counts from the line after the
				front matter.
			</p>
		</main>

		<script>
			import { breakLines, build, frontMatterLines, SAMPLE, slideEnd, slideViews, step, titleEnd } from '../../../lib/segno-languages-demo';

			const $ = (id) => document.getElementById(id);
			const ed = $('ed');
			let model = build(SAMPLE);
			const plural = (n, one, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;

			function render(reread) {
				const fm = frontMatterLines(model);
				$('fm').textContent = fm ? model.text.slice(0, model.bodyStart).replace(/\n$/, '') : 'None';
				$('fm-lines').textContent = fm ? `lines 1–${fm}` : '';
				const views = slideViews(model);
				const list = $('slides');
				list.replaceChildren();
				for (const v of views) {
					const li = document.createElement('li');
					li.dataset.state = reread ? (reread.includes(v.index) ? 'reread' : 'reused') : 'read';
					const b = document.createElement('button');
					const num = document.createElement('span');
					num.className = 'num';
					num.textContent = `Slide ${v.index + 1}`;
					const pill = document.createElement('span');
					pill.className = 'pill';
					pill.textContent = li.dataset.state === 'reread' ? 'Read again' : li.dataset.state === 'reused' ? 'Reused' : 'Read';
					const title = document.createElement('span');
					title.className = 'title';
					title.textContent = v.title;
					const meta = document.createElement('span');
					meta.className = 'meta';
					const parts = [v.from === null ? 'no lines' : `lines ${v.from}–${v.to}`];
					if (v.sep !== null) parts.push(`break on ${v.sep}`);
					if (v.fences) parts.push(plural(v.fences, 'fence'));
					if (v.directives) parts.push(plural(v.directives, 'directive'));
					meta.textContent = parts.join(' · ');
					b.append(num, pill, title, meta);
					b.addEventListener('click', () => {
						const s = model.slides[v.index];
						const from = model.bodyStart + model.lineStart(s.fromLine);
						const to = model.bodyStart + model.lineEnd(Math.max(s.fromLine, s.toLine - 1));
						ed.focus();
						ed.setSelectionRange(from, to);
					});
					li.append(b);
					list.append(li);
				}
				const breaks = breakLines(model);
				$('breaks').textContent = breaks.length ? `Slide breaks on lines ${breaks.join(', ')}.` : 'No slide breaks.';
				$('s-slides').textContent = String(views.length);
				$('s-lines').textContent = String(model.lines);
			}

			function update() {
				const t0 = performance.now();
				const r = step(model, ed.value);
				const ms = performance.now() - t0;
				if (r.model === model) return;
				model = r.model;
				render(r.reread);
				const total = model.slides.length;
				$('s-reread').textContent = String(r.rereadLines);
				$('s-reused').textContent = String(total - r.reread.length);
				$('s-ms').textContent = ms.toFixed(2);
				const which = r.reread.map((i) => i + 1);
				$('log').textContent = r.full
					? `The front matter changed, so the whole deck was read again: ${plural(r.rereadLines, 'line')}.`
					: `Read ${which.length === 1 ? `slide ${which[0]}` : `slides ${which.join(' and ')}`} again (${plural(r.rereadLines, 'line')}) and reused the other ${plural(total - which.length, 'slide')}.`;
			}

			function apply(next, caret) {
				ed.value = next;
				ed.setSelectionRange(caret, caret);
				update();
			}

			function reset() {
				ed.value = SAMPLE;
				model = build(SAMPLE);
				render(null);
				$('s-reread').textContent = String(model.lines);
				$('s-reused').textContent = '0';
				$('s-ms').textContent = '0';
				$('log').textContent = `Read the whole deck from nothing: ${plural(model.slides.length, 'slide')}, ${plural(model.lines, 'line')} after the front matter.`;
			}

			$('type-in').addEventListener('click', () => {
				if (model.slides.length < 3) return;
				const at = titleEnd(model, 2);
				apply(`${ed.value.slice(0, at)} again${ed.value.slice(at)}`, at + 6);
			});
			$('split').addEventListener('click', () => {
				if (model.slides.length < 2) return;
				const at = slideEnd(model, 1);
				const add = '\n\n---\n\n## A new slide';
				apply(ed.value.slice(0, at) + add + ed.value.slice(at), at + add.length);
			});
			$('front').addEventListener('click', () => {
				const text = ed.value;
				const m = /^paginate: (true|false)$/m.exec(text.slice(0, model.bodyStart));
				if (m) apply(text.slice(0, m.index) + `paginate: ${m[1] === 'true' ? 'false' : 'true'}` + text.slice(m.index + m[0].length), m.index + m[0].length);
				else if (model.bodyStart > 0) apply(`---\npaginate: true\n${text.slice(4)}`, 17);
				else apply(`---\npaginate: true\n---\n\n${text}`, 17);
			});
			$('reset').addEventListener('click', reset);
			ed.addEventListener('input', update);
			reset();
		</script>
	</body>
</html>
