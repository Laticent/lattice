---
// Lattice playground — a standalone Astro route (like the landing) that runs
// the owned Lattice engine client-side via docs/public/playground/
// lattice-playground.js. Type Lattice markdown, pick a component template, see
// it render live in the chosen palette.
//
// Phase 3 of the shadcn migration: the surface is a React + shadcn island
// (PlaygroundApp, mounted through the PlaygroundIsland wrapper so its effects
// run under React StrictMode — a dev-only double-mount that surfaces
// missing-cleanup leaks; no-op in prod). Astro owns the page shell (head, topbar, the engine
// <script> tags); React owns the toolbar, editor host, preview iframe, and the
// Sheets — WRAPPING the irreducible engine pieces (CodeMirror editor.js, the
// filmstrip deck-preview.js, the shared deck-config.js, window.LatticePlayground)
// rather than reimplementing them. See engineering/decisions/2026-06-09-shadcn-migration.md §0.
import { createRequire } from 'node:module';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/landing.css';
import '../styles/playground.css';
import '../styles/deck-config.css';
import '../styles/chart-interact.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import ResourceHints from '../components/site/ResourceHints.astro';
import RuntimeWarm from '../components/site/RuntimeWarm.astro';
import ColorSchemeSeed from '../components/site/ColorSchemeSeed.astro';
import PlaygroundIsland from '../components/playground/PlaygroundIsland.tsx';
import { buildCatalog, buildLenses } from '../lib/families.mjs';
import { PG_SPLIT_BUCKET, PG_SPLIT_KEY, PG_SPLIT_MIN, PG_SPLIT_PANEL_IDS, PG_SPLIT_SNAP_MIDPOINT } from '../components/playground/pg-split';
// The storage keys the pre-paint seed reads, from the module that DECLARES them rather
// than restated as literals in the inline script. `playground-controller.ts` has no
// imports of its own, so an Astro page can pull five strings out of it without dragging
// React or the island into this page's module graph — the same reason `pg-split.ts`
// exists (#1495). Closes the drift risk the 2026-08-10 boot-state note recorded as a
// known gap: a renamed key used to fail SILENTLY here, seeding the wrong first paint.
import { HANDOFF_KEY, INSERTED_HASH_KEY, SOURCE_KEY, VIEW_KEY } from '../lib/playground-controller';
import { joinBase } from '../lib/base-url.mjs';
import { isPreviewDeploy } from '../lib/deploy-env.mjs';
import { assetBase } from '../playground/asset-version.mjs';
import { loadGalleries, GALLERY_GROUPS } from '../playground/galleries.mjs';

const docsRoot = process.cwd();
const repoRoot = join(docsRoot, '..');
const require = createRequire(import.meta.url);
const { loadAll, manifestBucket } = require(join(repoRoot, 'lib/components', 'index.js'));
const { FINISH_NAMES } = require(join(repoRoot, 'lib/core', 'resolve-finish.js'));
const manifests = loadAll();

const base = import.meta.env.BASE_URL;
const url = (p) => joinBase(base, p);
// Cache-busted prefix for the playground's runtime-fetched assets (see
// asset-version.mjs); the bare `playground/` route is unchanged.
const pg = assetBase();

// Guided tours run on the production site only — never local dev or the
// Cloudflare PR previews. Baked into the HTML so the client gate is build-time.
const previewDeploy = isPreviewDeploy({
	dev: import.meta.env.DEV,
	cfPages: process.env.CF_PAGES,
	cfBranch: process.env.CF_PAGES_BRANCH,
});

const tokensCss = readFileSync(join(docsRoot, 'src/styles/lattice-tokens.generated.css'), 'utf8');
const palettes = [...new Set([...tokensCss.matchAll(/data-palette="([^"]+)"/g)].map((m) => m[1]))];

// Template catalog for the picker. Each component carries its documented
// variants (modifiers) so the Variant dropdown can load any of them into the
// editor. The `components` array (the Function·Form·Substance / family / tags
// fields) feeds the searchable, groupable popover picker — reusing the same
// buildCatalog + the shared search-core the component reference browses with.
const catalog = {};
for (const m of manifests) {
	const variantDocs = m.variantDocs || {};
	const variantKeys = Array.isArray(m.variants) ? m.variants.filter((v) => variantDocs[v]) : [];
	catalog[m.name] = {
		skeleton: m.skeleton,
		sample: m.sample || m.skeleton,
		variants: variantKeys.map((v) => ({ key: v, label: v, caption: variantDocs[v].summary || '', sample: variantDocs[v].sample })),
	};
}
const components = buildCatalog(manifests, manifestBucket);
const lenses = buildLenses();

// Inline-validation vocabulary — the SAME deck-grammar vocab the Drawing Board's
// Architect lints from, computed here at build time from the live manifests so the
// playground editor's underlines recognize every component/modifier/region. Map
// Sets are serialized to arrays for the page handoff (rehydrated by buildVocabSets).
const { buildVocab } = require(join(repoRoot, 'lib/authoring', 'lint.js'));
const _vocab = buildVocab(manifests);
const lintVocab = {
	names: [..._vocab.names],
	modifiers: [..._vocab.modifiers],
	universalModifiers: [..._vocab.universalModifiers],
	mapRegions: Object.fromEntries(
		Object.entries(_vocab.mapRegions || {}).map(([k, v]) => [k, { valid: [...v.valid], names: v.names }]),
	),
	finishNames: _vocab.finishNames || [],
	modeNames: _vocab.modeNames || [],
	splitNames: _vocab.splitNames || [],
	capacity: _vocab.capacity || {},
	// The registered `@size` geometry, so the editor derives the deck's adaptive
	// family from the same numbers the renderer resolves rather than from a name
	// table (#1218). All three vocab handoffs — here, studio.astro and
	// studio.astro — must carry it; this one was missed on the first pass.
	sizes: _vocab.sizes || {},
};

// Starter deck = the hero component's sample (verdict-grid).
const heroComp = manifests.find((m) => m.showcase && m.showcase.hero);
const starter = (heroComp && heroComp.sample) || '<!-- _class: title silent -->\n\n# Lattice\n';

// Full showcase + per-family survey decks for the "Load a deck" drawer. Loaded
// from repo markdown at build time (galleries.mjs), with local image assets
// inlined as data URIs so the preview iframe renders them. The Sheet renders
// labels + slide counts; the controller maps id → source.
const galleries = loadGalleries(repoRoot);
const galleryGroups = GALLERY_GROUPS.map((grp) => ({
	key: grp.key,
	hint: grp.hint,
	items: galleries
		.filter((g) => g.group === grp.key)
		.map((g) => ({ id: g.id, label: g.label, slides: g.slides })),
})).filter((grp) => grp.items.length);
const gallerySources = Object.fromEntries(galleries.map((g) => [g.id, g.source]));

// The full data payload for the React island. Passed as a prop (Astro
// serializes it); the deck sources can contain a literal `</script>` (the jargon
// gallery ends with two), but as a serialized prop — not an inline <script> —
// Astro escapes it safely, so the old `<` hand-escape is no longer needed.
const pgData = {
	catalog,
	components,
	lenses,
	gallerySources,
	galleryGroups,
	themeBase: url(pg + 'themes/'),
	runtimeUrl: url(pg + 'lattice-runtime.js'),
	engineUrl: url(pg + 'lattice-playground.js'),
	// Self-hosted Mermaid + KaTeX (staged by sync-playground-assets), so a
	// diagram/math preview renders from our own origin instead of jsdelivr.
	mermaidUrl: url(pg + 'export/mermaid-v11.min.js'),
	katexUrl: url(pg + 'katex/katex.min.css'),
	plansBase: url(pg + 'plans/'),
	palettes,
	finishes: FINISH_NAMES,
	lintVocab,
	starter,
};
---

<!doctype html>
<html lang="en" data-palette="cuoio" data-mode="light" data-tours={previewDeploy ? 'off' : 'on'}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		{/* FIRST thing after the charset/viewport metas: pin color-scheme to the app mode so the
		    blank canvas (shown while the render-blocking CSS loads) is never a white flash — even
		    for a dark-app visitor on a light-OS device. Must precede ResourceHints + the seed. */}
		<ColorSchemeSeed />
		<ResourceHints />
		{/* Prefetch the preview runtime at parse time so the first live render's
		    iframe finds it warm instead of cold-fetching it on the critical path
		    (the FRAME REBUILD cost). Overlaps island hydration + the engine load. */}
		<RuntimeWarm />
		<title>Lattice playground — try it in the browser</title>
		<meta name="description" content="Write Lattice Markdown and watch it render to boardroom slides live in your browser. Start from any component template." />
		<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
		<script
			is:inline
			define:vars={{
				validPalettes: palettes,
				PG_SPLIT_KEY,
				PG_SPLIT_BUCKET,
				PG_SPLIT_PANEL_IDS,
				PG_SPLIT_MIN,
				PG_SPLIT_SNAP_MIDPOINT,
				SOURCE_KEY,
				VIEW_KEY,
				HANDOFF_KEY,
				INSERTED_HASH_KEY,
				// The app clamps the boot view to Edit when the host stages no walk plans (the
				// test harness). Baked in at build time so the mirror below cannot diverge on
				// that branch either.
				exploreAvailable: !!pgData.plansBase,
			}}
		>
			(function () {
				var r = document.documentElement;
				try {
					var p = localStorage.getItem('lattice-docs-palette');
					// Only adopt a persisted palette that is still a registered theme. A
					// retired/renamed palette from an earlier session would 404 its theme
					// CSS and blank the live preview (the "blank in my browser, fine in
					// private browsing" report); drop it so we keep the default data-palette
					// and it self-heals instead of failing every render.
					if (p && validPalettes.indexOf(p) !== -1) r.setAttribute('data-palette', p);
					else if (p) localStorage.removeItem('lattice-docs-palette');
					var m = localStorage.getItem('lattice-docs-mode');
					if (m === 'light' || m === 'dark') r.setAttribute('data-mode', m);
					else if (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) r.setAttribute('data-mode', 'dark');
					// (color-scheme is pinned earlier, by <ColorSchemeSeed> at the top of <head>.)
					// Focus mode (toolbar hidden) — seeded on <html> before the island
					// hydrates so a returning focus-mode visitor never sees the SSR toolbar
					// flash then vanish. PlaygroundApp owns the attribute after hydration.
					if (localStorage.getItem('lattice-docs-pg-focus') === '1') r.setAttribute('data-pg-focus', '');
					// SPLIT SEED (#1553) — reinstated, and the note it replaces was wrong about why
					// it couldn't work. Retiring it in the 2026-07-19 migration assumed "the library
					// owns the panel's inline flex, so a CSS var can't seed it". Before hydration the
					// library owns no such thing: the server-rendered wrapper has NO inline
					// flex-grow, and its inline `flex-basis:45` is a unitless number the CSS parser
					// throws away. So the panes size to CONTENT and leave the row empty — measured on
					// an iPad reload as an 85px editor and a 205px preview against a blank viewport,
					// which is the jank this seeds away. The stylesheet owns that window (see
					// playground.css) and the library takes the layout back the moment it hydrates.
					// Values are the SHARES the app itself saved, read through the shared contract
					// (pg-split.ts) rather than a restated key + bucket string, so a rename in the
					// hook cannot silently miss this lookup.
					try {
						var pgStore = JSON.parse(localStorage.getItem(PG_SPLIT_KEY) || 'null');
						var pgSaved = pgStore && pgStore[PG_SPLIT_BUCKET];
						if (pgSaved) {
							var pgA = pgSaved[PG_SPLIT_PANEL_IDS[0]], pgB = pgSaved[PG_SPLIT_PANEL_IDS[1]];
							// Both must be real, FINITE, positive numbers: a half-written or corrupt entry falls
							// through to the CSS fallbacks, which are the panels' own defaults. `Number.isFinite`
							// and not `> 0` alone — `JSON.parse('1e400')` is `Infinity`, which is a number, is
							// positive, and is not a valid `flex-grow` token, so the parser drops the declaration
							// and the pane sizes to its content. (Same for the #1800 reservation's `flex`
							// shorthand, which spends the same var.)
							if (isFinite(pgA) && isFinite(pgB) && typeof pgA === 'number' && typeof pgB === 'number' && pgA > 0 && pgB > 0) {
								r.style.setProperty('--pg-split-a', String(pgA));
								r.style.setProperty('--pg-split-b', String(pgB));
								// …AND THE PANES' PIXEL MINIMUMS (#1589). The saved value is a pair of PERCENTAGES;
								// the library bounds each pane by a minimum in PIXELS. A share that clears its minimum
								// at the window it was saved in can fall below it at a narrower one, and then the seed
								// and the hydrated app disagree — measured by dragging the real divider to a 25%
								// preview at 1920 and reloading at 1194: 298.3px pre-paint against 320px after, the
								// divider moving 22px in view, and the instant shell declining outright because its
								// slide had been measured in a box that no longer existed.
								//
								// BUT RESTORING IS NOT A CLAMP, and a first draft of this seed got that wrong in a way
								// that was WORSE than the defect it fixed. `react-resizable-panels` resolves an
								// under-minimum size in two branches (`Z()` in its bundle): a collapsible pane restored
								// below the MIDPOINT of `collapsedSize` and `minSize` snaps to the 28px rail; only above
								// that midpoint does it clamp to the minimum. Modeling the clamp alone painted a 320px
								// preview where the app then handed off to a 28px rail — 292px wrong, held ~1.3 seconds,
								// on the share the divider leaves behind the moment it is dragged past its minimum (the
								// collapse button's own tooltip advertises that gesture). The Studio's shell learned
								// this first and wrote it down in `preview-rect.ts`; this missed it.
								//
								// So the clamp is scoped to the width band where the library actually clamps. The
								// threshold is a GROUP width, and the group spans the viewport on this surface (the
								// page column has no horizontal padding — measured 873 + 320 + a 1px separator at a
								// 1194 viewport), so a media query expresses it exactly and — unlike reading
								// `innerWidth` here — stays right if the window is resized before hydration.
								//
								// Below the threshold no rule applies and the raw share paints, which is what shipped
								// before any of this: the pane is a little wrong for a beat rather than 292px wrong.
								// Reproducing the rail here would need the seed to model the snap as well, and a
								// mis-modeled snap fails in the same expensive direction — so it declines instead.
								var pgTotal = pgA + pgB;
								var pgRules = '';
								for (var pgI = 0; pgI < 2; pgI++) {
									var pgKey = pgI === 0 ? 'editor' : 'preview';
									var pgShare = pgI === 0 ? pgA : pgB;
									// The narrowest GROUP at which this pane still lands on the clamp branch. `+ 1` for the
									// separator the group's width excludes; 821 because below the tab breakpoint the split
									// is disabled and the panes are stacked full-width, where a pixel minimum means nothing.
									var pgAt = Math.max(821, Math.ceil(PG_SPLIT_SNAP_MIDPOINT[pgKey] * pgTotal / pgShare) + 1);
									pgRules += '@media (min-width:' + pgAt + 'px){:root[data-pg-split-seed] .pg-split>#' +
										PG_SPLIT_PANEL_IDS[pgI] + '{min-width:' + PG_SPLIT_MIN[pgKey] + 'px!important}}';
								}
								// `!important` because the SSR'd panel wrapper carries `min-width:0` INLINE. Setting the
								// pixel minimum on the ELEMENT instead would win the cascade and then never be undone:
								// React's prop record would still read `0`, so the library would never write over it and
								// the clamp would outlive the seed for the life of the page.
								var pgStyle = document.createElement('style');
								pgStyle.textContent = pgRules;
								(document.head || r).appendChild(pgStyle);
								// The rules key on this attribute and DIE with it: `adoptBootSeed` drops it when the app
								// takes the layout back, because a min-width that outlived the seed would stop a pane the
								// visitor collapses from ever reaching its 28px rail.
								r.setAttribute('data-pg-split-seed', '');
							}
						}
					} catch (e2) {}
					// BOOT-VIEW SEED (#1563). `body[data-view]` is the single biggest piece of
					// client-only state on this surface: in Explore it removes the editor pane,
					// takes the preview full-bleed, drops both pane labels and moves the walk bar to
					// the foot of the column. The app resolved it in a mount effect, so a returning
					// Explore visitor got the EDIT layout at first paint and watched it rebuild
					// ~900ms later (measured at 1194x834, CPU throttled 6x: the editor pane 337px
					// wide then gone, the preview 856 → 1194 → 1194x619). Resolve it here instead and
					// publish it on <html>, which playground.css reads alongside the body attribute;
					// the app takes ownership at mount and drops it.
					//
					// This is a MIRROR of resolveStartupView (playground-controller.ts) — an inline
					// pre-paint script cannot import — so the two drifting apart is the one way it
					// can silently break. `playground-first-paint.spec.ts` drives every branch of the
					// precedence table on the real page and requires the pre-paint answer to equal
					// the hydrated one.
					try {
					var src = '';
					try { src = localStorage.getItem(SOURCE_KEY) || ''; } catch (e3) {}
					var ih = null;
					try { ih = localStorage.getItem(INSERTED_HASH_KEY); } catch (e3) {}
					var hasHandoff = false;
					try {
						var hv = JSON.parse(localStorage.getItem(HANDOFF_KEY) || 'null');
						hasHandoff = !!(hv && typeof hv.md === 'string' && hv.md);
					} catch (e3) {}
					var rawView = new URLSearchParams(location.search || '').get('view');
					var urlView = rawView === 'read' || rawView === 'explore' ? 'read' : rawView === 'edit' ? 'edit' : null;
					var savedView = null;
					try { savedView = localStorage.getItem(VIEW_KEY); } catch (e3) {}
					// djb2 hex — byte-identical to `fingerprint` in playground-controller.ts, so the
					// pristine test here reaches the same verdict the app's will.
					var fp = function (t) {
						var h = 5381;
						for (var i = 0; i < t.length; i++) h = ((h << 5) + h + t.charCodeAt(i)) | 0;
						return (h >>> 0).toString(16);
					};
					var pristine = !src || !src.trim() ? true : ih != null && fp(src) === ih;
					var view;
					if (hasHandoff) view = 'edit';
					else if (urlView) view = urlView;
					else if (savedView === 'read' || savedView === 'edit') view = savedView;
					else view = pristine ? 'read' : 'edit';
					if (!exploreAvailable) view = 'edit';
					r.setAttribute('data-pg-view', view);
					// The single-pane phone layout keys off body[data-pane], derived from the same
					// answer (Explore shows the deck, Edit the editor). Seeded on <html> for the same
					// reason, and consumed by the same aliased selectors.
					r.setAttribute('data-pg-pane', view === 'read' ? 'preview' : 'edit');
					// Hand the resolution to the body-parse replay below rather than have it
					// recompute — ONE mirror on this page, not two. `hasHandoff` also travels to
					// the APP (PlaygroundApp's startup effect), because this read is the only one
					// that happens before a child effect can consume the one-shot key.
					window.__pgBoot = { view: view, hasHandoff: hasHandoff, src: src, insertedHash: ih, fp: fp };
					} catch (e4) {}
				} catch (e) {}
			})();
		</script>
	</head>
	<body class="pg-page">
		<SiteHeader palettes={palettes} wide={true} />

		<!-- The playground surface: one React + shadcn island owning the toolbar
		     (component Popover+Command picker, variant Select, mobile Edit/Preview
		     Tabs, status, the Deck-setup + Galleries Sheets), the CodeMirror editor
		     host, and the preview iframe. -->
		<PlaygroundIsland client:load data={pgData} />

		<!-- Instant-shell pre-paint replay (kill the cold-load preview flash). Runs
		     inline during body parse — BEFORE the island hydrates + the on-demand engine
		     bundle loads — so a returning visitor's real first slide paints immediately
		     instead of white→black→slides. Reads the Playground's OWN snapshot key and
		     paints ONLY when the app will boot into Edit showing the SAME draft: it
		     mirrors resolveStartupView (a handoff, an explicit/persisted Explore view, or
		     a pristine draft all boot different content), and matches palette + mode +
		     a hash of the persisted source. Any mismatch paints nothing — the dark
		     loading skeleton covers the window — so a wrong deck can never flash.
		     Injects the cached slide HTML (already sanitized at the #22 capture + storage
		     chokepoints in snapshot-cache.js) into the SSR'd #pg-ssr-slidebox, and stashes
		     it on window.__pgShellHtml for React to adopt. HARD RULE #22 sink: sanctioned
		     in SANCTIONED_SNAPSHOT_SINKS (tools/check-ownership.js). -->
		<script is:inline>
			(function () {
				var root = document.documentElement;
				var box = document.getElementById('pg-ssr-slidebox');
				if (!box) return;
				var palette = root.getAttribute('data-palette') || 'cuoio';
				var mode = root.getAttribute('data-mode') === 'dark' ? 'dark' : 'light';
				try {
					// The boot resolution is the head seed's — recomputing it here would be a
					// SECOND mirror of resolveStartupView on one page, free to drift from the
					// first (#1563). Only an Edit boot shows the draft: a handoff forces Edit but
					// REPLACES the draft (so its post-apply content differs) → don't paint; an
					// explicit/persisted Explore view boots a gallery deck; a pristine draft opens
					// Explore. Paint only on a genuine Edit-of-this-draft.
					var boot = window.__pgBoot;
					if (!boot || boot.view !== 'edit' || boot.hasHandoff) return;
					var src = boot.src;
					var ih = boot.insertedHash;
					// djb2 hex — the same hash the capture stamps, so the two agree on identity.
					var fp = boot.fp;
					var raw = localStorage.getItem('lattice-docs-pg-last-slide');
					if (!raw) return;
					var snap = JSON.parse(raw);
					// WHAT IS ABOUT TO RENDER, hashed — and it is NOT always `fp(src)` (#1553).
					// `pg-source` holds the visitor's DRAFT, and it only exists once they have typed
					// into the editor. A visitor who only ever picks components never writes one, so
					// `src` is '' and `fp(src)` is the hash of the empty string — which never equals
					// the hash the capture stamped from the source it actually rendered. That single
					// clause switched this whole instant shell off for everyone who had not hand-
					// edited a deck: measured, every other clause passed (v1, palette, mode, html,
					// css) and this one failed '96ae8e9b' vs '1505', so `data-pg-shell` was never
					// set, `.pg-ssr-shell` stayed `display:none`, and the preview pane was an empty
					// void until the engine rendered.
					// With no draft, the identity of what will render is the INSERTED hash — the
					// same `ih` the `pristine` test above already relies on for exactly this reason.
					// Absent both, we do not know what is coming and must not paint.
					var willRender = src && src.trim() ? fp(src) : ih;
					var fit = snap && snap.fit;
					if (
						snap && snap.v === 2 && snap.palette === palette && snap.mode === mode && snap.html && snap.css &&
						willRender && snap.srcHash === willRender &&
						fit && fit.boxW > 0 && fit.boxH > 0 && fit.w > 0 && fit.h > 0
					) {
						// PLACE THE CACHED SLIDE WHERE THE LIVE ONE IS ABOUT TO LAND (#1563).
						//
						// This used to derive its own geometry — center the slide in the pane, less a
						// 16px padding — and the live filmstrip derives a DIFFERENT one, from an
						// `html,body{padding:18px}` that applies to BOTH elements plus a `safe center`
						// on a clamped deck height. Measured at 1194x834 with the split dragged: the
						// cached slide painted at [354,261,824x464] and the live one arrived at
						// [374,290,784x441] — 20px right, 29px down and 40px narrower. So the slide a
						// person had been looking at for three seconds shrank and jumped as the engine
						// took over.
						//
						// Reproducing the filmstrip's chain here would be a second model of a layout
						// the srcdoc's CSS already owns — the drift engine the Studio's shell is made
						// of. Instead the app MEASURES its own live slide at capture time and stores
						// the rect (`snap.fit`, in preview-wrap coordinates, alongside the wrap size it
						// was measured in); this replays that measurement verbatim.
						//
						// A MEASUREMENT IS ONLY VALID FOR THE BOX IT WAS TAKEN IN. An earlier draft
						// rescaled into a different box — width by the pure ratio, the vertical by the
						// ratio of the slack — and claimed that reproduced a centered slide exactly. It
						// does not: the filmstrip centers at `18 + (boxH - h)/2`, because the srcdoc's
						// html padding sits OUTSIDE the box it centers in, so a slack ratio is off by
						// `18 * dBoxH / (boxH - h)` vertically and `72 * dBoxW / boxW` across. Measured
						// on a frozen snapshot replayed into a resized window: 5.1px and 18.3px out.
						// The rescale was exact only where it did nothing.
						//
						// So we do not guess. If the pane is not the pane the measurement was taken in,
						// paint nothing: the visitor gets the pane's brand fill for a beat — a blank
						// that never moves — instead of a slide that jumps, which is the whole defect
						// this mechanism exists to remove. The next capture re-measures at the new size
						// and the load after that is exact again. A pixel of tolerance absorbs the
						// sub-pixel rounding of a fractional pane width.
						var wrap = box.parentElement;
						var boxW = wrap ? wrap.clientWidth : box.clientWidth;
						var boxH = wrap ? wrap.clientHeight : box.clientHeight;
						if (Math.abs(boxW - fit.boxW) > 1 || Math.abs(boxH - fit.boxH) > 1) return;
						var sw = snap.w || 1280;
						var sh = snap.h || 720;
						var st = document.createElement('style');
						st.id = 'pg-ssr-snap-css';
						st.textContent = snap.css;
						document.head.appendChild(st);
						// Set as custom props on the box (not on a child) so React's
						// dangerouslySetInnerHTML re-parse can't wipe them.
						box.style.setProperty('--pg-ssr-w', sw + 'px');
						box.style.setProperty('--pg-ssr-h', sh + 'px');
						box.style.setProperty('--pg-ssr-scale', String(fit.w / sw));
						box.style.setProperty('--pg-ssr-x', fit.x + 'px');
						box.style.setProperty('--pg-ssr-y', fit.y + 'px');
						box.innerHTML = snap.html;
						window.__pgShellHtml = snap.html;
						root.setAttribute('data-pg-shell', 'on');
						// FOLD IF THE PANE MOVES UNDER US. The placement is absolute and computed once,
						// so a pane that changes size after this point leaves the cached slide the wrong
						// size AND in the wrong place — it overflows and clips, where the old centered
						// shell would merely have been the wrong size. Two real triggers: the visitor
						// resizing during the ~2s the shell is up, and the split seed writing a share the
						// library then clamps to its 320px minimum at hydration (measured 238px pre-paint
						// against 320px after). Withdrawing beats correcting: the same reasoning as the
						// box check above, one moment later.
						if (wrap && typeof ResizeObserver === 'function') {
							var ro = new ResizeObserver(function () {
								if (Math.abs(wrap.clientWidth - fit.boxW) <= 1 && Math.abs(wrap.clientHeight - fit.boxH) <= 1) return;
								root.removeAttribute('data-pg-shell');
								ro.disconnect();
							});
							ro.observe(wrap);
						}
					}
				} catch (e) {}
			})();
		</script>

		<!-- Editor pre-paint seed (#1563). The SSR'd <pre> placeholder carries the STARTER
		     deck — the only source the build knows — but CodeMirror is about to open the
		     visitor's saved draft. For anyone who has edited anything, the editor therefore
		     paints one deck and replaces it with another a second later. The draft is in
		     localStorage, so write it in before first paint and stash it for React to render
		     the same value (EditorHost), which makes hydration a no-op rather than a swap
		     back. Plain textContent — never innerHTML — so the draft is inert text here. -->
		<script is:inline>
			(function () {
				try {
					var boot = window.__pgBoot;
					var draft = boot && boot.src;
					if (!draft || !draft.trim()) return;
					var ph = document.querySelector('.pg-editor-placeholder');
					if (!ph) return;
					ph.textContent = draft;
					window.__pgEditorSeed = draft;
				} catch (e) {}
			})();
		</script>

		<!-- Guided tour: first-visit walkthrough + replay button (driver.js). The
		     tour targets the live DOM by selector, so it runs after the island
		     hydrates; it's unchanged from the vanilla surface. -->
		<script>
			import { initPlaygroundTour } from '../playground/playground-tour.js';
			initPlaygroundTour();
		</script>

		<!-- Bridge: expose the shared filmstrip-preview controller (deck-preview.js)
		     on window so the React render loop (playground-engine.ts) can drive the
		     iframe write/patch/fit through one implementation (also used by the
		     Drawing Board and both Workbench studios). Deferred like the engine
		     bundle; the controller guards on window.LatticeDeckPreview's presence. -->
		<script>
			import { renderDeck } from '../playground/deck-preview.js';
			window.LatticeDeckPreview = { renderDeck };
		</script>

		<!-- The Lattice render engine (window.LatticePlayground) is loaded ON DEMAND by
		     load-engine.ts (PlaygroundApp triggers it on idle, after the chrome
		     paints), not eagerly here — so the toolbar + editor host paint without
		     the ~554KB-gz bundle blocking. The render loop polls for the global. -->

	</body>
</html>
