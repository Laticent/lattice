---
// The Studio — the unified workspace prototype from the redesign decision doc
// (engineering/decisions/2026-06-21-app-redesign.md). A single standalone route
// that renders the v4 lean shell as ONE React island — StudioShell, mounted
// through the StudioIsland wrapper so its effects run under React StrictMode
// (a dev-only double-mount that surfaces missing-cleanup leaks; no-op in prod) —
// wired live:
// a real CodeMirror editor, a live engine preview (DeckPreview), the Architect,
// the deck Inspector, Share / Workspace / Present overlays, the ⌘K palette, and
// the Fabricate studio. It is ADDITIVE — it does not touch the shipped Drawing
// Board / Playground; the engine is loaded on demand exactly as those do.
import '../styles/landing.css';
import StudioIsland from '../components/studio/StudioIsland.tsx';
import { StudioActivityRailSkeleton, StudioChromeSkeleton, StudioEditorPaneSkeleton, StudioPreviewBarSkeleton, StudioPreviewFooterSkeleton } from '../components/studio/StudioChromeSkeleton.tsx';
import CrashSentinel from '../components/studio/CrashSentinel.astro';
import VizDiagnosticsOverlay from '../components/studio/VizDiagnosticsOverlay.astro';
import ViewportDebugOverlay from '../components/studio/ViewportDebugOverlay.astro';
import PreviewFidelityOverlay from '../components/studio/PreviewFidelityOverlay.astro';
import SkipLink from '../components/SkipLink.astro';
import ResourceHints from '../components/site/ResourceHints.astro';
import ColorSchemeSeed from '../components/site/ColorSchemeSeed.astro';
import EngineWarm from '../components/site/EngineWarm.astro';
import RuntimeWarm from '../components/site/RuntimeWarm.astro';
import { joinBase } from '../lib/base-url.mjs';
import { buildStudioCatalog } from '../lib/studio-catalog.mjs';
import { assetBase } from '../playground/asset-version.mjs';
import { DECKS, deckSource } from '../components/studio/decks';
import { SIZE_RATIO, deckRatio } from '../components/studio/slide-size';
import { PREVIEW_CHROME, PREVIEW_RECT_KEY, STUDIO_SPLIT_BUCKET, STUDIO_SPLIT_COLLAPSE_KEY, STUDIO_SPLIT_KEY, STUDIO_SPLIT_PANEL_IDS } from '../components/studio/preview-rect';
import { BOOT_POSTURE, LEGACY_ONBOARDED_POSTURE, POSTURE_ALIASES, POSTURES } from '../components/studio/studio-store';
import { BUILTIN_PALETTES } from '../components/studio/palettes';
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { join } from 'node:path';

const base = import.meta.env.BASE_URL;
const url = (p) => joinBase(base, p);
const pg = assetBase();

const options = {
	themeBase: url(pg + 'themes/'),
	runtimeUrl: url(pg + 'lattice-runtime.js'),
	engineUrl: url(pg + 'lattice-playground.js'),
	// Locally-vendored Mermaid — the SAME committed `mermaid-v11.min.js` the
	// Export-to-Marp bundle ships (staged under export/), which sets the
	// `globalThis.mermaid` the runtime orchestrates. The Studio renders diagrams
	// from our own origin, never the jsdelivr CDN (offline / strict-CSP safe).
	mermaidUrl: url(pg + 'export/mermaid-v11.min.js'),
	// Locally-vendored KaTeX (staged under katex/) for the presenter/stage math path —
	// same reason as Mermaid: render math from our own origin, never jsdelivr.
	katexUrl: url(pg + 'katex/katex.min.css'),
};

// The component catalog, read from the committed machine manifest at build time
// and trimmed to what the insert palette needs (name / bucket / description /
// the authored insert skeleton). Serialized into the island as a prop.
// Built by the SHARED builder (src/lib/studio-catalog.mjs), which also backs the
// static `/studio/component-catalog.json` endpoint the island fetches. Only the NAME
// list is inlined here — the editor's lint needs it from the first frame, and it is
// ~1KB against the full payload's ~180KB (2026-08-17 loading audit §5, §9.3).
const components = buildStudioCatalog();
const componentNames = components.map((c) => c.name);

// The per-class HEADING register for Compose: a `_class` name → the heading level(s) its GRAMMAR
// anchors ('h1' for the title family, 'h2' for body classes, both where the slot lists both), read from
// each component's heading/title slot in the generated grammar (`dist/docs/grammar.json`). A KNOWN class
// with NO heading slot maps to an empty `[]` (Compose then offers no heading register — e.g. big-number,
// whose hero is a list item). Threaded into the Compose editor so its Format group offers the grammar-
// correct heading — never H1 on a body slide, never H2 on a title — sharing the engine's slot contract
// as the one source of truth (HARD RULE #1).
let slideHeadings = {};
try {
	const grammar = JSON.parse(readFileSync(join(process.cwd(), '..', 'dist/docs/grammar.json'), 'utf8'));
	for (const c of grammar.components || []) {
		if (!c.name) continue;
		const slots = c.slots || {};
		// Scan EVERY slot's selector for a heading element, not just the slot NAMED heading/title — a
		// class can carry its heading in a differently-named slot (e.g. policy-recommendation's required
		// `recommendation` slot has selector `h2`). Keying on the slot name alone wrongly mapped such a
		// class to [] and hid its H2 (trio: red-team + checker MAJOR). Match hN only as an ELEMENT
		// selector (start / whitespace / a combinator before it, no word-char or hyphen after) so a
		// class/id token like `.h2-foo` never false-matches. `h1, h2` (journey) yields both levels.
		const levels = [];
		for (const slot of Object.values(slots)) {
			for (const mm of String(slot?.selector || '').matchAll(/(?:^|[\s>,(+~])h([1-6])(?![\w-])/g)) levels.push(mm[1] === '1' ? 'h1' : 'h2');
		}
		// The class's declared heading level set — an EMPTY [] means no slot renders a heading at all
		// (big-number, quote), so Compose offers no heading register there rather than the permissive
		// default. A class absent from the map entirely (unnamed) stays permissive in `headingKeysFor`.
		slideHeadings[c.name] = [...new Set(levels)];
	}
} catch (e) {
	// Graceful, but make the degradation OBSERVABLE: a missing/corrupt grammar.json or a slot-shape
	// change silently disables grammar-driven headings site-wide (every class → permissive H1/H2).
	console.warn('[studio] slideHeadings: could not derive the grammar heading map — Compose falls back to permissive H1/H2', e && e.message);
	slideHeadings = {};
}

// The per-class OPTIONAL-BLOCK map for Compose: a `_class` name → the universal
// editorial blocks that layout actually renders (`key-insight`, `below-note`), read
// from `authoring.blocks` in the generated manifest (#1651). Both blocks are
// OPT-OUT, so a layout that claims its trailing blockquote or paragraph for its own
// anatomy renders neither — a `quote` takes them as the quotation and the
// attribution. Compose's grammar gutter offered "Key insight" and "Below-note" on
// every slide regardless, so applying one on a quote did nothing and said nothing.
// Threaded through so the gutter only offers a register that will render, sharing
// the engine's own exclusion sets as the one source of truth (HARD RULE #1 — the
// same shape as slideHeadings above).
//
// An ABSENT class stays permissive: `applicableRegisters` only withholds a register
// for a class it positively knows drops the block, so an unrecognized `_class` and a
// missing map both behave exactly as they did before.
let slideBlocks = {};
try {
	const catalogForBlocks = JSON.parse(readFileSync(join(process.cwd(), '..', 'dist/docs/components.json'), 'utf8'));
	for (const c of catalogForBlocks.components || []) {
		if (!c.name) continue;
		const blocks = c.authoring && Array.isArray(c.authoring.blocks) ? c.authoring.blocks : null;
		if (blocks) slideBlocks[c.name] = blocks;
	}
} catch (e) {
	// Same observable degradation as slideHeadings: without the map Compose offers
	// both registers everywhere, which is exactly the pre-#1651 behavior.
	console.warn('[studio] slideBlocks: could not read authoring.blocks — Compose offers insight/note on every layout', e && e.message);
	slideBlocks = {};
}

// The deterministic lint vocabulary — built at build time from the LIVE component
// manifests (the SAME buildVocab the Drawing Board and the Node CLI use), so the
// editor's inline grammar linter is the canonical lint-core, not a reduced copy.
let lintVocab = null;
try {
	const require = createRequire(import.meta.url);
	const repoRoot = join(process.cwd(), '..');
	const { loadAll } = require(join(repoRoot, 'lib/components', 'index.js'));
	const { buildVocab } = require(join(repoRoot, 'lib/authoring', 'lint.js'));
	const v = buildVocab(loadAll());
	lintVocab = {
		names: [...v.names],
		modifiers: [...v.modifiers],
		// The cross-component modifier tokens (`dark`, `light`, `numbered`, tone/stamp/
		// spectrum styles, …) valid on ANY slide — drives the editor's `_class:` /
		// `class:` modifier completion (never a hand-kept list).
		universalModifiers: [...(v.universalModifiers || [])],
		mapRegions: Object.fromEntries(Object.entries(v.mapRegions || {}).map(([k, mv]) => [k, { valid: [...mv.valid], names: mv.names }])),
		finishNames: v.finishNames || [],
		modeNames: v.modeNames || [],
		splitNames: v.splitNames || [],
		capacity: v.capacity || {},
		sizes: v.sizes || undefined,
		universalGroups: v.universalGroups || {},
		semiUniversalVariants: v.semiUniversalVariants || [],
		exclusiveAxes: v.exclusiveAxes || {},
		stampStyles: v.stampStyles || { boardroom: [], range: [] },
		toneStyles: v.toneStyles || [],
		stampStyleNames: v.stampStyleNames || [],
		toneStyleNames: v.toneStyleNames || [],
		spectrumNames: v.spectrumNames || [],
	};
} catch (e) {
	lintVocab = null;
}

// firstDeck powers only the instant-shell topbar title (a chrome placeholder shown until
// the hydrated app's own topbar takes over). The shell paints a static, no-JS Nacre
// skeleton at HTML-parse time so a reload never stares at a blank preview while the
// client:only island + engine bundle load.
const firstDeck = DECKS[0];
// Aspect ratio (w:h) each builtin deck renders at — its AUTHOR-CHOSEN size, never assumed
// 16:9 — so the instant shell's fallback box matches the deck the visitor actually boots
// into. Injected into the seed below (with the size map, for resolving a user-edited deck's
// size pre-paint). DEFAULT_RATIO is the newcomer's deck (DECKS[0]).
const DECK_RATIOS: Record<string, [number, number]> = Object.fromEntries(DECKS.map((d) => [d.id, deckRatio(deckSource(d))]));
const DEFAULT_RATIO = DECK_RATIOS[firstDeck.id] ?? [16, 9];
// Built-in deckId → title, so the seed can best-effort correct the shell topbar title to the
// LAST-ACTIVE deck (not just DECKS[0]) for a returning visitor — a title, never slide content.
const DECK_TITLES: Record<string, string> = Object.fromEntries(DECKS.map((d) => [d.id, d.title]));
// The Studio's pre-hydration INSTANT SHELL is Nacre-ONLY: a single animated skeleton in one
// contained box (at the deck's chosen aspect), shown to EVERY visitor at HTML-parse time
// (before the client:only island + the ~505KB engine load) and dismissed by the app once its
// own (identical) Nacre is up. There is deliberately NO cached-last-slide replay and NO
// server-rendered welcome slide: a second, REAL-CONTENT surface racing the live preview at a
// mismatched geometry was the root of the "slide in the top half, shimmer bleeding into the
// bottom, seam down the middle" bug on mobile (two surfaces, two coordinate systems, one gated
// on the flaky iOS reveal). One skeleton, one rect, one honest ground — the seam is now
// structurally impossible. See engineering/decisions/2026-07-21-studio-preview-one-skeleton.md.
// NOTE — these CSS blocks are JS TEMPLATE LITERALS. Do not use a backtick anywhere inside
// them, including in a comment: it terminates the literal, and the build fails several
// hundred lines away with "data is not defined" rather than at the character responsible.
// Quote identifiers in these comments plainly, not in code spans.
//
// Chrome for the instant shell (topbar + centered stage). Keyed under #studio-ssr-shell so
// it never touches the hydrated island. The shell ground is the theme `var(--bg)` (the SAME
// token the hydrated app's root `bg-background` and the Nacre card resolve to) — NOT a hardcoded
// near-black. A hardcoded `#0c0c0c` made the pre-hydration letterbox flash BLACK around the navy
// Nacre card, then jump to the app's navy `--bg` on hydration (reported on iPhone reload). Using
// `var(--bg)` makes the letterbox, the Nacre card, and the hydrated pane one continuous ground.
// FONT: the shell inherits the app's own `--font-body`, NOT a system stack. The system stack
// was correct for the old hand-drawn shell (which believed the app's stylesheet was absent
// pre-hydration); with the REAL chrome rendered here it made every label render in different
// metrics from the app's. Invisible on a phone, where the deck pill is width-constrained and
// truncates — but the pill is CONTENT-sized from tablet up, so the mismatch showed as the pill
// jumping 164.5px -> 185px at hand-off (reported as "slight shift when the real things are
// hydrated", measured at 820px). The fallback stays in the var() default, so a palette that
// somehow lacks the token still gets a sane stack.
const SHELL_CHROME_CSS = `#studio-ssr-shell{position:fixed;inset:0;z-index:1;pointer-events:none;flex-direction:column;background:var(--bg,#e9eef5);color:var(--text-body,#1a1a1a);font-family:var(--font-body,system-ui,-apple-system,"Segoe UI",sans-serif);-webkit-font-smoothing:antialiased;--mark-bond:#003d66;--mark-halo:#faf7f2;--sk:color-mix(in srgb,currentColor 11%,transparent);--sk-band:color-mix(in srgb,currentColor 3%,transparent);}
:root[data-mode="dark"] #studio-ssr-shell{background:var(--bg,#0c1626);color:var(--text-body,#e8e8e8);--mark-bond:#4fa8da;--mark-halo:#15110d;}
/* TOPBAR + BAND CHROME — the app's REAL controls, rendered to static HTML at build time by
   <StudioChromeSkeleton> (no client directive = zero JS). This block therefore holds NO box
   model: every size, gap and glyph comes from the app's own Button/Separator/LatticeMark/
   BarIcon/PostureDial and its Tailwind classes, which are already in the render-blocking
   stylesheet this page ships. All that is left here is (a) placing the pane bands at the rect
   the seed resolved, (b) picking the light/dark brand mark and the moon/sun glyph, and (c)
   muting the whole layer so it never reads as live. */
#studio-ssr-shell .ssr-chrome{flex:0 0 auto;opacity:.62;}
#studio-ssr-shell .ssr-mark-dark{display:none;}
#studio-ssr-shell .ssr-mode-to-light{display:none;}
:root[data-mode="dark"] #studio-ssr-shell .ssr-mark-light{display:none;}
:root[data-mode="dark"] #studio-ssr-shell .ssr-mark-dark{display:block;}
:root[data-mode="dark"] #studio-ssr-shell .ssr-mode-to-dark{display:none;}
:root[data-mode="dark"] #studio-ssr-shell .ssr-mode-to-light{display:inline-flex;}
/* The stage is the LAST-RESORT layout: a centered box with no seeded rect. It applies only
   when the geometry seed could not place the box (storage threw, or a viewport so small the
   letterbox fit degenerates) — every other path sets data-ssr-rect and the rule below takes
   over with padding:0. The --sh-ftr term keeps the box off the footer band in the one case
   where the chrome DID publish and the box did not; it resolves to 0 when it didn't. */
#studio-ssr-shell .ssr-stage{flex:1 1 auto;min-height:0;display:flex;align-items:center;justify-content:center;padding:clamp(12px,3vw,20px);padding-bottom:calc(clamp(12px,3vw,20px) + var(--sh-ftr,0px));container-type:size;}
/* FALLBACK box (a visitor with no persisted rect): ONE full-bleed box at the deck's
   AUTHOR-CHOSEN aspect (--sb-ratio / numeric --sb-ar, seeded below; the engine's own 16:9
   only when a deck names no size), fit into the stage the SAME way the app fits its preview:
   width = min(available width, available height × ratio) via container-query units, so it
   letterboxes correctly for ANY aspect — a square/portrait deck binds on height on a wide
   viewport, a landscape deck binds on width on a phone. Mirrors the app's newcomer boot (the
   Read stop's full-bleed preview). The letterbox bands are flat shell background — never
   Nacre — the invariant that kills the bleed. */
#studio-ssr-shell .ssr-slidebox{position:relative;width:min(100cqw, calc(100cqh * var(--sb-ar, 1.7778)));aspect-ratio:var(--sb-ratio, 16 / 9);box-shadow:0 8px 30px rgba(0,0,0,.16);border-radius:8px;overflow:hidden;}
/* RECT-REPLAY mode: a returning visitor's seed script (below) resolved the app's OWN last
   preview-box rect from localStorage and set --sb-* to px in the CURRENT viewport. Position
   the box ABSOLUTELY at that rect (its containing block is the position:fixed shell = the
   viewport), so the Nacre lands exactly where the hydrated app will re-measure its box — no
   geometry reimplementation here, so it can't drift from the app's split/stop/ratio layout. */
:root[data-ssr-rect] #studio-ssr-shell .ssr-stage{display:block;padding:0;container-type:normal;}
:root[data-ssr-rect] #studio-ssr-shell .ssr-slidebox{position:absolute;left:var(--sb-l);top:var(--sb-t);width:var(--sb-w);height:var(--sb-h);max-width:none;max-height:none;aspect-ratio:auto;}`;

// STRUCTURAL CHROME BANDS (#1438). Before this, the shell drew exactly two things — a topbar
// and the slide box — so a reload showed those floating in an otherwise EMPTY page, and
// hydration then dropped four more bands into place at once (the phone's eight-cell action
// bar, the preview sub-bar, the slide navigator, the status strip) while the desktop's whole
// editor column appeared from nothing. Reported as "the icons and the action bar are missing
// on reload"; the honest description is that the shell was STRUCTURALLY INCOMPLETE, so the
// hand-off was a re-layout rather than a cross-fade.
//
// The bands' CONTENT is the app's own chrome components, rendered to static HTML at build
// time (see StudioChromeSkeleton) — no copied glyphs, no copied sizes. What lives here is
// only the POSITIONING: each band is placed at the rect the chrome seed resolved from
// PREVIEW_CHROME, the same numbers that place the slide box, so a band can never disagree
// with the box it frames. The whole layer is muted and `pointer-events:none`, so real-looking
// controls can't read as ready or swallow a tap.
const SHELL_BANDS_CSS = `#studio-ssr-shell .ssr-band{position:absolute;display:none;box-sizing:border-box;flex-direction:column;overflow:hidden;opacity:.62;}
:root[data-ssr-chrome] #studio-ssr-shell .ssr-band{display:flex;}
/* Tablet + desktop: the editor column left of the split. Hidden on the phone (one swappable
   pane) and at the Read stop (the editor track collapses to 0). */
#studio-ssr-shell .ssr-editpane{left:var(--sh-rail,0px);top:var(--sh-pane-t,54px);width:calc(var(--sh-pane-l,0px) - var(--sh-rail,0px));bottom:0;border-right:1px solid var(--border,rgba(127,127,127,.16));}
:root[data-ssr-bp="mobile"] #studio-ssr-shell .ssr-editpane,:root[data-ssr-read] #studio-ssr-shell .ssr-editpane{display:none;}
/* The preview pane's own sub-bar. Absent at Read, where the app renders the preview
   chromeless — so --sh-hdr is 0 and the band is dropped. */
/* min-height, NOT height. The constant is a FLOOR the band starts from, not a pin: the
   skeleton inside now carries the app's own text metrics, so it grows exactly as the app's
   row does when a reader raises the browser's minimum font size (#1496). Pinning the height
   clipped that growth and left the band up to 18px short of the row it is standing in for.
   At the default font size the content lands ON the constant (measured: 45.0 vs 45 on the
   two-pane tiers, 38.2 vs 38.2 on the phone), so the floor decides and this is byte-identical
   to the pinned version — which is what makes the change safe for the surface everybody
   actually sees. */
/* A SIZE CONTAINER, and it is MORE load-bearing than it looks — do not remove it because the
   band's HEIGHT no longer depends on pane width. Two things inside mirror the app's own
   container queries against this band, and both need this element as their query basis
   (its width IS the pane width):
     - the lens pill's text label, at 21rem of pane — it now costs the row WIDTH rather than
       height, since the pill is sized to the slide counter beside it (lens-picker.tsx);
     - the "Preview" caption, at 24rem of pane AND a 700px viewport — the app hides it on
       the phone, where the pane switcher above already names the pane.
   Without the containment the skeleton would show its caption at every pane width on a wide
   viewport and never show its label bar, against an app doing the opposite. (This note used
   to say the label made the bar "41px instead of 47" — that mechanism is retired; the bar is
   45 on the two-pane tiers and 38.2 on the phone, at every pane width.) */
#studio-ssr-shell .ssr-panehdr{left:var(--sh-pane-l,0px);width:var(--sh-pane-w,100%);top:var(--sh-pane-t,54px);min-height:var(--sh-hdr,0px);container-type:inline-size;}
:root[data-ssr-read] #studio-ssr-shell .ssr-panehdr{display:none;}
/* The footer is two stacked bands: the slide navigator, then the deck status strip. At Read
   it is one undivided affordance band (footerRead), so the inner rows are dropped. */
#studio-ssr-shell .ssr-paneftr{left:var(--sh-pane-l,0px);width:var(--sh-pane-w,100%);bottom:0;min-height:var(--sh-ftr,0px);border-top:1px solid var(--border,rgba(127,127,127,.16));}
/* The footer's internal split is a CONSTANT, not the natural height of the placeholder text:
   statusH is what the app measures, and the oracle compares this band to it. Pin the status
   row to it and let the navigator take the remainder, so the two rows land on the app's own
   line no matter what the placeholder inside them happens to be. */
#studio-ssr-shell .ssr-status{min-height:var(--sh-status,0px);flex:0 0 auto;}
/* flex:1 0 auto — grow to fill the footer at the default size, but do NOT shrink below the
   navigator's own content, or a raised font size would be absorbed by squashing this row
   instead of growing the band. (No backticks in these comments: this block is a JS template
   literal, and one backtick here ends it and fails the build ~500 lines away. That is #1494,
   and it cost a build during this very change.) */
#studio-ssr-shell .ssr-rail{flex:1 0 auto;min-height:0;}
:root[data-ssr-read] #studio-ssr-shell .ssr-paneftr > *{display:none;}
/* CINEMA (a landscape phone): the app suppresses the header, the action bar and the navigator
   and runs the slide full-bleed, so the shell drops its chrome too rather than flashing a
   54px band the app is about to delete. No chrome vars are published in this mode, so the
   bands are already absent — this only has to take the topbar with them. */
:root[data-ssr-cinema] #studio-ssr-shell .ssr-chrome{display:none;}
/* The activity rail — DESKTOP (>=1100) at Craft only. The seed publishes data-ssr-rail when
   it actually reserves the 52px, so this gate can't drift from the tier test that produced it
   (it used to re-derive "not mobile", which put a rail into every tablet Craft layout). */
#studio-ssr-shell .ssr-activityrail{left:0;top:var(--sh-pane-t,54px);width:var(--sh-rail,0px);bottom:0;border-right:1px solid var(--border,rgba(127,127,127,.16));}
:root:not([data-ssr-rail]) #studio-ssr-shell .ssr-activityrail{display:none;}
/* At Craft the app swaps the SLIM header for the FULL one: the launcher regains its wordmark
   and the tail regains Theme, the mode toggle and the tours launcher. Two tails, one shown. */
:root[data-ssr-stop="craft"] #studio-ssr-shell .ssr-desktop-tail{display:none;}
:root:not([data-ssr-stop="craft"]) #studio-ssr-shell .ssr-craft-tail{display:none;}
/* Guided tours are a PERSISTED PREFERENCE, not a width or a stop — the one chrome gate of that
   kind. The seed publishes it so the shell can honor it; see the rule in the header note above. */
:root[data-ssr-no-tours] #studio-ssr-shell .ssr-tours{display:none;}
/* The dial lights the stop the visitor lands on — one dial per stop, CSS picks. Hardcoding
   Write meant a Read visitor watched the highlight chip jump at hand-off. */
#studio-ssr-shell .ssr-dial{display:none;}
:root[data-ssr-stop="read"] #studio-ssr-shell .ssr-dial-read,:root[data-ssr-stop="write"] #studio-ssr-shell .ssr-dial-write,:root[data-ssr-stop="craft"] #studio-ssr-shell .ssr-dial-craft{display:contents;}
/* …and the header's LEFT run swaps with it: the full header leads with the launcher and a
   rule, the slim one with a bare mark. Not expressible in a width class — it turns on the
   STOP — so the three spans are re-gated here. Drawing the slim mark at Craft put the deck
   pill 27px right of where the app puts it, which is a visible slide at hand-off. */
@media (min-width:1100px){:root[data-ssr-stop="craft"] #studio-ssr-shell .ssr-launcher-wrap{display:contents;}:root[data-ssr-stop="craft"] #studio-ssr-shell .ssr-slim-mark{display:none;}:root[data-ssr-stop="craft"] #studio-ssr-shell .ssr-craft-lead{display:contents;}}
/* READ on a DESKTOP viewport shows the deck title as plain text, not the bordered switcher —
   the app's slim header drops deck navigation there entirely. Two elements, one shown, like the
   header's left run above; the shell used to keep the pill and merely blank its border, which
   left the title 27px right of the app's and kept a live-dot the app does not draw at Read.
   Below 1100 the app renders its FULL header at every stop, switcher included, so the pill
   stays exactly as it is — an unscoped data-ssr-read rule flattened it on a phone too. */
@media (min-width:1100px){:root[data-ssr-read] #studio-ssr-shell .ssr-deck-pill{display:none;}:root[data-ssr-read] #studio-ssr-shell .ssr-read-title{display:contents;}}`;

// The Nacre skeleton — a scoped inline COPY of docs/src/styles/nacre-loader.css (the
// island's stylesheet doesn't exist pre-hydration). It fills the 16:9 .ssr-slidebox exactly
// (inset:0), so it can never bleed past the slide rect. Palette-blind via the render-blocking
// --accent/--bg tokens. KEEP IN SYNC with nacre-loader.css (keyframes name + fallback hexes).
const SHELL_NACRE_CSS = `#studio-ssr-shell .nacre-loader{position:absolute;inset:0;overflow:hidden;isolation:isolate;background:var(--bg,#0c1626);}
#studio-ssr-shell .nacre-loader__layer{position:absolute;inset:-35%;mix-blend-mode:screen;transform-origin:50% 50%;will-change:transform;}
#studio-ssr-shell .nacre-loader__layer--0{filter:blur(26px);animation:nacre-rot 9s linear infinite;}
#studio-ssr-shell .nacre-loader__layer--1{filter:blur(26px) hue-rotate(34deg);animation:nacre-rot 12s linear infinite reverse;}
#studio-ssr-shell .nacre-loader__layer--2{filter:blur(26px) hue-rotate(-28deg);animation:nacre-rot 15s linear infinite;}
#studio-ssr-shell .nacre-loader__blob{position:absolute;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--accent,#5b8fc7) 60%,transparent),transparent 64%);}
#studio-ssr-shell .nacre-loader__blob:nth-child(1){width:54%;aspect-ratio:1;left:10%;top:16%;}
#studio-ssr-shell .nacre-loader__blob:nth-child(2){width:46%;aspect-ratio:1;left:56%;top:20%;}
#studio-ssr-shell .nacre-loader__blob:nth-child(3){width:50%;aspect-ratio:1;left:32%;top:56%;}
#studio-ssr-shell .nacre-loader__core{position:absolute;inset:0;background:radial-gradient(58% 58% at 50% 46%,color-mix(in srgb,var(--accent,#5b8fc7) 15%,transparent),transparent 72%);}
#studio-ssr-shell .nacre-loader__vig{position:absolute;inset:0;box-shadow:inset 0 0 70px 14px color-mix(in srgb,var(--bg,#0c1626) 92%,transparent);}
:root[data-mode="light"] #studio-ssr-shell .nacre-loader{background:var(--bg,#e9eef5);}
:root[data-mode="light"] #studio-ssr-shell .nacre-loader__layer{mix-blend-mode:multiply;}
@keyframes nacre-rot{to{transform:rotate(360deg);}}
@media (prefers-reduced-motion: reduce){#studio-ssr-shell .nacre-loader__layer{animation:none;}}`;

// (The old pre-paint REPLAY_JS — a per-visitor snapshot-replay / newcomer welcome-slide
// selection — is retired with the Nacre-only shell: there is no per-visitor content to
// choose anymore, so the shell is a static skeleton shown unconditionally by the seed
// script below. Why it went away: that real-slide replay was a SECOND preview surface that
// raced the live one in a different coordinate system, producing the "slide top-half /
// shimmer bottom-half, seam down the middle" bug on mobile. See
// engineering/decisions/2026-07-21-studio-preview-one-skeleton.md.)
---

<!doctype html>
<html lang="en" data-palette="cuoio" data-mode="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		{/* FIRST thing after the charset/viewport metas: pin color-scheme to the app mode so the
		    blank canvas (shown while the render-blocking CSS loads) is never a white flash — even
		    for a dark-app visitor on a light-OS device. Must precede ResourceHints + the inline
		    CSS below, which would otherwise delay it. */}
		<ColorSchemeSeed />
		<ResourceHints />
		{/* The crash sentinel, started as early as a bundled module can run — before
		    the client:only island hydrates, so a fault during boot is still recorded.
		    It writes only to this browser; see the module header for why an in-page
		    error handler cannot see the failure this exists to catch. */}
		<CrashSentinel />
		{/* Prefetch the preview runtime at parse time so the first live render's
		    iframe finds it warm instead of cold-fetching it on the critical path
		    (the FRAME REBUILD cost). Overlaps island hydration + the engine load. */}
		<RuntimeWarm />
		<title>Lattice Studio — one workspace</title>
		<meta name="description" content="The Lattice Studio: compose, present, and fabricate decks in one workspace. A live prototype of the app redesign." />
		<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
		<style is:global>
			html, body { margin: 0; height: 100%; overflow: hidden; }
			/* Instant-shell (below) is hidden until the seed script flips data-ssr-shell="on"
			   — which it now does UNCONDITIONALLY (every visitor gets the same Nacre skeleton). */
			#studio-ssr-shell { display: none; }
			:root[data-ssr-shell="on"] #studio-ssr-shell { display: flex; }
			/* Read stop → full-bleed preview: hide the editor Panel's OUTER (sizing)
			   div by id so the preview reclaims its track. react-resizable-panels wraps
			   each Panel in an outer div (carrying the id + inline flex) around the inner
			   div our className lands on, so a Tailwind class can't shrink the outer.
			   The divider is hidden via its own class (a Separator is a single div).
			   2026-07-19 splitter migration. */
			/* Selected by ROLE, not by panel id: CSS cannot import STUDIO_SPLIT_PANEL_IDS, so an
			   id selector here would be the one copy of the panel ids that the shared
			   declaration in #1495 cannot reach — a rename would compile, pass types, and
			   silently stop hiding the editor at Read. data-pane-role is set beside the id on
			   the same element and is already relied on by the e2e suite, so it does render. */
			[data-studio-split][data-studio-stop="read"] > [data-pane-role="editor"] { display: none !important; }
		</style>
		<style is:inline set:html={SHELL_CHROME_CSS + '\n' + SHELL_BANDS_CSS + '\n' + SHELL_NACRE_CSS}></style>
		<script is:inline define:vars={{ KNOWN_PALETTES: BUILTIN_PALETTES, SIZE_RATIO, DECK_RATIOS, DECK_TITLES, DEFAULT_RATIO, PREVIEW_CHROME, BOOT_POSTURE, LEGACY_ONBOARDED_POSTURE, POSTURES, POSTURE_ALIASES, PREVIEW_RECT_KEY, STUDIO_SPLIT_KEY, STUDIO_SPLIT_BUCKET, STUDIO_SPLIT_COLLAPSE_KEY, STUDIO_SPLIT_PANEL_IDS }}>
			(function () {
				var r = document.documentElement;
				// Show the instant shell to EVERY visitor FIRST — before any localStorage read.
				// In a storage-blocked context (private mode, disabled cookies) `getItem` THROWS,
				// and if that throw happened before this line the catch would skip it, leaving the
				// shell hidden = a blank preview (the exact failure this shell exists to prevent).
				// It's a palette-blind Nacre skeleton, so it is correct for every visitor with no
				// per-visitor decision to make; palette/geometry seeds below only refine it.
				r.setAttribute('data-ssr-shell', 'on');
				// Declared and DEFAULTED before the storage reads below, because the geometry seed
				// closes over it: if a blocked-storage throw skipped the assignment, `rr` would be
				// undefined and the box could not be computed at all.
				var rr = DEFAULT_RATIO;
				try {
					var p = localStorage.getItem('lattice-studio-palette');
					var palette = 'cuoio';
					// KNOWN_PALETTES is injected from the shared ../components/studio/palettes
					// list (define:vars), so EVERY built-in palette is honored at first paint —
					// not the stale 8-of-18 subset that dropped a returning visitor on a
					// non-curated palette back to indaco (lost instant-shell + color flash).
					if (p && KNOWN_PALETTES.indexOf(p) !== -1) { r.setAttribute('data-palette', p); palette = p; }
					var m = localStorage.getItem('lattice-docs-mode');
					var mode = 'light';
					if (m === 'light' || m === 'dark') { r.setAttribute('data-mode', m); mode = m; }
					else if (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) { r.setAttribute('data-mode', 'dark'); mode = 'dark'; }
					// (color-scheme is pinned earlier, by <ColorSchemeSeed> at the top of <head>.
					//  data-ssr-shell is set ABOVE, before this try, so the shell shows even if a
					//  storage read throws.)
					// RATIO SEED — the fallback box (a visitor with no persisted rect: a newcomer, or
					// the one transitional reload right after this ships) must match the AUTHOR-CHOSEN
					// size of the deck they boot into, never an assumed 16:9. Resolve it from the deck
					// they last viewed the same way the app does (its `size:` front-matter → SIZE_RATIO,
					// falling back to the engine's own 16:9 only when a deck names no size).
					try {
						var act = JSON.parse(localStorage.getItem('lattice-studio-active') || 'null');
						var did = act && act.deckId;
						// TITLE SEED — the returning user's actual deck, not the default. Precedence
						// matters: `derived` is the index MIRROR of the deck's RESOLVED title — its
						// `title:` override when it sets one, else its heading — written
						// by the app on save, so it is the only entry field guaranteed CURRENT — take
						// it first. Then the built-in's own declared title, which beats the index's
						// `title` because that field is a CREATION label: every returning user has a
						// built-in row stamped with whatever it was called when they first loaded,
						// and trusting it would paint a stale name for any built-in they never edit.
						// The creation label is right only for a user-made deck the app has yet to save.
						if (did) {
							var ttl = '';
							try {
								var idx = JSON.parse(localStorage.getItem('lattice-studio-deck-index') || 'null');
								if (idx && idx.length) for (var ti = 0; ti < idx.length; ti++) {
									var row = idx[ti];
									if (!row || row.id !== did) continue;
									if (typeof row.derived === 'string' && row.derived) ttl = row.derived;
									else if (typeof DECK_TITLES[did] === 'string') ttl = DECK_TITLES[did];
									else if (typeof row.title === 'string') ttl = row.title;
								}
							} catch (e5) { ttl = ''; } // corrupt index → fall through to the built-in title
							if (!ttl && typeof DECK_TITLES[did] === 'string') ttl = DECK_TITLES[did];
							if (ttl) r.setAttribute('data-ssr-title', ttl);
						}
						if (did) {
							var edited = localStorage.getItem('lattice-studio-src-' + did);
							var sz = '';
							if (edited) {
								// studio-store persists edited source via write() = JSON.stringify(source), so the raw value
								// is a QUOTED json string (leading ", escaped \n) that /^---/ would never match. Parse it
								// back to real markdown first; inner guard degrades a corrupt value to the deck default.
								var src = '';
								try { var parsed = JSON.parse(edited); if (typeof parsed === 'string') src = parsed; } catch (e4) { src = ''; }
								var fm = /^---\r?\n([\s\S]*?)\r?\n---/.exec(src);
								var sm = fm && /^[ \t]*size[ \t]*:[ \t]*(.+?)[ \t]*$/m.exec(fm[1]); // /m: end-of-LINE, not just last line (mirrors sizeFromSource)
								if (sm) sz = sm[1].replace(/^['"]|['"]$/g, '').trim();
							}
							if (sz && (SIZE_RATIO[sz] || SIZE_RATIO[sz.toLowerCase()])) rr = SIZE_RATIO[sz] || SIZE_RATIO[sz.toLowerCase()];
							else if (DECK_RATIOS[did]) rr = DECK_RATIOS[did];
						}
						if (Array.isArray(rr)) { // a corrupt/prototype size key can make rr a non-array — never emit NaN/undefined
							r.style.setProperty('--sb-ratio', rr[0] + ' / ' + rr[1]);
							r.style.setProperty('--sb-ar', String(rr[0] / rr[1]));
						}
					} catch (e3) {}
					// GEOMETRY SEED (#1438) — resolve the app's structural bands (the phone action
					// bar, the editor column, the preview sub-bar, the footer) AND the Nacre slide
					// box from ONE derivation, and publish them as CSS vars so the shell can DRAW
					// them rather than leave their space blank. One derivation, two consumers, so a
					// band can never disagree with the box it frames.
					//
					// It is a FUNCTION because the viewport is not a constant during a load: a phone
					// rotated while the ~505KB engine is still fetching would otherwise keep the
					// portrait geometry until hydration and then snap. Re-run on resize /
					// orientationchange until the app dismisses the shell (see the tail below).
					//
					// Cinema (a landscape phone) is the one surface with NO chrome at all — the app
					// suppresses the header, the bar and the navigator and runs the slide full-bleed
					// — so it is detected here from the SAME media query the app's `useLandscapePhone`
					// uses, and it turns the whole shell chrome off rather than painting bands the
					// app is about to delete.
				} catch (e) {}
				// OWN TRY. This block used to sit inside the palette try above, whose FIRST statement is
				// a localStorage read — so in a storage-blocked context (private mode, blocked cookies,
				// an enterprise policy) that read threw, the outer catch swallowed everything after it,
				// and the visitor got no bands, no posture dial and a full-viewport Nacre box the app
				// then snapped to a fraction of the width. Every storage read INSIDE seedGeometry is
				// already individually defended, so it degrades to the default-shaped shell instead.
				try {
				var seedGeometry = function () {
					var G = null;
					try {
						var C = PREVIEW_CHROME;
						var vw2 = window.innerWidth, vh2 = window.innerHeight;
						var cinema = !!(window.matchMedia && matchMedia('(orientation: landscape) and (max-height: 500px) and (pointer: coarse)').matches);
						// The app has THREE tiers (use-breakpoint.ts), not two: mobile <= 699,
						// tablet 700-1099, desktop >= 1100. The shell needs both boundaries — the
						// action bar and the single-pane layout key off the mobile one, and the
						// Craft stop's activity rail is DESKTOP-only. Deriving the rail from
						// "not mobile" put a 52px rail into the tablet Craft layout, which moved
						// every band right of it 28px.
						var bpMobile = vw2 <= 699;
						var bpDesktop = vw2 >= 1100;
						// Mirror the app's boot posture (studio-store derivePosture): an EXPLICITLY
						// stored posture wins; otherwise everyone falls back to BOOT_POSTURE — the
						// store's own constant, handed in through define:vars rather than restated
						// here (#1286). This mirror is load-bearing: deriving a stop the app won't
						// render makes the first load compute a full-bleed box against a split (or
						// the reverse), and the hand-off shows as a jump — which is exactly what
						// shipped when this line carried its own private copy of the answer.
						// The full mirror is studio-store's `asPosture(saved.posture) ?? derivePosture(
						// saved.onboarded)` — and derivePosture returns LEGACY_ONBOARDED_POSTURE (Craft)
						// for a legacy `onboarded: true`. Dropping that branch gave those visitors the
						// Write shell and the Craft app: a swapped header run, a 52px rail sliding in,
						// and the box 29px off. Harmless while the stop only moved the box; not harmless
						// now that it selects the header variant and the rail.
						//
						// The stop LIST and the legacy-name ALIASES arrive through define:vars too, for
						// the same reason the constants do: the Craft stop was called 'build' before
						// 2026-08-11, so a returning power user still has that value in storage, and a
						// seed that dropped the alias would paint the Write skeleton under the Craft app.
						var posture = null, settings = null;
						try { settings = JSON.parse(localStorage.getItem('lattice-studio-settings') || 'null'); } catch (e7) {}
						var storedStop = settings && settings.posture;
						// The next two lines are `asPosture` (studio-store), transliterated. Both halves
						// of this mirror must run the SAME ALGORITHM, not merely reach the same answer
						// for today's inputs — this seed and that function have already drifted twice
						// (#1286), and each drift was a line that was right when it was written.
						//
						//   · VALIDATE, THEN ALIAS — the order matters. It only coincides with
						//     alias-then-validate while no alias KEY is also a current stop; the day
						//     the map gains one (a plausible "merge two stops" edit, e.g.
						//     `{ write: 'craft' }`) the two orders resolve differently and the
						//     skeleton paints a stop the app is not about to render.
						//   · hasOwnProperty.call, not a bare truthiness test on the map, or
						//     'constructor' / 'toString' are INHERITED hits that resolve to a
						//     function. (The store says `Object.hasOwn`; this is an `is:inline`
						//     script, which Astro passes through VERBATIM — no transpile, no
						//     polyfill — so it takes the form with no browser floor.)
						//
						// Neither diverges today; the adversarial pass proved it over 135 storage
						// populations plus 16 driven through the real built page. Both were armed.
						if (POSTURES.indexOf(storedStop) !== -1) posture = storedStop;
						else if (typeof storedStop === 'string' && Object.prototype.hasOwnProperty.call(POSTURE_ALIASES, storedStop)) posture = POSTURE_ALIASES[storedStop];
						if (!posture) posture = (settings && settings.onboarded === true) ? LEGACY_ONBOARDED_POSTURE : BOOT_POSTURE;
						// THE ONE CHROME GATE THAT IS NEITHER WIDTH NOR STOP. The header's tours
						// button is gated on `toursEnabled()` (playground/tour-prefs.js, key
						// `lattice-tour-enabled`), a global preference a visitor can flip from any
						// surface. Drawing it unconditionally gave anyone who turned tours off a
						// phantom control plus a 44px slide of the three controls after it. Published
						// as a flag rather than guessed — see the rule in the shell's header note.
						var noTours = false;
						try { noTours = localStorage.getItem('lattice-tour-enabled') === 'off'; } catch (e10) {}
						// Read and cinema are both "chromeless" for the PREVIEW pane; cinema drops the
						// surrounding app chrome too (handled by `cinema` below).
						var chromeless = posture === 'read' || cinema;
						// The holder pads BOTH axes everywhere except the cinema morph, which is
						// `px-0 py-3` — one axis, and the axis that bounds a 16:9 box on a landscape
						// phone. Modeling cinema as unpadded made the shell's slide 43px wider and
						// 24px taller than the one the app was about to draw.
						var padX = cinema ? 0 : (vw2 < 640 ? C.padMobile : C.padDesktop);
						var padY = cinema ? C.padCinemaY : padX;
						var paneTop = cinema ? 0 : C.topbarH + (bpMobile ? C.mobileBarH : 0);
						// ── The reader's font clamp: MEASURED, not inferred ────────────────────────
						// These bands are text rows, so they grow for a reader who raises the browser's
						// MINIMUM font size — and the placement has to grow with them, or the slide box
						// lands where the bands used to be. A one-off probe carrying the pill's own
						// inline `font-size:12px` comes back clamped exactly as the pill will be.
						// Read its FONT SIZE, never its line-height: the site's line-height is not
						// applied yet at seed time (a probe asking for it gets `normal` and this
						// silently never fires), while an inline font-size is clamped by the UA before
						// any stylesheet. Do NOT swap the probe for a reading of the root's font size:
						// Chrome's "Font size" control moves the root WITHOUT touching a 12px pill, so
						// that inference fires on the wrong setting — it was tried, and it broke a
						// reader this model had served. Two-pane tiers only; the phone's third frozen
						// band (`mobileBarH`) errs the other way and correcting one of the three makes
						// it worse. Full derivation, fits and measurements: preview-rect.ts.
						var LH_RATIO = 1.6; // the app's inherited unitless line-height
						var lhBase = LH_RATIO * 12; // 19.2 — the pill's line box at the default size
						var lhNow = lhBase;
						try {
							var probe = document.createElement('span');
							probe.setAttribute('aria-hidden', 'true');
							probe.style.cssText = 'position:absolute;top:-9999px;left:-9999px;width:0;height:0;overflow:hidden;font-size:12px';
							(document.body || document.documentElement).appendChild(probe);
							var fs = parseFloat(getComputedStyle(probe).fontSize);
							if (fs > 0) lhNow = LH_RATIO * fs;
							probe.parentNode.removeChild(probe);
						} catch (eF) {}
						var lhGrow = bpMobile ? 0 : Math.max(0, lhNow - lhBase);
						var footerH = cinema ? 0 : (chromeless ? C.footerRead : C.footerWrite + 2 * lhGrow);
						// No width cap — the app stopped capping the preview box (#1283), so a cap
						// here would paint a narrower skeleton than the box the hydrated app
						// measures, and the hand-off would show as a jump.
						//
						// THE SPLIT. react-resizable-panels distributes percentages over the group
						// width minus its separators, and the app persists that percentage per panel
						// set. Read the saved one rather than assuming the default: a visitor who
						// dragged the divider gets it back on the next load, and a shell still drawing
						// the 54% default put the split line up to 288px off — the largest divergence
						// the adversarial trio found. A collapsed pane is a THIRD state, persisted
						// separately (sessionStorage, so it survives reload), and it pins the collapsed
						// side to its 46px rail rather than any percentage.
						var frac = C.defaultPreviewFrac;
						var collapsed = null;
						// The '-collapsed' suffix and the sessionStorage-vs-localStorage split are the HOOK's
						// format, handed in derived (STUDIO_SPLIT_COLLAPSE_KEY) rather than rebuilt here (#1495).
						try { collapsed = sessionStorage.getItem(STUDIO_SPLIT_COLLAPSE_KEY); } catch (e8) {}
						try {
							var store = JSON.parse(localStorage.getItem(STUDIO_SPLIT_KEY) || 'null');
							var saved = store && store[STUDIO_SPLIT_BUCKET];
							// Indexed by the SHARED ids, so renaming a panel is a compile error at the
							// declaration rather than a lookup that quietly misses here (#1495).
							var edId = STUDIO_SPLIT_PANEL_IDS[0], pvId = STUDIO_SPLIT_PANEL_IDS[1];
							if (saved && typeof saved[edId] === 'number' && typeof saved[pvId] === 'number') {
								var tot = saved[edId] + saved[pvId];
								if (tot > 0) frac = saved[pvId] / tot;
							}
						} catch (e9) {}
						// The Craft stop on a wide viewport puts a fixed activity rail down the left,
						// OUTSIDE the split — so the editor|preview ratio divides what is left of the
						// viewport, not the viewport.
						var railW = (bpDesktop && !chromeless && posture === 'craft') ? C.railCraftDesktop : 0;
						var paneX, paneW;
						if (chromeless || bpMobile) { paneX = 0; paneW = vw2; } else {
							var avail = vw2 - railW - C.splitSeparatorW;
							if (collapsed === 'a') paneW = avail - C.splitRailW;
							else if (collapsed === 'b') paneW = C.splitRailW;
							else {
								// Restoring a saved share on a narrower viewport does NOT simply clamp to
								// the px minimum: both panes are `collapsible`, and the library snaps a
								// pane to `collapsedSize` once the requested size falls below the MIDPOINT
								// of collapsedSize and minSize (react-resizable-panels' `A(o,l) < 0` pick).
								// Clamping to the minimum instead painted a 300px preview where the app
								// handed off to a 46px rail — 254px of pane and the whole slide gone at
								// hand-off. Mirror the library's branch on both sides.
								var want = avail * frac;
								var otherWant = avail - want;
								if (want < (C.splitRailW + C.splitPreviewMin) / 2) paneW = C.splitRailW;
								else if (otherWant < (C.splitRailW + C.splitEditorMin) / 2) paneW = avail - C.splitRailW;
								else paneW = Math.max(C.splitPreviewMin, Math.min(want, avail - C.splitEditorMin));
								paneW = Math.min(Math.max(paneW, 0), avail); // a viewport too narrow for BOTH minimums
							}
							paneX = vw2 - paneW;
						}
						// The preview sub-bar's height is per TIER: the two-pane row carries a 32px
						// "Collapse preview" button and the phone's does not, so the phone's band is
						// the shorter of the two. It no longer varies with the PANE's width — the
						// lens picker used to be the tallest thing in the row and shed 6px when a
						// narrow pane dropped its label; it is counter-sized now and never governs
						// (preview-rect.ts).
						// `lhGrow` above carries the raised-minimum-font case, and is 0 on the phone for
						// the reason given there. The two-pane row is FLAT until the line box passes the
						// 32px collapse button — 26px of line box, i.e. 6.8px of growth — so the split
						// tier takes only what exceeds that.
						var headerH = chromeless ? C.headerRead : (bpMobile ? C.headerWriteMobile : C.headerWriteSplit + Math.max(0, lhGrow - 6.8));
						G = { vw: vw2, vh: vh2, posture: posture, cinema: cinema, noTours: noTours, railW: railW, bpMobile: bpMobile, chromeless: chromeless, padX: padX, padY: padY, paneTop: paneTop, headerH: headerH, footerH: footerH, paneX: paneX, paneW: paneW, paneH: vh2 - paneTop };
						// Publishing is a function because the REPLAY seed below can widen the pane to
						// contain a replayed box (see there) and must re-publish the corrected values.
						// Every attribute is set OR cleared, never only set: a re-seed after a rotation
						// crosses in and out of cinema, and a stale `data-ssr-cinema` would hide the
						// chrome of the portrait layout it just switched to.
						G.publish = function () {
							if (G.cinema) {
								// CLEAR the portrait layout's flags before returning. The bands are
								// SIBLINGS of .ssr-chrome, so hiding the chrome does not hide them —
								// data-ssr-chrome is what gates them, and leaving it set painted a
								// portrait-width sub-bar and footer on top of a full-bleed cinema
								// slide. Unreachable while publish ran once; the re-seed below made it
								// reachable, which is precisely what a re-runnable publish has to own.
								r.removeAttribute('data-ssr-chrome');
								r.removeAttribute('data-ssr-rail');
								r.removeAttribute('data-ssr-read');
								r.setAttribute('data-ssr-cinema', '1');
								return;
							}
							r.removeAttribute('data-ssr-cinema');
							r.style.setProperty('--sh-pane-t', G.paneTop + 'px');
							r.style.setProperty('--sh-pane-l', G.paneX + 'px');
							r.style.setProperty('--sh-pane-w', G.paneW + 'px');
							r.style.setProperty('--sh-hdr', G.headerH + 'px');
							r.style.setProperty('--sh-ftr', G.footerH + 'px');
							r.style.setProperty('--sh-status', C.statusH + 'px');
							r.style.setProperty('--sh-rail', G.railW + 'px');
							// Presence, not width: the rail element carries a 1px border, so a
							// 0-width rail still draws a hairline down the left edge of a tablet.
							// The CSS gate keys on this attribute rather than re-deriving the tier.
							if (G.railW > 0) r.setAttribute('data-ssr-rail', '1'); else r.removeAttribute('data-ssr-rail');
							r.setAttribute('data-ssr-bp', G.bpMobile ? 'mobile' : 'wide');
							if (G.chromeless) r.setAttribute('data-ssr-read', '1'); else r.removeAttribute('data-ssr-read');
							r.setAttribute('data-ssr-stop', G.posture);
							if (G.noTours) r.setAttribute('data-ssr-no-tours', '1'); else r.removeAttribute('data-ssr-no-tours');
							r.setAttribute('data-ssr-chrome', '1');
						};
						G.publish();
						// NOT CORRECTED HERE, DELIBERATELY — see the note in preview-rect.ts on
						// mobileBarH. The phone's action bar is content-sized and already tracks a
						// raised minimum font size; everything below it is PLACED from the constant,
						// which does not, so the sub-bar sits up to 24px high for those readers.
						// A post-paint measure-and-republish fixes the number and loses the race:
						// the callback can fire after a rotation re-seed and republish the previous
						// orientation's geometry, and it does not re-run the box placement. It made
						// `rotation into cinema` and `a rect from another orientation` fail
						// intermittently (2 of 38 on one run, 0 on the next). An intermittent
						// geometry race is worse than a static offset on one band, so the offset
						// stays, measured and pinned by the @minfont matrix case, until the
						// correction can be folded into the re-seed path itself.
					} catch (e6) {
						// Same clear-symmetry rule as publish(): on a FIRST seed there is nothing to
						// undo, but a re-seed that throws would otherwise leave the previous
						// viewport's bands painted at the previous viewport's geometry.
						G = null;
						r.removeAttribute('data-ssr-chrome');
						r.removeAttribute('data-ssr-rail');
						r.removeAttribute('data-ssr-read');
						r.removeAttribute('data-ssr-cinema');
					}
					// BOX SEED — place the Nacre box at the EXACT rect the app last had its
					// preview box (persisted by StudioShell on unload as viewport fractions). On a
					// same-device reload the shell box then lands pixel-identical to where the
					// hydrated app re-measures it → no jump at hand-off. Computed to px from the
					// CURRENT viewport (not vw/vh units) so it matches whatever the app measures
					// now, and clamped on-screen in case the viewport changed since (rotation).
					// No saved rect (newcomer) → the compute fallback below.
					var hasRect = false;
					try {
						var rectRaw = localStorage.getItem(PREVIEW_RECT_KEY);
						if (rectRaw) {
							var q = JSON.parse(rectRaw);
							if (q && q.w > 0.1 && q.h > 0.05 && q.l >= 0 && q.t >= 0 && q.l < 1 && q.t < 1) {
								var vw = window.innerWidth, vh = window.innerHeight;
								var bw = Math.min(q.w * vw, vw);
								var bh = Math.min(q.h * vh, vh);
								// ASPECT SANITY. The rect is stored as viewport FRACTIONS, so it only
								// survives a change of viewport SHAPE if the shape did not change. Replay
								// one measured in landscape on a portrait phone and the fractions resolve
								// to a 300x791 panel where the app draws a 358x201 slide. The app's box
								// always carries the deck's own aspect, so a resolved rect that does not
								// is a rect from a layout this load cannot be in — drop it and compute.
								// (Catches a corrupt/hand-edited rect for free.)
								var wantAr = Array.isArray(rr) ? rr[0] / rr[1] : 0;
								var gotAr = bh > 0 ? bw / bh : 0;
								var aspectOk = wantAr > 0 && Math.abs(gotAr - wantAr) / wantAr <= 0.04;
								if (aspectOk) {
								var bl = Math.max(0, Math.min(q.l * vw, vw - bw));
								var bt = Math.max(0, Math.min(q.t * vh, vh - bh));
								r.style.setProperty('--sb-l', bl + 'px');
								r.style.setProperty('--sb-t', bt + 'px');
								r.style.setProperty('--sb-w', bw + 'px');
								r.style.setProperty('--sb-h', bh + 'px');
								hasRect = true;
								// The replayed box is the app's OWN measurement, so it already reflects a
								// splitter the user dragged; the chrome bands above were derived from the
								// PERSISTED split share, which is the same answer in every case we can
								// check — but a rect saved under an older rule set (a different stop, a
								// pre-migration key) can still disagree. Widen the pane to CONTAIN the
								// replayed box when it does, so the slide can never sit on the editor
								// band. Widening only — an agreeing rect comes through untouched.
								if (G && !G.cinema && !G.bpMobile) {
									if (bl - G.padX < G.paneX) { G.paneW += G.paneX - (bl - G.padX); G.paneX = bl - G.padX; }
									if (bl + bw + G.padX > G.paneX + G.paneW) G.paneW = bl + bw + G.padX - G.paneX;
									G.paneX = Math.max(0, G.paneX);
									G.paneW = Math.min(G.paneW, G.vw - G.paneX);
									G.publish();
								}
								}
							}
						}
					} catch (e2) {}
					// COMPUTE FALLBACK — when there is NO persisted rect (a brand-new visitor, a
					// cross-device first load), don't fall back to an approximate centered box:
					// COMPUTE the exact rect from known inputs, the same pure function the
					// validation proved matches the app to 0.1px. Every input (posture, breakpoint,
					// pane rect, per-stop chrome) comes from `G` above rather than being re-derived
					// — the second copy of that derivation is exactly the kind of drift the shell
					// keeps paying for — so this is only the letterbox fit of the deck ratio (`rr`)
					// into `G`'s pane. Still not modeled: the Craft stop's docked side panels
					// (rect-replay covers a returning visitor there).
					try {
						if (G && !hasRect) {
							var ar2 = rr[0] / rr[1];
							var cw = G.paneW - 2 * G.padX, ch = G.paneH - G.headerH - G.footerH - 2 * G.padY;
							// FLOOR, because the app does: the slide card's width is
							// `Math.floor(min(paneW, paneH * ratio))px` and its height follows from
							// `aspect-ratio`. Rounding the other way put the shell's box up to 1px wide
							// of the app's and, through the aspect ratio, ~0.6px tall of it.
							var bw2 = Math.floor(Math.max(0, Math.min(cw, ch * ar2)));
							var bh2 = bw2 / ar2;
							if (bw2 > 1 && bh2 > 1) {
								r.style.setProperty('--sb-l', (G.paneX + G.padX + (cw - bw2) / 2) + 'px');
								r.style.setProperty('--sb-t', (G.paneTop + G.headerH + G.padY + (ch - bh2) / 2) + 'px');
								r.style.setProperty('--sb-w', bw2 + 'px');
								r.style.setProperty('--sb-h', bh2 + 'px');
								hasRect = true;
							}
						}
					} catch (e4) {}
					// A re-seed that can no longer place the box must UNSET the flag, or the CSS
					// keeps absolutely positioning the box at the previous viewport's rect.
					if (hasRect) r.setAttribute('data-ssr-rect', '1'); else r.removeAttribute('data-ssr-rect');
				};
				seedGeometry();
				// Re-seed while the shell is up. A phone rotated during the engine fetch is the
				// case that matters: the geometry was derived once, at parse time, and the shell
				// would hold the portrait layout until hydration corrected it in one jump. The
				// listener retires itself the moment the app removes the shell node — latched on
				// having SEEN it, because at parse time the node has not been created yet and a
				// bare absence check would unhook immediately.
				// Retire on the first resize that finds the shell GONE — but only once parsing has
				// finished, because this script runs in <head> and an absent node before then means
				// "not created yet", not "dismissed". The previous form latched on having SEEN the
				// shell during a resize; for most visitors no resize fires while it is up, so the
				// latch never set and the listener went on re-seeding a page with no shell, forever.
				var reseed = function () {
					if (document.readyState !== 'loading' && !document.getElementById('studio-ssr-shell')) {
						window.removeEventListener('resize', reseed);
						window.removeEventListener('orientationchange', reseed);
						return;
					}
					seedGeometry();
				};
				window.addEventListener('resize', reseed);
				window.addEventListener('orientationchange', reseed);
				// (The editor|preview split ratio's pre-paint CSS-var seed is retired
				// with the react-resizable-panels migration: the hook restores the saved
				// ratio post-mount via the panel imperative API. Studio is client:only,
				// so there is no SSR split paint to seed anyway. 2026-07-19.)
				} catch (e) {}
			})();
		</script>
	</head>
	<body>
		{/* First tabbable element on the surface — the bypass has to come before the
		    chrome it bypasses. The Studio is `client:only`, so `#main-content` exists
		    only after hydration; that is fine, because before hydration there is no
		    content to skip to. */}
		<SkipLink />
		{/* Pre-hydration INSTANT SHELL — Nacre-only skeleton, one contained 16:9 box, shown
		    to every visitor and dismissed by the app once its own (identical) Nacre is up.
		    No baked slide, no snapshot replay — one surface, no seam. */}
		<!-- `inert` is load-bearing now that the chrome is REAL controls: a <button> inside an
		     aria-hidden subtree is still tabbable, so a keyboard user would land on buttons that
		     do nothing while the app boots. `inert` takes them out of the tab order AND the a11y
		     tree, and pointer-events:none already blocks the mouse.
		     `lx-ui` is equally load-bearing: Tailwind Preflight is OFF site-wide, and shadcn's
		     baseline reset is SCOPED to that class on every island root (styles/tailwind.css).
		     Without it the shell's Buttons render on the browser's default box model and the
		     eight-cell bar distributes its fractional cell widths differently from the app's —
		     measured as a 3px drift by the sixth cell. -->
		<div id="studio-ssr-shell" class="lx-ui" aria-hidden="true" inert>
			{/* Chrome — the APP'S OWN controls, rendered to static HTML at build time (no client
			    directive = zero JS). Everything visible here comes from the same Button /
			    LatticeMark / BarIcon / PostureDial the hydrated app renders, so there is no
			    copied glyph or size to drift. See StudioChromeSkeleton. */}
			<div class="ssr-chrome"><StudioChromeSkeleton deckTitle={firstDeck.title} /></div>
			<script is:inline>(function(){var v=document.documentElement.getAttribute("data-ssr-title");if(!v)return;var t=document.querySelectorAll(".ssr-deck-title");for(var i=0;i<t.length;i++)t[i].textContent=v;})();</script>
			{/* The pane bands — positioned at the rect the CHROME SEED resolved, and dropped
			    entirely if that seed didn't run. See SHELL_BANDS_CSS. */}
			<div class="ssr-band ssr-activityrail"><StudioActivityRailSkeleton /></div>
			<div class="ssr-band ssr-editpane"><StudioEditorPaneSkeleton /></div>
			<div class="ssr-band ssr-panehdr"><StudioPreviewBarSkeleton /></div>
			<div class="ssr-band ssr-paneftr"><StudioPreviewFooterSkeleton /></div>
			<div class="ssr-stage">
				<div class="ssr-slidebox" id="ssr-slidebox">
					<span class="nacre-loader" aria-hidden="true">
						<span class="nacre-loader__core"></span>
						<span class="nacre-loader__layer nacre-loader__layer--0"><i class="nacre-loader__blob"></i><i class="nacre-loader__blob"></i><i class="nacre-loader__blob"></i></span>
						<span class="nacre-loader__layer nacre-loader__layer--1"><i class="nacre-loader__blob"></i><i class="nacre-loader__blob"></i><i class="nacre-loader__blob"></i></span>
						<span class="nacre-loader__layer nacre-loader__layer--2"><i class="nacre-loader__blob"></i><i class="nacre-loader__blob"></i><i class="nacre-loader__blob"></i></span>
						<span class="nacre-loader__vig"></span>
					</span>
				</div>
			</div>
		</div>
		<!-- client:only — the Studio is a browser app surface (no SSR/SEO need),
		     so it never server-renders; this also sidesteps Browser-API-on-server. -->
		<StudioIsland client:only="react" options={options} componentNames={componentNames} catalogUrl={url('studio/component-catalog.json')} lintVocab={lintVocab} slideHeadings={slideHeadings} slideBlocks={slideBlocks} />
		{/* Live viz diagnostics — renders nothing until the Workspace → Diagnostics
		    switch (or ?viz) turns it on; then reads dropped-to-black chart paint from
		    the render pipeline. */}
		<VizDiagnosticsOverlay />
		{/* Preview fidelity — renders nothing until the Workspace → Diagnostics switch
		    (or ?fidelity) turns it on; then reports whether the slide on screen is what the
		    full deck would render, and why the preview took the route it took. */}
		<PreviewFidelityOverlay />
		{/* Live viewport-debug readout — renders nothing until the Workspace →
		    Diagnostics switch (or ?vvdebug) turns it on; then reads the live viewport
		    geometry (layout + visual viewport, svh/dvh/lvh, cinema stage, iframe rect)
		    on the real device — the on-device probe that diagnosed the #1121 landscape
		    overflow. */}
		<ViewportDebugOverlay />
		{/* Intent-gated engine warm (was allowEager): the eager 505KB fetch competed
		    with first paint/hydration. StudioShell loads the engine on mount, so
		    warming only needs to fire on pointer/focus intent — off the paint path. */}
		<EngineWarm />
	</body>
</html>
