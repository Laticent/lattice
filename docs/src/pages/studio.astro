---
// The Studio — the unified workspace prototype from the redesign decision doc
// (engineering/decisions/2026-06-21-app-redesign.md). A single standalone route
// that renders the v4 lean shell as ONE React island (StudioShell), wired live:
// a real CodeMirror editor, a live engine preview (DeckPreview), the Architect,
// the deck Inspector, Share / Workspace / Present overlays, the ⌘K palette, and
// the Fabricate studio. It is ADDITIVE — it does not touch the shipped Drawing
// Board / Playground; the engine is loaded on demand exactly as those do.
import '../styles/landing.css';
import StudioShell from '../components/studio/StudioShell.tsx';
import ResourceHints from '../components/site/ResourceHints.astro';
import EngineWarm from '../components/site/EngineWarm.astro';
import { joinBase } from '../lib/base-url.mjs';
import { assetBase } from '../playground/asset-version.mjs';
import { DECKS } from '../components/studio/decks';
import { renderFirstSlideShell } from '../../scripts/ssg-first-slide.mjs';
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { join } from 'node:path';

const base = import.meta.env.BASE_URL;
const url = (p) => joinBase(base, p);
const pg = assetBase();

const options = {
	themeBase: url(pg + 'themes/'),
	runtimeUrl: url(pg + 'lattice-runtime.js'),
	engineUrl: url(pg + 'lattice-playground.js'),
	// Locally-vendored Mermaid — the SAME committed `mermaid-v11.min.js` the
	// Export-to-Marp bundle ships (staged under export/), which sets the
	// `globalThis.mermaid` the runtime orchestrates. The Studio renders diagrams
	// from our own origin, never the jsdelivr CDN (offline / strict-CSP safe).
	mermaidUrl: url(pg + 'export/mermaid-v11.min.js'),
	// Locally-vendored KaTeX (staged under katex/) for the presenter/stage math path —
	// same reason as Mermaid: render math from our own origin, never jsdelivr.
	katexUrl: url(pg + 'katex/katex.min.css'),
};

// The component catalog, read from the committed machine manifest at build time
// and trimmed to what the insert palette needs (name / bucket / description /
// the authored insert skeleton). Serialized into the island as a prop.
let components = [];
try {
	// Resolve from the repo root via process.cwd() (docs/ at build), NOT
	// import.meta.url — under `astro build` the page frontmatter is bundled into a
	// chunk whose URL no longer sits at src/pages/, so the relative walk misses and
	// the catch silently empties the catalog (disabling Insert). This mirrors the
	// lintVocab read below, which already resolves from process.cwd().
	const catalog = JSON.parse(readFileSync(join(process.cwd(), '..', 'dist/docs/components.json'), 'utf8'));
	components = (catalog.components || [])
		.map((c) => ({
			name: c.name,
			bucket: c.bucket,
			description: c.description || '',
			skeleton: String(c.skeleton || ''),
			// Per-component validity data for the per-slide drawer: which variants /
			// family modifiers / axes this layout actually accepts, so the drawer only
			// offers controls that resolve at render time (never a disabled graveyard).
			variants: Array.isArray(c.variants) ? c.variants : [],
			...(Array.isArray(c.variantAxes) && c.variantAxes.length ? { variantAxes: c.variantAxes } : {}),
			effectiveVariants: Array.isArray(c.effectiveVariants) ? c.effectiveVariants : [],
			familyModifiers: Array.isArray(c.familyModifiers) ? c.familyModifiers : [],
			...(Array.isArray(c.focusAxes) && c.focusAxes.length ? { focusAxes: c.focusAxes } : {}),
		}))
		.filter((c) => c.name && c.skeleton);
} catch (e) {
	components = [];
}

// The deterministic lint vocabulary — built at build time from the LIVE component
// manifests (the SAME buildVocab the Drawing Board and the Node CLI use), so the
// editor's inline grammar linter is the canonical lint-core, not a reduced copy.
let lintVocab = null;
try {
	const require = createRequire(import.meta.url);
	const repoRoot = join(process.cwd(), '..');
	const { loadAll } = require(join(repoRoot, 'lib/components', 'index.js'));
	const { buildVocab } = require(join(repoRoot, 'lib/authoring', 'lint.js'));
	const v = buildVocab(loadAll());
	lintVocab = {
		names: [...v.names],
		modifiers: [...v.modifiers],
		// The cross-component modifier tokens (`dark`, `light`, `numbered`, tone/stamp/
		// spectrum styles, …) valid on ANY slide — drives the editor's `_class:` /
		// `class:` modifier completion (never a hand-kept list).
		universalModifiers: [...(v.universalModifiers || [])],
		mapRegions: Object.fromEntries(Object.entries(v.mapRegions || {}).map(([k, mv]) => [k, { valid: [...mv.valid], names: mv.names }])),
		finishNames: v.finishNames || [],
		modeNames: v.modeNames || [],
		splitNames: v.splitNames || [],
		capacity: v.capacity || {},
		universalGroups: v.universalGroups || {},
		semiUniversalVariants: v.semiUniversalVariants || [],
		exclusiveAxes: v.exclusiveAxes || {},
		stampStyles: v.stampStyles || { boardroom: [], range: [] },
		toneStyles: v.toneStyles || [],
		stampStyleNames: v.stampStyleNames || [],
		toneStyleNames: v.toneStyleNames || [],
		spectrumNames: v.spectrumNames || [],
	};
} catch (e) {
	lintVocab = null;
}

// SSG the first slide of the newcomer's default deck (DECKS[0] · indaco · light)
// into a static, no-JS instant shell below. It paints the largest element at
// HTML-parse time so mobile LCP no longer waits on the client:only island +
// engine bundle. A returning user (saved deck / non-default palette or mode) is
// gated OUT of the shell by the pre-paint seed script — for them the welcome
// slide is the wrong content, so they keep the prior (island-gated) first paint.
// engineering/decisions/2026-07-11-preview-performance-diagnosis.md (front A).
const SSR_PALETTE = 'indaco';
const firstDeck = DECKS[0];
// process.cwd() is docs/ under `astro build` (the same basis the lintVocab read
// below uses); repo root is one up. NOT an import.meta.url walk — the bundled
// frontmatter chunk doesn't sit at src/pages/.
const shell = firstDeck?.slides?.[0] ? await renderFirstSlideShell(firstDeck.slides[0], SSR_PALETTE, join(process.cwd(), '..')) : null;
// Chrome + responsive-scale CSS for the instant shell. Keyed under
// #studio-ssr-shell so it never touches the hydrated island; the slide scales
// fluidly via its own container queries (fixed 1280×720 → width:100% + the deck's
// aspect box), so no JS measure is needed and there is no layout shift.
const SHELL_CHROME_CSS = shell
	? `#studio-ssr-shell{position:fixed;inset:0;z-index:1;flex-direction:column;background:#e7e7ea;color:#1a1a1a;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased;}
#studio-ssr-shell .ssr-topbar{flex:0 0 auto;height:52px;display:flex;align-items:center;gap:10px;padding:0 16px;border-bottom:1px solid rgba(0,0,0,.08);background:#fbfbfa;}
#studio-ssr-shell .ssr-logo{width:22px;height:22px;border-radius:6px;background:conic-gradient(from 45deg,#1a3a5c,#3f6d9c,#1a3a5c);flex:0 0 auto;}
#studio-ssr-shell .ssr-deck-title{font-weight:600;font-size:15px;line-height:1;}
#studio-ssr-shell .ssr-welcome{flex:0 0 auto;margin:0;padding:12px 16px;font-size:13px;line-height:1.5;color:#41403c;background:#f2efe9;border-bottom:1px solid rgba(0,0,0,.06);}
#studio-ssr-shell .ssr-welcome strong{color:#1a1a1a;font-weight:600;}
#studio-ssr-shell .ssr-stage{flex:1 1 auto;min-height:0;display:flex;align-items:center;justify-content:center;padding:clamp(12px,4vw,32px);}
#studio-ssr-shell .ssr-slidebox{width:100%;max-width:min(960px,100%);box-shadow:0 8px 30px rgba(0,0,0,.16);border-radius:8px;overflow:hidden;}
#studio-ssr-shell .ssr-slidebox .lattice{width:100%;}
#studio-ssr-shell .ssr-slidebox .lattice>section{width:100%!important;height:auto!important;max-width:100%;aspect-ratio:${shell.width}/${shell.height};}`
	: '';
---

<!doctype html>
<html lang="en" data-palette="indaco" data-mode="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<ResourceHints />
		<title>Lattice Studio — one workspace</title>
		<meta name="description" content="The Lattice Studio: compose, present, and fabricate decks in one workspace. A live prototype of the app redesign." />
		<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
		<style is:global>
			html, body { margin: 0; height: 100%; overflow: hidden; }
			/* Instant-shell (below) is hidden by default; the pre-paint seed script
			   flips data-ssr-shell="on" only for a first-time visitor on the default look. */
			#studio-ssr-shell { display: none; }
			:root[data-ssr-shell="on"] #studio-ssr-shell { display: flex; }
		</style>
		{shell && <style is:inline set:html={shell.css + SHELL_CHROME_CSS}></style>}
		<script is:inline>
			(function () {
				var r = document.documentElement;
				try {
					var p = localStorage.getItem('lattice-studio-palette');
					var palette = 'indaco';
					if (p && ['indaco','cuoio','burgundy','laguna','crepuscolo','atelier','carbone','onyx'].indexOf(p) !== -1) { r.setAttribute('data-palette', p); palette = p; }
					var m = localStorage.getItem('lattice-docs-mode');
					var mode = 'light';
					if (m === 'light' || m === 'dark') { r.setAttribute('data-mode', m); mode = m; }
					else if (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) { r.setAttribute('data-mode', 'dark'); mode = 'dark'; }
					// Gate the SSG instant-shell (below): show it ONLY to a first-time visitor on
					// the default look — the shell bakes DECKS[0]'s title slide in indaco·light,
					// exactly what a newcomer lands on. A returning user (any saved deck → the
					// deck-index key exists) or a non-default palette/mode would see wrong
					// content/theme, so they keep the prior island-gated first paint.
					if (!localStorage.getItem('lattice-studio-deck-index') && palette === 'indaco' && mode === 'light') r.setAttribute('data-ssr-shell', 'on');
					// Pre-paint seed for the editor|preview split ratio: the Studio grid
					// consumes these as var() fallbacks, so a returning resizer's saved
					// width applies before the island hydrates (no first-paint jump).
					// Clamped to the same [0.2, 0.8] band the split hook enforces.
					var sp = localStorage.getItem('lattice-docs-split-studio');
					if (sp) {
						var sv = JSON.parse(sp);
						if (sv && sv.v === 1 && typeof sv.a === 'number' && sv.a >= 0.2 && sv.a <= 0.8) {
							// Doubled flex pair (sum 2, never 1) — a sum-1 pair leaves a
							// dead void when a pane clamps at its px minimum (CSS Grid
							// §12.7.1). Must match split.tsx splitFlexPair.
							r.style.setProperty('--split-studio-a', 2 * sv.a + 'fr');
							r.style.setProperty('--split-studio-b', 2 * (1 - sv.a) + 'fr');
						}
					}
				} catch (e) {}
			})();
		</script>
	</head>
	<body>
		{/* SSG instant-shell: paints DECKS[0]'s first slide (static HTML + critical
		    CSS, no JS) so mobile LCP lands at HTML-parse time instead of after the
		    client:only island + engine bundle. StudioShell removes #studio-ssr-shell
		    on mount; a returning user is gated out by the seed script above. */}
		{shell && (
			<div id="studio-ssr-shell" aria-hidden="true">
				<div class="ssr-topbar">
					<span class="ssr-logo"></span>
					<span class="ssr-deck-title">{firstDeck.title}</span>
				</div>
				{/* Static twin of the newcomer welcome banner (StudioShell). It is the
				    largest above-the-fold text a first-time visitor sees, so rendering it
				    here makes the LARGEST-contentful-paint a server-rendered element at
				    HTML-parse time — the LCP lands near FCP, not at hydration. */}
				<p class="ssr-welcome"><strong>New here?</strong> This is a sample deck about Lattice — edit any slide to make it yours. Your AI Coach and deck settings are one tap away.</p>
				<div class="ssr-stage">
					<div class="ssr-slidebox" set:html={shell.html}></div>
				</div>
			</div>
		)}
		<!-- client:only — the Studio is a browser app surface (no SSR/SEO need),
		     so it never server-renders; this also sidesteps Browser-API-on-server. -->
		<StudioShell client:only="react" options={options} components={components} lintVocab={lintVocab} />
		{/* Intent-gated engine warm (was allowEager): the eager 505KB fetch competed
		    with first paint/hydration. StudioShell loads the engine on mount, so
		    warming only needs to fire on pointer/focus intent — off the paint path. */}
		<EngineWarm />
	</body>
</html>
