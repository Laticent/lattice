---
// The Studio — the unified workspace prototype from the redesign decision doc
// (engineering/decisions/2026-06-21-app-redesign.md). A single standalone route
// that renders the v4 lean shell as ONE React island — StudioShell, mounted
// through the StudioIsland wrapper so its effects run under React StrictMode
// (a dev-only double-mount that surfaces missing-cleanup leaks; no-op in prod) —
// wired live:
// a real CodeMirror editor, a live engine preview (DeckPreview), the Architect,
// the deck Inspector, Share / Workspace / Present overlays, the ⌘K palette, and
// the Fabricate studio. It is ADDITIVE — it does not touch the shipped Drawing
// Board / Playground; the engine is loaded on demand exactly as those do.
import '../styles/landing.css';
import StudioIsland from '../components/studio/StudioIsland.tsx';
import VizDiagnosticsOverlay from '../components/studio/VizDiagnosticsOverlay.astro';
import ViewportDebugOverlay from '../components/studio/ViewportDebugOverlay.astro';
import SkipLink from '../components/SkipLink.astro';
import ResourceHints from '../components/site/ResourceHints.astro';
import ColorSchemeSeed from '../components/site/ColorSchemeSeed.astro';
import EngineWarm from '../components/site/EngineWarm.astro';
import RuntimeWarm from '../components/site/RuntimeWarm.astro';
import { joinBase } from '../lib/base-url.mjs';
import { assetBase } from '../playground/asset-version.mjs';
import { DECKS, deckSource } from '../components/studio/decks';
import { SIZE_RATIO, deckRatio } from '../components/studio/slide-size';
import { PREVIEW_CHROME } from '../components/studio/preview-rect';
import { BUILTIN_PALETTES } from '../components/studio/palettes';
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { join } from 'node:path';

const base = import.meta.env.BASE_URL;
const url = (p) => joinBase(base, p);
const pg = assetBase();

const options = {
	themeBase: url(pg + 'themes/'),
	runtimeUrl: url(pg + 'lattice-runtime.js'),
	engineUrl: url(pg + 'lattice-playground.js'),
	// Locally-vendored Mermaid — the SAME committed `mermaid-v11.min.js` the
	// Export-to-Marp bundle ships (staged under export/), which sets the
	// `globalThis.mermaid` the runtime orchestrates. The Studio renders diagrams
	// from our own origin, never the jsdelivr CDN (offline / strict-CSP safe).
	mermaidUrl: url(pg + 'export/mermaid-v11.min.js'),
	// Locally-vendored KaTeX (staged under katex/) for the presenter/stage math path —
	// same reason as Mermaid: render math from our own origin, never jsdelivr.
	katexUrl: url(pg + 'katex/katex.min.css'),
};

// The component catalog, read from the committed machine manifest at build time
// and trimmed to what the insert palette needs (name / bucket / description /
// the authored insert skeleton). Serialized into the island as a prop.
let components = [];
try {
	// Resolve from the repo root via process.cwd() (docs/ at build), NOT
	// import.meta.url — under `astro build` the page frontmatter is bundled into a
	// chunk whose URL no longer sits at src/pages/, so the relative walk misses and
	// the catch silently empties the catalog (disabling Insert). This mirrors the
	// lintVocab read below, which already resolves from process.cwd().
	const catalog = JSON.parse(readFileSync(join(process.cwd(), '..', 'dist/docs/components.json'), 'utf8'));
	components = (catalog.components || [])
		.map((c) => ({
			name: c.name,
			bucket: c.bucket,
			// The semantic role axes the reader-lens suggester keys off (function/form). Present
			// in components.json; carried through so the Lenses panel can build a ComponentCatalog.
			function: c.function || '',
			form: c.form || '',
			// The add-slide gallery (SlidePicker) filters on these + shows `purpose` in its
			// detail rail; without them the shared search core throws on undefined `tags`.
			substance: c.substance || '',
			tags: Array.isArray(c.tags) ? c.tags : [],
			purpose: c.purpose || '',
			description: c.description || '',
			// Prose-density budget (axis/soft/hard). The engine review's density findings
			// key off it via `densityOf`; without it those findings silently vanish from the
			// Coach's assessment (succession doc §2.1). Present in components.json.
			...(c.density ? { density: c.density } : {}),
			skeleton: String(c.skeleton || ''),
			// Per-component validity data for the per-slide drawer: which variants /
			// family modifiers / axes this layout actually accepts, so the drawer only
			// offers controls that resolve at render time (never a disabled graveyard).
			variants: Array.isArray(c.variants) ? c.variants : [],
			...(Array.isArray(c.variantAxes) && c.variantAxes.length ? { variantAxes: c.variantAxes } : {}),
			effectiveVariants: Array.isArray(c.effectiveVariants) ? c.effectiveVariants : [],
			familyModifiers: Array.isArray(c.familyModifiers) ? c.familyModifiers : [],
			...(Array.isArray(c.focusAxes) && c.focusAxes.length ? { focusAxes: c.focusAxes } : {}),
		}))
		.filter((c) => c.name && c.skeleton);
} catch (e) {
	components = [];
}

// The per-class HEADING register for Compose: a `_class` name → the heading level(s) its GRAMMAR
// anchors ('h1' for the title family, 'h2' for body classes, both where the slot lists both), read from
// each component's heading/title slot in the generated grammar (`dist/docs/grammar.json`). A KNOWN class
// with NO heading slot maps to an empty `[]` (Compose then offers no heading register — e.g. big-number,
// whose hero is a list item). Threaded into the Compose editor so its Format group offers the grammar-
// correct heading — never H1 on a body slide, never H2 on a title — sharing the engine's slot contract
// as the one source of truth (HARD RULE #1).
let slideHeadings = {};
try {
	const grammar = JSON.parse(readFileSync(join(process.cwd(), '..', 'dist/docs/grammar.json'), 'utf8'));
	for (const c of grammar.components || []) {
		if (!c.name) continue;
		const slots = c.slots || {};
		// Scan EVERY slot's selector for a heading element, not just the slot NAMED heading/title — a
		// class can carry its heading in a differently-named slot (e.g. policy-recommendation's required
		// `recommendation` slot has selector `h2`). Keying on the slot name alone wrongly mapped such a
		// class to [] and hid its H2 (trio: red-team + checker MAJOR). Match hN only as an ELEMENT
		// selector (start / whitespace / a combinator before it, no word-char or hyphen after) so a
		// class/id token like `.h2-foo` never false-matches. `h1, h2` (journey) yields both levels.
		const levels = [];
		for (const slot of Object.values(slots)) {
			for (const mm of String(slot?.selector || '').matchAll(/(?:^|[\s>,(+~])h([1-6])(?![\w-])/g)) levels.push(mm[1] === '1' ? 'h1' : 'h2');
		}
		// The class's declared heading level set — an EMPTY [] means no slot renders a heading at all
		// (big-number, quote), so Compose offers no heading register there rather than the permissive
		// default. A class absent from the map entirely (unnamed) stays permissive in `headingKeysFor`.
		slideHeadings[c.name] = [...new Set(levels)];
	}
} catch (e) {
	// Graceful, but make the degradation OBSERVABLE: a missing/corrupt grammar.json or a slot-shape
	// change silently disables grammar-driven headings site-wide (every class → permissive H1/H2).
	console.warn('[studio] slideHeadings: could not derive the grammar heading map — Compose falls back to permissive H1/H2', e && e.message);
	slideHeadings = {};
}

// The deterministic lint vocabulary — built at build time from the LIVE component
// manifests (the SAME buildVocab the Drawing Board and the Node CLI use), so the
// editor's inline grammar linter is the canonical lint-core, not a reduced copy.
let lintVocab = null;
try {
	const require = createRequire(import.meta.url);
	const repoRoot = join(process.cwd(), '..');
	const { loadAll } = require(join(repoRoot, 'lib/components', 'index.js'));
	const { buildVocab } = require(join(repoRoot, 'lib/authoring', 'lint.js'));
	const v = buildVocab(loadAll());
	lintVocab = {
		names: [...v.names],
		modifiers: [...v.modifiers],
		// The cross-component modifier tokens (`dark`, `light`, `numbered`, tone/stamp/
		// spectrum styles, …) valid on ANY slide — drives the editor's `_class:` /
		// `class:` modifier completion (never a hand-kept list).
		universalModifiers: [...(v.universalModifiers || [])],
		mapRegions: Object.fromEntries(Object.entries(v.mapRegions || {}).map(([k, mv]) => [k, { valid: [...mv.valid], names: mv.names }])),
		finishNames: v.finishNames || [],
		modeNames: v.modeNames || [],
		splitNames: v.splitNames || [],
		capacity: v.capacity || {},
		sizes: v.sizes || undefined,
		universalGroups: v.universalGroups || {},
		semiUniversalVariants: v.semiUniversalVariants || [],
		exclusiveAxes: v.exclusiveAxes || {},
		stampStyles: v.stampStyles || { boardroom: [], range: [] },
		toneStyles: v.toneStyles || [],
		stampStyleNames: v.stampStyleNames || [],
		toneStyleNames: v.toneStyleNames || [],
		spectrumNames: v.spectrumNames || [],
	};
} catch (e) {
	lintVocab = null;
}

// firstDeck powers only the instant-shell topbar title (a chrome placeholder shown until
// the hydrated app's own topbar takes over). The shell paints a static, no-JS Nacre
// skeleton at HTML-parse time so a reload never stares at a blank preview while the
// client:only island + engine bundle load.
const firstDeck = DECKS[0];
// Aspect ratio (w:h) each builtin deck renders at — its AUTHOR-CHOSEN size, never assumed
// 16:9 — so the instant shell's fallback box matches the deck the visitor actually boots
// into. Injected into the seed below (with the size map, for resolving a user-edited deck's
// size pre-paint). DEFAULT_RATIO is the newcomer's deck (DECKS[0]).
const DECK_RATIOS: Record<string, [number, number]> = Object.fromEntries(DECKS.map((d) => [d.id, deckRatio(deckSource(d))]));
const DEFAULT_RATIO = DECK_RATIOS[firstDeck.id] ?? [16, 9];
// Built-in deckId → title, so the seed can best-effort correct the shell topbar title to the
// LAST-ACTIVE deck (not just DECKS[0]) for a returning visitor — a title, never slide content.
const DECK_TITLES: Record<string, string> = Object.fromEntries(DECKS.map((d) => [d.id, d.title]));
// The Studio's pre-hydration INSTANT SHELL is Nacre-ONLY: a single animated skeleton in one
// contained box (at the deck's chosen aspect), shown to EVERY visitor at HTML-parse time
// (before the client:only island + the ~505KB engine load) and dismissed by the app once its
// own (identical) Nacre is up. There is deliberately NO cached-last-slide replay and NO
// server-rendered welcome slide: a second, REAL-CONTENT surface racing the live preview at a
// mismatched geometry was the root of the "slide in the top half, shimmer bleeding into the
// bottom, seam down the middle" bug on mobile (two surfaces, two coordinate systems, one gated
// on the flaky iOS reveal). One skeleton, one rect, one honest ground — the seam is now
// structurally impossible. See engineering/decisions/2026-07-21-studio-preview-one-skeleton.md.
// Chrome for the instant shell (topbar + centered stage). Keyed under #studio-ssr-shell so
// it never touches the hydrated island. The shell ground is the theme `var(--bg)` (the SAME
// token the hydrated app's root `bg-background` and the Nacre card resolve to) — NOT a hardcoded
// near-black. A hardcoded `#0c0c0c` made the pre-hydration letterbox flash BLACK around the navy
// Nacre card, then jump to the app's navy `--bg` on hydration (reported on iPhone reload). Using
// `var(--bg)` makes the letterbox, the Nacre card, and the hydrated pane one continuous ground.
const SHELL_CHROME_CSS = `#studio-ssr-shell{position:fixed;inset:0;z-index:1;pointer-events:none;flex-direction:column;background:var(--bg,#e9eef5);color:var(--text-body,#1a1a1a);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased;--mark-bond:#003d66;--mark-halo:#faf7f2;}
:root[data-mode="dark"] #studio-ssr-shell{background:var(--bg,#0c1626);color:var(--text-body,#e8e8e8);--mark-bond:#4fa8da;--mark-halo:#15110d;}
#studio-ssr-shell .ssr-topbar{flex:0 0 auto;height:54px;display:flex;align-items:center;gap:10px;padding:0 16px;border-bottom:1px solid var(--border,rgba(127,127,127,.16));background:color-mix(in srgb,var(--bg,#0c1626) 92%,transparent);}
#studio-ssr-shell .ssr-logo{width:26px;height:26px;flex:0 0 auto;}
#studio-ssr-shell .ssr-deck-title{font-weight:600;font-size:15px;line-height:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text-heading,inherit);}
#studio-ssr-shell .ssr-stage{flex:1 1 auto;min-height:0;display:flex;align-items:center;justify-content:center;padding:clamp(12px,3vw,20px);container-type:size;}
/* FALLBACK box (a visitor with no persisted rect): ONE full-bleed box at the deck's
   AUTHOR-CHOSEN aspect (--sb-ratio / numeric --sb-ar, seeded below; the engine's own 16:9
   only when a deck names no size), fit into the stage the SAME way the app fits its preview:
   width = min(available width, available height × ratio) via container-query units, so it
   letterboxes correctly for ANY aspect — a square/portrait deck binds on height on a wide
   viewport, a landscape deck binds on width on a phone. Mirrors the app's newcomer boot (the
   Read stop's full-bleed preview). The letterbox bands are flat shell background — never
   Nacre — the invariant that kills the bleed. */
#studio-ssr-shell .ssr-slidebox{position:relative;width:min(100cqw, calc(100cqh * var(--sb-ar, 1.7778)));aspect-ratio:var(--sb-ratio, 16 / 9);box-shadow:0 8px 30px rgba(0,0,0,.16);border-radius:8px;overflow:hidden;}
/* RECT-REPLAY mode: a returning visitor's seed script (below) resolved the app's OWN last
   preview-box rect from localStorage and set --sb-* to px in the CURRENT viewport. Position
   the box ABSOLUTELY at that rect (its containing block is the position:fixed shell = the
   viewport), so the Nacre lands exactly where the hydrated app will re-measure its box — no
   geometry reimplementation here, so it can't drift from the app's split/stop/ratio layout. */
:root[data-ssr-rect] #studio-ssr-shell .ssr-stage{display:block;padding:0;container-type:normal;}
:root[data-ssr-rect] #studio-ssr-shell .ssr-slidebox{position:absolute;left:var(--sb-l);top:var(--sb-t);width:var(--sb-w);height:var(--sb-h);max-width:none;max-height:none;aspect-ratio:auto;}`;

// The Nacre skeleton — a scoped inline COPY of docs/src/styles/nacre-loader.css (the
// island's stylesheet doesn't exist pre-hydration). It fills the 16:9 .ssr-slidebox exactly
// (inset:0), so it can never bleed past the slide rect. Palette-blind via the render-blocking
// --accent/--bg tokens. KEEP IN SYNC with nacre-loader.css (keyframes name + fallback hexes).
const SHELL_NACRE_CSS = `#studio-ssr-shell .nacre-loader{position:absolute;inset:0;overflow:hidden;isolation:isolate;background:var(--bg,#0c1626);}
#studio-ssr-shell .nacre-loader__layer{position:absolute;inset:-35%;mix-blend-mode:screen;transform-origin:50% 50%;will-change:transform;}
#studio-ssr-shell .nacre-loader__layer--0{filter:blur(26px);animation:nacre-rot 9s linear infinite;}
#studio-ssr-shell .nacre-loader__layer--1{filter:blur(26px) hue-rotate(34deg);animation:nacre-rot 12s linear infinite reverse;}
#studio-ssr-shell .nacre-loader__layer--2{filter:blur(26px) hue-rotate(-28deg);animation:nacre-rot 15s linear infinite;}
#studio-ssr-shell .nacre-loader__blob{position:absolute;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--accent,#5b8fc7) 60%,transparent),transparent 64%);}
#studio-ssr-shell .nacre-loader__blob:nth-child(1){width:54%;aspect-ratio:1;left:10%;top:16%;}
#studio-ssr-shell .nacre-loader__blob:nth-child(2){width:46%;aspect-ratio:1;left:56%;top:20%;}
#studio-ssr-shell .nacre-loader__blob:nth-child(3){width:50%;aspect-ratio:1;left:32%;top:56%;}
#studio-ssr-shell .nacre-loader__core{position:absolute;inset:0;background:radial-gradient(58% 58% at 50% 46%,color-mix(in srgb,var(--accent,#5b8fc7) 15%,transparent),transparent 72%);}
#studio-ssr-shell .nacre-loader__vig{position:absolute;inset:0;box-shadow:inset 0 0 70px 14px color-mix(in srgb,var(--bg,#0c1626) 92%,transparent);}
:root[data-mode="light"] #studio-ssr-shell .nacre-loader{background:var(--bg,#e9eef5);}
:root[data-mode="light"] #studio-ssr-shell .nacre-loader__layer{mix-blend-mode:multiply;}
@keyframes nacre-rot{to{transform:rotate(360deg);}}
@media (prefers-reduced-motion: reduce){#studio-ssr-shell .nacre-loader__layer{animation:none;}}`;

// (The old pre-paint REPLAY_JS — a per-visitor snapshot-replay / newcomer welcome-slide
// selection — is retired with the Nacre-only shell: there is no per-visitor content to
// choose anymore, so the shell is a static skeleton shown unconditionally by the seed
// script below. Why it went away: that real-slide replay was a SECOND preview surface that
// raced the live one in a different coordinate system, producing the "slide top-half /
// shimmer bottom-half, seam down the middle" bug on mobile. See
// engineering/decisions/2026-07-21-studio-preview-one-skeleton.md.)
---

<!doctype html>
<html lang="en" data-palette="indaco" data-mode="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		{/* FIRST thing after the charset/viewport metas: pin color-scheme to the app mode so the
		    blank canvas (shown while the render-blocking CSS loads) is never a white flash — even
		    for a dark-app visitor on a light-OS device. Must precede ResourceHints + the inline
		    CSS below, which would otherwise delay it. */}
		<ColorSchemeSeed />
		<ResourceHints />
		{/* Prefetch the preview runtime at parse time so the first live render's
		    iframe finds it warm instead of cold-fetching it on the critical path
		    (the FRAME REBUILD cost). Overlaps island hydration + the engine load. */}
		<RuntimeWarm />
		<title>Lattice Studio — one workspace</title>
		<meta name="description" content="The Lattice Studio: compose, present, and fabricate decks in one workspace. A live prototype of the app redesign." />
		<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
		<style is:global>
			html, body { margin: 0; height: 100%; overflow: hidden; }
			/* Instant-shell (below) is hidden until the seed script flips data-ssr-shell="on"
			   — which it now does UNCONDITIONALLY (every visitor gets the same Nacre skeleton). */
			#studio-ssr-shell { display: none; }
			:root[data-ssr-shell="on"] #studio-ssr-shell { display: flex; }
			/* Read stop → full-bleed preview: hide the editor Panel's OUTER (sizing)
			   div by id so the preview reclaims its track. react-resizable-panels wraps
			   each Panel in an outer div (carrying the id + inline flex) around the inner
			   div our className lands on, so a Tailwind class can't shrink the outer.
			   The divider is hidden via its own class (a Separator is a single div).
			   2026-07-19 splitter migration. */
			[data-studio-split][data-studio-stop="read"] > #studio-editor { display: none !important; }
		</style>
		<style is:inline set:html={SHELL_CHROME_CSS + '\n' + SHELL_NACRE_CSS}></style>
		<script is:inline define:vars={{ KNOWN_PALETTES: BUILTIN_PALETTES, SIZE_RATIO, DECK_RATIOS, DECK_TITLES, DEFAULT_RATIO, PREVIEW_CHROME }}>
			(function () {
				var r = document.documentElement;
				// Show the instant shell to EVERY visitor FIRST — before any localStorage read.
				// In a storage-blocked context (private mode, disabled cookies) `getItem` THROWS,
				// and if that throw happened before this line the catch would skip it, leaving the
				// shell hidden = a blank preview (the exact failure this shell exists to prevent).
				// It's a palette-blind Nacre skeleton, so it is correct for every visitor with no
				// per-visitor decision to make; palette/geometry seeds below only refine it.
				r.setAttribute('data-ssr-shell', 'on');
				try {
					var p = localStorage.getItem('lattice-studio-palette');
					var palette = 'indaco';
					// KNOWN_PALETTES is injected from the shared ../components/studio/palettes
					// list (define:vars), so EVERY built-in palette is honored at first paint —
					// not the stale 8-of-18 subset that dropped a returning visitor on a
					// non-curated palette back to indaco (lost instant-shell + color flash).
					if (p && KNOWN_PALETTES.indexOf(p) !== -1) { r.setAttribute('data-palette', p); palette = p; }
					var m = localStorage.getItem('lattice-docs-mode');
					var mode = 'light';
					if (m === 'light' || m === 'dark') { r.setAttribute('data-mode', m); mode = m; }
					else if (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) { r.setAttribute('data-mode', 'dark'); mode = 'dark'; }
					// (color-scheme is pinned earlier, by <ColorSchemeSeed> at the top of <head>.
					//  data-ssr-shell is set ABOVE, before this try, so the shell shows even if a
					//  storage read throws.)
					// RATIO SEED — the fallback box (a visitor with no persisted rect: a newcomer, or
					// the one transitional reload right after this ships) must match the AUTHOR-CHOSEN
					// size of the deck they boot into, never an assumed 16:9. Resolve it from the deck
					// they last viewed the same way the app does (its `size:` front-matter → SIZE_RATIO,
					// falling back to the engine's own 16:9 only when a deck names no size).
					try {
						var rr = DEFAULT_RATIO;
						var act = JSON.parse(localStorage.getItem('lattice-studio-active') || 'null');
						var did = act && act.deckId;
						// TITLE SEED — the returning user's actual deck, not the default. Precedence
						// matters: `derived` is the index MIRROR of the deck's real heading, written
						// by the app on save, so it is the only entry field guaranteed CURRENT — take
						// it first. Then the built-in's own declared title, which beats the index's
						// `title` because that field is a CREATION label: every returning user has a
						// built-in row stamped with whatever it was called when they first loaded,
						// and trusting it would paint a stale name for any built-in they never edit.
						// The creation label is right only for a user-made deck the app has yet to save.
						if (did) {
							var ttl = '';
							try {
								var idx = JSON.parse(localStorage.getItem('lattice-studio-deck-index') || 'null');
								if (idx && idx.length) for (var ti = 0; ti < idx.length; ti++) {
									var row = idx[ti];
									if (!row || row.id !== did) continue;
									if (typeof row.derived === 'string' && row.derived) ttl = row.derived;
									else if (typeof DECK_TITLES[did] === 'string') ttl = DECK_TITLES[did];
									else if (typeof row.title === 'string') ttl = row.title;
								}
							} catch (e5) { ttl = ''; } // corrupt index → fall through to the built-in title
							if (!ttl && typeof DECK_TITLES[did] === 'string') ttl = DECK_TITLES[did];
							if (ttl) r.setAttribute('data-ssr-title', ttl);
						}
						if (did) {
							var edited = localStorage.getItem('lattice-studio-src-' + did);
							var sz = '';
							if (edited) {
								// studio-store persists edited source via write() = JSON.stringify(source), so the raw value
								// is a QUOTED json string (leading ", escaped \n) that /^---/ would never match. Parse it
								// back to real markdown first; inner guard degrades a corrupt value to the deck default.
								var src = '';
								try { var parsed = JSON.parse(edited); if (typeof parsed === 'string') src = parsed; } catch (e4) { src = ''; }
								var fm = /^---\r?\n([\s\S]*?)\r?\n---/.exec(src);
								var sm = fm && /^[ \t]*size[ \t]*:[ \t]*(.+?)[ \t]*$/m.exec(fm[1]); // /m: end-of-LINE, not just last line (mirrors sizeFromSource)
								if (sm) sz = sm[1].replace(/^['"]|['"]$/g, '').trim();
							}
							if (sz && (SIZE_RATIO[sz] || SIZE_RATIO[sz.toLowerCase()])) rr = SIZE_RATIO[sz] || SIZE_RATIO[sz.toLowerCase()];
							else if (DECK_RATIOS[did]) rr = DECK_RATIOS[did];
						}
						if (Array.isArray(rr)) { // a corrupt/prototype size key can make rr a non-array — never emit NaN/undefined
							r.style.setProperty('--sb-ratio', rr[0] + ' / ' + rr[1]);
							r.style.setProperty('--sb-ar', String(rr[0] / rr[1]));
						}
					} catch (e3) {}
					// GEOMETRY SEED — place the Nacre box at the EXACT rect the app last had its
					// preview box (persisted by StudioShell on unload as viewport fractions). On a
					// same-device reload the shell box then lands pixel-identical to where the
					// hydrated app re-measures it → no jump at hand-off. Computed to px from the
					// CURRENT viewport (not vw/vh units) so it matches whatever the app measures
					// now, and clamped on-screen in case the viewport changed since (rotation).
					// No saved rect (newcomer) → the CSS falls back to a centered full-bleed box.
					try {
						var rectRaw = localStorage.getItem('lattice-studio-preview-rect');
						if (rectRaw) {
							var q = JSON.parse(rectRaw);
							if (q && q.w > 0.1 && q.h > 0.05 && q.l >= 0 && q.t >= 0 && q.l < 1 && q.t < 1) {
								var vw = window.innerWidth, vh = window.innerHeight;
								var bw = Math.min(q.w * vw, vw);
								var bh = Math.min(q.h * vh, vh);
								var bl = Math.max(0, Math.min(q.l * vw, vw - bw));
								var bt = Math.max(0, Math.min(q.t * vh, vh - bh));
								r.style.setProperty('--sb-l', bl + 'px');
								r.style.setProperty('--sb-t', bt + 'px');
								r.style.setProperty('--sb-w', bw + 'px');
								r.style.setProperty('--sb-h', bh + 'px');
								r.setAttribute('data-ssr-rect', '1');
							}
						}
					} catch (e2) {}
					// COMPUTE SEED (prototype, option B) — when there is NO persisted rect (a
					// brand-new visitor, a cross-device first load), don't fall back to an
					// approximate centered box: COMPUTE the exact rect from known inputs, the same
					// pure function the validation proved matches the app to 0.1px. Inputs: the
					// posture (chromeless = the full-bleed Read stop), the breakpoint (from vw), the
					// deck ratio (rr, above), and the editor|preview split share, using the shared
					// PREVIEW_CHROME constants. Not modeled: the Build stop's side panels +
					// landscape-phone cinema (rect-replay still covers a returning visitor there);
					// this only runs on a FIRST load, where replay has nothing to give.
					try {
						if (!r.hasAttribute('data-ssr-rect')) {
							var C = PREVIEW_CHROME;
							var vw2 = window.innerWidth, vh2 = window.innerHeight;
							var bpMobile = vw2 <= 699;
							// Mirror the app's boot posture (studio-store derivePosture): an EXPLICITLY
							// stored posture wins; otherwise a returning visitor (prior deck index or any
							// edited-source key) derives to 'write' (the editor|preview split), a fresh one to
							// 'read'. Defaulting to 'read' made every upgrading user's first load compute a
							// full-bleed box while the app rendered the split — a hand-off jump.
							var posture = null;
							try { var st = JSON.parse(localStorage.getItem('lattice-studio-settings') || 'null'); if (st && (st.posture === 'read' || st.posture === 'write' || st.posture === 'build')) posture = st.posture; } catch (e5) {}
							if (!posture) {
								var prior = false;
								try {
									if (localStorage.getItem('lattice-studio-deck-index')) prior = true;
									else { for (var i = 0; i < localStorage.length; i++) { var k = localStorage.key(i); if (k && k.indexOf('lattice-studio-src-') === 0) { prior = true; break; } } }
								} catch (e6) {}
								posture = prior ? 'write' : 'read';
							}
							var chromeless = posture === 'read';
							var pad = vw2 < 640 ? C.padMobile : C.padDesktop;
							var paneTop = C.topbarH + (bpMobile ? C.mobileBarH : 0);
							var headerH = chromeless ? C.headerRead : C.headerWrite;
							var footerH = chromeless ? C.footerRead : C.footerWrite;
							var cap = chromeless ? Infinity : C.cap;
							var frac = C.defaultPreviewFrac; // exact persisted split is a follow-up; default is the common case
							var paneX, paneW;
							if (chromeless || bpMobile) { paneX = 0; paneW = vw2; } else { paneW = vw2 * frac; paneX = vw2 - paneW; }
							var paneH = vh2 - paneTop;
							var ar2 = rr[0] / rr[1];
							var cw = paneW - 2 * pad, ch = paneH - headerH - footerH - 2 * pad;
							var bw2 = Math.max(0, Math.min(cw, ch * ar2, cap));
							var bh2 = bw2 / ar2;
							if (bw2 > 1 && bh2 > 1) {
								r.style.setProperty('--sb-l', (paneX + pad + (cw - bw2) / 2) + 'px');
								r.style.setProperty('--sb-t', (paneTop + headerH + pad + (ch - bh2) / 2) + 'px');
								r.style.setProperty('--sb-w', bw2 + 'px');
								r.style.setProperty('--sb-h', bh2 + 'px');
								r.setAttribute('data-ssr-rect', '1');
							}
						}
					} catch (e4) {}
					// (The editor|preview split ratio's pre-paint CSS-var seed is retired
					// with the react-resizable-panels migration: the hook restores the saved
					// ratio post-mount via the panel imperative API. Studio is client:only,
					// so there is no SSR split paint to seed anyway. 2026-07-19.)
				} catch (e) {}
			})();
		</script>
	</head>
	<body>
		{/* First tabbable element on the surface — the bypass has to come before the
		    chrome it bypasses. The Studio is `client:only`, so `#main-content` exists
		    only after hydration; that is fine, because before hydration there is no
		    content to skip to. */}
		<SkipLink />
		{/* Pre-hydration INSTANT SHELL — Nacre-only skeleton, one contained 16:9 box, shown
		    to every visitor and dismissed by the app once its own (identical) Nacre is up.
		    No baked slide, no snapshot replay — one surface, no seam. */}
		<div id="studio-ssr-shell" aria-hidden="true">
			<div class="ssr-topbar">
				<svg class="ssr-logo" viewBox="0 0 128 128" fill="none" aria-hidden="true"><g transform="rotate(45 64 64)" stroke="var(--mark-bond)" stroke-width="6.4" stroke-linecap="round"><line x1="31" y1="31" x2="97" y2="31"></line><line x1="97" y1="31" x2="97" y2="97"></line><line x1="97" y1="97" x2="31" y2="97"></line><line x1="31" y1="97" x2="31" y2="31"></line></g><circle cx="64" cy="17.3" r="12.7" fill="var(--mark-halo)"></circle><circle cx="64" cy="17.3" r="11" fill="#5b86b8"></circle><circle cx="110.7" cy="64" r="12.7" fill="var(--mark-halo)"></circle><circle cx="110.7" cy="64" r="11" fill="#a8628a"></circle><circle cx="64" cy="110.7" r="12.7" fill="var(--mark-halo)"></circle><circle cx="64" cy="110.7" r="11" fill="#d08c42"></circle><circle cx="17.3" cy="64" r="12.7" fill="var(--mark-halo)"></circle><circle cx="17.3" cy="64" r="11" fill="#7b72c0"></circle><circle cx="64" cy="64" r="16.2" fill="var(--mark-halo)"></circle><circle cx="64" cy="64" r="14" fill="#c8a040"></circle><circle cx="64" cy="64" r="10.4" fill="none" stroke="#7a5a10" stroke-width="1.5" opacity="0.55"></circle></svg>
				<span class="ssr-deck-title" id="ssr-deck-title">{firstDeck.title}</span>
				<script is:inline>(function(){var t=document.getElementById("ssr-deck-title"),v=document.documentElement.getAttribute("data-ssr-title");if(t&&v)t.textContent=v;})();</script>
			</div>
			<div class="ssr-stage">
				<div class="ssr-slidebox" id="ssr-slidebox">
					<span class="nacre-loader" aria-hidden="true">
						<span class="nacre-loader__core"></span>
						<span class="nacre-loader__layer nacre-loader__layer--0"><i class="nacre-loader__blob"></i><i class="nacre-loader__blob"></i><i class="nacre-loader__blob"></i></span>
						<span class="nacre-loader__layer nacre-loader__layer--1"><i class="nacre-loader__blob"></i><i class="nacre-loader__blob"></i><i class="nacre-loader__blob"></i></span>
						<span class="nacre-loader__layer nacre-loader__layer--2"><i class="nacre-loader__blob"></i><i class="nacre-loader__blob"></i><i class="nacre-loader__blob"></i></span>
						<span class="nacre-loader__vig"></span>
					</span>
				</div>
			</div>
		</div>
		<!-- client:only — the Studio is a browser app surface (no SSR/SEO need),
		     so it never server-renders; this also sidesteps Browser-API-on-server. -->
		<StudioIsland client:only="react" options={options} components={components} lintVocab={lintVocab} slideHeadings={slideHeadings} />
		{/* Live viz diagnostics — renders nothing until the Workspace → Diagnostics
		    switch (or ?viz) turns it on; then reads dropped-to-black chart paint from
		    the render pipeline. */}
		<VizDiagnosticsOverlay />
		{/* Live viewport-debug readout — renders nothing until the Workspace →
		    Diagnostics switch (or ?vvdebug) turns it on; then reads the live viewport
		    geometry (layout + visual viewport, svh/dvh/lvh, cinema stage, iframe rect)
		    on the real device — the on-device probe that diagnosed the #1121 landscape
		    overflow. */}
		<ViewportDebugOverlay />
		{/* Intent-gated engine warm (was allowEager): the eager 505KB fetch competed
		    with first paint/hydration. StudioShell loads the engine on mount, so
		    warming only needs to fire on pointer/focus intent — off the paint path. */}
		<EngineWarm />
	</body>
</html>
