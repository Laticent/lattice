---
// The Print page route — the on-brand tab the Studio's "Print deck" opens. It mounts
// PrintPage (a client:only island), which receives the deck source + options from the
// Studio over a postMessage handshake, renders a live preview, and builds the real
// per-slide PDF in this foreground tab (the render can't run in the backgrounded
// opener — see the component header + engineering/decisions/2026-06-14-deck-print-styling.md).
import PrintPage from '../../components/studio/PrintPage.tsx';
import ResourceHints from '../../components/site/ResourceHints.astro';
import EngineWarm from '../../components/site/EngineWarm.astro';
import { joinBase } from '../../lib/base-url.mjs';
import { assetBase } from '../../playground/asset-version.mjs';

const base = import.meta.env.BASE_URL;
const url = (p) => joinBase(base, p);
const pg = assetBase();

// The engine URL bundle (identical to studio.astro) — theme/runtime/engine + the
// locally-vendored Mermaid/KaTeX, so previews and the PDF render from our own origin.
const options = {
	themeBase: url(pg + 'themes/'),
	runtimeUrl: url(pg + 'lattice-runtime.js'),
	engineUrl: url(pg + 'lattice-playground.js'),
	mermaidUrl: url(pg + 'export/mermaid-v11.min.js'),
	katexUrl: url(pg + 'katex/katex.min.css'),
};
---

<!doctype html>
<html lang="en" data-mode="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<ResourceHints />
		<title>Print · Lattice</title>
		<meta name="description" content="Print a Lattice deck — one slide per page at the paper size you choose." />
		<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
		<style is:global>
			html, body { margin: 0; height: 100%; background: #0b1c33; overflow: hidden; }
		</style>
	</head>
	<body>
		<!-- client:only — a browser app surface (opens with a live handshake, no SSR need). -->
		<PrintPage client:only="react" options={options} />
		<EngineWarm />
	</body>
</html>
