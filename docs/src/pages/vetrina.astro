---
// Vetrina — a standalone, framework-free showcase driven by the REAL engine
// (docs/src/lib/vetrina): run() drives a self-directing cursor over a plain-DOM mini dashboard —
// theater over REAL state, seamlessly interruptible. No React, no slide engine. A guided storyboard:
// each beat runs a short walkthrough that shows one primitive (narrate + point, a real state change,
// typing, gestures, the cooperative hand-off). Reached at /vetrina.
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Vetrina — a self-driving walkthrough</title>
		<link rel="icon" href="/vetrina-mark.svg" type="image/svg+xml" />
		<style is:global>
			:root {
				--paper: #fbf5f7; --stage: #f4e9ee; --ink: #2a1a22; --muted: #9c8a92; --spent: #cbb8c1;
				--line: #e6d5dd; --accent: #a8446a; --accent-ink: #fff; --glow: #c67a12; --glow-bg: #f6e2c4;
				--panel: #fffafc; --shadow: 0 1px 2px rgba(42,26,34,.06), 0 8px 24px rgba(42,26,34,.06);
				--vt-accent: #a8446a;
				--stage-serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
				--sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
				--mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--paper: #140d11; --stage: #1e141a; --ink: #efe2e8; --muted: #6a5560; --spent: #47343d;
					--line: #2c1f26; --accent: #e08aa8; --accent-ink: #1a0f14; --glow: #f6b64a; --glow-bg: #33291a;
					--panel: #191016; --shadow: 0 1px 2px rgba(0,0,0,.4), 0 10px 30px rgba(0,0,0,.35);
					--vt-accent: #e08aa8;
				}
			}
			:root[data-theme="light"] {
				--paper: #fbf5f7; --stage: #f4e9ee; --ink: #2a1a22; --muted: #9c8a92; --spent: #cbb8c1;
				--line: #e6d5dd; --accent: #a8446a; --accent-ink: #fff; --glow: #c67a12; --glow-bg: #f6e2c4; --panel: #fffafc; --vt-accent: #a8446a;
			}
			:root[data-theme="dark"] {
				--paper: #140d11; --stage: #1e141a; --ink: #efe2e8; --muted: #6a5560; --spent: #47343d;
				--line: #2c1f26; --accent: #e08aa8; --accent-ink: #1a0f14; --glow: #f6b64a; --glow-bg: #33291a; --panel: #191016; --vt-accent: #e08aa8;
			}
			* { box-sizing: border-box; }
			body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans);
				line-height: 1.5; -webkit-font-smoothing: antialiased; padding: clamp(16px, 4vw, 48px); }
			.wrap { max-width: 900px; margin: 0 auto; }
			header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
			.brand { display: flex; align-items: center; gap: 13px; }
			.brand .logo { width: 46px; height: 46px; flex-shrink: 0; }
			.home { color: var(--muted); text-decoration: none; font-size: 13px; font-weight: 600; }
			.home:hover { color: var(--accent); }
			h1 { font-family: var(--stage-serif); font-size: clamp(28px, 5vw, 40px); font-weight: 600; margin: 0; letter-spacing: -.01em; }
			.tag { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent);
				border: 1px solid var(--accent); padding: 3px 8px; border-radius: 999px; font-weight: 600; }
			.sub { color: var(--muted); font-size: 14px; max-width: 66ch; margin: 6px 0 0; }
			.sub b { color: var(--ink); font-weight: 600; }

			.stage { margin: 26px 0 0; background: var(--stage); border: 1px solid var(--line); border-radius: 18px;
				box-shadow: var(--shadow); padding: clamp(22px, 4vw, 36px); position: relative; }
			/* The mini dashboard the walkthrough drives — real widgets, real state. */
			.board { display: grid; gap: 14px; max-width: 480px; margin: 0 auto; }
			.board-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
			.metric { display: flex; flex-direction: column; gap: 2px; }
			.metric-label { font-family: var(--mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
			.metric-val { font-family: var(--stage-serif); font-size: 34px; font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
			.pub-badge { font-family: var(--mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; font-weight: 700;
				color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 4px 10px; }
			.board[data-published="true"] .pub-badge { color: var(--accent-ink); background: var(--accent); border-color: var(--accent); }

			/* CREATE — the note field + Add */
			.board-create { display: flex; gap: 8px; }
			.board-create input { flex: 1 1 auto; min-width: 0; font-family: var(--sans); font-size: 14px; color: var(--ink);
				background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
			.board-btn { border: 1px solid var(--line); background: var(--panel); color: var(--ink); font-family: var(--sans);
				font-size: 13px; font-weight: 600; border-radius: 10px; padding: 10px 16px; cursor: pointer; white-space: nowrap;
				transition: transform .08s ease, border-color .12s ease; }
			.board-btn:hover:not(:disabled) { transform: translateY(-1px); border-color: var(--accent); }
			.board-btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
			.board-btn:disabled { opacity: .5; cursor: default; transform: none; }

			/* READ — the list of note records */
			.note-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
			.note { display: flex; align-items: center; gap: 10px; padding: 9px 12px; background: var(--panel);
				border: 1px solid var(--line); border-radius: 10px; }
			.note-text { flex: 1 1 auto; min-width: 0; font-size: 14px; color: var(--ink); overflow-wrap: anywhere; cursor: text; }
			.note-edit { flex: 1 1 auto; min-width: 0; font-family: var(--sans); font-size: 14px; color: var(--ink);
				background: var(--stage); border: 1px solid var(--accent); border-radius: 8px; padding: 6px 8px; }
			.note-actions { display: flex; gap: 4px; flex-shrink: 0; }
			/* UPDATE / DELETE — per-row icon buttons */
			.icon-btn { border: 1px solid transparent; background: none; color: var(--muted); cursor: pointer; border-radius: 8px;
				width: 28px; height: 28px; display: grid; place-items: center; font-size: 15px; line-height: 1;
				transition: color .12s ease, background-color .12s ease; }
			.icon-btn:hover { color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
			.icon-btn.danger:hover { color: var(--glow); background: color-mix(in srgb, var(--glow) 14%, transparent); }
			.note-empty { font-size: 13px; color: var(--muted); font-style: italic; padding: 4px 2px; }
			.board[data-published="true"] .note { opacity: .65; }

			.transport { margin-top: 20px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
			.btn { border: 1px solid var(--line); background: var(--panel); color: var(--ink); font-family: var(--sans);
				font-size: 13px; font-weight: 600; border-radius: 999px; padding: 9px 16px; cursor: pointer; transition: transform .08s ease; }
			.btn:hover { transform: translateY(-1px); }
			.btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
			.diag { margin-top: 14px; min-height: 18px; font-family: var(--mono); font-size: 12px; color: var(--muted); }

			.rail { margin-top: 26px; }
			.rail-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
			.rail-head h2 { font-family: var(--stage-serif); font-size: 18px; margin: 0; font-weight: 600; }
			.beats { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 10px; }
			.beat { text-align: left; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); padding: 14px 15px;
				cursor: pointer; display: flex; gap: 12px; align-items: flex-start; transition: border-color .12s ease, transform .08s ease; }
			.beat:hover { transform: translateY(-2px); border-color: var(--accent); }
			.beat[aria-current="true"] { border-color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 16%, transparent); }
			.beat .n { flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: var(--stage); border: 1px solid var(--line);
				color: var(--accent); font-family: var(--mono); font-size: 12px; font-weight: 700; display: grid; place-items: center; }
			.beat[aria-current="true"] .n { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
			.beat .bt { font-size: 14px; font-weight: 600; color: var(--ink); margin: 0 0 2px; }
			.beat .bd { font-size: 12.5px; color: var(--muted); margin: 0; line-height: 1.45; }
			.beat .api { font-family: var(--mono); font-size: 11px; color: var(--accent); }

			.foot { margin-top: 26px; color: var(--muted); font-size: 12px; line-height: 1.7; }
			.foot code { font-family: var(--mono); background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; }
			.theme { background: none; border: 1px solid var(--line); color: var(--muted); border-radius: 999px; font-size: 11px; padding: 5px 11px; cursor: pointer; font-family: var(--sans); }
			:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }

			/* ── THE CONTROL STRIP ─────────────────────────────────────────────────────
			   Vetrina's most VISIBLE choices are theme options, and this page used to pass
			   no theme at all — so the caption styles, pointer shapes, speeds, motion tiers
			   and the two pacing models were invisible on the one page that exists to show
			   them. Each control re-runs the current beat, because the library's own
			   `pacing` doc asks for exactly this: "compare the two on one surface in one
			   session — a pacing change that cannot be A/B'd is a matter of taste." */
			.controls { margin: 18px 0 0; display: grid; gap: 10px; }
			.ctl-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
			.ctl-label { font-size: 11px; letter-spacing: .12em; text-transform: uppercase;
				color: var(--muted); font-weight: 700; min-width: 74px; }
			.seg { display: inline-flex; border: 1px solid var(--line); border-radius: 999px;
				background: var(--panel); overflow: hidden; }
			.seg button { appearance: none; border: 0; background: transparent; color: var(--muted);
				font: inherit; font-size: 12px; font-weight: 600; padding: 5px 11px; cursor: pointer;
				border-right: 1px solid var(--line); white-space: nowrap; }
			.seg button:last-child { border-right: 0; }
			.seg button[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); }
			.seg button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
			.ctl-note { font-size: 12px; color: var(--muted); margin: 0; }
			.ctl-note code { font-family: var(--mono); font-size: 11px; }

			/* ── THE BEAT LOG — what actually happened, with the clock on it ───────────
			   Borrowed from the caption prototype bench. The sibling showcases report
			   NUMBERS (Suono prints its real `produce()` delta); this page asserted. */
			details.pane { margin: 16px 0 0; border: 1px solid var(--line); border-radius: 14px;
				background: var(--panel); overflow: hidden; }
			details.pane > summary { cursor: pointer; padding: 11px 15px; font-size: 13px; font-weight: 600;
				list-style: none; display: flex; justify-content: space-between; gap: 12px; align-items: center; }
			details.pane > summary::-webkit-details-marker { display: none; }
			details.pane > summary::after { content: "+"; color: var(--muted); font-weight: 700; }
			details.pane[open] > summary::after { content: "\2013"; }
			details.pane > summary:hover { color: var(--accent); }
			.pane-body { padding: 0 15px 14px; }
			.pane-note { font-size: 12px; color: var(--muted); margin: 0 0 10px; }
			.log { width: 100%; border-collapse: collapse; font-family: var(--mono); font-size: 11px; }
			.log th { text-align: left; color: var(--muted); font-weight: 700; padding: 4px 8px 4px 0;
				border-bottom: 1px solid var(--line); position: sticky; top: 0; background: var(--panel); }
			.log td { padding: 3px 8px 3px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
			.log td.num { text-align: right; color: var(--muted); white-space: nowrap; }
			.log td.verb { color: var(--accent); font-weight: 700; white-space: nowrap; }
			.log-scroll { max-height: 260px; overflow: auto; }
			.log-empty { color: var(--muted); font-size: 12px; padding: 8px 0; }
			pre.data { margin: 0; font-family: var(--mono); font-size: 11px; line-height: 1.55;
				color: var(--ink); background: var(--stage); border: 1px solid var(--line);
				border-radius: 10px; padding: 12px; overflow: auto; max-height: 300px; }

			@media (max-width: 560px) {
				.ctl-label { min-width: 0; flex-basis: 100%; }
				.seg button { padding: 6px 10px; }
			}
		</style>
	</head>
	<body>
		<div class="wrap">
			<header>
				<div class="brand">
					<img class="logo" src="/vetrina-mark.svg" alt="" width="46" height="46" />
					<h1>Vetrina</h1><span class="tag">walkthrough</span>
				</div>
				<div style="display:flex; gap:14px; align-items:center;">
					<a class="home" href="/">← Lattice</a>
					<button class="theme" id="themeBtn" type="button">◐ theme</button>
				</div>
			</header>
			<p class="sub">
				A self-driving product tour — a cursor that <b>narrates and operates real UI</b>, theater over <b>real state</b>, and hands you the wheel the instant you touch anything. Framework-free; it drives
				plain DOM. Every beat below runs the <b>real engine</b> over the mini dashboard.
			</p>

			<div class="stage">
				<div class="board" id="vt-board" data-published="false">
					<div class="board-head">
						<div class="metric"><span class="metric-label">Release notes</span><span class="metric-val" id="vt-count">0</span></div>
						<span class="pub-badge" id="vt-badge">draft</span>
					</div>
					<form class="board-create" id="vt-create">
						<input id="vt-note" type="text" placeholder="Add a release note…" autocomplete="off" aria-label="New release note" />
						<button class="board-btn" id="vt-add" type="submit">+ Add</button>
					</form>
					<ul class="note-list" id="vt-list" aria-label="Release notes"></ul>
					<button class="board-btn primary" id="vt-finish" type="button">Publish release</button>
				</div>
			</div>
			<div class="controls" id="controls">
				<div class="ctl-row">
					<span class="ctl-label" id="lbl-caption">Caption</span>
					<span class="seg" role="group" aria-labelledby="lbl-caption" data-opt="caption"></span>
				</div>
				<div class="ctl-row">
					<span class="ctl-label" id="lbl-pointer">Pointer</span>
					<span class="seg" role="group" aria-labelledby="lbl-pointer" data-opt="pointer"></span>
					<span class="ctl-label" id="lbl-hand">Hand</span>
					<span class="seg" role="group" aria-labelledby="lbl-hand" data-opt="hand"></span>
				</div>
				<div class="ctl-row">
					<span class="ctl-label" id="lbl-speed">Speed</span>
					<span class="seg" role="group" aria-labelledby="lbl-speed" data-opt="speed"></span>
					<span class="ctl-label" id="lbl-pacing">Pacing</span>
					<span class="seg" role="group" aria-labelledby="lbl-pacing" data-opt="pacing"></span>
				</div>
				<div class="ctl-row">
					<span class="ctl-label" id="lbl-motion">Motion</span>
					<span class="seg" role="group" aria-labelledby="lbl-motion" data-opt="motion"></span>
				</div>
				<p class="ctl-note" id="ctl-note"></p>
			</div>
			<div class="transport">
				<button class="btn" id="stopBtn" type="button">Stop</button>
				<button class="btn" id="resetBtn" type="button">Reset board</button>
				<button class="btn" id="recordBtn" type="button" title="Record “Point at a thing” as a timing track (.ltt.json)">Record</button>
				<button class="btn" id="replayBtn" type="button" title="Replay the committed recording of “Point at a thing”">Replay recording</button>
				<a class="btn" id="recordingLink" hidden>Download recording</a>
			</div>
			<p class="diag" id="diag" role="status" aria-live="polite"></p>

			<div class="rail">
				<div class="rail-head">
					<h2>The storyboard</h2>
					<button class="btn primary" id="tourBtn" type="button">▸ Play all seven</button>
				</div>
				<div class="beats" id="beats"></div>
			</div>

			<details class="pane" id="logPane">
				<summary>The beat log — what ran, and when<span class="log-sum" id="logSum"></span></summary>
				<div class="pane-body">
					<p class="pane-note">
						Every verb the engine performed, timestamped from the run's first frame. The gap column is
						where the pacing model shows itself — switch <code>Pacing</code> above and play the same
						beat twice.
					</p>
					<div class="log-scroll">
						<table class="log">
							<thead><tr><th>t (ms)</th><th>gap</th><th>verb</th><th>detail</th></tr></thead>
							<tbody id="logBody"></tbody>
						</table>
					</div>
					<p class="log-empty" id="logEmpty">Nothing yet — play a beat.</p>
				</div>
			</details>

			<details class="pane" id="dataPane">
				<summary>The storyboard, as data<span class="log-sum" id="dataSum"></span></summary>
				<div class="pane-body">
					<p class="pane-note">
						<code>scene()</code> is a recorder, not a runtime: it compiles to a plain <code>Step[]</code> that <code>storyboard()</code> plays. That array is the wire format —
						inspectable, generatable, diffable. Below is the selected beat's, verbatim
						(<code>ƒ</code> marks a callback, which is the one thing that does not serialize).
					</p>
					<pre class="data" id="dataOut">Pick a beat to see its steps.</pre>
				</div>
			</details>

			<p class="foot">
				Driven by the real engine (<code>@/lib/vetrina</code>): <code>run()</code> owns the take-over race +
				teardown; the self-directing cursor calls <code>stage.say</code> / <code>point</code> /
				<code>gesture</code> and <code>ctx.type</code> / <code>awaitUser</code> over the real board above.
				The board is a <b>working CRUD example</b> — <b>Create</b> (type + Add), <b>Read</b> (the list), <b>Update</b> (click a note to edit), <b>Delete</b> (×), then Publish. The tour calls the <i>same</i>
				<code>actions.add</code> / <code>update</code> / <code>remove</code> / <code>publish</code> you do — it
				mutates real state, it doesn't paint it. Operate it yourself any time; touch anything mid-tour and it
				hands you the wheel. A plain DOM page, no framework — the proof the core is standalone.
			</p>
		</div>

		<script>
			import { ENGINE_HASH } from '@/lib/cadenza';
			import { run, storyboard, wait } from '@/lib/vetrina';
			import deicticRecording from '@/lib/vetrina-exemplars/deictic.ltt.json';
			import { DEICTIC_RECORDING_ID, deicticScene, RECORDING_PACE, teachScene } from '@/lib/vetrina-exemplars/page-scenes';
			import { cadenzaNarrator } from '@/lib/vetrina-narration/cadenza-narrator';

			const $ = (s) => document.querySelector(s);
			const root = document.documentElement;
			const board = $('#vt-board'), countEl = $('#vt-count'), noteEl = $('#vt-note'), finishEl = $('#vt-finish');
			const beatsEl = $('#beats');
			const setDiag = (m) => { $('#diag').textContent = m || ''; };

			// Theme toggle (shared docs key).
			const THEME_LS = 'lattice-docs-mode';
			const applyTheme = (t) => { if (t === 'light' || t === 'dark') root.setAttribute('data-theme', t); else root.removeAttribute('data-theme'); };
			// `lattice-docs-mode` holds the user's PREFERENCE, which since #1285 has a third
			// value: `system` follows the OS. Resolve it here rather than testing for
			// light/dark only — that test treats a stored `system` as "nothing stored" and
			// drops the page to its CSS default, so a visitor following the OS in dark lands
			// on a light demo. Writing a pinned light/dark from this button is intended: like
			// the Studio top bar, this is a two-stop surface, and the site header is where the
			// three-stop cycle lives.
			const resolveThemePref = (t) => (t === 'light' || t === 'dark' ? t : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'));
			try { applyTheme(resolveThemePref(localStorage.getItem(THEME_LS))); } catch {}
			$('#themeBtn').addEventListener('click', () => {
				const cur = root.getAttribute('data-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				const next = cur === 'dark' ? 'light' : 'dark';
				applyTheme(next); try { localStorage.setItem(THEME_LS, next); } catch {}
			});

			// ── The release-notes board: REAL CRUD state that BOTH you and the walkthrough drive ──
			const listEl = $('#vt-list'), badgeEl = $('#vt-badge');
			let notes = [];        // the records: [{ id, text }]
			let published = false;
			let seq = 0;           // id source

			// READ — paint the whole board from state (count, badge, publish-enabled, the list).
			function renderBoard() {
				countEl.textContent = String(notes.length);
				badgeEl.textContent = published ? 'published' : 'draft';
				board.dataset.published = String(published);
				finishEl.disabled = notes.length === 0 || published;
				listEl.replaceChildren(...(notes.length ? notes.map(rowFor) : [emptyRow()]));
			}
			function emptyRow() {
				const li = document.createElement('li'); li.className = 'note-empty';
				li.textContent = 'No notes yet — add one above.'; return li;
			}
			function rowFor(n) {
				const li = document.createElement('li'); li.className = 'note'; li.dataset.id = String(n.id);
				// textContent, never innerHTML — a note is user text (HARD RULE #22 hygiene).
				const text = document.createElement('span'); text.className = 'note-text'; text.textContent = n.text;
				text.title = 'Click to edit';
				const acts = document.createElement('div'); acts.className = 'note-actions';
				const edit = document.createElement('button'); edit.type = 'button'; edit.className = 'icon-btn';
				edit.dataset.act = 'edit'; edit.setAttribute('aria-label', `Edit "${n.text}"`); edit.textContent = '✎';
				const del = document.createElement('button'); del.type = 'button'; del.className = 'icon-btn danger';
				del.dataset.act = 'remove'; del.setAttribute('aria-label', `Delete "${n.text}"`); del.textContent = '×';
				acts.append(edit, del); li.append(text, acts); return li;
			}

			// The action bag — the REAL create/update/delete/publish. The tour calls these; so does the UI.
			const actions = {
				add: (text) => { const t = String(text ?? '').trim(); if (!t) return null; const id = ++seq; notes.push({ id, text: t }); published = false; renderBoard(); return id; },
				update: (id, text) => { const n = notes.find((x) => x.id === id); if (!n) return; n.text = String(text ?? '').trim() || n.text; published = false; renderBoard(); },
				remove: (id) => { const before = notes.length; notes = notes.filter((x) => x.id !== id); if (notes.length !== before) { if (!notes.length) published = false; renderBoard(); } },
				publish: () => { if (notes.length && !published) { published = true; renderBoard(); } },
				// Commit the create field — what Add / Enter does; the tour uses it after ctx.type().
				addFromInput: () => { const id = actions.add(noteEl.value); if (id != null) noteEl.value = ''; return id; },
			};
			const type = {
				set: (t) => { noteEl.value = t; },
				append: (t) => { noteEl.value += t; },
				read: () => noteEl.value,
			};
			const within = (sel, node) => { const el = board.querySelector(sel); return !!el && node instanceof Node && el.contains(node); };

			// Seed a couple of records so the board reads as real on load (and the beats have rows to touch).
			function resetBoard() {
				notes = [{ id: ++seq, text: 'Ship the real ESM builds' }, { id: ++seq, text: 'Close the lente approval hole' }];
				published = false; noteEl.value = ''; renderBoard();
			}

			// ── Direct interaction: the board works whether or not a tour is running ──
			// CREATE — the form's submit fires on both the Add button and Enter in the field.
			$('#vt-create').addEventListener('submit', (e) => { e.preventDefault(); if (actions.addFromInput() != null) noteEl.focus(); });
			// UPDATE + DELETE — one delegated listener over the list.
			listEl.addEventListener('click', (e) => {
				const btn = e.target.closest('.icon-btn');
				const li = e.target.closest('.note');
				if (!li) return;
				const id = Number(li.dataset.id);
				if (btn?.dataset.act === 'remove') actions.remove(id);
				else if (btn?.dataset.act === 'edit' || e.target.closest('.note-text')) beginEdit(li, id);
			});
			// Inline edit: swap the text for an input; commit on Enter/blur, cancel on Escape.
			function beginEdit(li, id) {
				const n = notes.find((x) => x.id === id); if (!n) return;
				const textEl = li.querySelector('.note-text'); if (!textEl) return;
				const input = document.createElement('input'); input.className = 'note-edit'; input.value = n.text;
				input.setAttribute('aria-label', 'Edit note'); input.maxLength = 120;
				let settled = false;
				const commit = () => { if (settled) return; settled = true; actions.update(id, input.value); }; // update() re-renders
				const cancel = () => { if (settled) return; settled = true; renderBoard(); };
				input.addEventListener('keydown', (ev) => {
					if (ev.key === 'Enter') { ev.preventDefault(); commit(); }
					else if (ev.key === 'Escape') { ev.preventDefault(); cancel(); }
				});
				input.addEventListener('blur', commit);
				textEl.replaceWith(input); input.focus(); input.select();
			}
			// PUBLISH
			finishEl.addEventListener('click', () => actions.publish());

			let handle = null;
			let touring = false;
			const tourBtn = $('#tourBtn');
			// Halt the "Play all five" loop and restore the button — called by every manual
			// interruption (Stop, Reset, picking a single beat) so the tour can't march on.
			function endTour() { touring = false; tourBtn.textContent = '▸ Play all seven'; }
			function stopCurrent() { if (handle) { try { handle.stop(); } catch {} handle = null; } }
			// The beat a control change replays, so switching `caption` or `pacing` shows the
			// difference on the thing you were already watching rather than on nothing.
			let lastBeat = null;

			// ── THE STORYBOARD, AS DATA ───────────────────────────────────────────────
			// `scene()` records; it does not run. What it compiles to is a plain Step[] — the
			// wire format, which is why a walkthrough can be generated, diffed or shipped as
			// JSON. A callback cannot serialize, so it prints as a marker rather than silently
			// vanishing, which is the one thing a reader would be misled by.
			const dataOut = $('#dataOut'), dataSum = $('#dataSum');
			function stepToPlain(step) {
				const out = {};
				for (const [k, v] of Object.entries(step)) {
					if (typeof v === 'function') out[k] = k === 'act' || k === 'until' ? 'ƒ' : `ƒ ${k}`;
					else if (v && typeof v === 'object') out[k] = JSON.parse(JSON.stringify(v, (_, x) => (typeof x === 'function' ? 'ƒ' : x)));
					else out[k] = v;
				}
				return out;
			}
			function renderData(beat) {
				if (!beat || !beat.scene) {
					dataOut.textContent = `“${beat ? beat.t : '—'}” is a raw Walkthrough — an async function over the run context, the lowest of the three authoring layers. It has no Step[] to show; the recorder is what produces one.`;
					dataSum.textContent = '';
					return;
				}
				const steps = beat.scene().toData().map(stepToPlain);
				dataOut.textContent = JSON.stringify(steps, null, 2);
				dataSum.textContent = `${steps.length} steps`;
			}

			// ── THE LIVE THEME, and why it is a control and not a constant ────────────
			// This page passed NO theme for its whole life, so every option below — the five
			// caption styles, three pointer shapes, three speeds, three motion tiers, the hand
			// model and the two pacing models — was invisible on the one page that exists to
			// show them. `pacing` in particular is documented as a choice that "cannot be A/B'd
			// is a matter of taste", so the page owes the A/B.
			const OPTIONS = {
				caption: { label: 'caption', values: ['bar', 'split', 'scrim', 'progress', 'cursor', 'none'], def: 'bar',
					note: { bar: 'Full-width dock with an Exit icon — the universal default.', split: 'Text-only caption, Exit as its own chip.', scrim: 'A gradient band; the phone posture.', progress: 'The dock carries a progress ring.', cursor: 'A speech balloon anchored to the cursor — it steps aside while the cursor performs.', none: 'The bare pointer layer. What Present uses: the deck narrates, so the tour must not.' } },
				pointer: { label: 'pointer', values: ['arrow', 'ring', 'dot'], def: 'arrow', note: {} },
				hand: { label: 'hand', values: ['0', '1', '2'], def: '1',
					note: { 0: 'A straight path at a symmetric ease — the glide this library shipped before. No hand arcs, overshoots or tremors.', 1: 'Default. An arc, a ballistic overshoot-and-correct, and a band-limited tremor at real hand frequencies.', 2: 'Twice the amplitude — legible on a small screen, and past what a hand does.' } },
				speed: { label: 'speed', values: ['slow', 'moderate', 'fast'], def: 'moderate', note: {} },
				pacing: { label: 'pacing', values: ['legacy', 'grounded'], def: 'legacy',
					note: { legacy: 'The five hand-tuned literals this library shipped first.', grounded: 'One cited model. Costs ~21% run length and every number is sourced — read the gap column below.' } },
				motion: { label: 'motion', values: ['system', 'full', 'legible', 'still'], def: 'system',
					note: { system: 'Follow prefers-reduced-motion: reduce lands on legible, never still.', full: 'Play everything, ignore the OS preference.', legible: 'Suppress vestibular motion (glides, orbits, sweeps) but KEEP the cadence a viewer reads by — typing, cross-fades, settles.', still: 'Collapse everything to instant. The maximal-suppression escape hatch.' } },
			};
			const picked = Object.fromEntries(Object.entries(OPTIONS).map(([k, o]) => [k, o.def]));
			const noteEl2 = $('#ctl-note');
			// `hand` is the one numeric option, so it round-trips through the control as a string.
			const themeNow = () => ({ ...picked, hand: Number(picked.hand), accent: 'var(--accent)' });
			function renderControls() {
				for (const [key, opt] of Object.entries(OPTIONS)) {
					const host = document.querySelector(`.seg[data-opt="${key}"]`);
					if (!host) continue;
					host.textContent = '';
					for (const v of opt.values) {
						const b = document.createElement('button');
						b.type = 'button'; b.textContent = v;
						b.setAttribute('aria-pressed', String(picked[key] === v));
						b.addEventListener('click', () => {
							picked[key] = v;
							renderControls();
							const note = OPTIONS[key].note[v];
							noteEl2.textContent = note ? `${key}: ${v} — ${note}` : '';
							// Re-run what is on screen so the change is SEEN, not just stored.
							if (lastBeat) { resetBoard(); lastBeat.run(); }
						});
						host.appendChild(b);
					}
				}
			}

			// ── THE BEAT LOG ──────────────────────────────────────────────────────────
			// The sibling showcases report numbers (Suono prints its real produce() delta);
			// this page asserted. Wrapping the stage's own verbs is the only honest source —
			// it records what the engine DID, not what the beat list says it would.
			const logRows = [];
			let logT0 = 0;
			const logBody = $('#logBody'), logEmpty = $('#logEmpty'), logSum = $('#logSum');
			function logReset() { logRows.length = 0; logT0 = performance.now(); paintLog(); }
			function logAdd(verb, detail) {
				const t = Math.round(performance.now() - logT0);
				logRows.push({ t, gap: logRows.length ? t - logRows[logRows.length - 1].t : 0, verb, detail: detail ?? '' });
				paintLog();
			}
			function paintLog() {
				logBody.textContent = '';
				for (const r of logRows) {
					const tr = document.createElement('tr');
					const cells = [[String(r.t), 'num'], [r.gap ? `+${r.gap}` : '', 'num'], [r.verb, 'verb'], [r.detail, '']];
					for (const [text, cls] of cells) {
						const td = document.createElement('td');
						if (cls) td.className = cls;
						td.textContent = text;
						tr.appendChild(td);
					}
					logBody.appendChild(tr);
				}
				logEmpty.hidden = logRows.length > 0;
				const last = logRows[logRows.length - 1];
				logSum.textContent = logRows.length ? `${logRows.length} verbs · ${last.t} ms` : '';
				logBody.parentElement.parentElement.scrollTop = logBody.parentElement.parentElement.scrollHeight;
			}
			// A short, readable form of a target for the log — a selector stays as typed, an
			// element becomes its own selector-ish name, anything else is named by its kind.
			const targetName = (t) => (typeof t === 'string' ? t : t && t.tagName ? `<${t.tagName.toLowerCase()}>` : t ? 'rect source' : '');
			/** Wrap the stage so every verb lands in the log. The stage is the library's object,
			 *  so this observes rather than reimplements — a log built from the BEAT LIST would
			 *  report the script, not the run. */
			function instrument(stage) {
				const say = stage.say.bind(stage), point = stage.point.bind(stage), gesture = stage.gesture.bind(stage);
				stage.say = (text, ...rest) => { logAdd('say', text); return say(text, ...rest); };
				stage.point = (t, ...rest) => { logAdd('point', targetName(t)); return point(t, ...rest); };
				stage.gesture = (kind, t, ...rest) => { logAdd(`gesture ${kind}`, targetName(t)); return gesture(kind, t, ...rest); };
				return stage;
			}

			// Run one walkthrough `play` over the board; resolves when it tears down. Guard the
			// engine call so a synchronous throw can't wedge the awaiting tour loop.
			function playScene(play) {
				stopCurrent();
				logReset();
				// The stage is wrapped on its way INTO the walkthrough, so the log records the
				// verbs the engine actually performed rather than the ones the beat list names.
				const instrumented = (ctx) => play({ ...ctx, stage: instrument(ctx.stage) });
				return new Promise((resolve) => {
					try {
						handle = run({
							root: board, actions, type, play: instrumented,
							theme: themeNow(),
							takeover: { scope: 'window' },
							onStop: (reason) => { handle = null; setDiag(reason === 'takeover' ? 'You took the wheel.' : reason === 'error' ? 'Beat error — see console.' : ''); resolve(reason); },
						});
					} catch (err) {
						handle = null; console.error('[vetrina] beat failed to start', err); setDiag('Beat error — see console.'); resolve('error');
					}
				});
			}

			// ── The five beats — each a short walkthrough over the real widgets ──
			const BEATS = [
				{ id: 'read', t: 'Narrate + point', d: 'The cursor speaks and points at real elements — a caption dock + a gliding pointer over your own DOM.', api: 'stage.say / point', run: () => playScene(async ({ stage, signal }) => {
					stage.say('This is your release-notes board — a couple queued already.'); await wait(900, signal);
					await stage.point('#vt-list', signal); stage.say('Read: every row is real state, not a picture.'); await wait(1100, signal);
				}) },
				{ id: 'create', t: 'Create a record', d: 'Types a note and clicks Add — a real row appears in the list, end-to-end.', api: 'ctx.type + actions.add', run: () => playScene(async (ctx) => {
					const { stage, actions, signal } = ctx;
					await stage.point('#vt-note', signal); stage.say('Create — type a new note…'); await wait(450, signal);
					await ctx.type('#vt-note', 'Emit dist/index.mjs for all four', { cadence: 30 }); await wait(300, signal);
					await stage.point('#vt-add', signal); actions.addFromInput(); await stage.gesture('check', '#vt-list', signal);
					stage.say('Added — a real Create.'); await wait(950, signal);
				}) },
				{ id: 'update', t: 'Update a record', d: 'Edits the first note in place — the row’s text really changes through actions.update.', api: 'actions.update(id, text)', run: () => playScene(async ({ stage, actions, signal }) => {
					const first = notes[0];
					if (!first) { stage.say('Nothing to edit yet.'); await wait(700, signal); return; }
					await stage.point('#vt-list .note:first-child', signal); stage.say('Update — revise the first note.'); await wait(500, signal);
					actions.update(first.id, `${first.text} ✓`); await stage.gesture('circle', '#vt-list .note:first-child', signal);
					stage.say('Edited in place — a real Update.'); await wait(1000, signal);
				}) },
				{ id: 'delete', t: 'Delete a record', d: 'Crosses out the last note and removes it — the row is gone from state, not hidden.', api: 'actions.remove(id)', run: () => playScene(async ({ stage, actions, signal }) => {
					const last = notes[notes.length - 1];
					if (!last) { stage.say('Nothing to delete.'); await wait(700, signal); return; }
					await stage.point('#vt-list .note:last-child', signal); stage.say('Delete — drop the last one.'); await wait(500, signal);
					await stage.gesture('cross', '#vt-list .note:last-child', signal); actions.remove(last.id);
					stage.say('Gone — a real Delete.'); await wait(1000, signal);
				}) },
				{ id: 'handoff', t: 'Take the wheel', d: 'Hands you the board — add, edit, delete freely, or click Publish. Touch anything and it’s yours; times out after 8s.', api: 'ctx.awaitUser({ match })', run: () => playScene(async (ctx) => {
					const { stage, actions, signal } = ctx;
					stage.say('Your turn — the board is yours. Click Publish when ready.'); await stage.point('#vt-finish', signal);
					await ctx.awaitUser({ match: (e) => within('#vt-finish', e.target), timeout: 8000, onTimeout: 'abort' });
					actions.publish(); await stage.gesture('check', '#vt-finish', signal);
					stage.say('Published — the whole CRUD loop, self-driven and yours.'); await wait(900, signal);
				}) },
				// ── THE DEICTIC FOUR, which had no demo surface anywhere on this site ──
				// underline / wash / bracket / tap are the gestures the Studio's Present guide
				// uses to point INSIDE a slide, and until now a reader could only meet them in
				// a decision record. They name a thing by its shape: a line gets a rule under
				// it, a phrase gets its words swept, a box that draws no boundary of its own
				// gets one, and something small enough to be a point gets tapped.
				{ id: 'deictic', t: 'Point at a thing', d: 'The four deictic strokes — underline a line, wash a phrase, bracket a block, tap a point. Chosen by the SHAPE of what is named.', api: "scene().gesture('underline'…)", scene: deicticScene },
				// ── THE TEACHING BEAT ──
				{ id: 'teach', t: 'Teach, then do', d: 'A read() beat dips the cursor to the caption, pulses the words, and DWELLS long enough to read them — before the action runs.', api: 'scene().read()', scene: teachScene },
			];
			function setCurrentBeat(id) { [...beatsEl.children].forEach((el) => el.setAttribute('aria-current', String(el.dataset.id === id))); }
			// A `scene` beat compiles through the recorder; a `run` beat is a raw Walkthrough.
			// Both shapes ship on this page deliberately — they are two of the library's three
			// authoring layers, and only the recorder can show you its Step[].
			for (const b of BEATS) if (!b.run) b.run = () => playScene(b.scene().build());
			BEATS.forEach((b, i) => {
				const el = document.createElement('button');
				el.className = 'beat'; el.type = 'button'; el.dataset.id = b.id;
				el.innerHTML = `<span class="n">${i + 1}</span><span><span class="bt">${b.t}</span><p class="bd">${b.d}</p><span class="api">${b.api}</span></span>`;
				el.addEventListener('click', () => { endTour(); setCurrentBeat(b.id); resetBoard(); lastBeat = b; renderData(b); b.run(); });
				beatsEl.appendChild(el);
			});

			// ── RECORD AND REPLAY (LTT step 4) ──────────────────────────────────────────
			// Record runs "Point at a thing" with the Cadenza narrator and writes the run down as a
			// seekable timing track (createTourRecorder); Replay plays the committed recording back
			// through replayNarrator, so each word lands where it was recorded. `/vetrina?replay`
			// starts the replay on load. The steps come from page-scenes.ts, the module
			// page-scenes.test.ts checks the recording against.
			const digest = async (t) => `sha256:${[...new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(t)))].map((b) => b.toString(16).padStart(2, '0')).join('')}`;
			const recordingLink = $('#recordingLink');
			function playSteps(extra) {
				stopCurrent();
				logReset();
				endTour();
				resetBoard();
				const deictic = BEATS.find((b) => b.id === 'deictic');
				setCurrentBeat(deictic.id); lastBeat = deictic; renderData(deictic);
				const steps = deicticScene().toData();
				const play = storyboard('', steps);
				return new Promise((resolve) => {
					try {
						handle = run({
							// Instrumented like every other beat, so the log pane shows what ran.
							root: board, actions, type, play: (ctx) => play({ ...ctx, stage: instrument(ctx.stage) }), theme: themeNow(), takeover: { scope: 'window' }, ...extra(steps),
							onStop: (reason) => { handle = null; resolve({ reason, steps }); },
						});
					} catch (err) {
						handle = null; console.error('[vetrina] recording failed to start', err); resolve({ reason: 'error', steps });
					}
				});
			}
			const stopped = (reason) => (reason === 'takeover' ? 'You took the wheel' : reason === 'error' ? 'Beat error — see console' : 'Stopped');
			// The recorder loads on first use, in its own chunk. Imported statically, the bundler folded it
			// into the Vetrina chunk the Studio shares, and the Studio's eager JS grew 1.7 KB gz for code it
			// never runs (docs/route-budget.json caught it).
			const recorder = () => import('@/lib/vetrina/recorder');
			$('#recordBtn').addEventListener('click', async () => {
				const { createTourRecorder } = await recorder();
				const record = createTourRecorder({ id: DEICTIC_RECORDING_ID, inputs: { engine: ENGINE_HASH, pace: RECORDING_PACE }, digest });
				setDiag('Recording “Point at a thing”…');
				const { reason, steps } = await playSteps(() => ({ narrate: cadenzaNarrator({ pace: RECORDING_PACE }), record }));
				// A run that did not finish writes nothing, and leaves the last good recording's link alone.
				if (reason !== 'complete') { setDiag(`${stopped(reason)}, so nothing was recorded.`); return; }
				const ltt = await record.ltt(steps);
				if (recordingLink.href) URL.revokeObjectURL(recordingLink.href);
				recordingLink.href = URL.createObjectURL(new Blob([`${JSON.stringify(ltt, null, 2)}\n`], { type: 'application/json' }));
				recordingLink.download = `${DEICTIC_RECORDING_ID}.ltt.json`;
				recordingLink.hidden = false;
				const n = ltt.segments.length;
				setDiag(`Recorded ${n} ${n === 1 ? 'stretch' : 'stretches'}, ${Math.round(ltt.segments.reduce((t, s) => t + (s.track?.durationMs ?? 0), 0) / 100) / 10} s of narration.`);
			});
			const replay = async () => {
				const { replayNarrator } = await recorder();
				setDiag('Replaying the recording…');
				const { reason } = await playSteps(() => ({ narrate: replayNarrator(deicticRecording, cadenzaNarrator({ pace: RECORDING_PACE })) }));
				setDiag(reason === 'complete' ? 'Replayed from the recording.' : `${stopped(reason)}.`);
			};
			$('#replayBtn').addEventListener('click', replay);

			$('#stopBtn').addEventListener('click', () => { endTour(); stopCurrent(); setDiag('Stopped.'); });
			$('#resetBtn').addEventListener('click', () => { endTour(); stopCurrent(); resetBoard(); setCurrentBeat(null); setDiag(''); });

			tourBtn.addEventListener('click', async () => {
				if (touring) { endTour(); stopCurrent(); return; }
				touring = true; tourBtn.textContent = '■ Stop tour'; resetBoard();
				for (const b of BEATS) {
					if (!touring) break;
					setCurrentBeat(b.id);
					lastBeat = b; renderData(b);
					await b.run(); // resolves when the beat tears down (awaitUser beat resolves on click or 8s timeout)
					if (!touring) break;
					await new Promise((r) => setTimeout(r, 500));
				}
				endTour();
			});

			// Boot — seed the records, paint the board, and raise the controls.
			resetBoard();
			renderControls();
			renderData(null);
			if (new URLSearchParams(location.search).has('replay')) replay();
		</script>
	</body>
</html>
