---
// Vetrina — a standalone, framework-free showcase driven by the REAL engine
// (docs/src/lib/vetrina): run() drives a self-directing cursor over a plain-DOM mini dashboard —
// theater over REAL state, seamlessly interruptible. No React, no slide engine. A guided storyboard:
// each beat runs a short walkthrough that shows one primitive (narrate + point, a real state change,
// typing, gestures, the cooperative hand-off). Reached at /vetrina.
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Vetrina — a self-driving walkthrough</title>
		<link rel="icon" href="/vetrina-mark.svg" type="image/svg+xml" />
		<style is:global>
			:root {
				--paper: #fbf5f7; --stage: #f4e9ee; --ink: #2a1a22; --muted: #9c8a92; --spent: #cbb8c1;
				--line: #e6d5dd; --accent: #a8446a; --accent-ink: #fff; --glow: #c67a12; --glow-bg: #f6e2c4;
				--panel: #fffafc; --shadow: 0 1px 2px rgba(42,26,34,.06), 0 8px 24px rgba(42,26,34,.06);
				--vt-accent: #a8446a;
				--stage-serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
				--sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
				--mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--paper: #140d11; --stage: #1e141a; --ink: #efe2e8; --muted: #6a5560; --spent: #47343d;
					--line: #2c1f26; --accent: #e08aa8; --accent-ink: #1a0f14; --glow: #f6b64a; --glow-bg: #33291a;
					--panel: #191016; --shadow: 0 1px 2px rgba(0,0,0,.4), 0 10px 30px rgba(0,0,0,.35);
					--vt-accent: #e08aa8;
				}
			}
			:root[data-theme="light"] {
				--paper: #fbf5f7; --stage: #f4e9ee; --ink: #2a1a22; --muted: #9c8a92; --spent: #cbb8c1;
				--line: #e6d5dd; --accent: #a8446a; --accent-ink: #fff; --glow: #c67a12; --glow-bg: #f6e2c4; --panel: #fffafc; --vt-accent: #a8446a;
			}
			:root[data-theme="dark"] {
				--paper: #140d11; --stage: #1e141a; --ink: #efe2e8; --muted: #6a5560; --spent: #47343d;
				--line: #2c1f26; --accent: #e08aa8; --accent-ink: #1a0f14; --glow: #f6b64a; --glow-bg: #33291a; --panel: #191016; --vt-accent: #e08aa8;
			}
			* { box-sizing: border-box; }
			body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans);
				line-height: 1.5; -webkit-font-smoothing: antialiased; padding: clamp(16px, 4vw, 48px); }
			.wrap { max-width: 900px; margin: 0 auto; }
			header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
			.brand { display: flex; align-items: center; gap: 13px; }
			.brand .logo { width: 46px; height: 46px; flex-shrink: 0; }
			.home { color: var(--muted); text-decoration: none; font-size: 13px; font-weight: 600; }
			.home:hover { color: var(--accent); }
			h1 { font-family: var(--stage-serif); font-size: clamp(28px, 5vw, 40px); font-weight: 600; margin: 0; letter-spacing: -.01em; }
			.tag { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent);
				border: 1px solid var(--accent); padding: 3px 8px; border-radius: 999px; font-weight: 600; }
			.sub { color: var(--muted); font-size: 14px; max-width: 66ch; margin: 6px 0 0; }
			.sub b { color: var(--ink); font-weight: 600; }

			.stage { margin: 26px 0 0; background: var(--stage); border: 1px solid var(--line); border-radius: 18px;
				box-shadow: var(--shadow); padding: clamp(22px, 4vw, 36px); position: relative; }
			/* The mini dashboard the walkthrough drives — real widgets, real state. */
			.board { display: grid; gap: 14px; max-width: 480px; margin: 0 auto; }
			.board-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
			.metric { display: flex; flex-direction: column; gap: 2px; }
			.metric-label { font-family: var(--mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
			.metric-val { font-family: var(--stage-serif); font-size: 34px; font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
			.pub-badge { font-family: var(--mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; font-weight: 700;
				color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 4px 10px; }
			.board[data-published="true"] .pub-badge { color: var(--accent-ink); background: var(--accent); border-color: var(--accent); }

			/* CREATE — the note field + Add */
			.board-create { display: flex; gap: 8px; }
			.board-create input { flex: 1 1 auto; min-width: 0; font-family: var(--sans); font-size: 14px; color: var(--ink);
				background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
			.board-btn { border: 1px solid var(--line); background: var(--panel); color: var(--ink); font-family: var(--sans);
				font-size: 13px; font-weight: 600; border-radius: 10px; padding: 10px 16px; cursor: pointer; white-space: nowrap;
				transition: transform .08s ease, border-color .12s ease; }
			.board-btn:hover:not(:disabled) { transform: translateY(-1px); border-color: var(--accent); }
			.board-btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
			.board-btn:disabled { opacity: .5; cursor: default; transform: none; }

			/* READ — the list of note records */
			.note-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
			.note { display: flex; align-items: center; gap: 10px; padding: 9px 12px; background: var(--panel);
				border: 1px solid var(--line); border-radius: 10px; }
			.note-text { flex: 1 1 auto; min-width: 0; font-size: 14px; color: var(--ink); overflow-wrap: anywhere; cursor: text; }
			.note-edit { flex: 1 1 auto; min-width: 0; font-family: var(--sans); font-size: 14px; color: var(--ink);
				background: var(--stage); border: 1px solid var(--accent); border-radius: 8px; padding: 6px 8px; }
			.note-actions { display: flex; gap: 4px; flex-shrink: 0; }
			/* UPDATE / DELETE — per-row icon buttons */
			.icon-btn { border: 1px solid transparent; background: none; color: var(--muted); cursor: pointer; border-radius: 8px;
				width: 28px; height: 28px; display: grid; place-items: center; font-size: 15px; line-height: 1;
				transition: color .12s ease, background-color .12s ease; }
			.icon-btn:hover { color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
			.icon-btn.danger:hover { color: var(--glow); background: color-mix(in srgb, var(--glow) 14%, transparent); }
			.note-empty { font-size: 13px; color: var(--muted); font-style: italic; padding: 4px 2px; }
			.board[data-published="true"] .note { opacity: .65; }

			.transport { margin-top: 20px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
			.btn { border: 1px solid var(--line); background: var(--panel); color: var(--ink); font-family: var(--sans);
				font-size: 13px; font-weight: 600; border-radius: 999px; padding: 9px 16px; cursor: pointer; transition: transform .08s ease; }
			.btn:hover { transform: translateY(-1px); }
			.btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
			.diag { margin-top: 14px; min-height: 18px; font-family: var(--mono); font-size: 12px; color: var(--muted); }

			.rail { margin-top: 26px; }
			.rail-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
			.rail-head h2 { font-family: var(--stage-serif); font-size: 18px; margin: 0; font-weight: 600; }
			.beats { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 10px; }
			.beat { text-align: left; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); padding: 14px 15px;
				cursor: pointer; display: flex; gap: 12px; align-items: flex-start; transition: border-color .12s ease, transform .08s ease; }
			.beat:hover { transform: translateY(-2px); border-color: var(--accent); }
			.beat[aria-current="true"] { border-color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 16%, transparent); }
			.beat .n { flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: var(--stage); border: 1px solid var(--line);
				color: var(--accent); font-family: var(--mono); font-size: 12px; font-weight: 700; display: grid; place-items: center; }
			.beat[aria-current="true"] .n { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
			.beat .bt { font-size: 14px; font-weight: 600; color: var(--ink); margin: 0 0 2px; }
			.beat .bd { font-size: 12.5px; color: var(--muted); margin: 0; line-height: 1.45; }
			.beat .api { font-family: var(--mono); font-size: 11px; color: var(--accent); }

			.foot { margin-top: 26px; color: var(--muted); font-size: 12px; line-height: 1.7; }
			.foot code { font-family: var(--mono); background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; }
			.theme { background: none; border: 1px solid var(--line); color: var(--muted); border-radius: 999px; font-size: 11px; padding: 5px 11px; cursor: pointer; font-family: var(--sans); }
			:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
		</style>
	</head>
	<body>
		<div class="wrap">
			<header>
				<div class="brand">
					<img class="logo" src="/vetrina-mark.svg" alt="" width="46" height="46" />
					<h1>Vetrina</h1><span class="tag">walkthrough</span>
				</div>
				<div style="display:flex; gap:14px; align-items:center;">
					<a class="home" href="/">← Lattice</a>
					<button class="theme" id="themeBtn" type="button">◐ theme</button>
				</div>
			</header>
			<p class="sub">
				A self-driving product tour — a cursor that <b>narrates and operates real UI</b>, theater over
				<b>real state</b>, and hands you the wheel the instant you touch anything. Framework-free; it drives
				plain DOM. Every beat below runs the <b>real engine</b> over the mini dashboard.
			</p>

			<div class="stage">
				<div class="board" id="vt-board" data-published="false">
					<div class="board-head">
						<div class="metric"><span class="metric-label">Release notes</span><span class="metric-val" id="vt-count">0</span></div>
						<span class="pub-badge" id="vt-badge">draft</span>
					</div>
					<form class="board-create" id="vt-create">
						<input id="vt-note" type="text" placeholder="Add a release note…" autocomplete="off" aria-label="New release note" />
						<button class="board-btn" id="vt-add" type="submit">+ Add</button>
					</form>
					<ul class="note-list" id="vt-list" aria-label="Release notes"></ul>
					<button class="board-btn primary" id="vt-finish" type="button">Publish release</button>
				</div>
			</div>
			<div class="transport">
				<button class="btn" id="stopBtn" type="button">Stop</button>
				<button class="btn" id="resetBtn" type="button">Reset board</button>
			</div>
			<p class="diag" id="diag" role="status" aria-live="polite"></p>

			<div class="rail">
				<div class="rail-head">
					<h2>The storyboard</h2>
					<button class="btn primary" id="tourBtn" type="button">▸ Play all five</button>
				</div>
				<div class="beats" id="beats"></div>
			</div>

			<p class="foot">
				Driven by the real engine (<code>@/lib/vetrina</code>): <code>run()</code> owns the take-over race +
				teardown; the self-directing cursor calls <code>stage.say</code> / <code>point</code> /
				<code>gesture</code> and <code>ctx.type</code> / <code>awaitUser</code> over the real board above.
				The board is a <b>working CRUD example</b> — <b>Create</b> (type + Add), <b>Read</b> (the list),
				<b>Update</b> (click a note to edit), <b>Delete</b> (×), then Publish. The tour calls the <i>same</i>
				<code>actions.add</code> / <code>update</code> / <code>remove</code> / <code>publish</code> you do — it
				mutates real state, it doesn't paint it. Operate it yourself any time; touch anything mid-tour and it
				hands you the wheel. A plain DOM page, no framework — the proof the core is standalone.
			</p>
		</div>

		<script>
			import { run, wait } from '@/lib/vetrina';

			const $ = (s) => document.querySelector(s);
			const root = document.documentElement;
			const board = $('#vt-board'), countEl = $('#vt-count'), noteEl = $('#vt-note'), finishEl = $('#vt-finish');
			const beatsEl = $('#beats');
			const setDiag = (m) => { $('#diag').textContent = m || ''; };

			// Theme toggle (shared docs key).
			const THEME_LS = 'lattice-docs-mode';
			const applyTheme = (t) => { if (t === 'light' || t === 'dark') root.setAttribute('data-theme', t); else root.removeAttribute('data-theme'); };
			try { applyTheme(localStorage.getItem(THEME_LS)); } catch {}
			$('#themeBtn').addEventListener('click', () => {
				const cur = root.getAttribute('data-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				const next = cur === 'dark' ? 'light' : 'dark';
				applyTheme(next); try { localStorage.setItem(THEME_LS, next); } catch {}
			});

			// ── The release-notes board: REAL CRUD state that BOTH you and the walkthrough drive ──
			const listEl = $('#vt-list'), badgeEl = $('#vt-badge');
			let notes = [];        // the records: [{ id, text }]
			let published = false;
			let seq = 0;           // id source

			// READ — paint the whole board from state (count, badge, publish-enabled, the list).
			function renderBoard() {
				countEl.textContent = String(notes.length);
				badgeEl.textContent = published ? 'published' : 'draft';
				board.dataset.published = String(published);
				finishEl.disabled = notes.length === 0 || published;
				listEl.replaceChildren(...(notes.length ? notes.map(rowFor) : [emptyRow()]));
			}
			function emptyRow() {
				const li = document.createElement('li'); li.className = 'note-empty';
				li.textContent = 'No notes yet — add one above.'; return li;
			}
			function rowFor(n) {
				const li = document.createElement('li'); li.className = 'note'; li.dataset.id = String(n.id);
				// textContent, never innerHTML — a note is user text (HARD RULE #22 hygiene).
				const text = document.createElement('span'); text.className = 'note-text'; text.textContent = n.text;
				text.title = 'Click to edit';
				const acts = document.createElement('div'); acts.className = 'note-actions';
				const edit = document.createElement('button'); edit.type = 'button'; edit.className = 'icon-btn';
				edit.dataset.act = 'edit'; edit.setAttribute('aria-label', `Edit "${n.text}"`); edit.textContent = '✎';
				const del = document.createElement('button'); del.type = 'button'; del.className = 'icon-btn danger';
				del.dataset.act = 'remove'; del.setAttribute('aria-label', `Delete "${n.text}"`); del.textContent = '×';
				acts.append(edit, del); li.append(text, acts); return li;
			}

			// The action bag — the REAL create/update/delete/publish. The tour calls these; so does the UI.
			const actions = {
				add: (text) => { const t = String(text ?? '').trim(); if (!t) return null; const id = ++seq; notes.push({ id, text: t }); published = false; renderBoard(); return id; },
				update: (id, text) => { const n = notes.find((x) => x.id === id); if (!n) return; n.text = String(text ?? '').trim() || n.text; published = false; renderBoard(); },
				remove: (id) => { const before = notes.length; notes = notes.filter((x) => x.id !== id); if (notes.length !== before) { if (!notes.length) published = false; renderBoard(); } },
				publish: () => { if (notes.length && !published) { published = true; renderBoard(); } },
				// Commit the create field — what Add / Enter does; the tour uses it after ctx.type().
				addFromInput: () => { const id = actions.add(noteEl.value); if (id != null) noteEl.value = ''; return id; },
			};
			const type = {
				set: (t) => { noteEl.value = t; },
				append: (t) => { noteEl.value += t; },
				read: () => noteEl.value,
			};
			const within = (sel, node) => { const el = board.querySelector(sel); return !!el && node instanceof Node && el.contains(node); };

			// Seed a couple of records so the board reads as real on load (and the beats have rows to touch).
			function resetBoard() {
				notes = [{ id: ++seq, text: 'Ship the real ESM builds' }, { id: ++seq, text: 'Close the lente approval hole' }];
				published = false; noteEl.value = ''; renderBoard();
			}

			// ── Direct interaction: the board works whether or not a tour is running ──
			// CREATE — the form's submit fires on both the Add button and Enter in the field.
			$('#vt-create').addEventListener('submit', (e) => { e.preventDefault(); if (actions.addFromInput() != null) noteEl.focus(); });
			// UPDATE + DELETE — one delegated listener over the list.
			listEl.addEventListener('click', (e) => {
				const btn = e.target.closest('.icon-btn');
				const li = e.target.closest('.note');
				if (!li) return;
				const id = Number(li.dataset.id);
				if (btn?.dataset.act === 'remove') actions.remove(id);
				else if (btn?.dataset.act === 'edit' || e.target.closest('.note-text')) beginEdit(li, id);
			});
			// Inline edit: swap the text for an input; commit on Enter/blur, cancel on Escape.
			function beginEdit(li, id) {
				const n = notes.find((x) => x.id === id); if (!n) return;
				const textEl = li.querySelector('.note-text'); if (!textEl) return;
				const input = document.createElement('input'); input.className = 'note-edit'; input.value = n.text;
				input.setAttribute('aria-label', 'Edit note'); input.maxLength = 120;
				let settled = false;
				const commit = () => { if (settled) return; settled = true; actions.update(id, input.value); }; // update() re-renders
				const cancel = () => { if (settled) return; settled = true; renderBoard(); };
				input.addEventListener('keydown', (ev) => {
					if (ev.key === 'Enter') { ev.preventDefault(); commit(); }
					else if (ev.key === 'Escape') { ev.preventDefault(); cancel(); }
				});
				input.addEventListener('blur', commit);
				textEl.replaceWith(input); input.focus(); input.select();
			}
			// PUBLISH
			finishEl.addEventListener('click', () => actions.publish());

			let handle = null;
			let touring = false;
			const tourBtn = $('#tourBtn');
			// Halt the "Play all five" loop and restore the button — called by every manual
			// interruption (Stop, Reset, picking a single beat) so the tour can't march on.
			function endTour() { touring = false; tourBtn.textContent = '▸ Play all five'; }
			function stopCurrent() { if (handle) { try { handle.stop(); } catch {} handle = null; } }
			// Run one walkthrough `play` over the board; resolves when it tears down. Guard the
			// engine call so a synchronous throw can't wedge the awaiting tour loop.
			function playScene(play) {
				stopCurrent();
				return new Promise((resolve) => {
					try {
						handle = run({
							root: board, actions, type, play,
							takeover: { scope: 'window' },
							onStop: (reason) => { handle = null; setDiag(reason === 'takeover' ? 'You took the wheel.' : reason === 'error' ? 'Beat error — see console.' : ''); resolve(reason); },
						});
					} catch (err) {
						handle = null; console.error('[vetrina] beat failed to start', err); setDiag('Beat error — see console.'); resolve('error');
					}
				});
			}

			// ── The five beats — each a short walkthrough over the real widgets ──
			const BEATS = [
				{ id: 'read', t: 'Narrate + point', d: 'The cursor speaks and points at real elements — a caption dock + a gliding pointer over your own DOM.', api: 'stage.say / point', run: () => playScene(async ({ stage, signal }) => {
					stage.say('This is your release-notes board — a couple queued already.'); await wait(900, signal);
					await stage.point('#vt-list', signal); stage.say('Read: every row is real state, not a picture.'); await wait(1100, signal);
				}) },
				{ id: 'create', t: 'Create a record', d: 'Types a note and clicks Add — a real row appears in the list, end-to-end.', api: 'ctx.type + actions.add', run: () => playScene(async (ctx) => {
					const { stage, actions, signal } = ctx;
					await stage.point('#vt-note', signal); stage.say('Create — type a new note…'); await wait(450, signal);
					await ctx.type('#vt-note', 'Emit dist/index.mjs for all four', { cadence: 30 }); await wait(300, signal);
					await stage.point('#vt-add', signal); actions.addFromInput(); await stage.gesture('check', '#vt-list', signal);
					stage.say('Added — a real Create.'); await wait(950, signal);
				}) },
				{ id: 'update', t: 'Update a record', d: 'Edits the first note in place — the row’s text really changes through actions.update.', api: 'actions.update(id, text)', run: () => playScene(async ({ stage, actions, signal }) => {
					const first = notes[0];
					if (!first) { stage.say('Nothing to edit yet.'); await wait(700, signal); return; }
					await stage.point('#vt-list .note:first-child', signal); stage.say('Update — revise the first note.'); await wait(500, signal);
					actions.update(first.id, `${first.text} ✓`); await stage.gesture('circle', '#vt-list .note:first-child', signal);
					stage.say('Edited in place — a real Update.'); await wait(1000, signal);
				}) },
				{ id: 'delete', t: 'Delete a record', d: 'Crosses out the last note and removes it — the row is gone from state, not hidden.', api: 'actions.remove(id)', run: () => playScene(async ({ stage, actions, signal }) => {
					const last = notes[notes.length - 1];
					if (!last) { stage.say('Nothing to delete.'); await wait(700, signal); return; }
					await stage.point('#vt-list .note:last-child', signal); stage.say('Delete — drop the last one.'); await wait(500, signal);
					await stage.gesture('cross', '#vt-list .note:last-child', signal); actions.remove(last.id);
					stage.say('Gone — a real Delete.'); await wait(1000, signal);
				}) },
				{ id: 'handoff', t: 'Take the wheel', d: 'Hands you the board — add, edit, delete freely, or click Publish. Touch anything and it’s yours; times out after 8s.', api: 'ctx.awaitUser({ match })', run: () => playScene(async (ctx) => {
					const { stage, actions, signal } = ctx;
					stage.say('Your turn — the board is yours. Click Publish when ready.'); await stage.point('#vt-finish', signal);
					await ctx.awaitUser({ match: (e) => within('#vt-finish', e.target), timeout: 8000, onTimeout: 'abort' });
					actions.publish(); await stage.gesture('check', '#vt-finish', signal);
					stage.say('Published — the whole CRUD loop, self-driven and yours.'); await wait(900, signal);
				}) },
			];
			function setCurrentBeat(id) { [...beatsEl.children].forEach((el) => el.setAttribute('aria-current', String(el.dataset.id === id))); }
			BEATS.forEach((b, i) => {
				const el = document.createElement('button');
				el.className = 'beat'; el.type = 'button'; el.dataset.id = b.id;
				el.innerHTML = `<span class="n">${i + 1}</span><span><span class="bt">${b.t}</span><p class="bd">${b.d}</p><span class="api">${b.api}</span></span>`;
				el.addEventListener('click', () => { endTour(); setCurrentBeat(b.id); resetBoard(); b.run(); });
				beatsEl.appendChild(el);
			});

			$('#stopBtn').addEventListener('click', () => { endTour(); stopCurrent(); setDiag('Stopped.'); });
			$('#resetBtn').addEventListener('click', () => { endTour(); stopCurrent(); resetBoard(); setCurrentBeat(null); setDiag(''); });

			tourBtn.addEventListener('click', async () => {
				if (touring) { endTour(); stopCurrent(); return; }
				touring = true; tourBtn.textContent = '■ Stop tour'; resetBoard();
				for (const b of BEATS) {
					if (!touring) break;
					setCurrentBeat(b.id);
					await b.run(); // resolves when the beat tears down (awaitUser beat resolves on click or 8s timeout)
					if (!touring) break;
					await new Promise((r) => setTimeout(r, 500));
				}
				endTour();
			});

			// Boot — seed the records and paint the board.
			resetBoard();
		</script>
	</body>
</html>
