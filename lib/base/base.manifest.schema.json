{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lattice.laticent.io/base.manifest.schema.json",
  "title": "Lattice base manifest",
  "description": "lib/base/base.manifest.json: every class word a slide accepts without a component declaring it, grouped, and every front-matter register with the groups it stamps. See engineering/decisions/2026-11-19-deterministic-authoring-audit.md W5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kinds", "groups", "registers"],
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "description": "The taxonomy: each kind of word an author meets, with the one-line test that tells it apart.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "test"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "test": { "type": "string", "minLength": 1 }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "description": "The modifier groups, in the order completion offers them.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["expand"],
            "properties": { "expand": { "enum": ["plugin-registers"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "label", "summary"],
            "anyOf": [{ "required": ["tokens"] }, { "required": ["axes"] }],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "label": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "tokens": { "$ref": "#/$defs/words" },
              "axes": {
                "type": "array",
                "minItems": 1,
                "items": { "oneOf": [{ "$ref": "#/$defs/words" }, { "$ref": "#/$defs/source" }] }
              },
              "exclusive": { "const": true },
              "offer": { "const": false },
              "surface": {
                "oneOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
                ]
              },
              "follows": {
                "type": "object",
                "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            }
          }
        ]
      }
    },
    "registers": {
      "type": "array",
      "description": "Every DECK_SETTINGS row of kind `register` or `axis`, once, with the groups whose words it stamps. A register that stamps no class word says why.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "groups"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "groups": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "why": { "type": "string", "minLength": 1 }
        },
        "if": { "properties": { "groups": { "type": "array", "maxItems": 0 } } },
        "then": { "required": ["why"] }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": { "source": { "type": "string", "pattern": "^[a-z][a-z0-9:-]*$" } }
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          { "$ref": "#/$defs/source" }
        ]
      }
    }
  }
}
