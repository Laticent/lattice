{
  "$comment": "The ten structures every component is one of, and the units the Guide can address in each. A manifest `gesture` names its archetype and overrides only what its own render does differently (lib/core/gesture.js merges them). Selectors are scoped to the slide's section; `{id}` placeholders are filled by a binding, and with them removed a selector matches every unit of its kind (lib/core/scene-resolve.mjs). A component's FIRST unit (its own override, else the archetype's first) is its primary: the gate requires it to resolve on every slide of its gallery. Prose, list and table units are bound by ORDINAL (`{ i }`, the i-th unit of its kind across the slide), so their selectors carry no placeholder; the narration builder emits the same unit names wherever the structure is the same (heading, paragraph, item, row). engineering/decisions/2026-09-27-guide-storyboards.md §5.",
  "statement": {
    "units": {
      "heading": {
        "select": ":is(h1, h2):not(header *):not(footer *)"
      },
      "paragraph": {
        "select": "p:not(header *):not(footer *):not(li *)"
      }
    },
    "key": "first"
  },
  "list": {
    "units": {
      "item": {
        "select": "li:not(li li)"
      },
      "title": {
        "select": "li:not(li li) > strong:first-child"
      },
      "heading": {
        "select": ":is(h1, h2):not(header *):not(footer *)"
      }
    },
    "key": "first"
  },
  "grid": {
    "units": {
      "item": {
        "select": "li:not(li li)"
      },
      "title": {
        "select": "li:not(li li) > strong:first-child"
      },
      "heading": {
        "select": ":is(h1, h2):not(header *):not(footer *)"
      }
    },
    "key": "first"
  },
  "table": {
    "units": {
      "row": {
        "select": "tbody > tr:nth-child({tr})"
      },
      "column": {
        "select": "tbody > tr > :is(td, th):nth-child({td})",
        "labels": "thead th:nth-child({td})"
      },
      "cell": {
        "select": "tbody > tr:nth-child({tr}) > :is(td, th):nth-child({td})"
      },
      "colheader": {
        "select": "thead th:nth-child({td})"
      },
      "rowheader": {
        "select": "tbody > tr:nth-child({tr}) > :is(td, th):first-child"
      },
      "heading": {
        "select": ":is(h1, h2):not(header *):not(footer *)"
      }
    },
    "key": "first"
  },
  "compare": {
    "units": {
      "side": {
        "select": ":is(.compare-left, .compare-right, .panel-left, .panel-right, .compare-col)"
      },
      "item": {
        "select": "li:not(li li)"
      },
      "heading": {
        "select": ":is(h1, h2):not(header *):not(footer *)"
      }
    },
    "key": "act:compare"
  },
  "cartesian": {
    "units": {
      "mark": {
        "select": "[data-mark=\"{mark}\"]:not(text)",
        "labels": "[data-mark-for=\"{mark}\"]"
      },
      "series": {
        "select": "[data-series=\"{series}\"]:not(text)"
      },
      "figure": {
        "select": ".chart-body"
      }
    },
    "key": "largest"
  },
  "part": {
    "units": {
      "mark": {
        "select": "[data-mark=\"{mark}\"]:not(text)",
        "labels": "[data-mark-for=\"{mark}\"]"
      },
      "figure": {
        "select": ".chart-body"
      }
    },
    "key": "largest"
  },
  "field": {
    "units": {
      "mark": {
        "select": "[data-mark=\"{mark}\"]:not(text)",
        "labels": "[data-mark-for=\"{mark}\"]"
      },
      "figure": {
        "select": ".chart-body"
      }
    },
    "key": "largest"
  },
  "flow": {
    "units": {
      "node": {
        "select": "[data-mark=\"{mark}\"]:not(text)",
        "labels": "[data-mark-for=\"{mark}\"]"
      },
      "step": {
        "select": "[role=listitem]"
      },
      "figure": {
        "select": ":is(.chart-body, svg):not(header *)"
      }
    },
    "key": "last"
  },
  "media": {
    "units": {
      "figure": {
        "select": ":is(figure, img, video, pre, svg, .katex-display, .qr-card):not(header *):not(footer *):not(figure *):not(.qr-card *)"
      },
      "paragraph": {
        "select": "p:not(header *):not(footer *):not(li *)"
      },
      "heading": {
        "select": ":is(h1, h2):not(header *):not(footer *)"
      }
    },
    "key": "first"
  }
}
