  "coverage": {
    "$comment": "Which hair layers a head covering hides, per hairstyle; \"*\" is every hairstyle not named. A hijab and a turban hide all hair. A skull cap or a cap hides the fringe, and the volume (a bun, an afro, curls) that would otherwise show above it.",
    "hijab":  { "*": ["back", "mid", "front"] },
    "turban": { "*": ["back", "mid", "front"] },
    "skullcap": { "*": ["front"], "bun": ["back", "front"], "coily": ["back", "front"], "curly": ["back", "front"] },
    "beanie": { "*": ["front"], "bun": ["back", "front"], "coily": ["back", "front"], "curly": ["back", "front"] },
    "kufi": { "*": ["front"], "bun": ["back", "front"], "coily": ["back", "front"], "curly": ["back", "front"] },
    "backcap": { "*": [], "bun": ["back"], "coily": ["back"], "curly": ["back", "front"] },
    "cap":    { "*": ["front"], "bun": ["back", "front"], "coily": ["back", "front"], "curly": ["back", "front"] }
  },
  "hides-earrings": ["hijab"],
  "fit": {
    "$comment": "Head coverings are drawn once, then fitted to the head they sit on (the hijab wraps the whole head and is not fitted). A covering is sized to the higher of the face's top and the hair's crown, and the wider of the face and the hair, plus a small margin, so it sits snug: sy stretches it from `anchor` (the brow line) up to its target top, sx across about the centerline. `hats` holds each drawing's measured top and half-width, `faces` each face shape's, and `hair` each hairstyle's crown height and half-width (the hair drawings do not change with the face, so these are absolute; the volume styles are the height they press down to under a covering). target top = min(face top, hair top) - margin.top; target half-width = max(face half, hair half) + margin.side.",
    "anchor": 38,
    "margin": { "top": 1, "side": 1 },
    "hats": {
      "turban":   { "top": 21.2, "half": 21.4 },
      "skullcap": { "top": 17.4, "half": 19.1 },
      "beanie":   { "top": 17,   "half": 20.1 },
      "kufi":     { "top": 18.8, "half": 17.6 },
      "cap":      { "top": 17.9, "half": 19 },
      "backcap":  { "top": 17.3, "half": 19.3 }
    },
    "faces": {
      "oval":   { "top": 28,   "half": 16 },
      "round":  { "top": 30,   "half": 17 },
      "long":   { "top": 26,   "half": 15 },
      "square": { "top": 27.5, "half": 16 },
      "heart":  { "top": 27.5, "half": 16 }
    },
    "hair": {
      "none":  null,
      "buzz":  { "top": 26.6, "half": 15.6 },
      "short": { "top": 23.4, "half": 17.8 },
      "side":  { "top": 23,   "half": 17.8 },
      "curly": { "top": 22,   "half": 19 },
      "coily": { "top": 21,   "half": 20 },
      "bob":   { "top": 23,   "half": 19.5 },
      "long":  { "top": 26,   "half": 16 },
      "bun":   { "top": 22.5, "half": 17.4 },
      "locs":  { "top": 23.5, "half": 18 }
    }
  },
  "deep": {
    "$comment": "For the deeper skin tones, a default hair color comes from these pools instead, so a name never defaults to blonde or red where it would be rare. A color the author writes always wins.",
