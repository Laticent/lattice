{
  "$schema": "../plugin.schema.json",
  "type": "plugin",
  "format": 1,
  "name": "function-plot",
  "api": 1,
  "title": "Function plots",
  "description": "Plot y = f(x), parametric and polar curves from a JSON config fence, drawn in the browser by function-plot.",
  "contributes": {
    "fences": {
      "functionplot": { "aliases": [{ "name": "latticeplot", "deprecated": true }], "body": "json" }
    },
    "hydrate": {},
    "styles": true,
    "diagnostics": {
      "function-plot/deprecated-alias": "```latticeplot is a deprecated name for ```functionplot; rename the fence."
    }
  },
  "payload": {
    "function-plot": {
      "from": "npm:function-plot/dist/function-plot.js",
      "vendored": { "file": "vendor/function-plot.js", "version": "1.25.4", "sha256": "4e3cc6d8015e517b0356178bc6409405db2b31385ac655b657aaad7120b802d1" },
      "global": "functionPlot",
      "when": "used"
    }
  },
  "vendor": {
    "license": { "from": "npm:function-plot/LICENSE", "file": "vendor/function-plot.LICENSE", "version": "1.25.4", "sha256": "86afcfc89ecd82fcf71e87e1f7486cecefa878c73dd6f164445347f7d856d0f4" }
  },
  "tokens": [
    "--accent",
    "--border",
    "--cat-4-mark",
    "--cat-7-mark",
    "--font-body",
    "--font-mono",
    "--fs-meta",
    "--muted-mark",
    "--radius-sm",
    "--sp-sm",
    "--text-body",
    "--text-heading",
    "--text-muted",
    "--warn"
  ],
  "render": {
    "exec": { "hydrate": "browser" },
    "surfaces": { "engine": "placeholder", "preview": "figure", "pdf": "figure", "player": "figure-baked", "marp": "source" },
    "parity": "progressive",
    "degradesTo": "source"
  }
}
