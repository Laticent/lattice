{
  "$schema": "../plugin.schema.json",
  "type": "plugin",
  "format": 1,
  "name": "image",
  "api": 1,
  "title": "Images",
  "description": "A picture written as a record on a line of its own: `@image{sample:photo-wide.jpg, title=\"Q3 offsite\", frame=mat, nimbus}`, with Markdown's `![title](src \"description\")` as its alias. The record describes the picture (its title and description, a focus, a size, a frame, a finish and a tone, on the shared display layer); the slide places it: an `image` slide makes it the photo panel, a `bleed` slide its background, any other slide a figure in its flow. The address comes from the author's own record and nothing else, and Marp's alt-text keywords (`![bg left](x)`) are retired: `lint:deck --fix` rewrites them.",
  "icon": {
    "viewBox": "0 0 128 128",
    "paths": [
      {
