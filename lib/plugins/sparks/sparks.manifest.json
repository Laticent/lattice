{
  "$schema": "../plugin.schema.json",
  "type": "plugin",
  "format": 1,
  "name": "sparks",
  "api": 1,
  "title": "Sparks",
  "description": "Word-sized charts written in inline code: `~{12 14 17, bar, c3, lg}` draws a line, area, bar, step, win/loss, ring or bullet the size of a word, with no axes, labels or legend. A deck-wide `spark:` register sets the frame, look and corners; a slide's `spark-*` class and the spark's own words override it. Drawn at render time on every surface, with no payload.",
  "icon": {
    "viewBox": "0 0 128 128",
    "paths": [
      {
        "ink": "line",
        "d": "M24 26H104A12 12 0 0 1 116 38V90A12 12 0 0 1 104 102H24A12 12 0 0 1 12 90V38A12 12 0 0 1 24 26Z",
        "width": 7
      },
      {
        "ink": "line",
