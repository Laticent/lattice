{
  "$schema": "../plugin.schema.json",
  "type": "plugin",
  "format": 1,
  "name": "video",
  "api": 1,
  "title": "Video",
  "description": "A video as a static, PDF-safe poster that links to the clip, written in inline code on a line of its own: `@video{\"https://youtu.be/dQw4w9WgXcQ\", title=\"The 90-second tour\", poster=sample:photo-pano.jpg}`. The address comes from the author's own record and nowhere else: nothing here reads a slide's text or its rendered page, so a plugin's drawing can never become a video address. The `video` slide class lays the figure out.",
  "icon": {
    "viewBox": "0 0 128 128",
    "paths": [
      {
        "ink": "line",
        "d": "M32 20H96A16 16 0 0 1 112 36V70A16 16 0 0 1 96 86H32A16 16 0 0 1 16 70V36A16 16 0 0 1 32 20Z",
        "width": 7
      },
      {
        "ink": "accent",
        "d": "M53 36L79 52L53 68Z",
        "width": 7
      },
      {
        "ink": "line",
        "d": "M28 108H100",
        "width": 7
      },
      {
        "ink": "fill",
        "d": "M68 108A7 7 0 1 0 82 108A7 7 0 1 0 68 108Z"
      }
    ]
  },
  "hostApi": [
    "video.inline.js",
    "shared/video-marp-export.js"
  ],
  "contributes": {
    "inline": {
      "video": {
        "named": true,
        "address": true
      }
    },
    "providers": [
      {
        "key": "youtube",
        "label": "YouTube",
        "hosts": [
          "youtube.com",
          "youtu.be",
          "youtube-nocookie.com"
        ],
        "id": [
          {
            "query": "v",
            "pattern": "^[\\w-]{11}$"
          },
          {
            "host": "youtu.be",
            "path": "^/([\\w-]{11})$"
          },
          {
            "notHost": "youtu.be",
            "path": "^/(?:shorts|embed|live|v)/([\\w-]{11})$"
          }
        ],
        "watch": "https://www.youtube.com/watch?v={id}",
        "oembed": "https://www.youtube.com/oembed?url={watch}&format=json",
        "embed": "https://www.youtube-nocookie.com/embed/{id}?autoplay=1&rel=0",
        "shape": "landscape"
      },
      {
        "key": "vimeo",
        "label": "Vimeo",
        "hosts": [
          "vimeo.com"
        ],
        "id": [
          {
            "path": "^/(?:video/)?(\\d{5,})(?:/|$)"
          }
        ],
        "watch": "https://vimeo.com/{id}",
        "oembed": "https://vimeo.com/api/oembed.json?url={watch}",
        "embed": "https://player.vimeo.com/video/{id}?autoplay=1",
        "shape": "landscape"
      },
      {
        "key": "tiktok",
        "label": "TikTok",
        "hosts": [
          "tiktok.com"
        ],
        "id": [
          {
            "path": "^/(?:@[\\w.-]+/video/|embed/(?:v2/)?|player/v1/)(\\d{6,})(?:/|$)"
          }
        ],
        "watch": "{url}",
        "oembed": "https://www.tiktok.com/oembed?url={watch}",
        "embed": "https://www.tiktok.com/player/v1/{id}?autoplay=1",
        "shape": "portrait",
        "asyncResolve": true
      },
      {
        "key": "instagram",
        "label": "Instagram",
        "hosts": [
          "instagram.com"
        ],
        "id": [
          {
            "path": "^/(?:reels?|p|tv)/([\\w-]+)(?:/|$)"
          }
        ],
        "watch": "{url}",
        "oembed": null,
        "embed": "https://www.instagram.com/p/{id}/embed/",
        "shape": "portrait"
      }
    ]
  },
  "render": {
    "parity": "equivalent",
    "degradesTo": "source"
  }
}
