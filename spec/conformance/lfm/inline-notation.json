{
 "title": "Pills, marks, sparks and icons in single-backtick code; anything else stays code",
 "spec": "LFM-1.1",
 "section": "3.6",
 "rows": [
  { "name": "a pill with shape and color", "source": "## A\n\nStatus `{BETA, tag, c4}`\n",
    "L0": { "visible": ["{BETA, tag, c4}"] },
    "L1": { "slides": [{ "inline": [{ "kind": "pill", "label": "BETA", "shape": "tag", "color": "c4" }] }] } },
  { "name": "words in any order, or by name", "source": "## A\n\n`{BETA, c4, tag}` `{BETA, shape=tag, color=c4}`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "pill", "label": "BETA", "shape": "tag", "color": "c4" }, { "kind": "pill", "label": "BETA", "shape": "tag", "color": "c4" }] }] } },
  { "name": "no shape word is the capsule", "source": "## A\n\n`{LIVE}`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "pill", "label": "LIVE", "shape": "pill", "color": null }] }] } },
  { "name": "a quoted label holds a comma", "source": "## A\n\n`{\"Cost, excluding tax\", chip}`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "pill", "label": "Cost, excluding tax", "shape": "chip", "color": null }] }] } },
  { "name": "an unknown word leaves the span as code", "source": "## A\n\n`{X, c13}`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "code", "text": "{X, c13}" }] }] } },
  { "name": "an unquoted bar is code, and a diagnostic", "source": "## A\n\n`{A|B}`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "code", "text": "{A|B}" }] }] },
    "L2": { "findings": [{ "rule": "pill-literal", "severity": "warning", "slide": 1 }] } },
  { "name": "padded braces are code", "source": "## A\n\n`{ ok, scene }`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "code", "text": "{ ok, scene }" }] }] } },
  { "name": "a backslash escapes the sigil", "source": "## A\n\n`\\{LIVE}` and `\\[x]`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "code", "text": "{LIVE}" }, { "kind": "code", "text": "[x]" }] }] } },
  { "name": "a backslash anywhere else is kept", "source": "## A\n\n`\\d+`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "code", "text": "\\d+" }] }] } },
  { "name": "the six state marks inline", "source": "## A\n\n`[x]` `[-]` `[!]` `[?]` `[ ]` `[/]`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "mark", "answer": "yes" }, { "kind": "mark", "answer": "partly" }, { "kind": "mark", "answer": "no" }, { "kind": "mark", "answer": "unknown" }, { "kind": "mark", "answer": "open" }, { "kind": "mark", "answer": "does not apply" }] }] } },
  { "name": "a series spark is a line by default", "source": "## A\n\nTrend `~{12 14 17}`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "spark", "type": "line" }] }] } },
  { "name": "a ratio spark is a ring by default", "source": "## A\n\n`~{72/80}` `~{72%}`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "spark", "type": "ring" }, { "kind": "spark", "type": "ring" }] }] } },
  { "name": "a spark type word", "source": "## A\n\n`~{1 2 3, bar}` `~{1.9/1.6, bullet}`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "spark", "type": "bar" }, { "kind": "spark", "type": "bullet" }] }] } },
  { "name": "a spark that does not parse is code, and a diagnostic", "source": "## A\n\n`~{12 apples}`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "code", "text": "~{12 apples}" }] }] },
    "L2": { "findings": [{ "rule": "spark-literal", "severity": "warning", "slide": 1 }] } },
  { "name": "an icon on its own", "source": "## A\n\n`^{database}`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "icon", "name": "database" }] }] } },
  { "name": "an icon inside a pill", "source": "## A\n\n`{S3, icon=bucket, c4}`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "pill", "label": "S3", "shape": "pill", "color": "c4", "icon": true }] }] } },
  { "name": "plain inline code is untouched", "source": "## A\n\n`getUserId()` and `--accent`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "code", "text": "getUserId()" }, { "kind": "code", "text": "--accent" }] }] } },
  { "name": "fenced code is never notation", "source": "## A\n\n```\n{BETA, tag}\n```\n",
    "L1": { "slides": [{ "inline": [] }] } },
  { "name": "inline-code: literal turns every form off", "source": "---\ninline-code: literal\n---\n\n## A\n\n`{BETA, tag}` `[x]` `~{1 2 3}`\n",
    "L1": { "slides": [{ "inline": [{ "kind": "code", "text": "{BETA, tag}" }, { "kind": "code", "text": "[x]" }, { "kind": "code", "text": "~{1 2 3}" }] }] } }
 ]
}
