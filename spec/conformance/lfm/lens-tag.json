{
 "title": "A record's lens field names the lenses a slide is in or out of, and never reaches the output",
 "spec": "LFM-1.0",
 "section": "6.1",
 "rows": [
  { "name": "include and exclude", "source": "## A\n\n<!-- @meta{lens=\"brief +ask -evidence\"} -->\n\nText.\n",
    "L0": { "visible": ["Text."], "hidden": ["_lens", "brief"] },
    "L1": { "absent": ["_lens", "brief"], "slides": [{ "lens": { "include": ["ask", "brief"], "exclude": ["evidence"] }, "notes": { "note": null, "say": null, "alt": null, "handout": null } }] } },
  { "name": "no tag", "source": "## A\n\nText.\n",
    "L1": { "slides": [{ "lens": { "include": [], "exclude": [] } }] } },
  { "name": "a capital _Lens is not a tag", "source": "## A\n\n<!-- _Lens: brief -->\n\nText.\n",
    "L1": { "slides": [{ "lens": { "include": [], "exclude": [] } }] } },
  { "name": "two records that set the tag: the last one wins, as for any repeated field", "source": "## A\n\n<!-- @meta{lens=brief} -->\n\n<!-- @meta{lens=ask} -->\n\nText.\n",
    "L1": { "slides": [{ "lens": { "include": ["ask"], "exclude": [] } }] } },
  { "name": "an old _lens comment is not a tag", "source": "## A\n\n<!-- _lens: brief -->\n\nText.\n",
    "L1": { "slides": [{ "lens": { "include": [], "exclude": [] } }] } },
  { "name": "a tag inside a fence is documentation", "source": "## A\n\n```\n<!-- _lens: brief -->\n```\n",
    "L1": { "slides": [{ "lens": { "include": [], "exclude": [] } }] } }
 ]
}
