# Copy to /etc/lattice-runner/env, then: sudo chown root:root /etc/lattice-runner/env && sudo chmod 600 /etc/lattice-runner/env
# This file holds a secret. Never commit the filled-in copy.

# Fine-grained personal access token, scoped to Laticent/lattice only,
# repository permission "Administration: Read and write" (needed to mint one-job runner configs).
GITHUB_PAT=github_pat_REPLACE_ME

LATTICE_REPO=Laticent/lattice

# Precision (48 GB): 8 slots x 3 CPUs x 5.5 GB.  After a RAM upgrade to 128 GB: 16 slots.
# Alienware Linux VM (give the VM 12 vCPUs / 22 GB): 4 slots x 3 CPUs x 5 GB.
LATTICE_SLOTS=8
LATTICE_CPUS_PER_JOB=3
LATTICE_MEMORY_PER_JOB=5500m

# Shown in GitHub's runner list and added as a label, so you can see which machine ran a job.
LATTICE_HOST_LABEL=precision

# Defaults you rarely change: the job network's subnet, the public DNS servers jobs use (a
# private resolver would be blocked by firewall.sh), and how long one container may live.
# LATTICE_SUBNET=172.31.250.0/24
# LATTICE_DNS="1.1.1.1 9.9.9.9"
# LATTICE_MAX_CONTAINER_MINUTES=180

# Optional: a healthchecks.io (or Uptime Kuma push) URL. The supervisor pings it every 2 minutes
# while the token works and Docker is healthy, and pings <url>/fail when either breaks.
LATTICE_HEALTHCHECK_URL=
